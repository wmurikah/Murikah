---
import Container from '@/components/primitives/Container.astro';
import { NAV, PRIMARY_CTA } from '@/site.config';
import type { NavItem } from '@/site.config';

const path = Astro.url.pathname;
const groupActive = (item: NavItem) =>
  (item.match ?? [item.href]).some((prefix) => path === prefix || path.startsWith(prefix + '/'));
const childActive = (href: string) => path === href || path.startsWith(href + '/');
const idFor = (label: string, index: number) =>
  `site-nav-${index}-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<header class="site-header" data-site-header>
  <Container class="site-header__container">
    <div class="site-header__row">
      <a href="/" class="site-header__logo" aria-label="Murikah, home">
        <img
          src="/brand/murikah-header-lockup.svg"
          alt="Murikah"
          width="190"
          height="32"
          decoding="async"
        />
      </a>

      <nav class="site-primary-nav" aria-label="Primary">
        {
          NAV.map((item, index) => {
            const active = groupActive(item);
            if (!item.children) {
              return (
                <a
                  href={item.href}
                  class="site-nav-link"
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            }

            const menuId = idFor(item.label, index);
            return (
              <div class="site-nav-group" data-nav-group>
                <a
                  href={item.href}
                  id={`${menuId}-trigger`}
                  class="site-nav-link site-nav-trigger"
                  aria-current={active ? 'page' : undefined}
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls={menuId}
                  data-nav-trigger
                >
                  <span>{item.label}</span>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" />
                  </svg>
                </a>

                <div
                  id={menuId}
                  class="site-nav-menu"
                  role="menu"
                  aria-labelledby={`${menuId}-trigger`}
                  aria-hidden="true"
                  inert
                  data-nav-panel
                >
                  <ul>
                    {item.children.map((child) => (
                      <li role="none">
                        <a
                          href={child.href}
                          role="menuitem"
                          class="site-nav-menu__item"
                          aria-current={childActive(child.href) ? 'page' : undefined}
                        >
                          <span>{child.label}</span>
                          {child.description && <small>{child.description}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })
        }
      </nav>

      <a href={PRIMARY_CTA.href} class="site-header__cta">
        {PRIMARY_CTA.label}
      </a>

      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-mobile-toggle
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      <div class="site-header__fullscreen-controls" aria-label="Sandbox full-screen controls">
        <button type="button" class="site-header__fullscreen-exit" data-exit-sandbox-fullscreen>
          Exit full screen
        </button>
        <a href={PRIMARY_CTA.href} class="site-header__cta site-header__cta--fullscreen">
          {PRIMARY_CTA.label}
        </a>
      </div>
    </div>
  </Container>

  <div id="mobile-menu" class="site-mobile-menu" aria-hidden="true" inert data-mobile-panel>
    <Container class="site-mobile-menu__container">
      <nav aria-label="Mobile">
        <a href={PRIMARY_CTA.href} class="site-header__cta site-mobile-menu__cta">
          {PRIMARY_CTA.label}
        </a>

        <div class="site-mobile-menu__items">
          {
            NAV.map((item, index) => {
              if (!item.children) {
                return (
                  <a
                    href={item.href}
                    class="site-mobile-menu__link"
                    aria-current={groupActive(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                );
              }

              const panelId = `mobile-${idFor(item.label, index)}`;
              return (
                <div class="site-mobile-accordion" data-mobile-accordion>
                  <div class="site-mobile-accordion__row">
                    <a
                      href={item.href}
                      class="site-mobile-menu__link"
                      aria-current={groupActive(item) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                    <button
                      type="button"
                      class="site-mobile-accordion__toggle"
                      aria-expanded="false"
                      aria-controls={panelId}
                      aria-label={`Show ${item.label} links`}
                      data-mobile-accordion-toggle
                    >
                      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <path d="M4 6l4 4 4-4" />
                      </svg>
                    </button>
                  </div>
                  <div id={panelId} class="site-mobile-accordion__panel" hidden data-mobile-accordion-panel>
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="site-mobile-menu__child"
                        aria-current={childActive(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>
      </nav>
    </Container>
  </div>
</header>

<script>
  function initSharedHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready === 'true') return;
    header.dataset.ready = 'true';

    const groups = Array.from(header.querySelectorAll<HTMLElement>('[data-nav-group]'));
    const pointerHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    let openGroup: HTMLElement | null = null;
    const timers = new WeakMap<HTMLElement, number>();

    const clearTimer = (group: HTMLElement) => {
      const timer = timers.get(group);
      if (timer) window.clearTimeout(timer);
      timers.delete(group);
    };

    const panelFor = (group: HTMLElement) =>
      group.querySelector<HTMLElement>('[data-nav-panel]');
    const triggerFor = (group: HTMLElement) =>
      group.querySelector<HTMLElement>('[data-nav-trigger]');

    const closeGroup = (group: HTMLElement, focusTrigger = false) => {
      clearTimer(group);
      const trigger = triggerFor(group);
      const panel = panelFor(group);
      group.dataset.open = 'false';
      trigger?.setAttribute('aria-expanded', 'false');
      panel?.setAttribute('aria-hidden', 'true');
      panel?.setAttribute('inert', '');
      if (openGroup === group) openGroup = null;
      if (focusTrigger) trigger?.focus();
    };

    const openMenu = (group: HTMLElement, focus: 'none' | 'first' | 'last' = 'none') => {
      if (openGroup && openGroup !== group) closeGroup(openGroup);
      clearTimer(group);
      const trigger = triggerFor(group);
      const panel = panelFor(group);
      if (!trigger || !panel) return;
      group.dataset.open = 'true';
      trigger.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      panel.removeAttribute('inert');
      openGroup = group;
      if (focus !== 'none') {
        const items = Array.from(panel.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        const target = focus === 'first' ? items[0] : items.at(-1);
        window.requestAnimationFrame(() => target?.focus());
      }
    };

    const scheduleOpen = (group: HTMLElement) => {
      clearTimer(group);
      timers.set(group, window.setTimeout(() => openMenu(group), 120));
    };

    const scheduleClose = (group: HTMLElement) => {
      clearTimer(group);
      timers.set(
        group,
        window.setTimeout(() => {
          if (!group.matches(':hover') && !group.contains(document.activeElement)) closeGroup(group);
        }, 120),
      );
    };

    groups.forEach((group) => {
      const trigger = triggerFor(group);
      const panel = panelFor(group);
      if (!trigger || !panel) return;

      group.addEventListener('pointerenter', () => {
        if (pointerHover.matches) scheduleOpen(group);
      });
      group.addEventListener('pointerleave', () => {
        if (pointerHover.matches) scheduleClose(group);
      });
      group.addEventListener('focusin', () => openMenu(group));
      group.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !group.contains(next)) scheduleClose(group);
      });

      trigger.addEventListener('click', (event) => {
        if (trigger.getAttribute('aria-expanded') !== 'true') {
          event.preventDefault();
          openMenu(group);
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === ' ' || event.key === 'Enter') {
          if (trigger.getAttribute('aria-expanded') !== 'true') {
            event.preventDefault();
            openMenu(group);
          }
          return;
        }
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          openMenu(group, 'first');
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          openMenu(group, 'last');
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closeGroup(group, true);
        }
      });

      panel.addEventListener('keydown', (event) => {
        const items = Array.from(panel.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        const index = items.indexOf(document.activeElement as HTMLElement);
        if (event.key === 'Escape') {
          event.preventDefault();
          closeGroup(group, true);
        } else if (event.key === 'ArrowDown') {
          event.preventDefault();
          items[(index + 1 + items.length) % items.length]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          items[(index - 1 + items.length) % items.length]?.focus();
        } else if (event.key === 'Home') {
          event.preventDefault();
          items[0]?.focus();
        } else if (event.key === 'End') {
          event.preventDefault();
          items.at(-1)?.focus();
        }
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (openGroup && !openGroup.contains(event.target as Node)) closeGroup(openGroup);
    });

    const mobileToggle = header.querySelector<HTMLElement>('[data-mobile-toggle]');
    const mobilePanel = header.querySelector<HTMLElement>('[data-mobile-panel]');
    const mobileAccordions = Array.from(
      header.querySelectorAll<HTMLElement>('[data-mobile-accordion]'),
    );

    const mobileFocusable = () =>
      Array.from(
        mobilePanel?.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ) ?? [],
      ).filter((element) => element.getClientRects().length > 0);

    const closeAccordions = () => {
      mobileAccordions.forEach((accordion) => {
        const toggle = accordion.querySelector<HTMLElement>('[data-mobile-accordion-toggle]');
        const panel = accordion.querySelector<HTMLElement>('[data-mobile-accordion-panel]');
        toggle?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });
    };

    const setMobileOpen = (open: boolean) => {
      if (!mobileToggle || !mobilePanel) return;
      mobileToggle.setAttribute('aria-expanded', String(open));
      mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobilePanel.setAttribute('aria-hidden', String(!open));
      if (open) {
        mobilePanel.removeAttribute('inert');
        document.body.classList.add('site-menu-open');
        window.requestAnimationFrame(() => mobileFocusable()[0]?.focus());
      } else {
        mobilePanel.setAttribute('inert', '');
        document.body.classList.remove('site-menu-open');
        closeAccordions();
      }
    };

    mobileToggle?.addEventListener('click', () => {
      setMobileOpen(mobileToggle.getAttribute('aria-expanded') !== 'true');
    });

    mobileAccordions.forEach((accordion) => {
      const toggle = accordion.querySelector<HTMLElement>('[data-mobile-accordion-toggle]');
      const panel = accordion.querySelector<HTMLElement>('[data-mobile-accordion-panel]');
      toggle?.addEventListener('click', () => {
        if (!panel) return;
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
      });
    });

    mobilePanel?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a[href]')) setMobileOpen(false);
    });

    mobilePanel?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = mobileFocusable();
      if (!items.length) return;
      const first = items[0];
      const last = items.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (mobileToggle?.getAttribute('aria-expanded') === 'true') {
        setMobileOpen(false);
        mobileToggle.focus();
      } else if (openGroup) {
        closeGroup(openGroup, true);
      }
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setMobileOpen(false);
    });

    header.querySelector<HTMLElement>('[data-exit-sandbox-fullscreen]')?.addEventListener(
      'click',
      () => window.dispatchEvent(new CustomEvent('murikah:sandbox-exit-fullscreen')),
    );
  }

  initSharedHeader();
  document.addEventListener('astro:page-load', initSharedHeader);
</script>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--header-z);
    width: 100%;
    height: var(--header-height);
    border-bottom: 1px solid var(--header-border);
    background: var(--header-bg);
    color: var(--header-fg);
    box-shadow: none;
  }

  .site-header__container {
    height: 100%;
  }

  .site-header__row {
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .site-header__logo {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    border-radius: 6px;
  }

  .site-header__logo img {
    display: block;
    width: auto;
    height: 32px;
  }

  .site-primary-nav {
    display: flex;
    min-width: 0;
    align-items: stretch;
    justify-content: center;
    gap: clamp(1.1rem, 2vw, 2rem);
    height: 100%;
  }

  .site-nav-group {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .site-nav-link {
    position: relative;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    gap: 4px;
    color: var(--header-fg-muted);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .site-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(50% - 20px);
    height: 2px;
    background: var(--color-brass-on-dark);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 150ms ease;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible,
  .site-nav-link[aria-current='page'] {
    color: var(--header-fg-hover);
  }

  .site-nav-link:hover::after,
  .site-nav-link:focus-visible::after,
  .site-nav-link[aria-current='page']::after,
  .site-nav-group[data-open='true'] > .site-nav-link::after {
    transform: scaleX(1);
  }

  .site-nav-link:focus-visible,
  .site-header__logo:focus-visible,
  .site-header__menu-toggle:focus-visible,
  .site-header__fullscreen-exit:focus-visible,
  .site-mobile-menu a:focus-visible,
  .site-mobile-menu button:focus-visible {
    outline: 2px solid var(--color-brass-on-dark);
    outline-offset: 3px;
  }

  .site-nav-trigger svg,
  .site-mobile-accordion__toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 150ms ease;
  }

  .site-nav-group[data-open='true'] .site-nav-trigger svg,
  .site-mobile-accordion__toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .site-nav-menu {
    position: absolute;
    top: calc(100% - 5px);
    left: 50%;
    z-index: calc(var(--header-z) + 1);
    width: min(28rem, 90vw);
    padding: 12px;
    border: 1px solid var(--header-border);
    border-radius: 12px;
    background: #0b2540;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 6px);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms step-end;
  }

  .site-nav-group[data-open='true'] .site-nav-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0ms;
  }

  .site-nav-menu ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav-menu__item {
    display: block;
    min-height: 48px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--header-fg);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav-menu__item:hover,
  .site-nav-menu__item:focus-visible {
    background: rgba(245, 241, 232, 0.06);
    color: var(--header-fg-hover);
  }

  .site-nav-menu__item span,
  .site-nav-menu__item small {
    display: block;
  }

  .site-nav-menu__item small {
    margin-top: 4px;
    color: var(--header-fg-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.35;
  }

  .site-header__cta {
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: 6px;
    background: var(--color-brass-on-dark);
    color: #071d35;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease;
  }

  .site-header__cta:hover {
    background: color-mix(in srgb, var(--color-brass-on-dark) 94%, white);
    color: #071d35;
  }

  .site-header__cta:focus-visible {
    outline: 2px solid #f5f1e8;
    outline-offset: 3px;
  }

  .site-header__menu-toggle,
  .site-header__fullscreen-controls,
  .site-mobile-menu {
    display: none;
  }

  .site-header__fullscreen-exit {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--header-border);
    border-radius: 6px;
    background: transparent;
    color: var(--header-fg);
    font: 500 14px/1 var(--font-sans);
    cursor: pointer;
  }

  .site-header__fullscreen-exit:hover {
    background: rgba(245, 241, 232, 0.06);
    color: var(--header-fg-hover);
  }

  .site-mobile-menu {
    position: fixed;
    inset: var(--header-height-sm) 0 0;
    z-index: calc(var(--header-z) - 1);
    overflow-y: auto;
    border-top: 1px solid var(--header-border);
    background: var(--header-bg);
    color: var(--header-fg);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 150ms ease,
      visibility 150ms step-end;
  }

  .site-mobile-menu[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 150ms ease,
      visibility 0ms;
  }

  .site-mobile-menu__container {
    min-height: 100%;
    padding-top: 20px;
    padding-bottom: max(24px, env(safe-area-inset-bottom));
  }

  .site-mobile-menu__cta {
    width: 100%;
    margin-bottom: 18px;
  }

  .site-mobile-menu__items {
    display: grid;
    border-top: 1px solid var(--header-border);
  }

  .site-mobile-menu__link {
    min-height: 48px;
    display: flex;
    align-items: center;
    color: var(--header-fg);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
  }

  .site-mobile-menu__link[aria-current='page'] {
    color: var(--header-fg-hover);
    text-decoration: underline;
    text-decoration-color: var(--color-brass-on-dark);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .site-mobile-accordion {
    border-bottom: 1px solid var(--header-border);
  }

  .site-mobile-accordion__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 48px;
    align-items: center;
  }

  .site-mobile-accordion__toggle {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--header-fg);
    cursor: pointer;
  }

  .site-mobile-accordion__toggle:hover {
    background: rgba(245, 241, 232, 0.06);
  }

  .site-mobile-accordion__panel {
    padding: 0 0 8px 14px;
  }

  .site-mobile-menu__child {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-left: 1px solid var(--header-border);
    color: var(--header-fg-muted);
    font-size: 15px;
    text-decoration: none;
  }

  .site-mobile-menu__child:hover,
  .site-mobile-menu__child:focus-visible,
  .site-mobile-menu__child[aria-current='page'] {
    background: rgba(245, 241, 232, 0.06);
    color: var(--header-fg-hover);
  }

  body.site-menu-open {
    overflow: hidden;
  }

  html.sandbox-fullscreen .site-header {
    height: 48px;
  }

  html.sandbox-fullscreen .site-header__row {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  html.sandbox-fullscreen .site-header__logo img {
    height: 24px;
  }

  html.sandbox-fullscreen .site-primary-nav,
  html.sandbox-fullscreen .site-header__cta:not(.site-header__cta--fullscreen),
  html.sandbox-fullscreen .site-header__menu-toggle,
  html.sandbox-fullscreen .site-mobile-menu {
    display: none !important;
  }

  html.sandbox-fullscreen .site-header__fullscreen-controls {
    grid-column: 3;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  html.sandbox-fullscreen .site-header__cta--fullscreen {
    height: 36px;
    padding-inline: 14px;
    font-size: 13px;
  }

  html.sandbox-fullscreen .site-header__fullscreen-exit {
    min-height: 36px;
  }

  @media (max-width: 1023px) {
    .site-header {
      height: var(--header-height-sm);
    }

    .site-header__row {
      grid-template-columns: auto minmax(0, 1fr) 44px;
      gap: 12px;
    }

    .site-header__logo img {
      height: 28px;
    }

    .site-primary-nav,
