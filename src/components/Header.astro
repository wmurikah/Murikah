---
/**
 * Header, site chrome following familiar conventions (Jakob's Law): logo
 * top-left links home, five primary navigation items, and one primary CTA
 * furthest right. Solutions, Platform, Pricing, Insights and About come straight from
 * `NAV` in site.config, so order and contents stay single-source. Dropdowns
 * are capped at five destinations to keep choices short and clearly grouped.
 *
 * Desktop: each group's trigger is a real link to its hub that also reveals a
 * disclosure menu of the group's pages on hover and keyboard focus
 * (group-hover / group-focus-within, no JavaScript). Mobile: a keyboard-operable
 * menu with focus trapping and body-scroll lock, where each group is an
 * expandable <details> section. Progressive enhancement, every link works
 * without JS.
 */
import Container from '@/components/primitives/Container.astro';
import Button from '@/components/primitives/Button.astro';
import { NAV, PRIMARY_CTA } from '@/site.config';
import type { NavItem } from '@/site.config';

const path = Astro.url.pathname;

// A group is active on any of its owned route prefixes (its `match` list, or
// its own href by default). Hash-only child links share the group's hub route.
const groupActive = (item: NavItem) =>
  (item.match ?? [item.href]).some((p) => path === p || path.startsWith(p + '/'));

// Inline editorial links on a light paper header: no pill, no boxed tabs. A
// fine brass underline grows on hover/focus and stays lit for the active group.
const navLink =
  'relative inline-flex min-h-[2.75rem] items-center gap-1 px-0.5 text-sm font-medium text-slate transition-[color,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-px hover:text-navy focus-visible:text-navy aria-[current=page]:text-navy ' +
  'after:pointer-events-none after:absolute after:inset-x-0 after:bottom-[0.7rem] after:h-px after:origin-center after:scale-x-0 after:bg-brass after:transition-transform after:duration-300 after:ease-[cubic-bezier(0.22,1,0.36,1)] ' +
  'hover:after:scale-x-100 focus-visible:after:scale-x-100 group-hover:after:scale-x-100 group-focus-within:after:scale-x-100 aria-[current=page]:after:scale-x-100';
---

<header class="site-header sticky top-0 z-50 border-b border-hairline bg-paper/95 backdrop-blur-md">
  <Container>
    <div class="site-header-row flex items-center justify-between">
      {/* Logo, top-left, links home (Jakob's Law). Navy-and-brass on paper. */}
      <a href="/" class="inline-flex rounded-md no-underline" aria-label="Murikah, home">
        {
          /* Dark lockup for the light navigation surface. */
        }
        <img
          src="/images/murikah-logo-dark.png"
          alt="Murikah"
          width="875"
          height="155"
          class="h-8 w-auto sm:h-9"
        />
      </a>

      {
        /* Desktop primary nav, five items mapped straight from NAV. Inline
          text links, no enclosing pill, with calm spacing between items. */
      }
      <nav aria-label="Primary" class="site-primary-nav hidden items-center lg:flex">
        {
          NAV.map((item) =>
            item.children ? (
              <div class="desktop-nav-group group relative" data-desktop-nav-group>
                {/* The trigger is a real link to the hub, so it works on click,
                    on touch and for keyboard users; the menu reveals on hover
                    and focus-within with no JavaScript. */}
                <a
                  href={item.href}
                  class={navLink}
                  aria-current={groupActive(item) ? 'page' : undefined}
                  aria-haspopup="true"
                  aria-expanded="false"
                  data-desktop-nav-trigger
                >
                  {item.label}
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    class="transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180"
                  >
                    <path
                      d="M4 6l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>

                {/* Disclosure menu. The pt-3 wrapper is a transparent hover
                    bridge so the pointer never crosses a dead gap. */}
                <div
                  class="desktop-nav-menu invisible absolute top-full left-1/2 z-50 w-[26rem] -translate-x-1/2 translate-y-1 scale-[0.985] pt-3 opacity-0 transition-[opacity,transform,visibility] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:scale-100 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100"
                  data-desktop-nav-menu
                >
                  <div class="rounded-[1.25rem] bg-surface p-2 shadow-pop ring-1 ring-hairline">
                    <ul class="grid gap-0.5">
                      {item.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class="group/row flex items-start gap-3 rounded-xl px-3 py-2.5 no-underline transition-colors hover:bg-paper-shade"
                          >
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brass transition-transform group-hover/row:scale-125" />
                            <span>
                              <span class="block text-sm font-medium text-navy">{c.label}</span>
                              <span class="mt-0.5 block text-xs leading-snug text-slate">
                                {c.description}
                              </span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class={navLink}
                aria-current={groupActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>

      {/* Desktop CTA, identical to the hero primary action. */}
      <div class="hidden lg:block">
        <Button href={PRIMARY_CTA.href} variant="primary">{PRIMARY_CTA.label}</Button>
      </div>

      {/* Mobile menu toggle, 44px tap target (Fitts's Law). */}
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-md text-navy hover:bg-paper-shade lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-mobile-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </Container>

  {/* Mobile menu panel */}
  <div
    id="mobile-menu"
    data-mobile-panel
    hidden
    class="max-h-[calc(100dvh-4.25rem)] overflow-y-auto border-t border-hairline bg-paper lg:hidden"
  >
    <Container>
      <nav aria-label="Mobile" class="flex flex-col gap-1 py-4">
        {
          NAV.map((item) =>
            item.children ? (
              <details class="group/m rounded-lg">
                <summary
                  class:list={[
                    'flex min-h-[2.75rem] cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 font-medium text-navy hover:bg-paper-shade [&::-webkit-details-marker]:hidden',
                    groupActive(item) && 'bg-paper-shade',
                  ]}
                  aria-current={groupActive(item) ? 'page' : undefined}
                >
                  {item.label}
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    class="text-slate transition-transform duration-200 group-open/m:rotate-180"
                  >
                    <path
                      d="M4 6l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <div class="mt-1 mb-1 flex flex-col gap-0.5 border-l border-hairline pl-3">
                  {item.children.map((c) => (
                    <a
                      href={c.href}
                      class="rounded-lg px-3 py-2.5 text-slate no-underline hover:bg-paper-shade hover:text-navy"
                    >
                      {c.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-3 font-medium text-navy no-underline hover:bg-paper-shade',
                  groupActive(item) && 'bg-paper-shade',
                ]}
                aria-current={groupActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
        <div class="px-1 pt-3">
          <Button href={PRIMARY_CTA.href} variant="primary" class="w-full">
            {PRIMARY_CTA.label}
          </Button>
        </div>
      </nav>
    </Container>
  </div>
</header>

<script>
  // Mobile menu only. The desktop disclosures are pure CSS (group-hover /
  // group-focus-within), so there is no dropdown JavaScript to fail.
  // Progressive enhancement: every link works without this script.
  function initNav() {
    const desktopGroups = document.querySelectorAll<HTMLElement>('[data-desktop-nav-group]');
    desktopGroups.forEach((group) => {
      const trigger = group.querySelector<HTMLElement>('[data-desktop-nav-trigger]');
      const dismiss = () => {
        // Focus the owning link first; then suppress the focus-within menu.
        // It reopens on the next intentional pointer or keyboard entry.
        trigger?.focus();
        group.dataset.dismissed = 'true';
        trigger?.setAttribute('aria-expanded', 'false');
      };

      group.addEventListener('pointerenter', () => {
        delete group.dataset.dismissed;
        trigger?.setAttribute('aria-expanded', 'true');
      });
      group.addEventListener('pointerleave', () => {
        if (!group.contains(document.activeElement))
          trigger?.setAttribute('aria-expanded', 'false');
      });
      group.addEventListener('focusin', () => {
        if (group.dataset.dismissed !== 'true') trigger?.setAttribute('aria-expanded', 'true');
      });
      group.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !group.contains(next)) {
          delete group.dataset.dismissed;
          trigger?.setAttribute('aria-expanded', 'false');
        }
      });
      group.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') dismiss();
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      desktopGroups.forEach((group) => {
        if (!group.matches(':hover') && !group.contains(document.activeElement)) return;
        const trigger = group.querySelector<HTMLElement>('[data-desktop-nav-trigger]');
        trigger?.focus();
        group.dataset.dismissed = 'true';
        trigger?.setAttribute('aria-expanded', 'false');
      });
    });

    const mToggle = document.querySelector<HTMLElement>('[data-mobile-toggle]');
    const mPanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
    if (mToggle && mPanel) {
      const focusables = () =>
        Array.from(
          mPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary'),
        ).filter((el) => el.getClientRects().length > 0);

      const setOpen = (open: boolean) => {
        mToggle.setAttribute('aria-expanded', String(open));
        mToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        mPanel.hidden = !open;
        document.body.classList.toggle('overflow-hidden', open);
        if (open) focusables()[0]?.focus();
      };

      window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
      mToggle.addEventListener('click', () => {
        setOpen(mToggle.getAttribute('aria-expanded') !== 'true');
      });
      // Close when a destination link is tapped, but not when toggling a
      // group's <summary> disclosure.
      mPanel.addEventListener('click', (e: MouseEvent) => {
        const el = e.target as HTMLElement;
        if (el.closest('a') && !el.closest('summary')) setOpen(false);
      });
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && mToggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          mToggle.focus();
        }
      });
      // Trap focus within the open mobile menu.
      mPanel.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Tab') return;
        const f = focusables();
        if (f.length === 0) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }
  }

  initNav();
</script>

<style>
  .site-header-row {
    height: 4.25rem;
  }

  .site-primary-nav {
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .desktop-nav-group[data-dismissed='true'] .desktop-nav-menu {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>
