---
import { PRODUCTS } from '@/site.config';

const productId = (label: string) => `product-${label.toLowerCase()}`;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    PRODUCTS.map((product) => (
      <li class="min-w-0">
        <article
          id={productId(product.label)}
          class="flex h-full min-h-[19rem] scroll-mt-24 flex-col overflow-hidden rounded-card bg-surface p-5 ring-1 ring-hairline"
        >
          <span class="flex items-start justify-between gap-4">
            <span>
              <span class="block text-2xl font-semibold text-navy">{product.label}</span>
              <span class="mt-1 block text-sm font-medium text-gold">{product.fullName}</span>
            </span>
          </span>
          <span class="mt-3 block text-slate">{product.description}</span>

          <span class="mt-5 block rounded-lg bg-paper p-4 ring-1 ring-hairline/80">
            <span class="block text-xs font-semibold tracking-[0.12em] text-gold uppercase">
              {product.previewLabel}
            </span>
            <span class="mt-3 grid gap-2">
              {product.preview.map((step, index) => (
                <span class="flex items-center gap-2 text-sm text-navy">
                  <span
                    aria-hidden="true"
                    class:list={[
                      'size-2 shrink-0 rounded-full',
                      index === product.preview.length - 1 ? 'bg-gold' : 'bg-navy/25',
                    ]}
                  />
                  {step}
                </span>
              ))}
            </span>
          </span>

          <span class="mt-4 block text-sm text-slate">
            <span class="font-medium text-navy">Example:</span> {product.useCase}
          </span>
          <span class="mt-auto flex items-end justify-between gap-4 pt-4">
            <span>
              <span class="block text-xs text-slate">{product.access}</span>
              <span class="mt-1 block text-xs text-slate">Opens product workspace</span>
            </span>
            <a
              href={product.href}
              class="group inline-flex min-h-11 shrink-0 items-center gap-2 rounded-btn px-3 text-sm font-medium text-blue no-underline ring-1 ring-hairline hover:bg-paper hover:underline"
              aria-label={`Open ${product.label} product workspace`}
            >
              Open {product.label}
              <span
                aria-hidden="true"
                class="text-gold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              >
                ↗
              </span>
            </a>
          </span>
        </article>
      </li>
    ))
  }
</ul>
