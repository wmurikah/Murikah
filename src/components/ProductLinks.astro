---
import { PRODUCTS } from '@/site.config';
---

<ul class="grid gap-x-10 sm:grid-cols-2">
  {
    PRODUCTS.map((product) => (
      <li class="border-t border-hairline py-6">
        <a href={product.href} class="group block no-underline">
          <span class="flex items-center justify-between text-2xl font-semibold text-navy">
            {product.label}
            <span aria-hidden="true" class="text-gold">
              ↗
            </span>
          </span>
          <span class="mt-2 block text-slate">{product.description}</span>
          <span class="mt-4 inline-block text-sm font-medium text-blue group-hover:underline">
            Open {product.label}
          </span>
        </a>
      </li>
    ))
  }
</ul>
