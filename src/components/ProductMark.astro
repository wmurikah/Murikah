---
/**
 * Compact product marks for the marketing site. The common octagonal tile
 * keeps the family coherent; the internal line symbol identifies the job.
 * Labels remain adjacent, so the icon is decorative rather than the sole
 * carrier of meaning.
 */
interface Props {
  product: string;
  class?: string;
}

const { product, class: className } = Astro.props;
---

<span class:list={['product-mark', className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none">
    {
      product === 'CMS' && (
        <>
          <path d="M7.2 9.1h9.6v7.3H7.2z" />
          <path d="M9.2 9.1V7.4h5.6v1.7M9.6 12h4.8M9.6 14.3h3.1" />
        </>
      )
    }
    {
      product === 'GRC' && (
        <>
          <path d="M12 6.6 17 8.5v3.8c0 3-2 4.5-5 5.5-3-1-5-2.5-5-5.5V8.5L12 6.6Z" />
          <path d="m9.7 12.1 1.5 1.5 3.2-3.2" />
        </>
      )
    }
    {
      product === 'Tutor' && (
        <>
          <path d="M6.8 8.3c2.1-.4 3.8.1 5.2 1.3 1.4-1.2 3.1-1.7 5.2-1.3v7.8c-2-.4-3.7.1-5.2 1.3-1.5-1.2-3.2-1.7-5.2-1.3V8.3Z" />
          <path d="M12 9.6v7.8M17.1 5.9v2.8M15.7 7.3h2.8" />
        </>
      )
    }
    {
      product === 'ENGR' && (
        <>
          <path d="M7.3 17.1v-4.2h2.5v4.2M10.8 17.1V9.8h2.5v7.3M14.3 17.1V7h2.5v10.1" />
          <path d="m7.3 10.1 3-2.1 2.4.6 4.1-3" />
        </>
      )
    }
  </svg>
</span>

<style>
  .product-mark {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    place-items: center;
    color: var(--color-blue);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(226, 240, 249, 0.86));
    border: 1px solid color-mix(in srgb, var(--color-blue) 18%, var(--color-hairline));
    border-radius: 0.9rem;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.9),
      0 8px 24px rgba(7, 29, 53, 0.08);
  }

  .product-mark svg {
    width: 1.65rem;
    height: 1.65rem;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
