<figure class="min-w-0" data-hero-film>
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm font-medium text-navy">
      Watch product workflows <span class="text-slate">· 60 sec</span>
    </p>
    <div class="flex flex-wrap gap-1.5" aria-label="Video controls">
      <button type="button" class="film-control" data-film-play aria-controls="hero-product-film"
        >Play film</button
      >
      <button
        type="button"
        class="film-control"
        data-film-fullscreen
        aria-controls="hero-product-film">Full screen</button
      >
    </div>
  </div>
  <video
    id="hero-product-film"
    controls
    muted
    playsinline
    preload="none"
    poster="/media/murikah-hero.jpg"
    aria-label="Murikah: a 60-second demonstration of Tutor, CMS, ENGR and GRC"
    aria-describedby="film-description"
    class="aspect-[64/45] w-full rounded-lg bg-header-bg shadow-card"
  >
    <source src="/media/murikah-hero.mp4" type="video/mp4" />
    <track
      kind="chapters"
      src="/media/murikah-hero-chapters.vtt"
      srclang="en"
      label="Product chapters"
    />
    <p><a href="/media/murikah-hero.mp4">Watch the 60-second product demonstration</a></p>
  </video>
  <nav class="mt-2 grid grid-cols-2 gap-1.5 sm:grid-cols-4" aria-label="Product video chapters">
    {
      [
        ['Tutor', 0],
        ['CMS', 15],
        ['ENGR', 30],
        ['GRC', 45],
      ].map(([label, time]) => (
        <button
          type="button"
          class="film-chapter"
          data-film-time={time}
          aria-controls="hero-product-film"
        >
          <span>{label}</span>
          <span class="text-xs text-slate">{`0:${String(time).padStart(2, '0')}`}</span>
        </button>
      ))
    }
  </nav>
  <figcaption id="film-description" class="sr-only">
    60 seconds. Tutor explains precision and recall; CMS creates a lead; ENGR assigns a technician;
    GRC creates an action plan with an owner and due date. Animated interface demonstrations using
    sample records, not live customer sessions. Silent video; use the controls to pause or replay.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-film]').forEach((figure) => {
    const video = figure.querySelector<HTMLVideoElement>('video');
    if (!video) return;
    const play = figure.querySelector<HTMLButtonElement>('[data-film-play]');
    const fullScreen = figure.querySelector<HTMLButtonElement>('[data-film-fullscreen]');
    const chapters = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-film-time]'));

    const updatePlayLabel = () => {
      if (play)
        play.textContent = video.paused
          ? video.currentTime > 0
            ? 'Continue film'
            : 'Play film'
          : 'Pause film';
    };
    const updateChapter = () => {
      const active = Math.min(3, Math.floor(video.currentTime / 15));
      chapters.forEach((chapter, index) => {
        if (index === active) chapter.setAttribute('aria-current', 'true');
        else chapter.removeAttribute('aria-current');
      });
    };

    play?.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
    });
    fullScreen?.addEventListener('click', () => {
      if (video.requestFullscreen) void video.requestFullscreen();
    });
    chapters.forEach((chapter) => {
      chapter.addEventListener('click', () => {
        video.currentTime = Number(chapter.dataset.filmTime ?? 0);
        void video.play();
      });
    });
    video.addEventListener('play', updatePlayLabel);
    video.addEventListener('pause', updatePlayLabel);
    video.addEventListener('ended', updatePlayLabel);
    video.addEventListener('timeupdate', updateChapter);
    updatePlayLabel();
    updateChapter();
  });
</script>

<style>
  .film-control,
  .film-chapter {
    min-height: 2.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-btn);
    background: var(--color-surface);
    color: var(--color-navy);
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .film-control {
    padding-inline: 0.75rem;
  }
  .film-chapter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 0.625rem;
  }
  .film-control:hover,
  .film-chapter:hover,
  .film-chapter[aria-current='true'] {
    border-color: var(--color-brass);
    background: var(--color-paper);
  }
</style>
