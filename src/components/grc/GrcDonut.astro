---
/**
 * An accessible doughnut or pie chart, rendered server-side as inline SVG (no
 * client runtime), themed to the Murikah GRC palette (navy, gold and paper). It
 * mirrors the approach Engineering Rhythm uses: a thick ring (doughnut, cutout
 * about 58 percent, with the total in the centre hole) or a full pie, with
 * external boxed leader-line callouts instead of a side legend, laid out in two
 * vertical columns so none overlap. Each slice and its callout link into the
 * filtered list behind it (drill-through), with a pointer cursor and a tooltip
 * carrying the exact figure. Below the callout layout's minimum width a
 * container query falls back to a compact chart with an inline legend. A
 * visually-hidden table carries the same data for assistive tech.
 */
import type { ChartDatum } from '@grc/repos/dashboard';

interface Props {
  title: string;
  description?: string;
  data: ChartDatum[];
  variant?: 'donut' | 'pie';
  valueHeading?: string;
  emptyText?: string;
}
const {
  title,
  description,
  data,
  variant = 'donut',
  valueHeading = 'Count',
  emptyText = 'No data yet.',
} = Astro.props;

const total = data.reduce((sum, d) => sum + d.value, 0);
const present = data.filter((d) => d.value > 0);
const hasData = present.length > 0 && total > 0;

// Keep the chart clean: with many small categories, fold the smallest into one
// "Other" callout (which is informational, not a drill link).
let source: ChartDatum[] = present;
if (present.length > 10) {
  const sorted = [...present].sort((a, b) => b.value - a.value);
  const other = sorted.slice(9).reduce((sum, d) => sum + d.value, 0);
  source = [...sorted.slice(0, 9), { label: 'Other', value: other }];
}

interface Slice {
  label: string;
  value: number;
  href?: string;
  frac: number;
  a0: number;
  a1: number;
  mid: number;
  colour: string;
  pctText: string;
  valueText: string;
}
let cum = 0;
const slices: Slice[] = source.map((d, i) => {
  const frac = total > 0 ? d.value / total : 0;
  const a0 = cum * 360;
  const a1 = (cum + frac) * 360;
  const mid = (cum + frac / 2) * 360;
  cum += frac;
  return {
    label: d.label,
    value: d.value,
    href: d.href,
    frac,
    a0,
    a1,
    mid,
    colour: `var(--grc-chart-${(i % 8) + 1})`,
    pctText: `${Math.round(frac * 100)}%`,
    valueText: String(d.value),
  };
});

// ---- geometry helpers -------------------------------------------------------
const pointOn = (cx: number, cy: number, rho: number, deg: number): [number, number] => {
  const rad = (deg * Math.PI) / 180;
  return [cx + rho * Math.sin(rad), cy - rho * Math.cos(rad)];
};
const f = (nn: number): string => nn.toFixed(2);
const sectorPath = (
  cx: number,
  cy: number,
  ro: number,
  ri: number,
  a0: number,
  a1: number,
): string => {
  const [ox0, oy0] = pointOn(cx, cy, ro, a0);
  const [ox1, oy1] = pointOn(cx, cy, ro, a1);
  const [ix1, iy1] = pointOn(cx, cy, ri, a1);
  const [ix0, iy0] = pointOn(cx, cy, ri, a0);
  const large = a1 - a0 > 180 ? 1 : 0;
  return `M ${f(ox0)} ${f(oy0)} A ${ro} ${ro} 0 ${large} 1 ${f(ox1)} ${f(oy1)} L ${f(ix1)} ${f(iy1)} A ${ri} ${ri} 0 ${large} 0 ${f(ix0)} ${f(iy0)} Z`;
};
const short = (t: string): string => (t.length > 15 ? `${t.slice(0, 14)}…` : t);
const unit = valueHeading.toLowerCase();
const single = slices.length === 1;
const showHole = variant === 'donut';

// ---- wide layout: two columns of callouts ----------------------------------
const R = 62;
const RIN = variant === 'pie' ? 0 : 36; // doughnut cutout = 36/62 ≈ 58%
const boxW = 100;
const boxH = 30;
const rowSlot = 38;
const padY = 12;
const leaderOut = 12;
const edge = 6;
const gap = 22;
const leftBoxX = edge;
const leftConnectX = leftBoxX + boxW;
const cxW = leftConnectX + gap + R;
const rightBoxX = cxW + R + gap;
const rightConnectX = rightBoxX;
const W = rightBoxX + boxW + edge;

const sideOf = (sl: Slice): 'left' | 'right' => (sl.mid < 180 ? 'right' : 'left');
const rightCount = slices.filter((sl) => sideOf(sl) === 'right').length;
const leftCount = slices.filter((sl) => sideOf(sl) === 'left').length;
const maxSide = Math.max(rightCount, leftCount, 1);
const H = Math.max(2 * R + 2 * padY + 4, maxSide * rowSlot + 2 * padY);
const cyW = H / 2;

interface Placed extends Slice {
  arc: string;
  leader: string;
  boxX: number;
  boxY: number;
  boxCy: number;
}
const placeSide = (side: 'left' | 'right'): Placed[] => {
  const items = slices
    .filter((sl) => sideOf(sl) === side)
    .map((sl) => ({ sl, exitY: pointOn(cxW, cyW, R, sl.mid)[1] }))
    .sort((a, b) => a.exitY - b.exitY);
  const k = items.length;
  const avail = H - 2 * padY;
  const slot = k > 0 ? avail / k : avail;
  const boxX = side === 'right' ? rightBoxX : leftBoxX;
  const connectX = side === 'right' ? rightConnectX : leftConnectX;
  return items.map((it, j) => {
    const boxCy = padY + (j + 0.5) * slot;
    const [p0x, p0y] = pointOn(cxW, cyW, R, it.sl.mid);
    const [p1x, p1y] = pointOn(cxW, cyW, R + leaderOut, it.sl.mid);
    return {
      ...it.sl,
      arc: sectorPath(cxW, cyW, R, RIN, it.sl.a0, it.sl.a1),
      leader: `M ${f(p0x)} ${f(p0y)} L ${f(p1x)} ${f(p1y)} L ${connectX} ${f(boxCy)}`,
      boxX,
      boxY: boxCy - boxH / 2,
      boxCy,
    };
  });
};
const placed: Placed[] = hasData ? [...placeSide('left'), ...placeSide('right')] : [];

// ---- mini layout: compact chart + inline legend ----------------------------
const miniR = 52;
const miniRIN = variant === 'pie' ? 0 : 30;
const miniArcs = slices.map((sl) => ({
  ...sl,
  arc: sectorPath(60, 60, miniR, miniRIN, sl.a0, sl.a1),
}));
const ariaSummary = `${title}. ${slices
  .map((sl) => `${sl.label} ${sl.value}, ${sl.pctText}`)
  .join('; ')}. Total ${total} ${unit}.`;
---

<figure class="grc-chart grc-chart--donut">
  <figcaption class="grc-chart__cap">
    <h3 class="grc-chart__title">{title}</h3>
    {description && <p class="grc-chart__desc">{description}</p>}
  </figcaption>
  {
    !hasData ? (
      <p class="grc-chart__empty">{emptyText}</p>
    ) : (
      <div class="grc-donut">
        {/* Wide: ring or pie with two-column boxed callouts. */}
        <div class="grc-donutwide">
          <svg
            viewBox={`0 0 ${W} ${H}`}
            class="grc-donutwide__svg"
            role="img"
            aria-label={ariaSummary}
          >
            {/* leader lines, behind everything */}
            {placed.map((p) => (
              <path d={p.leader} fill="none" stroke={p.colour} stroke-width="1" opacity="0.7" />
            ))}
            {/* slices (clickable, not in the tab order; the box carries the name) */}
            {single ? (
              <circle
                cx={cxW}
                cy={cyW}
                r={showHole ? (R + RIN) / 2 : R}
                fill={showHole ? 'none' : slices[0].colour}
                stroke={showHole ? slices[0].colour : 'none'}
                stroke-width={showHole ? R - RIN : 0}
              />
            ) : (
              placed.map((p) =>
                p.href ? (
                  <a href={p.href} tabindex={-1} aria-hidden="true">
                    <path d={p.arc} fill={p.colour} class="grc-donut__slice" />
                  </a>
                ) : (
                  <path d={p.arc} fill={p.colour} class="grc-donut__slice" />
                ),
              )
            )}
            {/* centre total and unit caption (doughnut only) */}
            {showHole && (
              <>
                <text class="grc-donut__total" x={cxW} y={cyW - 2} text-anchor="middle">
                  {total}
                </text>
                <text class="grc-donut__unit" x={cxW} y={cyW + 12} text-anchor="middle">
                  {unit}
                </text>
              </>
            )}
            {/* callout boxes */}
            {placed.map((p) => {
              const inner = (
                <>
                  <rect
                    x={p.boxX}
                    y={p.boxY}
                    width={boxW}
                    height={boxH}
                    rx="6"
                    class="grc-callout__box"
                  />
                  <circle cx={p.boxX + 10} cy={p.boxCy} r="3" fill={p.colour} />
                  <text x={p.boxX + 19} y={p.boxCy - 2} class="grc-callout__name">
                    {short(p.label)}
                  </text>
                  <text x={p.boxX + 19} y={p.boxCy + 9} class="grc-callout__val">
                    {`${p.valueText} · ${p.pctText}`}
                  </text>
                </>
              );
              return p.href ? (
                <a
                  href={p.href}
                  class="grc-callout"
                  aria-label={`${p.label}: ${p.valueText}, ${p.pctText}`}
                >
                  <title>{`${p.label}: ${p.valueText} (${p.pctText})`}</title>
                  {inner}
                </a>
              ) : (
                <g
                  class="grc-callout"
                  role="group"
                  aria-label={`${p.label}: ${p.valueText}, ${p.pctText}`}
                >
                  <title>{`${p.label}: ${p.valueText} (${p.pctText})`}</title>
                  {inner}
                </g>
              );
            })}
          </svg>
        </div>

        {/* Narrow fallback: compact chart and an inline legend. */}
        <div class="grc-donutmini">
          <svg viewBox="0 0 120 120" class="grc-donutmini__svg" role="img" aria-label={ariaSummary}>
            {single ? (
              <circle
                cx="60"
                cy="60"
                r={showHole ? (miniR + miniRIN) / 2 : miniR}
                fill={showHole ? 'none' : slices[0].colour}
                stroke={showHole ? slices[0].colour : 'none'}
                stroke-width={showHole ? miniR - miniRIN : 0}
              />
            ) : (
              miniArcs.map((sl) => <path d={sl.arc} fill={sl.colour} class="grc-donut__slice" />)
            )}
            {showHole && (
              <>
                <text class="grc-donut__total" x="60" y="58" text-anchor="middle">
                  {total}
                </text>
                <text class="grc-donut__unit" x="60" y="72" text-anchor="middle">
                  {unit}
                </text>
              </>
            )}
          </svg>
          <ul class="grc-legend grc-legend--wrap">
            {slices.map((sl) => {
              const body = (
                <>
                  <span
                    class="grc-legend__swatch"
                    style={`background:${sl.colour}`}
                    aria-hidden="true"
                  />
                  <span class="grc-legend__label">{sl.label}</span>
                  <span class="grc-legend__value">
                    {sl.valueText}
                    <span class="grc-legend__pct"> · {sl.pctText}</span>
                  </span>
                </>
              );
              return (
                <li>
                  {sl.href ? (
                    <a class="grc-legend__row" href={sl.href}>
                      {body}
                    </a>
                  ) : (
                    <span class="grc-legend__row">{body}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>

        {/* Accessible data equivalent for the visual callouts. */}
        <table class="grc-vh">
          <caption>{title}</caption>
          <thead>
            <tr>
              <th scope="col">Audit area</th>
              <th scope="col">{valueHeading}</th>
              <th scope="col">Share</th>
            </tr>
          </thead>
          <tbody>
            {slices.map((sl) => (
              <tr>
                <th scope="row">{sl.label}</th>
                <td>{sl.valueText}</td>
                <td>{sl.pctText}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</figure>
