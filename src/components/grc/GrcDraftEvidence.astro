---
/**
 * Staged evidence upload for a create form. Files upload straight to secure
 * storage against a random draft token (entity types work_paper_draft and
 * action_plan_draft), and the save endpoint binds the staged attachments to
 * the record it creates, so attaching evidence is part of writing the finding
 * rather than a second visit. The parent form must include this inside its
 * <form> so the hidden draft_token travels with the save.
 */
interface Props {
  /** 'work_paper_draft' or 'action_plan_draft'. */
  entityType: string;
  draftToken: string;
}
const { entityType, draftToken } = Astro.props;
---

<input type="hidden" name="draft_token" value={draftToken} />
<div
  class="grc-evidence__upload"
  data-draft-evidence
  data-entity-type={entityType}
  data-entity-id={draftToken}
>
  <label for="draft-evidence-file">Attach evidence now</label>
  <div class="grc-actionbar" style="margin:0.25rem 0 0">
    <input type="file" id="draft-evidence-file" class="grc-input" />
    <button type="button" class="grc-btn grc-btn--secondary" data-draft-evidence-btn>
      Upload
    </button>
  </div>
  <p class="grc-field__hint">
    Files upload to secure storage immediately and attach to the record when you save it.
  </p>
  <ul class="grc-evidence" data-draft-evidence-list aria-live="polite"></ul>
  <span class="grc-lead" role="status" aria-live="polite" data-draft-evidence-status></span>
</div>

<script>
  interface Presigned {
    fileId?: string;
    url?: string;
    error?: string;
  }

  for (const wrap of document.querySelectorAll('[data-draft-evidence]')) {
    const btn = wrap.querySelector('[data-draft-evidence-btn]');
    const input = wrap.querySelector('input[type="file"]') as HTMLInputElement | null;
    const list = wrap.querySelector('[data-draft-evidence-list]');
    const status = wrap.querySelector('[data-draft-evidence-status]');
    if (!btn || !input || !list || !status) continue;

    btn.addEventListener('click', async () => {
      const file = input.files?.[0];
      if (!file) {
        status.textContent = 'Choose a file first.';
        return;
      }
      const entityType = wrap.getAttribute('data-entity-type') ?? '';
      const entityId = wrap.getAttribute('data-entity-id') ?? '';
      const contentType = file.type || 'application/octet-stream';
      btn.setAttribute('disabled', 'true');
      status.textContent = 'Preparing upload...';
      try {
        const presignRes = await fetch('/api/evidence/upload-url', {
          method: 'POST',
          body: new URLSearchParams({
            entity_type: entityType,
            entity_id: entityId,
            file_name: file.name,
            content_type: contentType,
            size_bytes: String(file.size),
          }),
        });
        const presign = (await presignRes.json()) as Presigned;
        if (!presignRes.ok || !presign.url || !presign.fileId) {
          status.textContent = presign.error || 'Could not start the upload.';
          return;
        }
        status.textContent = 'Uploading...';
        const put = await fetch(presign.url, {
          method: 'PUT',
          headers: { 'content-type': contentType },
          body: file,
        });
        if (!put.ok) {
          status.textContent = 'The upload failed.';
          return;
        }
        const completeRes = await fetch('/api/evidence/complete', {
          method: 'POST',
          body: new URLSearchParams({
            entity_type: entityType,
            entity_id: entityId,
            file_id: presign.fileId,
            file_name: file.name,
            content_type: contentType,
          }),
        });
        if (!completeRes.ok) {
          const err = (await completeRes.json().catch(() => ({}))) as { error?: string };
          status.textContent = err.error || 'The upload could not be recorded.';
          return;
        }
        const li = document.createElement('li');
        li.className = 'grc-evidence__item';
        li.textContent = file.name;
        list.appendChild(li);
        status.textContent = 'Staged. It attaches when you save.';
        input.value = '';
      } catch {
        status.textContent = 'The upload failed. Please try again.';
      } finally {
        btn.removeAttribute('disabled');
      }
    });
  }
</script>
