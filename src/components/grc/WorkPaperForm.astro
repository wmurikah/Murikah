---
/**
 * The work-paper create/edit form (Workpaperform). Captures the section 1 fields
 * grouped as audit context, control, risk, observation and management response,
 * with the assigned auditor. Selecting a sub-area auto-populates the control
 * objectives, risk description, test objective and testing steps from the
 * sub_areas template (editable thereafter), done client-side from an embedded
 * template map so it needs no round trip. The caller passes the lookups, the
 * existing values (or null for a new draft) and the POST action.
 */
import type { Option, SubAreaTemplate } from '@grc/repos/workPaperLookups';
import GrcRichText from '@/components/grc/GrcRichText.astro';
import GrcEvidence from '@/components/grc/GrcEvidence.astro';
import type { Attachment } from '@grc/repos/evidence';
import type { ControlDropdowns } from '@grc/repos/dropdowns';
import { columnForFormField } from '@grc/repos/workPapers';

interface Props {
  action: string;
  /** The label on the save action: "Save as draft" on create, "Save changes" on edit. */
  submitLabel: string;
  /**
   * Whether to offer Submit for review beside the save (Build Prompt 59).
   *
   * The two are one screen and two acts. Saving keeps work in progress and asks
   * nothing of it; submitting hands the finding to a reviewer and is refused
   * until it is complete, with the missing fields named. Offered only while the
   * finding is the actor's to submit, so a reviewer editing somebody's draft is
   * not invited to release it on their behalf.
   */
  offerSubmit?: boolean;
  areas: Option[];
  affiliates: Option[];
  auditors: Option[];
  subAreas: SubAreaTemplate[];
  dropdowns: ControlDropdowns;
  values: Record<string, unknown> | null;
  /** Offers the AI drafting help when the plan includes the AI feature. */
  hasAi?: boolean;
  /**
   * The evidence panel this form shows. Evidence belongs with the observation
   * it supports, so it is part of writing the finding on both create and edit,
   * not a second visit to the detail page. On create the record does not exist
   * yet, so uploads stage against `draftToken` and the save binds them; on edit
   * they attach to the work paper directly. Null when storage is unconfigured.
   */
  evidence?: {
    entityType: string;
    entityId: string;
    items: Attachment[];
    canDelete: boolean;
    draftToken?: string | null;
    /** False when the storage backend is unconfigured; the panel says so. */
    storageReady?: boolean;
  } | null;
}
const {
  action,
  submitLabel,
  offerSubmit = false,
  areas,
  affiliates,
  auditors,
  subAreas,
  dropdowns,
  values,
  hasAi,
  evidence = null,
} = Astro.props;

/**
 * The stored value for a form control, resolved through the shared field map
 * (repos/workPapers.ts). A control's name is not always its column: reading
 * `values[name]` directly returned undefined for classification, standards and
 * the assigned auditor, so the form prefilled blank and the next save wrote that
 * blank back over real data (Build Prompt 50).
 */
const v = (key: string): string => {
  const raw = values?.[columnForFormField(key)];
  return raw == null ? '' : String(raw);
};
// Present a stored code (e.g. AD_HOC) as a readable label (Ad hoc).
const human = (s: string): string =>
  s.charAt(0).toUpperCase() + s.slice(1).toLowerCase().replace(/_/g, ' ');
// The sub-area templates for the client-side auto-populate.
const templateJson = JSON.stringify(
  Object.fromEntries(
    subAreas.map((sa) => [
      sa.id,
      {
        controlObjectives: sa.controlObjectives ?? '',
        riskDescription: sa.riskDescription ?? '',
        testObjective: sa.testObjective ?? '',
        testingSteps: sa.testingSteps ?? '',
      },
    ]),
  ),
);
---

<form method="post" action={action} class="grc-form">
  <fieldset class="grc-fieldset">
    <legend>Audit context</legend>
    <div class="grc-formgrid">
      <div class="grc-field">
        <label for="year">Year</label>
        <input type="number" id="year" name="year" class="grc-input" value={v('year')} />
      </div>
      <div class="grc-field">
        <label for="affiliate_code">Affiliate</label>
        <select id="affiliate_code" name="affiliate_code" class="grc-select">
          <option value="">Not set</option>
          {
            affiliates.map((a) => (
              <option value={a.id} selected={v('affiliate_code') === a.id}>
                {a.label}
              </option>
            ))
          }
        </select>
      </div>
      <div class="grc-field">
        <label for="audit_area_id">Audit area</label>
        <select id="audit_area_id" name="audit_area_id" class="grc-select">
          <option value="">Not set</option>
          {
            areas.map((a) => (
              <option value={a.id} selected={v('audit_area_id') === a.id}>
                {a.label}
              </option>
            ))
          }
        </select>
      </div>
      <div class="grc-field">
        <label for="sub_area_id">Sub-area</label>
        <select
          id="sub_area_id"
          name="sub_area_id"
          class="grc-select"
          data-templates={templateJson}
        >
          <option value="">Not set</option>
          {
            subAreas.map((sa) => (
              <option
                value={sa.id}
                data-area={sa.auditAreaId}
                selected={v('sub_area_id') === sa.id}
              >
                {sa.label}
              </option>
            ))
          }
        </select>
        <p class="grc-field__hint">
          Choosing a sub-area fills the control and risk fields; edit them after.
        </p>
      </div>
      <div class="grc-field">
        <label for="work_paper_date">Work paper date</label>
        <input
          type="date"
          id="work_paper_date"
          name="work_paper_date"
          class="grc-input"
          value={v('work_paper_date').slice(0, 10)}
        />
      </div>
      <div class="grc-field">
        <label for="audit_period_from">Audit period from</label>
        <input
          type="date"
          id="audit_period_from"
          name="audit_period_from"
          class="grc-input"
          value={v('audit_period_from').slice(0, 10)}
        />
      </div>
      <div class="grc-field">
        <label for="audit_period_to">Audit period to</label>
        <input
          type="date"
          id="audit_period_to"
          name="audit_period_to"
          class="grc-input"
          value={v('audit_period_to').slice(0, 10)}
        />
      </div>
      <div class="grc-field">
        <label for="assigned_auditor">Assigned auditor</label>
        <select id="assigned_auditor" name="assigned_auditor" class="grc-select">
          <option value="">Unassigned</option>
          {
            auditors.map((a) => (
              <option value={a.id} selected={v('assigned_auditor') === a.id}>
                {a.label}
              </option>
            ))
          }
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset class="grc-fieldset">
    <legend>Control</legend>
    <div class="grc-field">
      <label for="control_objectives">Control objectives</label>
      <GrcRichText
        id="control_objectives"
        name="control_objectives"
        value={v('control_objectives')}
      />
    </div>
    <div class="grc-formgrid">
      <div class="grc-field">
        <label for="classification">Classification</label>
        <select id="classification" name="classification" class="grc-select">
          <option value="">Not set</option>
          {
            dropdowns.classification.map((c) => (
              <option value={c} selected={v('classification') === c}>
                {human(c)}
              </option>
            ))
          }
        </select>
      </div>
      <div class="grc-field">
        <label for="control_type">Type</label>
        <select id="control_type" name="control_type" class="grc-select">
          <option value="">Not set</option>
          {
            dropdowns.controlType.map((c) => (
              <option value={c} selected={v('control_type') === c}>
                {human(c)}
              </option>
            ))
          }
        </select>
      </div>
      <div class="grc-field">
        <label for="control_frequency">Frequency</label>
        <select id="control_frequency" name="control_frequency" class="grc-select">
          <option value="">Not set</option>
          {
            dropdowns.controlFrequency.map((c) => (
              <option value={c} selected={v('control_frequency') === c}>
                {human(c)}
              </option>
            ))
          }
        </select>
      </div>
      <div class="grc-field">
        <label for="standards">Standards</label>
        <input
          type="text"
          id="standards"
          name="standards"
          class="grc-input"
          value={v('standards')}
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="grc-fieldset">
    <legend>Risk and testing</legend>
    <div class="grc-field">
      <label for="risk_description">Risk description</label>
      <GrcRichText id="risk_description" name="risk_description" value={v('risk_description')} />
    </div>
    <div class="grc-field">
      <label for="test_objective">Test objective</label>
      <GrcRichText id="test_objective" name="test_objective" value={v('test_objective')} />
    </div>
    <div class="grc-field">
      <label for="testing_steps">Testing steps</label>
      <GrcRichText id="testing_steps" name="testing_steps" value={v('testing_steps')} />
    </div>
  </fieldset>

  <fieldset class="grc-fieldset">
    <legend>Observation</legend>
    <div class="grc-field">
      <label for="observation_title">Observation title</label>
      <input
        type="text"
        id="observation_title"
        name="observation_title"
        class="grc-input"
        required
        maxlength="300"
        value={v('observation_title')}
      />
    </div>
    <div class="grc-field">
      <div class="grc-aihead">
        <label for="observation_description">Observation description</label>
        {
          hasAi && (
            <button
              type="button"
              class="grc-btn grc-btn--secondary grc-aihead__btn"
              data-ai-draft="observation"
              data-ai-target="observation_description"
            >
              Draft with AI
            </button>
          )
        }
      </div>
      <GrcRichText
        id="observation_description"
        name="observation_description"
        value={v('observation_description')}
      />
    </div>
    <div class="grc-formgrid">
      <div class="grc-field">
        <div class="grc-aihead">
          <label for="risk_rating">Risk rating</label>
          {
            hasAi && (
              <button
                type="button"
                class="grc-btn grc-btn--secondary grc-aihead__btn"
                data-ai-draft="risk_rating"
                data-ai-target="risk_rating"
              >
                Suggest rating
              </button>
            )
          }
        </div>
        <select id="risk_rating" name="risk_rating" class="grc-select">
          <option value="">Not rated</option>
          {
            dropdowns.riskRatings.map((r) => (
              <option value={r} selected={v('risk_rating') === r}>
                {human(r)}
              </option>
            ))
          }
        </select>
      </div>
    </div>
    <div class="grc-field">
      <label for="risk_summary">Risk summary</label>
      <GrcRichText id="risk_summary" name="risk_summary" value={v('risk_summary')} />
    </div>
    <div class="grc-field">
      <div class="grc-aihead">
        <label for="recommendation">Recommendation</label>
        {
          hasAi && (
            <button
              type="button"
              class="grc-btn grc-btn--secondary grc-aihead__btn"
              data-ai-draft="recommendation"
              data-ai-target="recommendation"
            >
              Draft with AI
            </button>
          )
        }
      </div>
      <GrcRichText id="recommendation" name="recommendation" value={v('recommendation')} />
    </div>
    {
      hasAi && (
        <p class="grc-field__hint" id="wp-ai-status" role="status" aria-live="polite">
          AI drafting is advisory and clearly yours to edit; nothing is saved until you submit.
        </p>
      )
    }
  </fieldset>

  <fieldset class="grc-fieldset">
    <legend>Management response</legend>
    <div class="grc-field">
      <label for="management_response">Management response</label>
      <GrcRichText
        id="management_response"
        name="management_response"
        value={v('management_response')}
      />
    </div>
  </fieldset>

  {
    evidence && (
      <GrcEvidence
        entityType={evidence.entityType}
        entityId={evidence.entityId}
        items={evidence.items}
        canUpload={true}
        canDelete={evidence.canDelete}
        draftToken={evidence.draftToken ?? null}
        storageReady={evidence.storageReady !== false}
        nested={true}
      />
    )
  }

  <div class="grc-actionbar">
    <button type="submit" name="intent" value="draft" class="grc-btn grc-btn--primary">
      {submitLabel}
    </button>
    {
      offerSubmit && (
        <button type="submit" name="intent" value="submit" class="grc-btn grc-btn--secondary">
          Submit for review
        </button>
      )
    }
  </div>
  {
    offerSubmit && (
      <p class="grc-field__hint" style="margin:0.5rem 0 0">
        Saving keeps an unfinished finding safe as a draft. Submitting for review needs the audit
        area, sub-area, audit period, observation title and description, risk rating, recommendation
        and assigned auditor.
      </p>
    )
  }
</form>

<script>
  // Auto-populate the control and risk fields from the chosen sub-area template.
  const select = document.getElementById('sub_area_id') as HTMLSelectElement | null;
  if (select) {
    const templates = JSON.parse(select.dataset.templates ?? '{}') as Record<
      string,
      {
        controlObjectives: string;
        riskDescription: string;
        testObjective: string;
        testingSteps: string;
      }
    >;
    const setValue = (id: string, value: string) => {
      const el = document.getElementById(id) as HTMLTextAreaElement | null;
      if (el) el.value = value;
    };
    select.addEventListener('change', () => {
      const t = templates[select.value];
      if (!t) return;
      setValue('control_objectives', t.controlObjectives);
      setValue('risk_description', t.riskDescription);
      setValue('test_objective', t.testObjective);
      setValue('testing_steps', t.testingSteps);
    });
  }
</script>

<script>
  // AI drafting help. Each button posts the current form fields to the drafting
  // endpoint and drops the result into its editable field; a suggestion never
  // submits anything, so the auditor always has the final word. Failures land
  // in the status line as plain text, never as an interruption.
  const status = document.getElementById('wp-ai-status');
  const say = (text: string) => {
    if (status) status.textContent = text;
  };
  const fieldValue = (id: string): string => {
    const el = document.getElementById(id) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | HTMLSelectElement
      | null;
    return el ? el.value : '';
  };
  document.querySelectorAll('[data-ai-draft]').forEach((el) => {
    const btn = el as HTMLButtonElement;
    btn.addEventListener('click', async () => {
      const kind = btn.dataset.aiDraft ?? '';
      const targetId = btn.dataset.aiTarget ?? '';
      btn.disabled = true;
      say('Asking the AI assistant...');
      try {
        const body = new FormData();
        body.set('kind', kind);
        body.set('observation_title', fieldValue('observation_title'));
        body.set('observation_description', fieldValue('observation_description'));
        body.set('risk_description', fieldValue('risk_description'));
        body.set('test_objective', fieldValue('test_objective'));
        body.set('recommendation', fieldValue('recommendation'));
        const res = await fetch('/api/ai/draft', { method: 'POST', body });
        const data = (await res.json()) as {
          content?: string;
          rating?: string | null;
          disclaimer?: string;
          error?: string;
        };
        if (!res.ok || data.error) {
          say(data.error ?? 'The AI assistant is unavailable right now.');
          return;
        }
        if (kind === 'risk_rating') {
          const select = document.getElementById(targetId) as HTMLSelectElement | null;
          if (select && data.rating) {
            const match = Array.from(select.options).find(
              (o) => o.value.toLowerCase() === String(data.rating).toLowerCase(),
            );
            if (match) select.value = match.value;
          }
          say(
            `AI-suggested rating${data.rating ? `: ${data.rating}` : ''}. ${data.content ?? ''} ` +
              'Yours to change.',
          );
        } else {
          const area = document.getElementById(targetId) as HTMLTextAreaElement | null;
          if (area) area.value = data.content ?? '';
          say('AI-assisted draft inserted. Edit it as your own before submitting.');
        }
      } catch {
        say('The AI assistant is unavailable right now.');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .grc-aihead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .grc-aihead__btn {
    min-height: 1.8rem;
    padding: 0 0.6rem;
    font-size: var(--grc-fs-caption);
  }
</style>
