---
/**
 * One section of an observation: a small gold label, then the content
 * (Build Prompt 72).
 *
 * A section, not a card. The panel is the card; these are the parts of it,
 * separated by a hairline rule and by the space around them. Boxing each one
 * would put a card inside a card and make the chrome louder than the argument.
 *
 * The label is small, uppercase and gold. It says which part of the argument
 * this is and then gets out of the way: the content is what the reader is here
 * for.
 */
import { renderRichHtml } from '@grc/richtext';
import { cardIsEmpty, type FindingCard } from '@grc/reports/findingCards';

interface Props {
  card: FindingCard;
}
const { card } = Astro.props;
const filled = (value: string | null | undefined): boolean => String(value ?? '').trim() !== '';
---

<section class="grc-snap__section" data-card={card.key}>
  <p class="grc-snap__label">{card.heading}</p>
  {
    cardIsEmpty(card) ? (
      <p class="grc-snap__empty">{card.emptyText}</p>
    ) : (
      card.body.map((body) =>
        body.kind === 'rich' ? (
          <div class="grc-snap__body grc-richbody" set:html={renderRichHtml(body.text)} />
        ) : body.kind === 'facts' ? (
          <dl class="grc-snap__facts">
            {body.facts
              .filter((f) => filled(f.value))
              .map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
          </dl>
        ) : (
          <div class="grc-tablewrap grc-tablewrap--fit">
            <table class="grc-snap__table">
              <thead>
                <tr>
                  {body.columns.map((c) => (
                    <th scope="col">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {body.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td>{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ),
      )
    )
  }
</section>
