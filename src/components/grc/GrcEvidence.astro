---
/**
 * The evidence panel: one component for every place evidence is attached, so
 * the create form, the detail and the edit view all show the same clearly
 * labelled section rather than three different half-hidden uploaders.
 *
 * An observation is only as good as what supports it, so this is deliberately a
 * first-class section with its own heading and a visible drop area, not a field
 * tucked at the foot of a form. Several documents and several images can be
 * attached in one go, by dropping them or through the file picker.
 *
 * Images are listed as thumbnails at one constant size, served from the reduced
 * copy the upload makes (`?variant=preview`, storage/keys.ts); the original is
 * kept and is what the tile links to. Documents show their filename against a
 * file mark. The result is a uniform, light grid whatever was uploaded.
 *
 * Two props describe where the panel is standing. `nested` says it sits inside
 * another <form> (the create and edit pages), so removal is a fetch rather than
 * a nested form, which HTML does not allow. `draftToken` says the record does
 * not exist yet: uploads stage against the token and the save binds them, and
 * the token rides along as a hidden input for that save to find.
 */
import GrcIcon from '@/components/grc/GrcIcon.astro';
import type { Attachment } from '@grc/repos/evidence';

interface Props {
  /** 'work_paper', 'action_plan', or one of the '_draft' staging types. */
  entityType: string;
  /** The record's id, or the draft token when staging on a create form. */
  entityId: string;
  items?: Attachment[];
  canUpload?: boolean;
  canDelete?: boolean;
  /** False when the organisation has no storage provider; the panel says so. */
  storageReady?: boolean;
  /** True when the panel sits inside another form (the create and edit pages). */
  nested?: boolean;
  /** Set on a create form: uploads stage against this token until the save binds them. */
  draftToken?: string | null;
  heading?: string;
}
const {
  entityType,
  entityId,
  items = [],
  canUpload = false,
  canDelete = false,
  storageReady = true,
  nested = false,
  draftToken = null,
  heading = 'Evidence',
} = Astro.props;

const isImage = (mime: string | null): boolean => String(mime ?? '').startsWith('image/');
/** The extension shown on a document tile, e.g. PDF. Falls back to FILE. */
const extensionOf = (name: string): string => {
  const dot = name.lastIndexOf('.');
  const ext = dot > 0 ? name.slice(dot + 1) : '';
  return (ext || 'file').toUpperCase().slice(0, 4);
};
const inputId = `grc-evidence-file-${entityType}`;
const staged = draftToken !== null;
const count = items.length;
---

<section
  class="grc-evidence-panel"
  data-evidence
  data-entity-type={entityType}
  data-entity-id={entityId}
  data-nested={nested ? '1' : '0'}
  data-staged={staged ? '1' : '0'}
  aria-labelledby={`${inputId}-heading`}
>
  <div class="grc-evidence-panel__head">
    <h2 id={`${inputId}-heading`}>{heading}</h2>
    <p class="grc-lead">Supporting documents and images. Several can be attached at once.</p>
  </div>

  {staged && <input type="hidden" name="draft_token" value={draftToken} />}

  {
    !storageReady ? (
      <p class="grc-notice" role="status">
        Evidence storage is not configured for your organisation yet, so nothing can be attached. An
        administrator can connect a provider under Settings, Evidence storage.
      </p>
    ) : (
      canUpload && (
        <div class="grc-dropzone" data-evidence-drop>
          <GrcIcon name="upload" size={22} />
          <p class="grc-dropzone__lead">
            <label for={inputId} class="grc-dropzone__pick">
              Choose files
            </label>
            <span> or drop them here</span>
          </p>
          <p class="grc-dropzone__hint">
            Documents and images, several at a time.
            {staged && ' They attach to the finding when you save it.'}
          </p>
          <input
            type="file"
            id={inputId}
            class="grc-vh"
            multiple
            data-evidence-input
            aria-describedby={`${inputId}-status`}
          />
        </div>
      )
    )
  }

  {
    /* One row per file being sent, each with its own real percentage, so a
      selection of several is legible rather than one line that keeps changing
      its mind about which file it means (Build Prompt 66). */
  }
  <ul class="grc-upload-list" data-upload-list></ul>

  <p class="grc-evidence__status" id={`${inputId}-status`} role="status" aria-live="polite"></p>

  <ul
    class="grc-evidence-grid"
    data-evidence-list
    data-empty-text="Nothing attached yet."
    aria-live="polite"
  >
    {
      items.map((e) => (
        <li class="grc-evidence-tile" data-attachment-id={e.attachmentId}>
          <a
            class="grc-evidence-tile__body"
            href={`/api/evidence/${e.attachmentId}/download`}
            title={e.fileName}
          >
            {isImage(e.mimeType) ? (
              <img
                class="grc-evidence-tile__thumb"
                src={`/api/evidence/${e.attachmentId}/download?variant=preview`}
                alt={e.fileName}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span
                class="grc-evidence-tile__thumb grc-evidence-tile__thumb--doc"
                aria-hidden="true"
              >
                {extensionOf(e.fileName)}
              </span>
            )}
            <span class="grc-evidence-tile__name">{e.fileName}</span>
          </a>
          {canDelete &&
            (nested ? (
              <button
                type="button"
                class="grc-evidence-tile__del"
                data-evidence-remove={e.attachmentId}
                aria-label={`Remove ${e.fileName}`}
              >
                <GrcIcon name="trash" size={14} />
              </button>
            ) : (
              <form method="post" action={`/api/evidence/${e.attachmentId}/delete`}>
                <button
                  type="submit"
                  class="grc-evidence-tile__del"
                  aria-label={`Remove ${e.fileName}`}
                  data-confirm-remove
                >
                  <GrcIcon name="trash" size={14} />
                </button>
              </form>
            ))}
        </li>
      ))
    }
  </ul>
  {
    count === 0 && (
      <p class="grc-evidence__empty" data-evidence-empty>
        Nothing attached yet.
      </p>
    )
  }
</section>

<script>
  import {
    UPLOAD_STALL_MS,
    UPLOAD_TAG,
    classifyUploadFailure,
    formatBytes,
    isCrossOrigin,
    uploadFailureMessage,
    uploadLogLine,
    uploadPercent,
    type UploadFailure,
  } from '@grc/storage/uploadFeedback';

  /**
   * What /api/evidence/upload-url answers. `mode` is the only thing the browser
   * learns about the organisation's storage provider: 'presigned' means PUT the
   * bytes at the signed URL and then call /complete, 'direct' means post them to
   * the worker, which stores and records them in one step (Build Prompt 51).
   */
  interface Prepared {
    fileId?: string;
    mode?: 'presigned' | 'direct';
    url?: string;
    previewUrl?: string | null;
    previewContentType?: string;
    previewMaxDimension?: number;
    error?: string;
  }

  /** What one transfer came back with. It never rejects: see `send`. */
  interface SendResult {
    ok: boolean;
    status: number;
    body: string;
    kind: UploadFailure | null;
  }

  /**
   * Send one body and report its outcome, whatever the outcome is.
   *
   * This replaced a bare `fetch`, for two reasons that are really one. A
   * cross-origin PUT the bucket refuses does not answer with a status: it
   * rejects the promise, and an uncaught rejection left the panel saying
   * "Uploading..." until the page was closed. And `fetch` cannot report how far
   * a request body has got, so there was nothing honest to show while it went.
   * XMLHttpRequest gives both: upload progress events, and every ending routed
   * through one resolve so the caller cannot forget a case.
   *
   * The timeout is armed on each progress event rather than once at the start,
   * so a legitimately slow transfer keeps itself alive and a silent one dies.
   */
  const send = (opts: {
    url: string;
    method: 'PUT' | 'POST';
    body: Blob | FormData;
    contentType?: string;
    onProgress?: (loaded: number, total: number) => void;
  }): Promise<SendResult> =>
    new Promise<SendResult>((resolve) => {
      const xhr = new XMLHttpRequest();
      const crossOrigin = isCrossOrigin(opts.url, window.location.origin);
      let settled = false;
      let stall = 0;
      const finish = (r: SendResult): void => {
        if (settled) return;
        settled = true;
        window.clearTimeout(stall);
        resolve(r);
      };
      const arm = (): void => {
        window.clearTimeout(stall);
        stall = window.setTimeout(() => {
          // Settle first, then abort: aborting fires its own event, and the
          // reason this ended is the silence, not the cancellation.
          finish({ ok: false, status: 0, body: '', kind: 'stalled' });
          try {
            xhr.abort();
          } catch {
            // already gone
          }
        }, UPLOAD_STALL_MS);
      };
      const failed = (): SendResult => ({
        ok: false,
        status: xhr.status,
        body: '',
        kind: classifyUploadFailure({ status: xhr.status, crossOrigin }),
      });
      xhr.open(opts.method, opts.url, true);
      if (opts.contentType) xhr.setRequestHeader('content-type', opts.contentType);
      xhr.upload.addEventListener('progress', (e) => {
        arm();
        opts.onProgress?.(e.loaded, e.lengthComputable ? e.total : 0);
      });
      xhr.addEventListener('load', () => {
        const ok = xhr.status >= 200 && xhr.status < 300;
        finish(
          ok
            ? { ok: true, status: xhr.status, body: xhr.responseText ?? '', kind: null }
            : failed(),
        );
      });
      xhr.addEventListener('error', () => finish(failed()));
      xhr.addEventListener('abort', () =>
        finish({ ok: false, status: 0, body: '', kind: 'aborted' }),
      );
      xhr.addEventListener('timeout', () =>
        finish({ ok: false, status: 0, body: '', kind: 'stalled' }),
      );
      arm();
      xhr.send(opts.body);
    });

  /** Same-origin JSON call that reports a dead network instead of throwing. */
  const callJson = async (
    url: string,
    body: URLSearchParams,
  ): Promise<{ ok: boolean; status: number; data: Record<string, unknown> }> => {
    try {
      const res = await fetch(url, { method: 'POST', body });
      const text = await res.text();
      let data: Record<string, unknown> = {};
      try {
        data = JSON.parse(text) as Record<string, unknown>;
      } catch {
        // A non-JSON answer is still an answer; the status carries the meaning.
      }
      return { ok: res.ok, status: res.status, data };
    } catch {
      return { ok: false, status: 0, data: {} };
    }
  };

  /**
   * Reduce an image to the constant longest edge the server asked for, as a
   * JPEG. Returns null when the browser cannot decode it, in which case the
   * upload simply carries no preview and the list falls back to the original.
   */
  const shrink = async (file: File, max: number, type: string): Promise<Blob | null> => {
    if (typeof createImageBitmap !== 'function') return null;
    try {
      const bitmap = await createImageBitmap(file);
      const longest = Math.max(bitmap.width, bitmap.height);
      const scale = longest > max ? max / longest : 1;
      const w = Math.max(1, Math.round(bitmap.width * scale));
      const h = Math.max(1, Math.round(bitmap.height * scale));
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      ctx.drawImage(bitmap, 0, 0, w, h);
      bitmap.close?.();
      return await new Promise((resolve) => canvas.toBlob(resolve, type, 0.82));
    } catch {
      return null;
    }
  };

  for (const panel of document.querySelectorAll<HTMLElement>('[data-evidence]')) {
    const input = panel.querySelector<HTMLInputElement>('[data-evidence-input]');
    const drop = panel.querySelector<HTMLElement>('[data-evidence-drop]');
    const list = panel.querySelector<HTMLElement>('[data-evidence-list]');
    const status = panel.querySelector<HTMLElement>('.grc-evidence__status');
    if (!list || !status) continue;

    const entityType = panel.dataset.entityType ?? '';
    const entityId = panel.dataset.entityId ?? '';
    const staged = panel.dataset.staged === '1';

    const dropEmptyNote = (): void => {
      panel.querySelector('[data-evidence-empty]')?.remove();
    };

    const addTile = (attachmentId: string, name: string, isImage: boolean): void => {
      dropEmptyNote();
      const li = document.createElement('li');
      li.className = 'grc-evidence-tile';
      li.dataset.attachmentId = attachmentId;
      const a = document.createElement('a');
      a.className = 'grc-evidence-tile__body';
      a.href = `/api/evidence/${attachmentId}/download`;
      a.title = name;
      if (isImage) {
        const img = document.createElement('img');
        img.className = 'grc-evidence-tile__thumb';
        img.src = `/api/evidence/${attachmentId}/download?variant=preview`;
        img.alt = name;
        img.loading = 'lazy';
        a.appendChild(img);
      } else {
        const mark = document.createElement('span');
        mark.className = 'grc-evidence-tile__thumb grc-evidence-tile__thumb--doc';
        mark.setAttribute('aria-hidden', 'true');
        const dot = name.lastIndexOf('.');
        mark.textContent = (dot > 0 ? name.slice(dot + 1) : 'file').toUpperCase().slice(0, 4);
        a.appendChild(mark);
      }
      const label = document.createElement('span');
      label.className = 'grc-evidence-tile__name';
      label.textContent = name;
      a.appendChild(label);
      li.appendChild(a);
      list.appendChild(li);
    };

    const uploads = panel.querySelector<HTMLElement>('[data-upload-list]');

    /**
     * One row per file, showing its name, its size and how far it has actually
     * got. The row is the whole of the feedback for that file: it says
     * "Waiting" while the ones before it go up, a real percentage while it is
     * going, and either disappears into the attached list or stays behind as a
     * failure with a Retry button and the reason. Nothing is left to a spinner
     * that cannot be told apart from a hang (Build Prompt 66).
     */
    interface Row {
      progress: (loaded: number, total: number) => void;
      note: (text: string) => void;
      done: () => void;
      failed: (message: string) => void;
    }

    const addRow = (file: File, retry: () => void): Row => {
      const li = document.createElement('li');
      li.className = 'grc-upload';
      li.dataset.state = 'waiting';

      const head = document.createElement('div');
      head.className = 'grc-upload__head';
      const name = document.createElement('span');
      name.className = 'grc-upload__name';
      name.textContent = file.name;
      const size = document.createElement('span');
      size.className = 'grc-upload__size';
      size.textContent = formatBytes(file.size);
      head.appendChild(name);
      head.appendChild(size);

      // A real progressbar, not a decoration: the value is the bytes the
      // browser has acknowledged sending, so a screen reader hears the same
      // number the bar draws.
      const bar = document.createElement('div');
      bar.className = 'grc-upload__bar';
      bar.setAttribute('role', 'progressbar');
      bar.setAttribute('aria-valuemin', '0');
      bar.setAttribute('aria-valuemax', '100');
      bar.setAttribute('aria-valuenow', '0');
      bar.setAttribute('aria-label', `Uploading ${file.name}`);
      const fill = document.createElement('span');
      fill.className = 'grc-upload__fill';
      fill.style.width = '0%';
      bar.appendChild(fill);

      const note = document.createElement('p');
      note.className = 'grc-upload__note';
      note.textContent = 'Waiting';

      const again = document.createElement('button');
      again.type = 'button';
      again.className = 'grc-upload__retry';
      again.textContent = 'Retry';
      again.hidden = true;
      again.addEventListener('click', retry);

      li.appendChild(head);
      li.appendChild(bar);
      li.appendChild(note);
      li.appendChild(again);
      uploads?.appendChild(li);

      const setPercent = (pct: number): void => {
        fill.style.width = `${pct}%`;
        bar.setAttribute('aria-valuenow', String(pct));
      };
      return {
        progress: (loaded, total) => {
          li.dataset.state = 'active';
          again.hidden = true;
          const pct = uploadPercent(loaded, total > 0 ? total : file.size);
          setPercent(pct);
          note.textContent = `${pct}%`;
        },
        note: (text) => {
          li.dataset.state = 'active';
          note.textContent = text;
        },
        done: () => {
          li.dataset.state = 'done';
          setPercent(100);
          note.textContent = 'Attached';
          again.hidden = true;
          // The file is in the list below now, so the row has said all it has
          // to say; leaving it would double every attachment on the screen.
          window.setTimeout(() => li.remove(), 2500);
        },
        failed: (message) => {
          li.dataset.state = 'failed';
          note.textContent = message;
          again.hidden = false;
        },
      };
    };

    /** The bytes for the worker to store, for a provider that cannot sign a URL. */
    const directBody = (
      fileId: string,
      name: string,
      type: string,
      body: Blob,
      variant: string,
    ) => {
      const payload = new FormData();
      payload.set('entity_type', entityType);
      payload.set('entity_id', entityId);
      payload.set('file_id', fileId);
      payload.set('file_name', name);
      payload.set('content_type', type);
      payload.set('variant', variant);
      payload.set('file', body, name);
      return payload;
    };

    /** A transfer's answer, when it claims to be JSON and might not be. */
    const answer = (body: string): Record<string, unknown> => {
      try {
        return JSON.parse(body || '{}') as Record<string, unknown>;
      } catch {
        return {};
      }
    };

    /** Report a transfer that did not arrive, on the row and in the console. */
    const reportFailure = (row: Row, file: File, res: SendResult, url: string): void => {
      const detail = {
        kind: res.kind ?? 'refused',
        status: res.status,
        fileName: file.name,
        origin: window.location.origin,
      };
      console.error(uploadLogLine({ ...detail, url }));
      row.failed(uploadFailureMessage(detail));
    };

    /** Upload one file: prepare, send the bytes, send any preview, then record. */
    const uploadOne = async (file: File, row: Row): Promise<boolean> => {
      const contentType = file.type || 'application/octet-stream';
      row.note('Preparing');
      const prepared = await callJson(
        '/api/evidence/upload-url',
        new URLSearchParams({
          entity_type: entityType,
          entity_id: entityId,
          file_name: file.name,
          content_type: contentType,
          size_bytes: String(file.size),
        }),
      );
      const prep = prepared.data as Prepared;
      if (!prepared.ok || !prep.url || !prep.fileId) {
        console.error(
          `${UPLOAD_TAG} the upload could not be prepared ` +
            JSON.stringify({ file_name: file.name, status: prepared.status }),
        );
        row.failed(prep.error || `The upload of ${file.name} could not be started.`);
        return false;
      }
      const fileId = prep.fileId;
      const onProgress = (loaded: number, total: number): void => row.progress(loaded, total);

      /** The reduced copy, when the server asked for one and the browser can make it. */
      const preview = async (): Promise<{ blob: Blob; type: string } | null> => {
        if (!prep.previewUrl || !prep.previewMaxDimension) return null;
        const type = prep.previewContentType ?? 'image/jpeg';
        const small = await shrink(file, prep.previewMaxDimension, type);
        return small ? { blob: small, type } : null;
      };

      if (prep.mode === 'direct') {
        // One request stores and records the evidence, so there is no window in
        // which the bytes are up and the record is not.
        const sent = await send({
          url: prep.url,
          method: 'POST',
          body: directBody(fileId, file.name, contentType, file, 'original'),
          onProgress,
        });
        if (!sent.ok) {
          const err = answer(sent.body) as { error?: string };
          if (err.error) row.failed(err.error);
          else reportFailure(row, file, sent, prep.url);
          return false;
        }
        row.note('Recording');
        const recorded = answer(sent.body) as { attachmentId?: string };
        // Best-effort: a missing preview costs a thumbnail, never the evidence.
        const small = await preview();
        if (small && prep.previewUrl) {
          await send({
            url: prep.previewUrl,
            method: 'POST',
            body: directBody(fileId, file.name, small.type, small.blob, 'preview'),
          });
        }
        if (recorded.attachmentId) {
          addTile(recorded.attachmentId, file.name, contentType.startsWith('image/'));
        }
        row.done();
        return true;
      }

      // The bytes go straight from the browser to the organisation's bucket.
      // This is the leg that used to hang: the bucket answers a browser it has
      // no cross-origin rule for by refusing the request outright, with no
      // status to read, and the panel waited on a promise that never settled.
      const put = await send({
        url: prep.url,
        method: 'PUT',
        body: file,
        contentType,
        onProgress,
      });
      if (!put.ok) {
        reportFailure(row, file, put, prep.url);
        return false;
      }

      // Best-effort: a missing preview costs a thumbnail, never the evidence.
      const small = await preview();
      if (small && prep.previewUrl) {
        await send({
          url: prep.previewUrl,
          method: 'PUT',
          body: small.blob,
          contentType: small.type,
        });
      }

      // Only now, and only because the PUT actually finished: the file and its
      // link row are written here (Build Prompt 65), so calling this before the
      // bytes have landed would record evidence that is not in the bucket.
      row.note('Recording');
      const completed = await callJson(
        '/api/evidence/complete',
        new URLSearchParams({
          entity_type: entityType,
          entity_id: entityId,
          file_id: fileId,
          file_name: file.name,
          content_type: contentType,
        }),
      );
      if (!completed.ok) {
        const err = completed.data as { error?: string };
        console.error(
          `${UPLOAD_TAG} the upload was not recorded ` +
            JSON.stringify({ file_name: file.name, file_id: fileId, status: completed.status }),
        );
        row.failed(err.error || `${file.name} was uploaded but could not be recorded.`);
        return false;
      }
      const done = completed.data as { attachmentId?: string };
      if (done.attachmentId)
        addTile(done.attachmentId, file.name, contentType.startsWith('image/'));
      row.done();
      return true;
    };

    /**
     * Run one upload and never let it throw. Everything inside reports its own
     * failure on its own row, but an unforeseen one must not escape either: an
     * exception escaping the loop is exactly what left the panel saying
     * "Uploading..." with no way back (Build Prompt 66).
     */
    const runOne = async (file: File, row: Row): Promise<boolean> => {
      try {
        return await uploadOne(file, row);
      } catch (err) {
        console.error(
          `${UPLOAD_TAG} the upload threw ` +
            JSON.stringify({
              file_name: file.name,
              error: err instanceof Error ? err.message : String(err),
            }),
        );
        row.failed(`${file.name} could not be uploaded. Try again.`);
        return false;
      }
    };

    const attachedText = (n: number): string =>
      staged
        ? `${n} attached. ${n === 1 ? 'It attaches' : 'They attach'} to the finding when you save.`
        : `${n} attached.`;

    /**
     * Upload a whole selection. Every file gets its row up front, so a person
     * dropping six documents sees six of them queued rather than one line
     * counting, and the summary underneath only ever states the total.
     */
    const uploadAll = async (files: FileList | File[]): Promise<void> => {
      const chosen = Array.from(files);
      if (chosen.length === 0) return;
      drop?.classList.add('is-busy');
      const rows = chosen.map((file) => {
        // Retry re-runs this one file, on its own row, without disturbing the
        // others: a single refused upload should not mean picking all six again.
        const row: Row = addRow(file, () => {
          void runOne(file, row).then((ok) => {
            if (ok) status.textContent = attachedText(1);
          });
        });
        return row;
      });
      let done = 0;
      try {
        for (const [i, file] of chosen.entries()) {
          status.textContent =
            chosen.length === 1
              ? `Uploading ${file.name}`
              : `Uploading ${i + 1} of ${chosen.length}: ${file.name}`;
          // One failure reports itself on its own row and the rest still go up.
          if (await runOne(file, rows[i])) done += 1;
        }
      } finally {
        // Whatever happened, the panel comes back to rest and says where it
        // got to. There is no path out of here that leaves it uploading.
        drop?.classList.remove('is-busy');
        status.textContent =
          done === chosen.length
            ? attachedText(done)
            : `${done} of ${chosen.length} attached. The rest are listed above with what went wrong.`;
        if (input) input.value = '';
      }
    };

    input?.addEventListener('change', () => {
      if (input.files) void uploadAll(input.files);
    });

    if (drop) {
      for (const name of ['dragenter', 'dragover'] as const) {
        drop.addEventListener(name, (e) => {
          e.preventDefault();
          drop.classList.add('is-over');
        });
      }
      for (const name of ['dragleave', 'dragend'] as const) {
        drop.addEventListener(name, () => drop.classList.remove('is-over'));
      }
      drop.addEventListener('drop', (e) => {
        e.preventDefault();
        drop.classList.remove('is-over');
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) void uploadAll(files);
      });
    }

    // Removal inside the create form, where a nested <form> is not allowed.
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-evidence-remove]');
      if (!btn) return;
      const id = btn.dataset.evidenceRemove;
      if (!id) return;
      if (!window.confirm('Remove this evidence?')) return;
      btn.setAttribute('disabled', 'true');
      void fetch(`/api/evidence/${id}/delete`, { method: 'POST', body: new URLSearchParams() })
        .then((res) => {
          if (!res.ok) throw new Error('failed');
          btn.closest('.grc-evidence-tile')?.remove();
          status.textContent = 'Removed.';
        })
        .catch(() => {
          btn.removeAttribute('disabled');
          status.textContent = 'That could not be removed.';
        });
    });
  }

  // A real form post still confirms before it leaves the page.
  for (const btn of document.querySelectorAll('[data-confirm-remove]')) {
    btn.addEventListener('click', (e) => {
      if (!window.confirm('Remove this evidence?')) e.preventDefault();
    });
  }
</script>
