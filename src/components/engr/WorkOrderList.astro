---
/** A compact table of work orders, each linking to its detail under basePath. */
import type { WorkOrderListRow } from '@engr/repos/workOrders';
import { shortDate } from '@engr/format';
interface Props {
  rows: WorkOrderListRow[];
  basePath: string;
  emptyText: string;
}
const { rows, basePath, emptyText } = Astro.props;
---

{
  rows.length === 0 ? (
    <p class="engr-empty">{emptyText}</p>
  ) : (
    <div class="engr-tablewrap">
      <table class="engr-table" aria-label="Work orders">
        <thead>
          <tr>
            <th scope="col">Work order</th>
            <th scope="col">Station</th>
            <th scope="col" class="engr-col-mid">
              Contractor
            </th>
            <th scope="col" class="engr-col-mid">
              Technician
            </th>
            <th scope="col" class="engr-col-lo engr-num">
              Raised
            </th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>
                <a href={`${basePath}/${r.id}`}>{r.woNo}</a>
              </td>
              <td>{r.stationName}</td>
              <td class="engr-col-mid">{r.contractorName ?? 'Unassigned'}</td>
              <td class="engr-col-mid">{r.technicianName ?? 'Unassigned'}</td>
              <td class="engr-col-lo engr-num">{shortDate(r.createdAt)}</td>
              <td>
                <span class="engr-status">{r.status}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
