---
/**
 * A readable area-and-line chart for a value over time, rendered server-side as
 * inline SVG. It carries a zeroed, labelled y-axis with a few gridlines, an
 * x-axis of period labels, a soft navy gradient fill, a crisp navy line, visible
 * points with a native hover tooltip (period and value), and a navy chip on the
 * latest point so a glance yields a number. When a datum carries an href each
 * period becomes a drill link: the plotted column for the mouse, and the "Show
 * data" table row for the keyboard and assistive tech. When every value is equal
 * it draws a clean baseline with a "no variation yet" note rather than a flat
 * mystery; an empty series shows a quiet empty line. The SVG is a labelled
 * role=img and the data table is its accessible equivalent.
 */
import type { ChartDatum } from '@engr/repos/analytics';

interface Props {
  title: string;
  description?: string;
  data: ChartDatum[];
  valueHeading?: string;
  emptyText?: string;
}
const {
  title,
  description,
  data,
  valueHeading = 'Count',
  emptyText = 'No data yet.',
} = Astro.props;

const values = data.map((d) => d.value);
const max = values.reduce((m, v) => Math.max(m, v), 0);
const hasData = data.length > 0 && max > 0;
const allEqual = new Set(values).size <= 1;

// A "nice" axis: round the step up to 1, 2, 5 x 10^n so gridlines land on tidy
// integers, then take the top as a whole number of steps above the max.
const niceCeil = (v: number): number => {
  if (v <= 0) return 1;
  const pow = Math.pow(10, Math.floor(Math.log10(v)));
  const n = v / pow;
  const nice = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
  return nice * pow;
};
const step = niceCeil(max / 4);
const top = Math.max(step, Math.ceil(max / step) * step);
const ticks: number[] = [];
for (let t = 0; t <= top + 0.0001; t += step) ticks.push(t);

// Geometry: left gutter for y labels, bottom gutter for x labels.
const W = 400;
const H = 200;
const L = 34; // left gutter
const R = 14; // right pad
const T = 14; // top pad
const B = 26; // bottom gutter
const plotW = W - L - R;
const plotH = H - T - B;
const n = data.length;
const px = (i: number): number => (n <= 1 ? L + plotW / 2 : L + (i * plotW) / (n - 1));
const py = (v: number): number => T + plotH - (top > 0 ? (v / top) * plotH : 0);

const pts = data.map((d, i) => ({ x: px(i), y: py(d.value), d }));
const linePath = pts.length
  ? `M${pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L')}`
  : '';
const areaPath = pts.length
  ? `M${pts[0].x.toFixed(1)},${(T + plotH).toFixed(1)} L${pts
      .map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`)
      .join(' L')} L${pts[n - 1].x.toFixed(1)},${(T + plotH).toFixed(1)} Z`
  : '';

// Thin the x labels when the series is long, so they never overlap.
const labelEvery = n > 8 ? Math.ceil(n / 6) : 1;
const last = pts[n - 1];
const latest = data[n - 1];

// The latest-value chip, sized to its text and clamped fully inside the plot so
// it can never overlap the axis or spill past the card edge. It flips below the
// point when placing it above would clip the top.
const chipText = String(latest?.value ?? 0);
const chipW = chipText.length * 7 + 12;
const chipH = 16;
const chipCx = last ? Math.max(L + chipW / 2, Math.min(last.x, W - R - chipW / 2)) : 0;
const chipCy = last ? (last.y - 14 - chipH / 2 < T ? last.y + 16 : last.y - 14) : 0;

const gradId = `engr-linegrad-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const ariaSummary = `${title}. ${data.map((d) => `${d.label}: ${d.value}`).join('; ')}. Latest ${latest?.value ?? 0}.`;
---

<figure class="engr-chart engr-chart--line">
  <figcaption class="engr-chart__cap">
    <h3 class="engr-chart__title">{title}</h3>
    {description && <p class="engr-chart__desc">{description}</p>}
  </figcaption>
  {
    !hasData ? (
      <p class="engr-empty">{emptyText}</p>
    ) : (
      <div>
        <div class="engr-line">
          <svg viewBox={`0 0 ${W} ${H}`} class="engr-line__svg" role="img" aria-label={ariaSummary}>
            <defs>
              <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--engr-navy-2)" stop-opacity="0.28" />
                <stop offset="100%" stop-color="var(--engr-navy-2)" stop-opacity="0" />
              </linearGradient>
            </defs>

            {/* gridlines and y-axis labels */}
            {ticks.map((t) => (
              <g>
                <line
                  x1={L}
                  y1={py(t)}
                  x2={W - R}
                  y2={py(t)}
                  stroke="var(--engr-line)"
                  stroke-width="1"
                  opacity={t === 0 ? 0.9 : 0.5}
                />
                <text x={L - 6} y={py(t) + 3} text-anchor="end" class="engr-line__axis">
                  {t}
                </text>
              </g>
            ))}

            {/* area and line */}
            <path d={areaPath} fill={`url(#${gradId})`} stroke="none" />
            <path
              d={linePath}
              fill="none"
              stroke="var(--engr-navy)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            {/* points, each a per-period drill target for the mouse (the data
                table carries the keyboard and assistive-tech equivalent) */}
            {pts.map((p) => {
              const hit = (
                <>
                  <rect
                    x={p.x - Math.max(6, plotW / (2 * Math.max(1, n - 1)))}
                    y={T}
                    width={Math.max(12, plotW / Math.max(1, n - 1))}
                    height={plotH}
                    fill="transparent"
                  >
                    <title>{`${p.d.label}: ${p.d.display ?? p.d.value}`}</title>
                  </rect>
                  <circle cx={p.x} cy={p.y} r="2.6" fill="var(--engr-navy)" />
                </>
              );
              return p.d.href ? (
                <a href={p.d.href} tabindex="-1" aria-hidden="true">
                  {hit}
                </a>
              ) : (
                <g>{hit}</g>
              );
            })}

            {/* latest value chip */}
            {last && (
              <g>
                <rect
                  x={chipCx - chipW / 2}
                  y={chipCy - chipH / 2}
                  width={chipW}
                  height={chipH}
                  rx="4"
                  fill="var(--engr-navy)"
                />
                <text x={chipCx} y={chipCy + 3.5} text-anchor="middle" class="engr-line__latest">
                  {chipText}
                </text>
              </g>
            )}

            {/* x-axis period labels: the first and last anchor inward so a wide
                label at the edge never clips the plot. */}
            {data.map((d, i) =>
              i % labelEvery === 0 || i === n - 1 ? (
                <text
                  x={i === 0 ? L : i === n - 1 ? W - R : px(i)}
                  y={H - 8}
                  text-anchor={i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}
                  class="engr-line__axis"
                >
                  {d.label}
                </text>
              ) : null,
            )}
          </svg>
        </div>

        {allEqual && (
          <p class="engr-chart__note">No variation yet: every period is {latest?.value ?? 0}.</p>
        )}

        <details class="engr-chart__data">
          <summary>Show data</summary>
          <table class="engr-chart__table">
            <thead>
              <tr>
                <th scope="col">Period</th>
                <th scope="col">{valueHeading}</th>
              </tr>
            </thead>
            <tbody>
              {data.map((d) => (
                <tr>
                  <th scope="row" class="engr-chart__label">
                    {d.href ? <a href={d.href}>{d.label}</a> : d.label}
                  </th>
                  <td>{d.display ?? d.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </div>
    )
  }
</figure>
