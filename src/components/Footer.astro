---
import Container from '@/components/primitives/Container.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import { SITE, PRODUCTS, SOCIAL } from '@/site.config';
const year = new Date().getFullYear();
const link =
  'inline-flex min-h-8 items-center text-sm text-slate no-underline hover:text-navy hover:underline';
---

<footer class="compact-footer border-t border-hairline bg-paper-shade text-slate">
  <Container>
    <div class="footer-main flex flex-wrap items-center gap-x-6 gap-y-1">
      <a
        href="/"
        class="inline-flex min-h-8 items-center text-base font-semibold tracking-widest text-navy no-underline"
        aria-label="Murikah, home">MURIKAH</a
      >
      <nav aria-label="Footer products" class="flex flex-wrap gap-x-4">
        {
          PRODUCTS.map((product) => (
            <a href={product.href} class={link}>
              {product.label}
            </a>
          ))
        }
      </nav>
      <nav aria-label="Footer company" class="flex flex-wrap gap-x-4 lg:ml-auto">
        <a href="/about" class={link}>About</a>
        <a href="/services" class={link}>Services</a>
        <a href="/pricing" class={link}>Pricing</a>
        <a href="/insights" class={link}>Insights</a>
        <a href="/contact" class={link}>Contact</a>
      </nav>
    </div>
    <div
      class="footer-meta flex flex-wrap items-center gap-x-5 gap-y-1 border-t border-hairline text-xs"
    >
      <p>© {year} {SITE.legalName}</p>
      <a href="/privacy" class={link}>Privacy</a>
      <a href="/terms" class={link}>Terms</a>
      {
        SOCIAL.map((s) => (
          <a href={s.href} class={link} rel="me noopener" target="_blank">
            {s.label}
          </a>
        ))
      }
      <a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>
      <details class="newsletter ml-auto">
        <summary class="min-h-8 cursor-pointer py-1.5 text-sm text-navy hover:underline">Newsletter</summary>
        <div class="newsletter-panel">
          <p class="mb-2 text-sm">Occasional notes on assurance and governance.</p>
          <SubscribeForm
            source="newsletter"
            tone="light"
            buttonLabel="Subscribe"
            successMessage="Thank you. We will send the occasional note, nothing more."
          />
        </div>
      </details>
    </div>
  </Container>
</footer>
<style>
  .compact-footer {
    padding-block: var(--marketing-footer-padding);
  }
  .footer-main {
    padding-bottom: var(--marketing-footer-padding);
  }
  .footer-meta {
    padding-top: var(--marketing-footer-padding);
  }
  .newsletter {
    position: relative;
  }
  .newsletter-panel {
    position: absolute;
    bottom: 100%;
    right: 0;
    width: min(24rem, calc(100vw - 3rem));
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-control-border);
    color: var(--color-ink);
    border-radius: var(--radius-btn);
    z-index: 10;
  }
  @media (max-width: 639px) {
    .compact-footer a,
    summary {
      min-height: 2.75rem;
    }
  }
</style>
