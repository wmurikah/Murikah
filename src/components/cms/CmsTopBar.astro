---
/**
 * The compact top bar: the drawer trigger on small screens, a search affordance,
 * notifications, and the account menu.
 *
 * Deliberately thin. The page's own title and actions live in CmsPageHeader,
 * below this, so the top bar carries only what is true on every page. That
 * keeps the number of equally weighted choices at the top of the screen small,
 * which is the Hick-Hyman point.
 *
 * The account and notification menus are <details> disclosures, so they work
 * with a keyboard and cost no JavaScript beyond the shared outside-click
 * handler in CmsDropdown.
 */
import CmsAvatar from './CmsAvatar.astro';
import CmsDropdown from './CmsDropdown.astro';
import CmsIcon from './CmsIcon.astro';
import CmsWordmark from './CmsWordmark.astro';
import CmsIconButton from './CmsIconButton.astro';
import CmsMenuItem from './CmsMenuItem.astro';

import type { CmsIdentity } from '@/lib/cms/repos/identity';
import { organisationLine } from '@/lib/cms/organisation';

interface Props {
  drawerId: string;
  /** The resolved principal from the middleware guard. Null when signed out. */
  principal?: { user: CmsIdentity } | null;
  notificationCount?: number;
  /** True when the server already knows the count (the notifications page). */
  notificationCountKnown?: boolean;
}
const {
  drawerId,
  principal = null,
  notificationCount = 0,
  notificationCountKnown = false,
} = Astro.props;
const user = principal?.user ?? null;
// Job title and organisational context come from the primary assignment, which
// an EXTERNAL user does not have at all, so both are optional everywhere.
const context = user ? organisationLine(user.assignment) : null;
---

<div
  class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b border-cms-line bg-cms-surface/95 px-3 backdrop-blur-sm sm:px-5"
>
  <button
    type="button"
    data-cms-modal-open={drawerId}
    aria-label="Open navigation"
    class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-cms text-cms-muted outline-none hover:bg-cms-canvas hover:text-cms-ink focus-visible:ring-2 focus-visible:ring-focus lg:hidden"
  >
    <CmsIcon name="menu" size={20} />
  </button>

  {
    /*
    Global search. Connected in phase 27, having been a disabled affordance
    since phase 02.

    THE RESULTS PANEL IS RENDERED FROM THE SERVER'S ANSWER AND NOTHING ELSE.
    There is no client-side cache and no local index: every keystroke that
    survives the debounce asks the endpoint, and the endpoint's queries carry
    the caller's scope. A cached result would outlive the membership or scope
    change that should have removed it.
  */
  }
  <div class="relative hidden min-w-0 flex-1 sm:block sm:max-w-sm" data-cms-search>
    <label for="cms-search" class="sr-only">Search records or pages</label>
    <CmsIcon
      name="search"
      size={17}
      class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-cms-muted"
    />
    <input
      id="cms-search"
      type="search"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="cms-search-results"
      aria-describedby="cms-search-note"
      placeholder="Search records or pages"
      class="h-10 w-full rounded-cms border border-cms-line bg-cms-canvas pr-14 pl-9 text-cms-body-sm text-cms-ink placeholder:text-cms-muted focus-visible:ring-2 focus-visible:ring-focus focus-visible:outline-none"
    />
    <kbd
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 rounded border border-cms-line bg-cms-surface px-1.5 py-0.5 text-cms-caption text-cms-muted"
      >/</kbd
    >
    <span id="cms-search-note" class="sr-only">
      Press the forward slash key from anywhere to search.
    </span>
    <div
      id="cms-search-results"
      role="listbox"
      aria-label="Search results"
      hidden
      class="absolute top-full right-0 left-0 z-40 mt-1 max-h-[60vh] overflow-y-auto rounded-cms-lg border border-cms-line bg-cms-surface shadow-cms-overlay"
    >
    </div>
    <p aria-live="polite" class="sr-only" data-cms-search-status></p>
  </div>

  <div class="ms-auto flex items-center gap-1">
    {
      /*
        Opens the assistant, which is rendered by the shell and reads nothing
        until this is pressed. A real control: it opens a real panel.
      */
    }
    {
      principal !== null && (
        <CmsIconButton icon="chat" label="Open the assistant" data-cms-modal-open="cms-assistant" />
      )
    }
    {
      /*
        THE BELL IS INSTANT AND ITS NUMBERS ARRIVE AFTERWARDS. The badge and
        the preview used to be resolved server-side on every page; both are now
        deferred (see the script below), so the shell never waits on them. The
        badge starts hidden unless the page already knew its count, and the
        preview is fetched the first time the menu opens — not on the ninety
        page views where nobody opens it.
      */
    }
    <CmsDropdown id="cms-notifications" label="Notifications">
      <span
        slot="trigger"
        class="relative inline-flex h-10 w-10 items-center justify-center text-cms-muted"
      >
        <CmsIcon name="bell" size={19} />
        <span
          data-cms-bell-badge
          data-known={notificationCountKnown ? '1' : undefined}
          hidden={!(notificationCountKnown && notificationCount > 0)}
          class="absolute top-1.5 right-1.5 min-w-4 rounded-full bg-cms-negative px-1 text-[0.625rem] leading-4 font-semibold text-white"
          aria-hidden="true"
        >
          {notificationCountKnown && notificationCount > 0 ? notificationCount : ''}
        </span>
        <span class="sr-only" data-cms-bell-label>
          Notifications{
            notificationCountKnown && notificationCount > 0 ? `, ${notificationCount} unread` : ''
          }
        </span>
      </span>
      <div data-cms-bell-preview>
        <p class="px-2.5 py-4 text-center text-cms-body-sm text-cms-muted">
          Nothing needs your attention right now.
        </p>
      </div>
      <a
        href="/app/notifications"
        class="block border-t border-cms-line px-2.5 py-2 text-center text-cms-body-sm font-medium text-cms-royal outline-none hover:bg-cms-canvas focus-visible:ring-2 focus-visible:ring-focus"
      >
        View notifications
      </a>
    </CmsDropdown>

    {
      user ? (
        <CmsDropdown id="cms-account" label="Account menu">
          <span slot="trigger" class="flex items-center gap-2">
            <CmsAvatar name={user.displayName} size="sm" />
            <span class="hidden min-w-0 flex-col text-left sm:flex">
              <span class="truncate text-cms-body-sm font-semibold text-cms-ink">
                {user.displayName}
              </span>
              <span class="truncate text-cms-caption text-cms-muted">
                {user.assignment?.jobTitle ??
                  (user.userType === 'EXTERNAL' ? 'Customer portal' : 'No assignment')}
              </span>
            </span>
            <CmsIcon name="chevronDown" size={15} class="text-cms-muted" />
          </span>

          <div class="border-b border-cms-line px-2.5 pt-1.5 pb-2.5">
            <p class="text-cms-body-sm font-semibold text-cms-ink">{user.displayName}</p>
            <p class="truncate text-cms-caption text-cms-muted">{user.email}</p>
            {user.assignment?.jobTitle && (
              <p class="mt-1 text-cms-caption text-cms-muted">{user.assignment.jobTitle}</p>
            )}
            {context && <p class="text-cms-caption text-cms-muted">{context}</p>}
          </div>

          <p class="px-2.5 py-2 text-cms-caption text-cms-muted">Account and profile settings</p>

          {/*
            A POST form, never a link. Sign-out on GET can be triggered by any
            third-party page that can make your browser issue a request, and a
            forced sign-out is a real if minor nuisance. The form also carries
            the Origin header the CSRF check requires.
          */}
          <form method="post" action="/api/auth/logout" class="border-t border-cms-line pt-1.5">
            <CmsMenuItem icon="logout" tone="danger" type="submit">
              Sign out
            </CmsMenuItem>
          </form>
        </CmsDropdown>
      ) : (
        <CmsIconButton icon="logout" label="Sign in" href="/login" />
      )
    }
  </div>
</div>

<script>
  /**
   * The bell's deferred lifecycle.
   *
   * COUNT: fetched once, shortly after first paint, in idle time — the page
   * never waits on it, and a page that passed its own count (data-known) is
   * left alone so "just marked read" is not overwritten by a racing fetch.
   *
   * PREVIEW: fetched the first time the menu opens, because that is the first
   * moment anybody needs it. Reused for the rest of the page's life; the
   * notifications page is one press away for anything longer.
   *
   * FAILURE IS SILENCE, NOT A BANNER, AND NEVER A PERMANENT LOADER. A failed
   * count leaves the badge hidden; a failed preview replaces "Loading" with
   * the quiet empty line. No retry loop — the next page view asks again.
   */
  const badge = document.querySelector<HTMLElement>('[data-cms-bell-badge]');
  const label = document.querySelector<HTMLElement>('[data-cms-bell-label]');
  const preview = document.querySelector<HTMLElement>('[data-cms-bell-preview]');
  const menu = document.getElementById('cms-notifications');

  const paintCount = (count: number) => {
    if (!badge) return;
    if (count > 0) {
      badge.textContent = String(count > 99 ? '99+' : count);
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
    if (label) label.textContent = count > 0 ? `Notifications, ${count} unread` : 'Notifications';
  };

  if (badge && badge.dataset.known !== '1') {
    const fetchCount = () => {
      fetch('/api/notifications/bell', { headers: { accept: 'application/json' } })
        .then((response): Promise<unknown> | null => (response.ok ? response.json() : null))
        .then((raw) => {
          const data = raw as { count?: number } | null;
          if (data && typeof data.count === 'number') paintCount(data.count);
        })
        .catch(() => {
          /* The bell is a convenience. The badge stays hidden. */
        });
    };
    // After first paint, in idle time where the browser offers it.
    const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => number })
      .requestIdleCallback;
    if (idle) idle(fetchCount);
    else window.setTimeout(fetchCount, 300);
  }

  if (menu instanceof HTMLDetailsElement && preview) {
    let loaded = false;
    menu.addEventListener('toggle', () => {
      if (!menu.open || loaded) return;
      loaded = true;
      preview.replaceChildren();
      const loading = document.createElement('p');
      loading.className = 'px-2.5 py-4 text-center text-cms-body-sm text-cms-muted';
      loading.textContent = 'Loading\u2026';
      preview.appendChild(loading);

      const quietLine = (text: string) => {
        preview.replaceChildren();
        const line = document.createElement('p');
        line.className = 'px-2.5 py-4 text-center text-cms-body-sm text-cms-muted';
        line.textContent = text;
        preview.appendChild(line);
      };

      fetch('/api/notifications/bell?preview=1', { headers: { accept: 'application/json' } })
        .then((response): Promise<unknown> | null => (response.ok ? response.json() : null))
        .then((raw) => {
          const data = raw as {
            count?: number;
            items?: { title: string; createdAt: string }[];
          } | null;
          if (data && typeof data.count === 'number') paintCount(data.count);
          const items = data?.items ?? [];
          if (items.length === 0) {
            quietLine('Nothing needs your attention right now.');
            return;
          }
          // Built with textContent, never markup: a notification title is data.
          preview.replaceChildren();
          const list = document.createElement('ul');
          list.className = 'flex flex-col';
          for (const item of items) {
            const row = document.createElement('li');
            row.className = 'border-b border-cms-line px-2.5 py-2 last:border-0';
            const title = document.createElement('p');
            title.className = 'text-cms-body-sm text-cms-ink';
            title.textContent = item.title;
            const at = document.createElement('p');
            at.className = 'text-cms-caption text-cms-muted';
            at.textContent = item.createdAt;
            row.appendChild(title);
            row.appendChild(at);
            list.appendChild(row);
          }
          preview.appendChild(list);
        })
        .catch(() => {
          // A loader must never become the permanent state.
          quietLine('Nothing needs your attention right now.');
          loaded = false;
        });
    });
  }
</script>
