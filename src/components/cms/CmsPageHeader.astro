---
/**
 * The page-title zone: breadcrumb, the single h1, a line of context, and the
 * page's actions.
 *
 * Every page in the shell renders exactly one of these, which is how the
 * "exactly one h1" rule is kept structurally rather than by discipline. The
 * actions slot is where the page's dominant action goes, on the right, alone if
 * possible, so there is one obvious thing to do.
 */
import CmsBreadcrumb, { type CmsCrumb } from './CmsBreadcrumb.astro';
import CmsAuditHistoryLink from './CmsAuditHistoryLink.astro';

interface Props {
  title: string;
  description?: string;
  crumbs?: CmsCrumb[];
  /**
   * A record's audit entity type and identifier. Where both are given, the
   * header renders the View Audit History action beside the page's own
   * actions.
   *
   * IT LIVES HERE RATHER THAN ON EACH PAGE so that eleven record types get
   * the same action in the same place from one line each, and so that a
   * twelfth cannot quietly ship without it. The component renders nothing for
   * a principal without AUDIT.EVENTS.VIEW, and that is presentation only: the
   * workspace checks the permission and applies the scope for itself.
   */
  auditEntityType?: string;
  auditEntityId?: string;
  class?: string;
}
const {
  title,
  description,
  crumbs,
  auditEntityType,
  auditEntityId,
  class: className,
} = Astro.props;
---

<header class:list={['flex flex-col gap-3', className]}>
  {crumbs && crumbs.length > 0 && <CmsBreadcrumb items={crumbs} />}
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 flex-col gap-1">
      <h1 class="text-cms-page font-semibold text-cms-navy">{title}</h1>
      {description && <p class="max-w-2xl text-cms-body-sm text-cms-muted">{description}</p>}
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <slot name="actions" />
      {
        auditEntityType !== undefined && auditEntityId !== undefined && auditEntityId !== '' && (
          <CmsAuditHistoryLink entityType={auditEntityType} entityId={auditEntityId} />
        )
      }
    </div>
  </div>
</header>
