---
/**
 * The product wordmark.
 *
 * Text, not an image. There is no Hass logo file anywhere in this repository:
 * public/brand/ holds only Murikah marks, and inventing an approximation of
 * another company's logo would be worse than a typographic wordmark. When an
 * approved asset arrives this component is the one place that changes.
 *
 * The gold rule under HASS is the single scarce accent, and it only ever
 * appears on navy, where it measures 7.33:1.
 */
interface Props {
  tone?: 'onNavy' | 'onLight';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { tone = 'onNavy', size = 'md', class: className } = Astro.props;

const sizes = {
  sm: 'text-cms-card',
  md: 'text-cms-section',
  lg: 'text-cms-display',
};
const tones = {
  onNavy: { name: 'text-white', sub: 'text-cms-rail-muted', rule: 'bg-cms-gold' },
  onLight: { name: 'text-cms-navy', sub: 'text-cms-muted', rule: 'bg-cms-gold-ink' },
};
const t = tones[tone];
---

<span class:list={['inline-flex flex-col gap-1', className]}>
  <span class:list={['leading-none font-semibold tracking-tight', sizes[size], t.name]}>
    HASS<span class:list={['ml-3 font-normal tracking-normal', t.sub]}>Petroleum</span>
  </span>
  <span class:list={['h-0.5 w-8 rounded-full', t.rule]} aria-hidden="true"></span>
</span>
