---
/**
 * The one placeholder page, rendered for every module destination.
 *
 * Seven near-identical page files would drift apart within a week, so there is
 * one component and the pages pass it their href. Everything it shows is read
 * from CMS_NAV: the label, the summary and the permission the section will
 * require. Nothing is retyped, so nothing can disagree with the rail.
 *
 * Showing the permission key is deliberate. It is the honest statement of what
 * this phase did and did not do: the model carries the key, and no code reads
 * it yet.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import { CMS_NAV } from '@/lib/cms/nav';

interface Props {
  href: string;
}
const { href } = Astro.props;
const item = CMS_NAV.find((entry) => entry.href === href);
if (!item) throw new Error(`No navigation entry for ${href}`);
// An entry may require any one of several codes, so the list is joined rather
// than rendered as an array, which would print a comma-separated string that
// looks like one code with commas in it.
const permissionLabel =
  item.permission === null ? 'Any signed-in user' : [item.permission].flat().join(' or ');
---

<CmsLayout title={item.label}>
  <CmsPageHeader
    title={item.label}
    description={item.summary}
    crumbs={[{ label: 'Home', href: '/' }, { label: item.label }]}
  >
    <CmsBadge slot="actions" tone="neutral" label="Unavailable" />
  </CmsPageHeader>

  <CmsEmptyState
    icon={item.icon}
    title={`${item.label} is not available`}
    description="This area is not available yet."
  />

  <CmsCard title="What this section will need" headingLevel="h2">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-1">
        <dt class="text-cms-caption font-semibold tracking-wide text-cms-muted uppercase">
          Permission key
        </dt>
        <dd class="font-mono text-cms-body-sm text-cms-ink">{permissionLabel}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-cms-caption font-semibold tracking-wide text-cms-muted uppercase">
          Visibility
        </dt>
        <dd class="text-cms-body-sm text-cms-ink">
          Declared on the navigation entry, deliberately unread. Filtering arrives with sessions.
        </dd>
      </div>
    </dl>
  </CmsCard>
</CmsLayout>
