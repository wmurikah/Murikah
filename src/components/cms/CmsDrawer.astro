---
/**
 * The mobile navigation drawer, also on <dialog>, for the same reasons as
 * CmsModal: the platform supplies the focus trap and Escape, and a slide-in
 * panel that traps focus badly is worse than no panel at all.
 *
 * It is the small-screen form of the navigation rail, so it is rendered on
 * every page of the shell and simply never opened above the lg breakpoint,
 * where the rail itself is visible.
 */
import CmsIconButton from './CmsIconButton.astro';

interface Props {
  id: string;
  title: string;
  /**
   * `navigation` is the small-screen menu: navy, anchored to the leading edge,
   * the width of a rail. `form` is the create-and-edit panel Build Prompt 05
   * needs: a light surface on the trailing edge, wide enough for labelled
   * fields, with room for actions at the foot.
   *
   * Added rather than writing a second drawer component. The two share the
   * dialog, the focus trap, Escape, the backdrop and the close control, and
   * only their surface and their edge differ; a second component would have
   * been a second place for those five things to drift.
   */
  /*
   * THE DEFAULT IS `form`, AND THE INVERSION IS THE POINT.
   *
   * It used to default to `navigation`, which is the rail's dark navy. Two
   * screens — "Add a provider" and "Add a connection" — simply omitted the
   * prop, so light-canvas form fields rendered on a navy panel and every label
   * and every helper became invisible. What survived was the red required
   * asterisks floating above white boxes with nothing to say what they were.
   *
   * Nineteen other form drawers passed `tone="form"` and were fine, which is
   * exactly what made this so hard to see: the fault was not in any of the
   * screens that broke, it was in the one that did not have to say anything.
   *
   * A default that can produce an unreadable screen is the defect. The dark
   * tone is now opt-in, asked for by name, and the only caller that asks is
   * the navigation drawer in CmsLayout — which is chrome, not content, and is
   * where the design sweep permits a dark field.
   */
  tone?: 'navigation' | 'form';
  /** Announced with the close control, so it names what is being closed. */
  closeLabel?: string;
}
const { id, title, tone = 'form', closeLabel } = Astro.props;
const titleId = `${id}-title`;
const form = tone === 'form';
---

<dialog
  id={id}
  aria-labelledby={titleId}
  class:list={[
    'm-0 h-dvh max-h-none max-w-none border-0 p-0 backdrop:bg-cms-navy/55',
    form
      ? 'ms-auto w-[min(30rem,100vw)] bg-cms-surface text-cms-ink'
      : 'w-[min(19rem,85vw)] bg-cms-navy text-cms-rail-text',
  ]}
>
  <div class="flex h-full flex-col">
    <div
      class:list={[
        'flex items-center justify-between gap-3 px-4 py-3.5',
        form && 'border-b border-cms-line',
      ]}
    >
      <h2
        id={titleId}
        class:list={['text-cms-card font-semibold', form ? 'text-cms-navy' : 'text-white']}
      >
        {title}
      </h2>
      <CmsIconButton
        icon="close"
        label={closeLabel ?? (form ? 'Close panel' : 'Close navigation')}
        tone={form ? 'default' : 'onNavy'}
        data-cms-modal-close
      />
    </div>
    <div class:list={['min-h-0 flex-1 overflow-y-auto', form ? 'px-4 py-4' : 'px-3 pb-4']}>
      <slot />
    </div>
    {
      form && (
        <div class="flex justify-end gap-2 border-t border-cms-line px-4 py-3">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</dialog>
