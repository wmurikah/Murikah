---
/**
 * One measure, at card size, in the reference deck's anatomy: a thin coloured
 * rule along the top, a small capitalised label, one large figure, and a quiet
 * line of context beneath.
 *
 * THE TOP RULE CARRIES THE STATE, NOT DECORATION. Where the metric has a
 * semantic reading, the rule takes that ramp; where it has none, it takes the
 * neutral accent. It is never chosen for variety, which is what would turn a
 * row of these into a row of colours that mean nothing.
 *
 * THE WHOLE CARD IS THE DRILL TARGET. Not the figure inside it: a four-pixel
 * number is a poor target and Fitts's law is not a suggestion. The card is one
 * anchor, so a keyboard user gets one stop and a mouse user gets the whole
 * rectangle.
 *
 * AND A CARD WITH NOTHING BEHIND IT IS NEVER A LINK. An absent value renders
 * as text: a link to a page that will show nothing costs a click to discover
 * and teaches people that the figures lie.
 *
 * THE DEFINITION IS ON DEMAND. Denominator and date basis sit behind the
 * control in the corner, never printed under the number. It is a sibling of
 * the card's anchor rather than inside it, because a <details> nested in an
 * <a> is invalid and would swallow its own clicks.
 */
import CmsDefinition from './CmsDefinition.astro';
import type { Chart } from '@/lib/cms/charts/svg';

interface Props {
  label: string;
  /** Already formatted, or the absent string. */
  value: string;
  /** The target, the unit or the denominator. One quiet line, never a sentence. */
  context?: string;
  /** The metric's semantic reading, which colours the top rule. */
  tone?: 'neutral' | 'positive' | 'caution' | 'negative' | 'info';
  /** Where the records behind this figure live, with the filter applied. */
  href?: string;
  definition?: string;
  denominator?: string;
  dateBasis?: string;
  /** A small trend inside the card, where direction matters more than figures. */
  spark?: Chart;
  class?: string;
}
const {
  label,
  value,
  context,
  tone = 'neutral',
  href,
  definition,
  denominator,
  dateBasis,
  spark,
  class: className,
} = Astro.props;

const absent = value === 'Not available' || value === '';
const drillable = href !== undefined && href !== '' && !absent;
const hasDefinition = definition !== undefined || denominator !== undefined;

const rules = {
  neutral: 'bg-cms-royal',
  positive: 'bg-cms-positive',
  caution: 'bg-cms-caution',
  negative: 'bg-cms-negative',
  info: 'bg-cms-info',
};
---

<div class:list={['relative overflow-hidden rounded-cms bg-cms-surface', className]}>
  <span class:list={['absolute inset-x-0 top-0 h-1', rules[tone]]} aria-hidden="true"></span>

  {
    hasDefinition && (
      <CmsDefinition
        label={label}
        definition={definition}
        denominator={denominator}
        dateBasis={dateBasis}
        class="absolute top-2 right-1.5 z-10"
      />
    )
  }

  {
    drillable ? (
      <a
        href={href}
        class="flex flex-col gap-1 px-4 pt-4 pb-3.5 outline-none focus-visible:ring-2 focus-visible:ring-focus [&:hover_[data-figure]]:underline"
      >
        <span class="pr-6 text-cms-caption font-semibold tracking-wide text-cms-muted uppercase">
          {label}
        </span>
        <span
          data-figure
          class="text-cms-kpi font-semibold text-cms-ink tabular-nums underline-offset-4"
        >
          {value}
        </span>
        {context && <span class="text-cms-caption text-cms-muted">{context}</span>}
        {spark && <span class="mt-1 block text-cms-royal" set:html={spark.svg} />}
        <span class="sr-only">Open the records behind this figure.</span>
      </a>
    ) : (
      <div class="flex flex-col gap-1 px-4 pt-4 pb-3.5">
        <span class="pr-6 text-cms-caption font-semibold tracking-wide text-cms-muted uppercase">
          {label}
        </span>
        <span
          class:list={[
            'text-cms-kpi font-semibold tabular-nums',
            absent ? 'text-cms-muted' : 'text-cms-ink',
          ]}
        >
          {value}
        </span>
        {context && <span class="text-cms-caption text-cms-muted">{context}</span>}
        {spark && <span class="mt-1 block text-cms-royal" set:html={spark.svg} />}
      </div>
    )
  }
</div>
