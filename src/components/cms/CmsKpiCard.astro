---
/**
 * One measure, at card size, in the reference deck's anatomy: a thin coloured
 * rule along the top, a small capitalised label, one large figure, and a quiet
 * line of context beneath.
 *
 * THE LABEL IS SET IN SMALL CAPITALS, which is the one piece of that anatomy
 * this component described and did not draw. Capitals at caption size read as a
 * field name rather than as a sentence, which is what keeps the figure the
 * loudest thing in the card at a glance.
 *
 * THE TOP RULE TIES THE CARD TO ITS BAR, AND IT IS NEVER A VERDICT. It takes
 * the same non-semantic series token as the function this figure belongs to, so
 * the eye carries a function from the KPI strip to its bar to its row in the
 * table beneath without reading a label three times. It is deliberately NOT a
 * status ramp: green, amber and red mean met, at risk and breached in this
 * application and nothing else, and a card whose figure has no target has no
 * such reading to carry. A card that is given no token draws no rule rather
 * than reaching for a colour to fill the space.
 *
 * THE WHOLE CARD IS THE DRILL TARGET. Not the figure inside it: a four-pixel
 * number is a poor target and Fitts's law is not a suggestion. The card is one
 * anchor, so a keyboard user gets one stop and a mouse user gets the whole
 * rectangle.
 *
 * AND A CARD WITH NOTHING BEHIND IT IS NEVER A LINK. An absent value renders
 * as zero but stays non-drillable: a link to an empty page costs a click to
 * discover and teaches people that the figures lie.
 *
 * THE DEFINITION IS ON DEMAND. Denominator and date basis sit behind the
 * control in the corner, never printed under the number. It is a sibling of
 * the card's anchor rather than inside it, because a <details> nested in an
 * <a> is invalid and would swallow its own clicks.
 */
import CmsDefinition from './CmsDefinition.astro';
import type { Chart } from '@/lib/cms/charts/svg';

interface Props {
  label: string;
  /** Already formatted, or the absent string. */
  value: string;
  /** The target, the unit or the denominator. One quiet line, never a sentence. */
  context?: string;
  /** The metric's semantic reading, which colours the label. */
  tone?: 'neutral' | 'positive' | 'caution' | 'negative' | 'info';
  /**
   * The chart series this figure belongs to, drawn as the rule along the top.
   *
   * A token name without the `--color-` prefix, and always one of the
   * `cms-series-*` ramp. The design sweep asserts that nothing semantic reaches
   * a series slot, which is what stops a status colour arriving here as
   * decoration.
   */
  token?: string;
  /** Where the records behind this figure live, with the filter applied. */
  href?: string;
  definition?: string;
  denominator?: string;
  dateBasis?: string;
  /** A small trend inside the card, where direction matters more than figures. */
  spark?: Chart;
  class?: string;
}
const {
  label,
  value,
  context,
  tone = 'neutral',
  token,
  href,
  definition,
  denominator,
  dateBasis,
  spark,
  class: className,
} = Astro.props;

const absent = value === 'Not available' || value === '';
const displayValue = absent ? '0' : value;
const drillable = href !== undefined && href !== '' && !absent;
const hasDefinition = definition !== undefined || denominator !== undefined;

const states = {
  neutral: '',
  positive: 'text-cms-positive',
  caution: 'text-cms-caution',
  negative: 'text-cms-negative',
  info: 'text-cms-info',
};
---

<div class:list={['relative min-w-0 overflow-hidden rounded-cms bg-cms-surface', className]}>
  {
    token && (
      <span
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-1"
        style={`background-color: var(--color-${token})`}
      />
    )
  }
  {
    /*
      THE CONTROL IS POSITIONED BY A WRAPPER, NOT BY A CLASS PASSED INTO IT.
      CmsDefinition's own root is `relative`, because its panel is absolutely
      positioned against it. Passing `absolute` in alongside that put two
      position declarations on one element, and which of them won was decided by
      the order Tailwind happened to emit them in rather than by anything here:
      `relative` won, the control fell back into the document flow, and it
      rendered at the top LEFT of every card, above the label. A wrapper carries
      the placement and the component keeps its own.
    */
  }
  {
    hasDefinition && (
      <span class="absolute top-2 right-1.5 z-10">
        <CmsDefinition
          label={label}
          definition={definition}
          denominator={denominator}
          dateBasis={dateBasis}
        />
      </span>
    )
  }

  {
    drillable ? (
      <a
        href={href}
        class="flex flex-col gap-1 px-4 pt-4.5 pb-4 outline-none focus-visible:ring-2 focus-visible:ring-focus [&:hover_[data-figure]]:underline"
      >
        <span
          class:list={[
            'pr-6 text-cms-caption font-semibold tracking-wide uppercase',
            states[tone] || 'text-cms-muted',
          ]}
        >
          {label}
        </span>
        <span
          data-figure
          class="text-cms-kpi font-semibold break-words text-cms-ink tabular-nums underline-offset-4"
        >
          {displayValue}
        </span>
        {context && <span class="text-cms-caption text-cms-muted">{context}</span>}
        {spark && <span class="mt-1 block text-cms-royal" set:html={spark.svg} />}
        <span class="sr-only">Open the records behind this figure.</span>
      </a>
    ) : (
      <div class="flex flex-col gap-1 px-4 pt-4.5 pb-4">
        <span
          class:list={[
            'pr-6 text-cms-caption font-semibold tracking-wide uppercase',
            states[tone] || 'text-cms-muted',
          ]}
        >
          {label}
        </span>
        <span
          class:list={[
            'text-cms-kpi font-semibold break-words tabular-nums',
            absent ? 'text-cms-muted' : 'text-cms-ink',
          ]}
        >
          {displayValue}
        </span>
        {context && <span class="text-cms-caption text-cms-muted">{context}</span>}
        {/*
          NOT THE ACTION COLOUR ON A CARD THAT IS NOT AN ACTION. Royal means
          "this can be pressed", and a card with no destination cannot be. The
          linked branch above keeps it; this one draws its trend in ink, so the
          colour never promises something the card does not do.
        */}
        {spark && <span class="mt-1 block text-cms-ink-500" set:html={spark.svg} />}
      </div>
    )
  }
</div>