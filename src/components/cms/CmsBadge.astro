---
/**
 * The status pill.
 *
 * The one rule this component exists to enforce: status is never colour alone.
 * The label is a required prop and an icon is drawn beside it, so the same
 * information survives greyscale, a colour-blind reader and a screen reader.
 * There is deliberately no way to render this component as a bare coloured dot.
 *
 * Tones map to the SLA vocabulary this product will speak: within, approaching,
 * breached, plus neutral and informational.
 */
import CmsIcon from './CmsIcon.astro';
import type { CmsIconName } from './icons';

interface Props {
  tone?: 'neutral' | 'success' | 'warning' | 'danger' | 'info' | 'accent';
  label: string;
  icon?: CmsIconName;
  class?: string;
}
const { tone = 'neutral', label, icon, class: className } = Astro.props;

const tones = {
  neutral: 'bg-cms-canvas text-cms-muted ring-cms-line',
  success: 'bg-cms-success-tint text-cms-success ring-cms-success/25',
  warning: 'bg-cms-warning-tint text-cms-warning ring-cms-warning/25',
  danger: 'bg-cms-danger-tint text-cms-danger ring-cms-danger/25',
  info: 'bg-cms-info-tint text-cms-info ring-cms-info/25',
  accent: 'bg-cms-lavender-tint text-cms-lavender ring-cms-lavender/25',
};

const defaultIcon: Record<string, CmsIconName> = {
  success: 'statusOk',
  warning: 'statusWarn',
  danger: 'statusBreach',
  info: 'statusInfo',
};
const glyph = icon ?? defaultIcon[tone];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-cms-caption font-semibold whitespace-nowrap ring-1 ring-inset',
    tones[tone],
    className,
  ]}
>
  {glyph && <CmsIcon name={glyph} size={13} class="shrink-0" />}
  {label}
</span>
