---
/**
 * A vertical activity trail shell.
 *
 * An ordered list, because the order is the meaning: this is a sequence of
 * things that happened, and a screen reader should say so. The rail and the
 * dots are drawn with borders on the list items rather than an absolutely
 * positioned line, so nothing has to be measured and it cannot drift out of
 * alignment when an entry wraps to two lines.
 *
 * Every entry carries its own time element, so a date is machine-readable as
 * well as visible.
 */
export interface CmsTimelineEntry {
  title: string;
  detail?: string;
  actor?: string;
  /** ISO 8601, used for the datetime attribute. */
  timestamp: string;
  /** What a reader sees, for example "2 hours ago" or a formatted date. */
  timeLabel: string;
  tone?: 'default' | 'success' | 'warning' | 'danger';
}

interface Props {
  entries: CmsTimelineEntry[];
  label: string;
  class?: string;
}
const { entries, label, class: className } = Astro.props;

const dots = {
  default: 'bg-cms-border',
  success: 'bg-cms-positive',
  warning: 'bg-cms-caution',
  danger: 'bg-cms-negative',
};
---

{
  /*
  The rail's fade-out on the final entry is a `last:` variant rather than
  index arithmetic, so an entry inserted or removed by script (the activity
  composer prepends confirmed entries) keeps the rail correct with no class
  bookkeeping. The data-timeline-* hooks exist for the same reason: a client
  renderer clones one of these items and fills its text through them, so the
  markup lives here once and only here.
*/
}
<ol aria-label={label} class:list={['flex flex-col', className]}>
  {
    entries.map((entry) => (
      <li class="relative flex gap-3 border-l border-cms-line pb-5 pl-1 last:border-transparent last:pb-0">
        <span
          class:list={[
            'absolute top-1.5 -left-[4.5px] h-2 w-2 shrink-0 rounded-full ring-2 ring-cms-surface',
            dots[entry.tone ?? 'default'],
          ]}
          aria-hidden="true"
        />
        <div class="min-w-0 pl-4">
          <p data-timeline-title class="text-cms-body-sm font-medium text-cms-ink">
            {entry.title}
          </p>
          {entry.detail && (
            <p data-timeline-detail class="mt-0.5 text-cms-body-sm text-cms-muted">
              {entry.detail}
            </p>
          )}
          <p class="mt-1 flex flex-wrap items-center gap-x-2 text-cms-caption text-cms-muted">
            {entry.actor && <span data-timeline-actor>{entry.actor}</span>}
            {entry.actor && <span aria-hidden="true">&middot;</span>}
            <time data-timeline-time datetime={entry.timestamp}>
              {entry.timeLabel}
            </time>
          </p>
        </div>
      </li>
    ))
  }
</ol>
