---
/**
 * The shared analytics filter, as a form.
 *
 * It submits with GET, so the filter lands in the URL and the view can be
 * shared or bookmarked, and every drill-down from here carries the same
 * query string. One filter object, parsed in one place, applied by every
 * analytical query behind this page.
 *
 * THE DATES AND THE TREND GRAIN ARE NOT HERE ANY MORE. They were two
 * `dd/mm/yyyy` boxes and a dropdown: a person had to type a date twice before
 * seeing anything, and the grain asked a question the period they had just
 * chosen already answers. All three moved to CmsPeriodControl, which every
 * analytical page now renders above this. The period travels in the URL as one
 * token and reaches the queries through `withPeriod`, so nothing behind this
 * form had to change and no page can obey half of it.
 *
 * The hidden field below is what keeps them apart without losing either: this
 * is a GET form, so submitting it replaces the whole query string, and a
 * period not written back here would be silently discarded the first time
 * somebody changed an affiliate.
 */
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import CmsFilterPanel from '@/components/cms/CmsFilterPanel.astro';
import type { AnalyticsFilter } from '@/lib/cms/analytics/filters';

interface Props {
  filter: AnalyticsFilter;
  affiliates: { value: string; label: string }[];
  statuses: string[];
  action: string;
  /** Purchase order pages have no credit column, so they hide that control. */
  showCredit?: boolean;
  /**
   * Hides the status control, for a page whose report has no status
   * dimension. Absent rather than empty: a control that does nothing is
   * worse than no control, because somebody sets it and concludes the page
   * is broken when the numbers do not move.
   */
  showStatus?: boolean;
  /** The period token this page is showing, so a submit does not discard it. */
  period?: string | null;
  /** Custom periods carry their own ends, which must survive the submit too. */
  periodFrom?: string | null;
  periodTo?: string | null;
}
const {
  filter,
  affiliates,
  statuses,
  action,
  showCredit = true,
  showStatus = true,
  period = null,
  periodFrom = null,
  periodTo = null,
} = Astro.props;
const titleCase = (value: string) =>
  value.charAt(0) + value.slice(1).toLowerCase().replace('_', ' ');
const activeCount = [
  filter.affiliateId,
  filter.status,
  filter.slaStatus,
  filter.creditRequired === 'ANY' ? null : filter.creditRequired,
].filter(Boolean).length;
---

<CmsFilterPanel action={action} activeCount={activeCount} label="Order filters">
  {
    /*
    Extra hidden fields from the caller. A GET form replaces the whole query
    string, so a page carrying its own parameter (the reports page carries
    which report) must put it back or submitting the filter would navigate
    away from the thing being filtered.
  */
  }
  {period !== null && <input type="hidden" name="period" value={period} />}
  {
    period === 'custom' && periodFrom !== null && (
      <input type="hidden" name="from" value={periodFrom} />
    )
  }
  {period === 'custom' && periodTo !== null && <input type="hidden" name="to" value={periodTo} />}
  <Fragment slot="primary"><slot /></Fragment>
  <Fragment slot="advanced">
    <CmsSelect
      id="f-affiliate"
      name="affiliateId"
      label="Affiliate"
      value={filter.affiliateId ?? ''}
      options={[{ value: '', label: 'All affiliates' }, ...affiliates]}
    />
    {
      showStatus && (
        <CmsSelect
          id="f-status"
          name="status"
          label="Status"
          value={filter.status ?? ''}
          options={[
            { value: '', label: 'Any status' },
            ...statuses.map((status) => ({ value: status, label: titleCase(status) })),
          ]}
        />
      )
    }
    <CmsSelect
      id="f-sla"
      name="slaStatus"
      label="SLA"
      value={filter.slaStatus ?? ''}
      options={[
        { value: '', label: 'Any SLA state' },
        { value: 'RUNNING', label: 'Running' },
        { value: 'AT_RISK', label: 'At risk' },
        { value: 'BREACHED', label: 'Breached' },
        { value: 'MET', label: 'Met' },
      ]}
    />
    {
      showCredit && (
        <CmsSelect
          id="f-credit"
          name="creditRequired"
          label="Credit approval"
          value={filter.creditRequired}
          options={[
            { value: 'ANY', label: 'Any' },
            { value: 'YES', label: 'Required' },
            { value: 'NO', label: 'Not required' },
          ]}
        />
      )
    }
    <CmsInput
      id="f-min-volume"
      name="minVolume"
      label="Minimum volume to rank"
      type="number"
      value={String(filter.minVolume)}
      hint="Below this, figures are shown without a comparative rank."
    />
  </Fragment>
  <Fragment slot="chips"
    >{
      activeCount > 0 && (
        <a
          href={action}
          class="rounded-full bg-cms-royal-tint px-3 py-1 text-cms-caption font-medium text-cms-royal outline-none focus-visible:ring-2 focus-visible:ring-focus"
        >
          Clear {activeCount} active {activeCount === 1 ? 'filter' : 'filters'}{' '}
          <span aria-hidden="true">×</span>
        </a>
      )
    }</Fragment
  >
</CmsFilterPanel>
