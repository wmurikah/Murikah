---
/**
 * The branded error card, the CMS safety net (section 2). When a route's query or
 * render throws, the page catches it, logs it with a tag and the area, and renders
 * this instead of a blank 500. One broken widget can render this in place and the
 * rest of the page survives. Never render raw error detail to the user; the tag is
 * the operator's handle to the logged cause.
 */
interface Props {
  /** The log tag, e.g. [cms.dashboard]. */
  tag: string;
  /** A short, human area label, e.g. "the dashboard". */
  area: string;
  /** Optional inline variant for a single widget rather than a whole page. */
  inline?: boolean;
}
const { tag, area, inline = false } = Astro.props;
---

<div class:list={['cms-card', 'cms-errcard', { 'cms-errcard--inline': inline }]} role="alert">
  <h2>Something went wrong</h2>
  <p class="cms-lead">
    {area} could not be loaded just now. The problem has been logged; please try again.
  </p>
  <p class="cms-errcard__tag">{tag}</p>
</div>
