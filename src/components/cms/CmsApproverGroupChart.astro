---
/**
 * The purchase order approval chart: one bar per approver per product group,
 * ordered by median, slowest first — the problem at the top.
 *
 * WHY THIS SHAPE. Four bars by level answered which step is slow, and
 * averaged the best performer in the business into the worst. Split by
 * person and product, level 1 turns out to contain both a zero-breach fuel
 * approver and a 451-minute LPG median — and the same person can run at 5
 * minutes on fuel and 37 on lubricants, which is a product problem, not a
 * person problem. The levels still exist: each row expands to show them.
 *
 * TWO CLOCKS, EACH NAMED, NEVER MIXED. The bar and its state are the
 * ACCOUNTABLE figure — minutes inside the rule's business window — because
 * that is what the 30-minute target judges. The ELAPSED figure — wall clock,
 * what the business experienced — is printed beside it, labelled. The
 * over-target count appears for both, as absolute counts (`16 / 21`), never
 * a percentage a five-approval row would inflate.
 *
 * THE TARGET LINE IS READ, NEVER DRAWN FROM A CONSTANT. No active rule means
 * no line and one sentence saying so — the page renders that sentence, this
 * component simply draws nothing it cannot source.
 *
 * EXPANSION IS SERVER-RENDERED AND IN THE URL. The level rows are in this
 * markup already — the board query returns both grains in one statement — so
 * expanding fetches nothing. The toggle flips `hidden` (instant, motion-free,
 * so prefers-reduced-motion needs no special case) and mirrors itself into
 * `?poRow=` via replaceState, and the server opens whatever the URL names, so
 * an expanded view is shareable and a fresh load is collapsed.
 *
 * COLOUR IS NOT THE ONLY CARRIER. Every bar prints its figure and its state
 * in words; the table equivalent under "View as a table" carries every
 * column, and the whole visual strip is aria-hidden scenery beside them.
 */
import { formatDuration } from '@/lib/cms/analytics/stats';
import { approvalRecordsHref } from '@/lib/cms/analytics/leaderboard';
import type { ApproverGroupStat, PoApprovalRule } from '@/lib/cms/repos/approvalSla';
import type { ResolvedPeriod } from '@/lib/cms/analytics/period';

interface Props {
  rows: ApproverGroupStat[];
  levels: ReadonlyMap<string, ApproverGroupStat[]>;
  rule: PoApprovalRule | null;
  period: ResolvedPeriod;
  affiliateId: string | null;
  coverage: string;
}
const { rows, levels, rule, period, affiliateId, coverage } = Astro.props;

/** The URL key of a row, mirrored by the toggle script below. */
const keyOf = (row: ApproverGroupStat): string => `${row.userId ?? 'none'}~${row.group}`;
const expanded = new Set(Astro.url.searchParams.getAll('poRow'));

/**
 * The bar measures the clock the target judges — accountable — and falls back
 * to elapsed only when no rule resolves, in which case there is no target to
 * judge against and the axis says which clock it is drawing.
 */
const measureOf = (row: ApproverGroupStat): number | null =>
  rule === null ? row.elapsedMedianMinutes : row.accountableMedianMinutes;
const clockWord = rule === null ? 'elapsed' : 'business hours';

const most = Math.max(
  rule?.targetMinutes ?? 0,
  ...rows.map((row) => measureOf(row) ?? 0),
  ...[...levels.values()].flat().map((row) => measureOf(row) ?? 0),
  1,
);
const scale = most * 1.08;
const pct = (minutes: number | null): number =>
  minutes === null ? 0 : Math.max(Math.min((minutes / scale) * 100, 100), 0.5);
const targetPct = rule === null ? null : (rule.targetMinutes / scale) * 100;

type State = 'over' | 'risk' | 'within' | null;
const stateOf = (row: ApproverGroupStat): State => {
  const measure = row.accountableMedianMinutes;
  if (rule === null || measure === null) return null;
  if (measure > rule.targetMinutes) return 'over';
  if (rule.warningMinutes !== null && measure > rule.warningMinutes) return 'risk';
  return 'within';
};
const STATE_WORD: Record<Exclude<State, null>, string> = {
  over: 'Over target',
  risk: 'At risk',
  within: 'Within target',
};
const STATE_BAR: Record<Exclude<State, null>, string> = {
  over: 'bg-cms-negative',
  risk: 'bg-cms-caution',
  within: 'bg-cms-positive',
};
const STATE_TEXT: Record<Exclude<State, null>, string> = {
  over: 'text-cms-negative',
  risk: 'text-cms-caution',
  within: 'text-cms-positive',
};

const drill = (row: ApproverGroupStat): string =>
  approvalRecordsHref({
    period,
    affiliateId,
    process: 'PURCHASE_ORDER',
    view: 'completed',
    fn: row.levelName ?? '',
    actor: { kind: 'PERSON', userId: row.userId },
    productGroup: row.group,
  });

const minutesLabel = (minutes: number | null): string =>
  minutes === null ? 'Not measurable' : formatDuration(minutes);

/** One row's whole story as a sentence, for the screen-reader summary. */
const sentence = (row: ApproverGroupStat): string => {
  const state = stateOf(row);
  return (
    `${row.person ?? 'Not recorded'}, ${row.group}: median ${minutesLabel(row.accountableMedianMinutes)} ` +
    `business hours (${minutesLabel(row.elapsedMedianMinutes)} elapsed) over ${row.volume} approvals` +
    (rule === null
      ? '.'
      : `; ${row.accountableOverTarget} of ${row.volume} over the ${rule.targetMinutes}-minute target on business hours, ` +
        `${row.elapsedOverTarget} of ${row.volume} elapsed. ${state === null ? '' : STATE_WORD[state]}.`)
  );
};
---

<figure class="rounded-cms-lg bg-cms-surface p-4" data-cms-po-chart>
  <figcaption class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-cms-body font-semibold text-cms-ink">
      Purchase order approval, by approver and product
      <span class="ml-1 font-normal text-cms-muted">(minutes)</span>
    </h3>
    <span class="text-cms-caption text-cms-muted">{coverage}</span>
  </figcaption>

  {/* The text alternative: what the chart says, in one paragraph. */}
  <p class="sr-only">
    Median approval minutes per approver per product group, slowest first, over {coverage}.
    {
      rule === null
        ? 'No approval target is configured, so no bar is judged.'
        : `The target is ${rule.targetMinutes} minutes of business time (${rule.workdayStart} to ${rule.workdayEnd}); the warning level is ${rule.warningMinutes ?? 'not set'} minutes.`
    }
  </p>

  {
    rows.length === 0 ? (
      <p class="py-6 text-center text-cms-body-sm text-cms-muted">No completions this month</p>
    ) : (
      <ol class="flex flex-col">
        {rows.map((row) => {
          const key = keyOf(row);
          const open = expanded.has(key);
          const panelId = `po-levels-${key.replace(/[^A-Za-z0-9_-]/g, '-')}`;
          const state = stateOf(row);
          const rowLevels = levels.get(`${row.userId ?? ''}|${row.group}`) ?? [];
          return (
            <li class="border-b border-cms-line py-2 last:border-0">
              <div class="grid grid-cols-[minmax(7.5rem,12rem)_minmax(0,1fr)_minmax(9.5rem,auto)] items-center gap-3">
                <div class="min-w-0">
                  <button
                    type="button"
                    data-po-toggle={key}
                    aria-expanded={open ? 'true' : 'false'}
                    aria-controls={panelId}
                    class="flex max-w-full items-center gap-1 rounded-cms text-left text-cms-body-sm font-medium text-cms-ink outline-none hover:text-cms-royal focus-visible:ring-2 focus-visible:ring-focus"
                  >
                    <span
                      data-po-chevron
                      aria-hidden="true"
                      class="shrink-0 text-cms-muted select-none"
                    >
                      {open ? '▾' : '▸'}
                    </span>
                    <span class="truncate">{row.person ?? 'Not recorded'}</span>
                  </button>
                  <p class="ps-4 text-cms-caption text-cms-muted">{row.group}</p>
                </div>

                {/* The visual bar: scenery beside the linked figures. The
                    dashed rule is the target, at the same scale as every bar. */}
                <div class="relative h-9 min-w-0 rounded bg-cms-sunken" aria-hidden="true">
                  {targetPct !== null && (
                    <span
                      class="absolute inset-y-0 border-l-2 border-dashed border-cms-ink-500"
                      style={`left:${targetPct}%`}
                    />
                  )}
                  <span
                    class:list={[
                      'absolute top-1.5 bottom-1.5 left-0 rounded-r',
                      state === null ? 'bg-cms-royal' : STATE_BAR[state],
                    ]}
                    style={`width:${pct(measureOf(row))}%`}
                  />
                </div>

                <div class="text-right">
                  <p class="text-cms-body-sm">
                    <a
                      href={drill(row)}
                      class="rounded-cms font-semibold text-cms-ink tabular-nums underline-offset-2 outline-none hover:text-cms-royal hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                      aria-label={sentence(row)}
                    >
                      {minutesLabel(
                        rule === null ? row.elapsedMedianMinutes : row.accountableMedianMinutes,
                      )}
                    </a>
                    <span class="text-cms-caption text-cms-muted"> {clockWord}</span>
                    {state !== null && (
                      <span class:list={['ms-1 text-cms-caption font-semibold', STATE_TEXT[state]]}>
                        {STATE_WORD[state]}
                      </span>
                    )}
                  </p>
                  <p class="text-cms-caption text-cms-muted tabular-nums">
                    {rule === null
                      ? `${row.volume} approvals`
                      : `elapsed ${minutesLabel(row.elapsedMedianMinutes)} · over target ${row.accountableOverTarget} / ${row.volume} business hours, ${row.elapsedOverTarget} / ${row.volume} elapsed`}
                  </p>
                </div>
              </div>

              {/* THE LEVELS, ALREADY HERE. Server-rendered from the same
                  statement, hidden until the name is pressed, never fetched. */}
              <div id={panelId} hidden={!open} class="mt-1 border-s-2 border-cms-line ps-5">
                <ol class="flex flex-col">
                  {rowLevels.map((level) => {
                    const levelState = stateOf(level);
                    return (
                      <li class="grid grid-cols-[minmax(7rem,11rem)_minmax(0,1fr)_minmax(9.5rem,auto)] items-center gap-3 py-1.5">
                        <p class="truncate text-cms-caption text-cms-ink">
                          Level {level.levelOrder}
                          <span class="block truncate text-cms-muted">{level.levelName}</span>
                        </p>
                        <div class="relative h-6 min-w-0 rounded bg-cms-sunken" aria-hidden="true">
                          {targetPct !== null && (
                            <span
                              class="absolute inset-y-0 border-l-2 border-dashed border-cms-ink-500"
                              style={`left:${targetPct}%`}
                            />
                          )}
                          <span
                            class:list={[
                              'absolute top-1 bottom-1 left-0 rounded-r',
                              levelState === null ? 'bg-cms-royal' : STATE_BAR[levelState],
                            ]}
                            style={`width:${pct(measureOf(level))}%`}
                          />
                        </div>
                        <p class="text-right text-cms-caption text-cms-muted tabular-nums">
                          <a
                            href={drill(level)}
                            class="rounded-cms font-semibold text-cms-ink underline-offset-2 outline-none hover:text-cms-royal hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                            aria-label={sentence(level)}
                          >
                            {minutesLabel(measureOf(level))}
                          </a>{' '}
                          {clockWord}
                          {rule !== null &&
                            ` · elapsed ${minutesLabel(level.elapsedMedianMinutes)} · over ${level.accountableOverTarget} / ${level.volume}`}
                          {levelState !== null && (
                            <span class:list={['ms-1 font-semibold', STATE_TEXT[levelState]]}>
                              {STATE_WORD[levelState]}
                            </span>
                          )}
                        </p>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </li>
          );
        })}
      </ol>
    )
  }

  {/* The axis, in words and numbers: which clock, and where the line sits. */}
  <div class="mt-2 flex items-center justify-between text-cms-caption text-cms-muted">
    <span>0</span>
    <span>
      Minutes ({clockWord})
      {rule !== null && ` — dashed line: ${rule.targetMinutes}-minute target`}
    </span>
    <span class="tabular-nums">{formatDuration(Math.round(scale))}</span>
  </div>

  {
    /* THE TARGET'S SOURCE, OR ITS ABSENCE, SAID BENEATH THE CHART. The figure
      is read from the active rule, never a constant; where no rule resolves,
      no line is drawn and this says so — a missing target and a met target
      must not look alike. */
  }
  <p class="mt-1 text-cms-caption text-cms-muted">
    {
      rule === null
        ? 'No active purchase order approval target is configured, so no target line is drawn.'
        : `The target is ${rule.targetMinutes} minutes of business time` +
          ` (${rule.workdayStart}–${rule.workdayEnd}), read from rule ${rule.ruleId}.` +
          ' Elapsed time is the wall clock the business experienced, printed beside each' +
          ' figure and never blended with business hours.'
    }
  </p>

  {/* THE DATA-TABLE EQUIVALENT: every figure, both clocks, each labelled. */}
  <details class="mt-3 border-t border-cms-line pt-2">
    <summary
      class="cursor-pointer rounded-cms text-cms-body-sm font-medium text-cms-royal outline-none select-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
    >
      View as a table
    </summary>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-cms-body-sm">
        <caption class="sr-only">
          Purchase order approval medians by approver and product group
        </caption>
        <thead>
          <tr class="border-b border-cms-line text-left text-cms-caption text-cms-muted">
            <th scope="col" class="py-1.5 pr-3 font-medium">Approver</th>
            <th scope="col" class="py-1.5 pr-3 font-medium">Group</th>
            <th scope="col" class="py-1.5 pr-3 text-right font-medium">Approvals</th>
            <th scope="col" class="py-1.5 pr-3 text-right font-medium"> Median, business hours </th>
            <th scope="col" class="py-1.5 pr-3 text-right font-medium">Median, elapsed</th>
            <th scope="col" class="py-1.5 pr-3 text-right font-medium">
              Over target, business hours
            </th>
            <th scope="col" class="py-1.5 text-right font-medium">Over target, elapsed</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="py-1.5 pr-3 text-cms-ink">{row.person ?? 'Not recorded'}</td>
                <td class="py-1.5 pr-3 text-cms-muted">{row.group}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums">{row.volume}</td>
                <td class="py-1.5 pr-3 text-right tabular-nums">
                  {row.accountableMedianMinutes ?? '—'}
                </td>
                <td class="py-1.5 pr-3 text-right tabular-nums">
                  {row.elapsedMedianMinutes ?? '—'}
                </td>
                <td class="py-1.5 pr-3 text-right tabular-nums">
                  {rule === null ? '—' : `${row.accountableOverTarget} / ${row.volume}`}
                </td>
                <td class="py-1.5 text-right tabular-nums">
                  {rule === null ? '—' : `${row.elapsedOverTarget} / ${row.volume}`}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</figure>

<script>
  /**
   * The expansion lifecycle: flip the panel, mirror the URL. The panel's
   * markup is already on the page — nothing is fetched — and the flip is a
   * `hidden` toggle, which is instant by construction, so reduced motion
   * needs no special case. replaceState keeps the expanded set shareable
   * without growing history one entry per click.
   */
  const chart = document.querySelector<HTMLElement>('[data-cms-po-chart]');
  chart?.addEventListener('click', (event) => {
    const toggle = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-po-toggle]');
    if (!toggle) return;
    const key = toggle.dataset.poToggle ?? '';
    const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!panel) return;
    const open = panel.hidden;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const chevron = toggle.querySelector('[data-po-chevron]');
    if (chevron) chevron.textContent = open ? '▾' : '▸';
    const url = new URL(window.location.href);
    const keys = new Set(url.searchParams.getAll('poRow'));
    if (open) keys.add(key);
    else keys.delete(key);
    url.searchParams.delete('poRow');
    for (const entry of keys) url.searchParams.append('poRow', entry);
    window.history.replaceState(window.history.state, '', url);
  });
</script>
