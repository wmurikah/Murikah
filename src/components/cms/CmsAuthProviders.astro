---
/** Identity-provider entry points shared by sign-in and customer registration. */
interface Props {
  purpose: 'SIGN_IN' | 'REGISTER';
  apple?: boolean;
}

const { purpose, apple = false } = Astro.props;
const providers = [
  { key: 'google', label: 'Google' },
  { key: 'microsoft', label: 'Microsoft' },
  ...(apple ? [{ key: 'apple', label: 'Apple' }] : []),
];
---

<div class="grid gap-2.5" aria-label="Single sign-on options">
  {
    providers.map((provider) => (
      <a
        href={`/api/auth/oidc/${provider.key}/start?purpose=${purpose}`}
        class="group flex min-h-11 w-full items-center justify-center gap-3 rounded-cms border border-cms-border bg-cms-surface px-4 text-cms-body-sm font-semibold text-cms-ink transition-[border-color,background-color,transform] duration-150 outline-none hover:border-cms-royal hover:bg-cms-royal-tint focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-cms-canvas active:translate-y-px"
      >
        <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center" aria-hidden="true">
          {provider.key === 'google' ? (
            <svg viewBox="0 0 18 18" class="h-5 w-5" role="presentation">
              <path
                fill="#4285F4"
                d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.797 2.716v2.258h2.909c1.702-1.567 2.684-3.874 2.684-6.614Z"
              />
              <path
                fill="#34A853"
                d="M9 18c2.43 0 4.468-.806 5.956-2.181l-2.909-2.258c-.806.54-1.835.859-3.047.859-2.344 0-4.328-1.585-5.037-3.714H.956v2.332A9 9 0 0 0 9 18Z"
              />
              <path
                fill="#FBBC05"
                d="M3.963 10.706A5.41 5.41 0 0 1 3.682 9c0-.592.102-1.168.281-1.706V4.962H.956A9 9 0 0 0 0 9c0 1.453.348 2.827.956 4.038l3.007-2.332Z"
              />
              <path
                fill="#EA4335"
                d="M9 3.58c1.321 0 2.507.454 3.44 1.345l2.581-2.581C13.464.892 11.426 0 9 0A9 9 0 0 0 .956 4.962l3.007 2.332C4.672 5.165 6.656 3.58 9 3.58Z"
              />
            </svg>
          ) : provider.key === 'microsoft' ? (
            <svg viewBox="0 0 20 20" class="h-5 w-5" role="presentation">
              <rect x="1" y="1" width="8" height="8" fill="#F25022" />
              <rect x="11" y="1" width="8" height="8" fill="#7FBA00" />
              <rect x="1" y="11" width="8" height="8" fill="#00A4EF" />
              <rect x="11" y="11" width="8" height="8" fill="#FFB900" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-black" role="presentation">
              <path d="M15.9 3.2c.9-1 1.4-2.2 1.3-3.2-1.2.1-2.6.8-3.5 1.8-.8.9-1.5 2.2-1.3 3.3 1.3.1 2.6-.7 3.5-1.9Zm4.9 13.2c-.5 1.1-1 2.1-1.8 3.3-1.1 1.6-2.6 3.6-4.5 3.6-1.7 0-2.1-1.1-4.4-1.1s-2.8 1.1-4.5 1.1c-1.9 0-3.4-1.8-4.5-3.4C-2 15.4-2.3 10.2-.4 7.1 1 4.9 3.1 3.6 5.1 3.6c2 0 3.3 1.1 4.9 1.1 1.6 0 2.6-1.1 4.9-1.1 1.8 0 3.6 1 4.9 2.6-4.3 2.4-3.6 8.6 1 10.2Z" transform="translate(2 1) scale(.82)" />
            </svg>
          )}
        </span>
        Sign in with {provider.label}
      </a>
    ))
  }
</div>
