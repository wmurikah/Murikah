---
import CmsChart from './CmsChart.astro';
import type { Chart } from '@/lib/cms/charts/svg';

interface Props {
  title: string;
  subtitle: string;
  definition: string;
  chart: Chart;
}

const { title, subtitle, definition, chart } = Astro.props;
---

<CmsChart
  title={title}
  subtitle={subtitle}
  definition={definition}
  chart={chart}
  unit="minutes"
  class="h-full"
/>
