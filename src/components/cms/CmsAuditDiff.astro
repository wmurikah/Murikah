---
/**
 * The field-level diff, rendered in business language.
 *
 * ONE RENDERER, USED EVERYWHERE. The comparison itself is computed by
 * `diffPayloads` in src/lib/cms/audit/diff.ts and nothing here recomputes it;
 * this component decides only how the rows look. A second diff implementation
 * is the defect the phase text warns about, and the way to avoid it is for
 * every surface that shows a change to render this component.
 *
 * RAW JSON IS NOT THE PRIMARY EXPERIENCE. It sits behind a Technical Details
 * disclosure, closed by default, and even there it is masked: the disclosure
 * must not be the one hole in the masking control.
 *
 * A masked field still appears as a row. Knowing that a password hash changed
 * is the audit fact a reviewer needs; the value is only useful to somebody
 * attacking the account, so the row says the field changed and refuses to say
 * to what.
 */
import CmsBadge from './CmsBadge.astro';
import type { DiffResult } from '@/lib/cms/audit/diff';

interface Props {
  diff: DiffResult;
  /** The masked technical payloads. Omitted where the caller has none. */
  beforeJson?: string | null;
  afterJson?: string | null;
  /** Hides the disclosure entirely, for a surface that should never offer it. */
  showTechnical?: boolean;
}
const { diff, beforeJson = null, afterJson = null, showTechnical = true } = Astro.props;

const TONE = {
  added: 'success',
  removed: 'danger',
  changed: 'info',
  unchanged: 'neutral',
} as const;
const KIND_LABEL = {
  added: 'Added',
  removed: 'Removed',
  changed: 'Changed',
  unchanged: 'Unchanged',
} as const;
---

{
  diff.parseError !== null ? (
    <p class="rounded-cms border border-cms-warning bg-cms-warning-tint px-3 py-2 text-cms-body-sm text-cms-warning">
      {diff.parseError} The event itself stands; only its field detail cannot be read.
    </p>
  ) : diff.empty ? (
    <p class="text-cms-body-sm text-cms-muted">
      This event recorded no field-level detail. That is not the same as nothing having changed:
      some events record the action without a before and after payload.
    </p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">What changed, field by field</caption>
        <thead>
          <tr class="border-b border-cms-line">
            <th scope="col" class="py-2 pr-3 text-cms-label font-semibold text-cms-muted">
              Field
            </th>
            <th scope="col" class="py-2 pr-3 text-cms-label font-semibold text-cms-muted">
              Change
            </th>
            <th scope="col" class="py-2 pr-3 text-cms-label font-semibold text-cms-muted">
              Before
            </th>
            <th scope="col" class="py-2 text-cms-label font-semibold text-cms-muted">
              After
            </th>
          </tr>
        </thead>
        <tbody>
          {diff.rows.map((row) => (
            <tr class="border-b border-cms-line align-top last:border-0">
              <th scope="row" class="py-2 pr-3 text-cms-body-sm font-medium text-cms-ink">
                {row.label}
                {row.masked && (
                  <span class="mt-0.5 block text-cms-caption font-normal text-cms-muted">
                    Value withheld: this field holds a credential.
                  </span>
                )}
              </th>
              <td class="py-2 pr-3">
                {/* A label and a tone, never a tone alone. */}
                <CmsBadge tone={TONE[row.kind]} label={KIND_LABEL[row.kind]} />
              </td>
              <td class="py-2 pr-3 text-cms-body-sm break-words text-cms-muted">{row.before}</td>
              <td class="py-2 text-cms-body-sm break-words text-cms-ink">{row.after}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  showTechnical && (beforeJson !== null || afterJson !== null) && (
    <details class="mt-4 rounded-cms border border-cms-line">
      <summary class="cursor-pointer px-3 py-2 text-cms-body-sm font-medium text-cms-ink outline-none focus-visible:ring-2 focus-visible:ring-focus">
        Technical details
      </summary>
      <div class="flex flex-col gap-3 border-t border-cms-line px-3 py-3">
        <p class="text-cms-caption text-cms-muted">
          The stored payloads, with every credential field replaced. Masking applies here too, so
          this disclosure is not a way round it.
        </p>
        {beforeJson !== null && (
          <div>
            <p class="text-cms-label font-semibold text-cms-muted">Before</p>
            <pre class="mt-1 overflow-x-auto rounded-cms bg-cms-canvas p-3 text-cms-caption text-cms-ink">
              {beforeJson}
            </pre>
          </div>
        )}
        {afterJson !== null && (
          <div>
            <p class="text-cms-label font-semibold text-cms-muted">After</p>
            <pre class="mt-1 overflow-x-auto rounded-cms bg-cms-canvas p-3 text-cms-caption text-cms-ink">
              {afterJson}
            </pre>
          </div>
        )}
      </div>
    </details>
  )
}
