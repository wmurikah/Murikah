---
/**
 * The one modal. A dialog built on the native <dialog> element.
 *
 * WHY A MODAL AND NOT A DRAWER, FOR A SHORT FORM. A drawer suits a long list
 * you scroll beside the page you came from. "Add a provider" and "Add a
 * connection" are short forms with a single outcome: a modal centres the task,
 * dims the context, and returns you exactly where you were. The drawer remains,
 * for navigation and for the long record forms that genuinely want the page
 * still visible beside them.
 *
 * THE SURFACE IS LIGHT AND IT IS NOT OPTIONAL. There is no `tone` prop and
 * there never will be. The design sweep's rule is that nothing in the content
 * area sits on a dark field, and a modal is content. `CmsDrawer` made the dark
 * tone its DEFAULT, so two screens that simply forgot a prop rendered
 * light-canvas form fields on navy and every label vanished. A component whose
 * default can produce an unreadable screen is the defect; removing the choice
 * is the fix.
 *
 * WHAT THE PLATFORM GIVES US, AND WHY THAT MATTERS. `showModal()` provides the
 * focus trap, the inert background, the top layer and Escape-to-close. Every
 * one of those is a thing hand-written modals get subtly wrong, so none of it
 * is written here. What the platform does NOT give us — focus return to the
 * opening control, a locked page behind, and a confirmation before discarding
 * an edited form — is added once in CmsOverlayScript, for every dialog in the
 * shell, rather than per modal.
 *
 * Opened by any element carrying data-cms-modal-open="<id>", so a trigger can
 * live anywhere on the page without this component knowing about it. The
 * handler is deliberately not in this file: Astro ships a component's script
 * only when the component is rendered, and a page with a drawer but no modal
 * would then have a trigger and nothing listening. It lives in
 * CmsOverlayScript, which CmsLayout renders once per page.
 */
import CmsIconButton from './CmsIconButton.astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  /**
   * Ask for a confirmation before the backdrop or Escape discards this dialog,
   * once any field inside it has been edited.
   *
   * Opt-in rather than automatic: a modal showing a record is not something a
   * stray click can destroy, and prompting on the way out of one teaches people
   * to dismiss the prompt that matters.
   */
  confirmOnDirty?: boolean;
  class?: string;
}
const { id, title, description, confirmOnDirty = false, class: className } = Astro.props;
const titleId = `${id}-title`;
const descId = description ? `${id}-desc` : undefined;
---

<dialog
  id={id}
  aria-labelledby={titleId}
  aria-describedby={descId}
  data-cms-confirm-dirty={confirmOnDirty ? 'true' : undefined}
  class:list={[
    /*
      CLOSED MUST MEAN INVISIBLE. The old unconditional `flex` utility overrode
      the browser's native dialog:not([open]) { display:none }, so every modal
      could render visibly on page load even though showModal() was never
      called. Keep it explicitly hidden until the native `open` attribute is
      present, then make it the flex column the layout needs.
    */
    'hidden [&[open]]:flex flex-col overflow-hidden',
    /*
      A FULL-SCREEN SHEET ON A PHONE, A CENTRED BOX FROM `sm` UP. A 32rem box
      squeezed into a 360px viewport is a form with no room to breathe and a
      keyboard covering half of it. The sheet is the same markup at a different
      width, so there is no second mobile implementation to drift.
    */
    'm-0 h-dvh max-h-none w-screen max-w-none rounded-none border-0 p-0',
    'sm:m-auto sm:h-auto sm:max-h-[calc(100dvh-4rem)] sm:w-[min(32rem,calc(100vw-2rem))]',
    'sm:rounded-cms-lg sm:border sm:border-cms-line',
    // THE SURFACE. Light, ink text, and the one elevation level the design
    // sweep reserved for something that genuinely floats.
    'bg-cms-surface text-cms-ink shadow-cms-overlay backdrop:bg-cms-navy/45',
    className,
  ]}
>
  <div class="flex shrink-0 items-start justify-between gap-4 border-b border-cms-line px-5 py-4">
    <div class="flex flex-col gap-1">
      <h2 id={titleId} class="text-cms-section font-semibold text-cms-navy">{title}</h2>
      {
        description && (
          <p id={descId} class="text-cms-body-sm text-cms-muted">
            {description}
          </p>
        )
      }
    </div>
    <CmsIconButton
      icon="close"
      label="Close dialogue"
      data-testid={`${id}-close`}
      data-cms-modal-close
      class="-mr-2"
    />
  </div>

  {/* THE ONLY SCROLLING REGION. */}
  <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4 text-cms-body-sm">
    <slot />
  </div>

  {
    /*
      ONE DOMINANT ACTION, WITH CANCEL SUBORDINATE. The order is cancel then
      confirm so the dominant action sits where the eye finishes, and the
      caller passes a filled button and a ghost one rather than two of equal
      weight. `flex-row-reverse` on a phone puts the dominant action under the
      thumb without changing the DOM order a screen reader follows.
    */
  }
  <div
    class="flex shrink-0 flex-row-reverse justify-start gap-2 border-t border-cms-line px-5 py-4 sm:flex-row sm:justify-end"
  >
    <slot name="actions" />
  </div>
</dialog>
