---
/**
 * A loading placeholder shaped like the content it stands in for, so the page
 * does not reflow when the real thing arrives.
 *
 * The pulse comes from Tailwind's animate-pulse, which global.css already
 * clamps to 0.01ms under prefers-reduced-motion, so the shape still shows and
 * the movement stops. The whole block is aria-hidden and the region that owns
 * it announces "Loading" once, rather than every bar announcing itself.
 */
interface Props {
  variant?: 'text' | 'title' | 'block' | 'circle';
  width?: string;
  class?: string;
}
const { variant = 'text', width, class: className } = Astro.props;
const shapes = {
  text: 'h-3.5 rounded',
  title: 'h-5 rounded',
  block: 'h-24 rounded-cms',
  circle: 'h-9 w-9 rounded-full',
};
---

<span
  aria-hidden="true"
  class:list={['block animate-pulse bg-cms-line', shapes[variant], className]}
  style={width ? `width:${width}` : undefined}></span>
