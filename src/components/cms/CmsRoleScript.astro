---
/**
 * The behaviour behind the role drawer. A component, so it ships only where the
 * drawer ships.
 */
---

<script>
  const drawer = document.getElementById('cms-role-drawer') as HTMLDialogElement | null;
  const form = document.getElementById('cms-role-form') as HTMLFormElement | null;
  const heading = document.getElementById('cms-role-drawer-title');
  const errorBox = document.getElementById('cms-role-error');
  const systemNote = document.getElementById('cms-role-system');
  const consequence = document.getElementById('cms-role-consequence');
  const save = document.getElementById('cms-role-save') as HTMLButtonElement | null;

  if (drawer && form && save) {
    let editingId: string | null = null;
    let wasActive = true;

    const clear = () => {
      form.querySelectorAll<HTMLElement>('[data-field-error]').forEach((n) => {
        n.textContent = '';
        n.classList.add('hidden');
      });
      form
        .querySelectorAll('[aria-invalid="true"]')
        .forEach((n) => n.setAttribute('aria-invalid', 'false'));
      if (errorBox) {
        errorBox.hidden = true;
        errorBox.textContent = '';
      }
    };

    const paint = (fields: { field: string; message: string }[]) => {
      for (const item of fields) {
        const field = form.elements.namedItem(item.field);
        if (!(field instanceof HTMLElement) || !field.id) continue;
        field.setAttribute('aria-invalid', 'true');
        const message = document.getElementById(`${field.id}-error`);
        if (message) {
          message.textContent = item.message;
          message.classList.remove('hidden');
        }
      }
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
    };

    const open = (
      id: string | null,
      values: Record<string, unknown>,
      note: string,
      isSystem: boolean,
    ) => {
      editingId = id;
      wasActive = values.active !== false;
      clear();
      form.reset();
      for (const [name, value] of Object.entries(values)) {
        const field = form.elements.namedItem(name);
        if (field instanceof HTMLInputElement) {
          if (field.type === 'checkbox') field.checked = value === true;
          else field.value = String(value ?? '');
        }
      }
      const active = form.elements.namedItem('active');
      if (active instanceof HTMLInputElement && !('active' in values)) active.checked = true;
      if (heading) heading.textContent = id ? 'Edit role' : 'New role';
      if (systemNote) systemNote.hidden = !isSystem;
      if (consequence) {
        consequence.hidden = note === '';
        consequence.textContent = note;
      }
      drawer.showModal();
      form.querySelector<HTMLElement>('input')?.focus();
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-cms-role-create]')) {
        open(null, {}, '', false);
        return;
      }
      const edit = target?.closest<HTMLElement>('[data-cms-role-edit]');
      if (edit) {
        let values: Record<string, unknown> = {};
        try {
          values = JSON.parse(edit.dataset.values ?? '{}');
        } catch {
          values = {};
        }
        open(
          edit.dataset.cmsRoleEdit ?? null,
          values,
          edit.dataset.consequence ?? '',
          edit.dataset.system === '1',
        );
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const nowActive = data.get('active') !== null;

      // A strong confirmation before a change that removes privilege. The
      // server refuses the one that cannot be undone; this catches the ones
      // that merely hurt.
      if (editingId && wasActive && !nowActive) {
        const note = consequence?.textContent ?? '';
        if (
          !window.confirm(
            `Deactivate this role?\n\n${note}\n\nThis takes effect on each holder's next request.`,
          )
        ) {
          return;
        }
      }

      clear();
      save.disabled = true;
      const body: Record<string, unknown> = {};
      for (const [name, value] of data.entries()) body[name] = value;
      body.active = nowActive;

      const url = editingId
        ? `/api/admin/roles/${encodeURIComponent(editingId)}`
        : '/api/admin/roles';
      try {
        const response = await fetch(url, {
          method: editingId ? 'PATCH' : 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body),
        });
        if (response.ok) {
          window.location.reload();
          return;
        }
        const payload = (await response.json().catch(() => null)) as {
          error?: { message?: string; fields?: { field: string; message: string }[] };
        } | null;
        if (payload?.error?.fields?.length) paint(payload.error.fields);
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.textContent =
            payload?.error?.message ?? 'That could not be saved. Please try again.';
        }
      } catch {
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.textContent = 'There was a problem reaching the server. Check your connection.';
        }
      } finally {
        save.disabled = false;
      }
    });
  }
</script>
