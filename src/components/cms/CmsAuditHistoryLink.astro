---
/**
 * The View Audit History action, on every record that has one.
 *
 * ONE COMPONENT, TEN CALLERS. Customer, contact, lead, opportunity, case,
 * sales order, purchase order, user, role, workflow and SLA rule all show the
 * same action in the same place, and it goes to the same workspace with the
 * entity pre-filtered.
 *
 * IT RENDERS NOTHING FOR SOMEBODY WITHOUT THE AUDIT PERMISSION. That is
 * presentation and not access control: the workspace checks the permission
 * for itself and the scope predicate runs there whether or not this component
 * ever rendered a link.
 *
 * There is no inline audit panel on the record. The trail is an
 * investigation, not a sidebar: it needs the filters, the paging and the
 * detail view, and a truncated copy of it beside a customer would show the
 * last five events and quietly imply there were only five.
 */
import { canViewAudit } from '@/lib/cms/permissions';
import CmsDropdown from './CmsDropdown.astro';

interface Props {
  /** The `audit_events.entity_type` value this record is written under. */
  entityType: string;
  entityId: string;
  label?: string;
  class?: string;
}
const { entityType, entityId, label = 'View audit history', class: className } = Astro.props;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const visible = canViewAudit(permissions);
// The entity id goes into the search box, which matches `entity_id` exactly,
// so this is a filter and not a free-text guess.
const href = `/app/administration/audit?entityType=${encodeURIComponent(entityType)}&q=${encodeURIComponent(entityId)}`;
---

{
  visible && (
    <CmsDropdown
      id={`audit-${entityType}-${entityId}`}
      label="More record actions"
      class={className}
    >
      <span slot="trigger" class="text-cms-body-sm font-medium text-cms-muted">
        More
      </span>
      <a
        href={href}
        class="block rounded-cms px-3 py-2 text-cms-body-sm text-cms-ink outline-none hover:bg-cms-sunken focus-visible:ring-2 focus-visible:ring-focus"
      >
        {label}
      </a>
    </CmsDropdown>
  )
}
