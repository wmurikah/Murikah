---
/**
 * Document shell for the Engineering Rhythm product (engr.murikah.com). Reuses
 * the marketing design tokens (via global.css) and the self-hosted Inter, with
 * product rules in engr.css. Semantic landmarks and a skip link throughout for
 * assistive tech. The product is marked noindex; it is an authenticated app.
 *
 * The top bar shows the primary nav and the sign-out control only when a
 * session is present (locals.engr), so the login screen stays clean.
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/engr.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title}, Engineering Rhythm`;
const engr = Astro.locals.engr;
// The visitor-facing root-relative path, set by the middleware before it
// rewrites to the internal /engr route. Astro.url shows the rewritten path, so
// the active-nav check must read this. Falls back to the URL off the subdomain.
const path = Astro.locals.engrPath ?? Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');

// Money-layer nav. Approvers land on the approvals queue; a contractor lands on
// their own list. Payments is the financial controller's.
const has = (key: string) => engr?.perms.includes(key) ?? false;
const canApproveCost = has('cost.approve.l1') || has('cost.approve.l2');
const canApproveBill = has('bill.approve.l1') || has('bill.approve.l2') || has('bill.approve.l3');
const costsHref = canApproveCost
  ? '/costs/approvals'
  : has('cost.create')
    ? '/contractor/costs'
    : null;
const billsHref = canApproveBill
  ? '/bills/approvals'
  : has('bill.create')
    ? '/contractor/bills'
    : null;
const showPayments = has('payment.record');
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>
  <body class="engr">
    <a href="#engr-main" class="engr-skip">Skip to content</a>
    <header class="engr-topbar">
      <div class="engr-topbar__inner">
        <a href="/" class="engr-brand" aria-label="Engineering Rhythm, home">
          <span class="engr-brand__mark" aria-hidden="true">ER</span>
          <span class="engr-brand__name">Engineering Rhythm</span>
        </a>

        {
          engr && (
            <nav class="engr-nav" aria-label="Primary">
              <a href="/" aria-current={path === '/' ? 'page' : undefined}>
                Dashboard
              </a>
              <a href="/requests" aria-current={isActive('/requests') ? 'page' : undefined}>
                Requests
              </a>
              <a href="/workorders" aria-current={isActive('/workorders') ? 'page' : undefined}>
                Work orders
              </a>
              {engr.perms.includes('rfq.view') && (
                <a href="/rfqs" aria-current={isActive('/rfqs') ? 'page' : undefined}>
                  RFQs
                </a>
              )}
              {engr.perms.includes('pm.allocate') && (
                <a href="/pm" aria-current={isActive('/pm') ? 'page' : undefined}>
                  Maintenance
                </a>
              )}
              {engr.perms.includes('workorder.create') && (
                <a href="/lpos" aria-current={isActive('/lpos') ? 'page' : undefined}>
                  LPOs
                </a>
              )}
              {costsHref && (
                <a
                  href={costsHref}
                  aria-current={
                    isActive('/costs') || isActive('/contractor/costs') ? 'page' : undefined
                  }
                >
                  Costs
                </a>
              )}
              {billsHref && (
                <a
                  href={billsHref}
                  aria-current={
                    isActive('/bills') || isActive('/contractor/bills') ? 'page' : undefined
                  }
                >
                  Bills
                </a>
              )}
              {showPayments && (
                <a href="/payments" aria-current={isActive('/payments') ? 'page' : undefined}>
                  Payments
                </a>
              )}
              <a
                href="/notifications"
                aria-current={isActive('/notifications') ? 'page' : undefined}
              >
                Notifications
              </a>
            </nav>
          )
        }

        {
          engr && (
            <form method="post" action="/api/auth/logout" class="engr-account">
              <span class="engr-account__org" title="Organisation">
                {engr.orgSlug}
              </span>
              <button type="submit" class="engr-btn engr-btn--ghost">
                Sign out
              </button>
            </form>
          )
        }
      </div>
    </header>

    <main id="engr-main" class="engr-main">
      <slot />
    </main>
  </body>
</html>
