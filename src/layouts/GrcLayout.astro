---
/**
 * The authenticated GRC shell: a persistent left sidebar of grouped destinations
 * beside the content, in the Murikah house style. The sidebar carries the brand,
 * the acting organisation label, a platform-owner instance switcher (only for a
 * platform owner, who is the only user with more than one instance to be in),
 * the grouped navigation with icons and collapsible groups, and the account and
 * sign-out at the foot. The active item and its group are marked from the
 * visitor-facing path the middleware captured. The Murikah mark is on the tab.
 * Modules render their pages into the slot.
 *
 * The organisation line tells the two kinds of user apart (Build Prompt 38). An
 * instance admin is pinned, so it always names their organisation. A platform
 * owner is pinned to nothing, so it reads "All organisations" until they enter
 * an instance, and that instance's name once they have.
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/grc.css';
import GrcIcon from '@/components/grc/GrcIcon.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { getSidebarCounts, type SidebarCounts } from '@grc/repos/dashboard';
import { buildNav, type CountKey, type NavGroupDef, type NavItemDef } from '@grc/dashboard/roleNav';
import { aiEnabled } from '@grc/ai/gate';

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title} - Assurance OS`;

const grc = Astro.locals.grc;
const path = Astro.locals.grcPath ?? '/';

// True only for a platform owner who has entered no instance: there is no acting
// organisation, so nothing organisation-scoped renders in the shell.
const inInstance = grc?.instanceSelected !== false;

// The navigation is filtered to the signed-in role and permissions.
const groups = buildNav({
  roleCode: grc?.roleCode ?? '',
  perms: grc?.perms ?? [],
  isPlatformOwner: grc?.isPlatformOwner ?? false,
  hasAi: grc ? aiEnabled((f) => grc.hasFeature(f)) : false,
  instanceSelected: inInstance,
});

// Sidebar badge counts, server-rendered on every navigation and refreshed by a
// light client poll. Best-effort: a count failure never breaks the app shell.
// They count an organisation's queues, so with no instance selected there is
// nothing to count and no query is made.
let counts: SidebarCounts | null = null;
if (grc && inInstance) {
  try {
    const db = await getDb(getGrcEnv());
    counts = await getSidebarCounts(
      db,
      grc.organizationId,
      grc.userId,
      grc.affiliateScope,
      grc.isPlatformOwner || grc.perms.includes('WORK_PAPERS.review'),
    );
  } catch (err) {
    console.error('[grc.layout] sidebar counts failed', err);
    counts = null;
  }
}
const countFor = (key: CountKey | undefined): number => (key && counts ? counts[key] : 0);

// Nested items can share a prefix (Settings at /settings, Users at
// /settings/users), so the longest matching href wins and only one item is
// marked current.
const matches = (href: string): boolean =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
const allHrefs = groups.flatMap((g: NavGroupDef) => g.items.map((i: NavItemDef) => i.href));
const isActive = (href: string): boolean =>
  matches(href) && !allHrefs.some((h) => h !== href && h.length > href.length && matches(h));
const groupActive = (g: NavGroupDef): boolean => g.items.some((i: NavItemDef) => isActive(i.href));

const orgName = grc?.organizationName ?? 'Organisation';
// The super-label distinguishes "you are above the customers" from "you are
// inside one", which is real information for a platform owner and none at all
// for anybody else: an instance admin belongs to exactly one organisation,
// cannot switch, and has no second context to tell it apart from. So they see
// the name alone, and the line costs them nothing (audit observation AC-08).
const orgLabel = grc?.isPlatformOwner === true ? (inInstance ? 'Organisation' : 'Platform') : null;
const userName = grc?.userName ?? grc?.userEmail ?? 'Signed in';
// The switcher belongs to the platform owner alone, and stays available inside
// an instance so they can move straight to another one. An instance admin never
// has it: there is nowhere for them to switch to.
const showSwitcher = grc?.isPlatformOwner === true && (grc?.switchable.length ?? 0) > 0;
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Apply the remembered sidebar preference before first paint, so a
      // pinned sidebar never flashes folded (Build Prompt 31).
      try {
        if (localStorage.getItem('grc.sidebar') === 'pinned') {
          document.documentElement.classList.add('grc-pin');
        }
      } catch {
        /* storage unavailable: the folded default stands */
      }
    </script>
  </head>
  <body class="grc">
    <a href="#grc-main" class="grc-skip">Skip to content</a>

    <header class="grc-topbar">
      <button
        type="button"
        class="grc-topbar__menu"
        id="grc-menu"
        aria-expanded="false"
        aria-controls="grc-sidebar"
        aria-label="Open the navigation"
      >
        <GrcIcon name="menu" size={20} />
      </button>
      <a href="/" class="grc-topbar__brand">
        <span class="grc-brand__badge" aria-hidden="true">M</span>
        <span>Assurance OS</span>
      </a>
    </header>

    <div class="grc-shell">
      <nav class="grc-sidebar" id="grc-sidebar" aria-label="Primary">
        <div class="grc-sidebar__head">
          <a href="/" class="grc-brand">
            <span class="grc-brand__badge" aria-hidden="true">M</span>
            <span>
              <span class="grc-brand__name">Assurance OS</span>
              <span class="grc-brand__sub">Internal audit</span>
            </span>
          </a>
          <button
            type="button"
            class="grc-pinbtn"
            id="grc-pin"
            aria-pressed="false"
            aria-label="Keep the sidebar open"
          >
            <GrcIcon name="pin" size={15} />
          </button>
          <button
            type="button"
            class="grc-railbtn"
            id="grc-rail-expand"
            aria-expanded="false"
            aria-controls="grc-sidebar"
            aria-label="Expand the sidebar"
          >
            <GrcIcon name="chevron" size={14} />
          </button>
        </div>

        <div class="grc-orgline">
          {orgLabel && <p class="grc-orgline__label">{orgLabel}</p>}
          <p class="grc-orgline__name">{orgName}</p>
        </div>

        {
          /* There is no Notifications item in the sidebar (Build Prompt 67).
            Build Prompt 60 took away the destination and left the bell; the
            bell was the same thing wearing a different shape, a second place
            to look that repeated what the modules were already saying. What is
            waiting for somebody is counted on the module it is waiting in, in
            red, next to the label they would click anyway. Two of the three
            queries this shell used to make on every navigation went with it. */
        }

        {
          showSwitcher && (
            <div class="grc-switcher">
              <form method="post" action="/api/org/switch" class="grc-switcher__form">
                <label class="grc-vh" for="grc-switch">
                  {inInstance ? 'Switch to another organisation' : 'Enter an organisation'}
                </label>
                <div class="grc-switcher__row">
                  <select id="grc-switch" name="organization_id" class="grc-switcher__select">
                    {!inInstance && (
                      <option value="" selected>
                        Select an organisation
                      </option>
                    )}
                    {grc!.switchable.map((o) => (
                      <option value={o.id} selected={inInstance && o.id === grc!.organizationId}>
                        {o.name}
                      </option>
                    ))}
                  </select>
                  <button type="submit" class="grc-switcher__go">
                    Go
                  </button>
                </div>
              </form>
              {inInstance ? (
                <form method="post" action="/api/org/leave" class="grc-switcher__form">
                  <button type="submit" class="grc-switcher__leave">
                    Leave this organisation
                  </button>
                </form>
              ) : (
                <a href="/platform" class="grc-switcher__leave">
                  See all organisations
                </a>
              )}
            </div>
          )
        }

        <div class="grc-nav">
          {
            groups.map((group) => (
              <details class="grc-navgroup" open={groupActive(group) || undefined}>
                <summary class="grc-navgroup__summary" data-tip={group.label}>
                  <GrcIcon name={group.icon} size={15} />
                  <span class="grc-navgroup__label">{group.label}</span>
                  <span class="grc-navgroup__chevron" aria-hidden="true" />
                </summary>
                <ul class="grc-navgroup__list">
                  {group.items.map((item) => (
                    <li>
                      <a
                        class="grc-navlink"
                        href={item.href}
                        data-tip={item.label}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                      >
                        <GrcIcon name={item.icon} size={16} class="grc-navlink__icon" />
                        {/*
                          The count rides the label as a superscript bubble
                          rather than sitting off at the far edge of the rail
                          (Build Prompt 62): it belongs to the word it counts,
                          the way a footnote marker does, and at the edge it read
                          as a column of unrelated numbers. `sup` is the element
                          that means this, so a screen reader and a stylesheet
                          agree about what it is; the label beside it says what
                          the number counts, since a bare digit announces nothing.
                        */}
                        <span class="grc-navlink__label">
                          <span>{item.label}</span>
                          {item.countKey && (
                            <sup
                              class="grc-navcount"
                              data-count-key={item.countKey}
                              hidden={countFor(item.countKey) === 0}
                            >
                              <span class="grc-vh">, </span>
                              {countFor(item.countKey)}
                              <span class="grc-vh"> pending</span>
                            </sup>
                          )}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>

        <div class="grc-account">
          <div class="grc-account__id">
            <GrcIcon name="account" size={18} />
            <span style="min-width:0">
              <span class="grc-account__name">{userName}</span>
              <span class="grc-account__meta">
                {grc?.roleCode ?? ''}
                {grc?.isPlatformOwner ? ' - platform owner' : ''}
              </span>
            </span>
          </div>
          {
            /*
            The account actions are options, not buttons (Build Prompt 60). They
            were bordered pills of their own width, so the footer sat out of line
            with the icon column above it and read as three controls bolted on
            rather than the end of the same list. They are now the same list, the
            same icon column and the same hover as the navigation; sign out stays
            a real button inside its form, because it posts, and only looks like
            its neighbours.
          */
          }
          <ul class="grc-account__list">
            <li>
              <a href="/mfa/setup" class="grc-navlink" data-tip="Account security">
                <GrcIcon name="roles" size={16} class="grc-navlink__icon" />
                <span>Account security</span>
              </a>
            </li>
            <li>
              <a href="/change-password" class="grc-navlink" data-tip="Change password">
                <GrcIcon name="key" size={16} class="grc-navlink__icon" />
                <span>Change password</span>
              </a>
            </li>
            <li>
              <form method="post" action="/api/auth/logout">
                <button type="submit" class="grc-navlink grc-navlink--action" data-tip="Sign out">
                  <GrcIcon name="signout" size={16} class="grc-navlink__icon" />
                  <span>Sign out</span>
                </button>
              </form>
            </li>
          </ul>
        </div>
      </nav>

      <div class="grc-scrim" id="grc-scrim"></div>

      <main id="grc-main" class="grc-main">
        <slot />
      </main>
    </div>

    <script>
      // Refresh the sidebar badge counts on a light interval and when the tab
      // regains focus, so the queues stay current between navigations. The
      // server-renders the counts on every navigation; this only tops them up.
      const applyCounts = (counts: Record<string, number>): void => {
        document.querySelectorAll<HTMLElement>('[data-count-key]').forEach((el) => {
          const key = el.getAttribute('data-count-key');
          const n = key && typeof counts[key] === 'number' ? counts[key] : 0;
          el.textContent = String(n);
          el.hidden = n === 0;
        });
      };
      const refresh = async (): Promise<void> => {
        try {
          const res = await fetch('/api/sidebar-counts', {
            headers: { accept: 'application/json' },
          });
          if (res.ok) applyCounts(await res.json());
        } catch {
          // best-effort; the server-rendered counts stand
        }
      };
      setInterval(refresh, 60000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') void refresh();
      });

      // ---- Auto-collapsing sidebar (Build Prompt 31) ----------------------
      // Unpinned and wide, the sidebar is a folded icon rail that expands as
      // an overlay: on hover after a short intent delay (so a passing pointer
      // never flickers it), on keyboard focus immediately, or from the rail's
      // chevron (the touch fallback on wide screens). Pinning locks it open,
      // remembered in localStorage and applied before paint by the head
      // script. Narrow screens use the top bar's tap-to-open drawer instead.
      const root = document.documentElement;
      const sidebar = document.getElementById('grc-sidebar');
      const pinBtn = document.getElementById('grc-pin');
      const railBtn = document.getElementById('grc-rail-expand');
      const menuBtn = document.getElementById('grc-menu');
      const scrim = document.getElementById('grc-scrim');
      const narrow = window.matchMedia('(max-width: 60rem)');
      const hoverable = window.matchMedia('(hover: hover)');
      const OPEN_DELAY = 150;
      const CLOSE_DELAY = 300;

      if (sidebar && pinBtn && railBtn && menuBtn && scrim) {
        let openTimer = 0;
        let closeTimer = 0;
        const pinned = (): boolean => root.classList.contains('grc-pin');
        const isOpen = (): boolean => sidebar.classList.contains('is-open');

        // On the folded rail the labels are invisible, so mirror each item's
        // label into a title tooltip; drop the titles as soon as labels show.
        const syncTips = (): void => {
          const railNow = !pinned() && !isOpen() && !narrow.matches;
          sidebar.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
            if (railNow) el.setAttribute('title', el.getAttribute('data-tip') ?? '');
            else el.removeAttribute('title');
          });
        };

        const setOpen = (open: boolean): void => {
          window.clearTimeout(openTimer);
          window.clearTimeout(closeTimer);
          sidebar.classList.toggle('is-open', open);
          railBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          syncTips();
        };

        // Hover intent, pointer devices only: touch taps navigate directly.
        sidebar.addEventListener('pointerenter', () => {
          if (!hoverable.matches || pinned() || narrow.matches) return;
          window.clearTimeout(closeTimer);
          openTimer = window.setTimeout(() => setOpen(true), OPEN_DELAY);
        });
        sidebar.addEventListener('pointerleave', () => {
          if (!hoverable.matches || pinned() || narrow.matches) return;
          window.clearTimeout(openTimer);
          closeTimer = window.setTimeout(() => setOpen(false), CLOSE_DELAY);
        });

        // Keyboard reach: focusing anything in the sidebar expands it.
        sidebar.addEventListener('focusin', () => {
          if (!pinned() && !narrow.matches) setOpen(true);
        });
        sidebar.addEventListener('focusout', (e) => {
          const next = e.relatedTarget;
          if (next instanceof Node && sidebar.contains(next)) return;
          if (!pinned() && !narrow.matches) setOpen(false);
        });

        // The rail chevron: the visible affordance, and the wide-screen touch
        // fallback. Clicking it holds the sidebar open until dismissed.
        railBtn.addEventListener('click', () => setOpen(!isOpen()));
        document.addEventListener('pointerdown', (e) => {
          if (narrow.matches || pinned() || !isOpen()) return;
          if (e.target instanceof Node && !sidebar.contains(e.target)) setOpen(false);
        });

        // Pin: lock open (in flow, the content makes room) or let it fold.
        const paintPin = (): void => {
          pinBtn.setAttribute('aria-pressed', pinned() ? 'true' : 'false');
          pinBtn.setAttribute(
            'aria-label',
            pinned() ? 'Let the sidebar fold away' : 'Keep the sidebar open',
          );
        };
        pinBtn.addEventListener('click', () => {
          const next = !pinned();
          root.classList.toggle('grc-pin', next);
          try {
            localStorage.setItem('grc.sidebar', next ? 'pinned' : 'folded');
          } catch {
            /* storage unavailable: the choice lasts this page only */
          }
          if (next) sidebar.classList.remove('is-open');
          else setOpen(true); // still under the pointer or focus: no jarring snap
          paintPin();
          syncTips();
        });

        // Narrow screens: the top bar's tap-to-open drawer with a scrim.
        const setDrawer = (open: boolean): void => {
          root.classList.toggle('grc-drawer-open', open);
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          menuBtn.setAttribute('aria-label', open ? 'Close the navigation' : 'Open the navigation');
          if (!open) menuBtn.focus({ preventScroll: true });
        };
        menuBtn.addEventListener('click', () => {
          setDrawer(!root.classList.contains('grc-drawer-open'));
        });
        scrim.addEventListener('click', () => setDrawer(false));
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          if (root.classList.contains('grc-drawer-open')) setDrawer(false);
          else if (!pinned() && isOpen() && !narrow.matches) setOpen(false);
        });
        narrow.addEventListener('change', () => {
          setOpen(false);
          root.classList.remove('grc-drawer-open');
          menuBtn.setAttribute('aria-expanded', 'false');
          syncTips();
        });

        paintPin();
        syncTips();
      }
    </script>
  </body>
</html>
