---
/**
 * The Hass CMS customer portal shell: a slim branded top bar and a centred main
 * column, for the external customer surface. The brand comes from the acting
 * tenant's brand (locals.cms.branding), else the Murikah default. Customers only:
 * the middleware keeps staff out of the portal, and scopes a customer to their
 * own records.
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/cms.css';
import { DEFAULT_BRANDING } from '@cms/repos/branding';

interface Props {
  title: string;
}
const { title } = Astro.props;
const cms = Astro.locals.cms;
const brand = cms?.branding ?? DEFAULT_BRANDING;
const pageTitle = `${title} - ${brand.appName}`;
const brandVars = `--cms-brand-primary:${brand.primaryColor};--cms-brand-secondary:${brand.secondaryColor};--cms-brand-accent:${brand.accentColor};`;
const initial = brand.appName.trim().charAt(0).toUpperCase() || 'H';
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="cms" style={brandVars}>
    <a href="#cms-main" class="cms-skip">Skip to content</a>
    <header
      class="cms-side__brand"
      style="background:var(--cms-brand-primary);color:var(--cms-on-navy);padding:0.75rem 1.25rem;display:flex;justify-content:space-between;align-items:center"
    >
      <span class="cms-side__brand">
        <span class="cms-authbrand__badge" aria-hidden="true">{initial}</span>
        <span>{brand.appName}</span>
      </span>
      <form method="post" action="/api/auth/logout">
        <button type="submit" class="cms-signout">Sign out</button>
      </form>
    </header>
    <main id="cms-main" class="cms-main" style="margin:0 auto">
      <slot />
    </main>
  </body>
</html>
