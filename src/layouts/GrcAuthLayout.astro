---
/**
 * The GRC platform front door. A full-viewport two-pane split: a navy brand
 * panel beside a paper form pane, mirroring Engineering Rhythm so the two read
 * as one family. Below 1024px it stacks, the brand above the form. A
 * single-signal guard disables the submit control on first click so repeated
 * clicks send one request. Navy, gold and paper only; the Murikah mark is on the
 * tab.
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/grc.css';

interface Props {
  title: string;
  brandHeadline?: string;
  brandSub?: string;
}
const {
  title,
  brandHeadline = 'Run assurance with discipline',
  brandSub = 'Internal audit, GRC and board reporting in one disciplined workflow.',
} = Astro.props;
const pageTitle = `${title} - Assurance OS`;
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="grc grc-authbody">
    <a href="#grc-auth-main" class="grc-skip">Skip to content</a>
    <div class="grc-authsplit">
      <aside class="grc-authbrand">
        <div class="grc-authbrand__inner">
          <a href="/" class="grc-authbrand__mark">
            <span class="grc-authbrand__markbadge" aria-hidden="true">M</span>
            <span class="grc-authbrand__markname">Assurance OS</span>
          </a>
          <div>
            <h2 class="grc-authbrand__headline">{brandHeadline}</h2>
            <p class="grc-authbrand__sub">{brandSub}</p>
          </div>
          <div class="grc-authbrand__foot">
            <p class="grc-authbrand__product">Risk Intelligence &amp; Analytics</p>
            <p class="grc-authbrand__trust">
              Governance, risk and compliance, built for audit teams.
            </p>
          </div>
        </div>
      </aside>

      <main id="grc-auth-main" class="grc-authpane">
        <div class="grc-authcard">
          <slot />
        </div>
      </main>
    </div>

    <script>
      // Single-signal guard: on the first real submit, disable the submit button
      // so repeated clicks send one request. Deferred so the button's name and
      // value are still serialised. Native required validation blocks empty
      // submits before this runs, so the button never sticks on a blocked form.
      document.addEventListener(
        'submit',
        (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement)) return;
          if (form.dataset.grcSubmitted === '1') {
            e.preventDefault();
            return;
          }
          form.dataset.grcSubmitted = '1';
          const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (btn) {
            setTimeout(() => {
              btn.setAttribute('aria-busy', 'true');
              btn.setAttribute('disabled', '');
            }, 0);
          }
        },
        true,
      );
    </script>
  </body>
</html>
