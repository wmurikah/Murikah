---
/**
 * The Hass CMS staff shell: a branded sidebar and a main column. The sidebar
 * shows only what is built (placeholder-free), grouped; the modules arrive one
 * per prompt behind the smoke test. The brand colours and name come from the
 * acting tenant's brand (locals.cms.branding), else the Murikah default. Staff
 * only: the middleware keeps customers on the portal.
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/cms.css';
import { DEFAULT_BRANDING } from '@cms/repos/branding';

interface Props {
  title: string;
}
const { title } = Astro.props;
const cms = Astro.locals.cms;
const brand = cms?.branding ?? DEFAULT_BRANDING;
const pageTitle = `${title} - ${brand.appName}`;
const brandVars = `--cms-brand-primary:${brand.primaryColor};--cms-brand-secondary:${brand.secondaryColor};--cms-brand-accent:${brand.accentColor};`;
const initial = brand.appName.trim().charAt(0).toUpperCase() || 'H';
const path = Astro.locals.cmsPath ?? '/';
const nav = [
  { label: 'Dashboard', href: '/' },
  { label: 'Customers', href: '/customers' },
  { label: 'Analytics', href: '/analytics' },
];
const roleLabel = (cms?.role ?? '').replace(/_/g, ' ');
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="cms" style={brandVars}>
    <a href="#cms-main" class="cms-skip">Skip to content</a>
    <div class="cms-shell">
      <nav class="cms-side" aria-label="Main">
        <div class="cms-side__brand">
          <span class="cms-authbrand__badge" aria-hidden="true">{initial}</span>
          <span>{brand.appName}</span>
        </div>
        <ul class="cms-nav">
          <li class="cms-nav__group">Overview</li>
          {
            nav.map((item) => (
              <li>
                <a
                  class="cms-navlink"
                  href={item.href}
                  aria-current={path === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="cms-account">
          <div>
            <div class="cms-account__name">{cms?.userName ?? 'Signed in'}</div>
            <div class="cms-account__meta">
              {roleLabel}
              {cms?.isPlatformOwner ? ' - platform owner' : ''}
            </div>
          </div>
          <form method="post" action="/api/auth/logout">
            <button type="submit" class="cms-signout">Sign out</button>
          </form>
        </div>
      </nav>

      <main id="cms-main" class="cms-main">
        <slot />
      </main>
    </div>
  </body>
</html>
