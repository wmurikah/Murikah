---
export const prerender = false;

/** Engineer work-order list: all org work orders, filterable by status. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import WorkOrderList from '@/components/engr/WorkOrderList.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listForEngineer, type WorkOrderListRow } from '@engr/repos/workOrders';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'workorder.view');
const status = Astro.url.searchParams.get('status') ?? undefined;
const station = Astro.url.searchParams.get('station') ?? undefined;
const filtered = Boolean(status || station);
const statusLabel = status
  ? status.charAt(0).toUpperCase() + status.slice(1).toLowerCase().replace(/_/g, ' ')
  : null;

let rows: WorkOrderListRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv());
  rows = await listForEngineer(db, engr.orgId, status, station);
}
---

<EngrLayout title="Work orders">
  <div class="engr-page-head">
    <div>
      <h1>Work orders</h1>
      <p class="engr-lead">All work orders across your organisation.</p>
    </div>
  </div>

  {
    filtered && (
      <p class="engr-filterbar">
        <span>
          Filtered{statusLabel ? ` to ${statusLabel}` : ''}
          {station ? ' at one station' : ''}
        </span>
        <a href="/workorders">Clear filter</a>
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to work orders.
      </p>
    ) : (
      <WorkOrderList
        rows={rows}
        basePath="/workorders"
        emptyText="No work orders match this filter."
      />
    )
  }
</EngrLayout>
