---
export const prerender = false;

/**
 * PM calendar: upcoming occurrences by due date, with their status and the
 * one-month and two-week reminder flags. Gate: pm.allocate.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listUpcomingOccurrences, type OccurrenceListRow } from '@engr/repos/pm';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'pm.allocate');

// An optional week window, drilled from the "Upcoming maintenance" chart: from
// inclusive, to exclusive, both YYYY-MM-DD against the due date.
const isDate = (v: string | null): v is string => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const fromRaw = Astro.url.searchParams.get('from');
const toRaw = Astro.url.searchParams.get('to');
const from = isDate(fromRaw) ? fromRaw : undefined;
const to = isDate(toRaw) ? toRaw : undefined;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const periodLabel = from
  ? `${Number(from.slice(8, 10))} ${MONTHS[Number(from.slice(5, 7)) - 1]}`
  : null;

let rows: OccurrenceListRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv());
  rows = await listUpcomingOccurrences(db, engr.orgId, { from, to });
}
---

<EngrLayout title="PM calendar">
  <div class="engr-page-head">
    <div>
      <h1>PM calendar</h1>
      <p class="engr-lead">Upcoming maintenance and what has been notified.</p>
    </div>
    <a href="/pm" class="engr-btn engr-btn--secondary">Schedules</a>
  </div>

  {
    periodLabel && (
      <p class="engr-filterbar">
        <span>Occurrences due in the week of {periodLabel}</span>
        <a href="/pm/calendar">Clear period</a>
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to preventive maintenance.
      </p>
    ) : rows.length === 0 ? (
      <p class="engr-empty">
        {periodLabel
          ? `Nothing due in the week of ${periodLabel}.`
          : 'No occurrences yet. They appear once the daily scan runs.'}
      </p>
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table" aria-label="Upcoming maintenance">
          <thead>
            <tr>
              <th scope="col">Due</th>
              <th scope="col">Schedule</th>
              <th scope="col">Status</th>
              <th scope="col">One month</th>
              <th scope="col">Two weeks</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.dueDate}</td>
                <td>
                  <a href={`/pm/occurrences/${r.id}`}>{r.scheduleName}</a>
                </td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
                <td>{r.notified1m ? 'Notified' : 'Pending'}</td>
                <td>{r.notified2w ? 'Notified' : 'Pending'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</EngrLayout>
