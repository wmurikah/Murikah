---
export const prerender = false;

/** Edit a PM schedule. Gate: pm.allocate. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import PmScheduleForm from '@/components/engr/PmScheduleForm.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import {
  getSchedule,
  listActiveContractors,
  listChecklistTemplates,
  pmAutomationEnabled,
  type ScheduleDetail,
  type Option,
} from '@engr/repos/pm';
import { listStations, listAssetCategories } from '@engr/repos/requests';
import { listSlas } from '@engr/repos/requestActions';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'pm.allocate');
const { id } = Astro.params;
const errorCode = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved') === '1';

let schedule: ScheduleDetail | null = null;
let stations: Option[] = [];
let categories: Option[] = [];
let contractors: Option[] = [];
let templates: Option[] = [];
let slas: Option[] = [];
let automationEnabled = false;

if (allowed && id) {
  const db = await getDb(getEngrEnv());
  schedule = await getSchedule(db, engr.orgId, id);
  if (schedule) {
    const [st, cat, con, tpl, sl, auto] = await Promise.all([
      listStations(db, engr.orgId),
      listAssetCategories(db, engr.orgId),
      listActiveContractors(db, engr.orgId),
      listChecklistTemplates(db, engr.orgId),
      listSlas(db, engr.orgId),
      pmAutomationEnabled(db, engr.orgId),
    ]);
    stations = st.map((s) => ({ id: s.id, name: s.name }));
    categories = cat.map((c) => ({ id: c.id, name: c.name }));
    contractors = con;
    templates = tpl;
    slas = sl;
    automationEnabled = auto;
  }
}
if (allowed && !schedule) Astro.response.status = 404;
---

<EngrLayout title="Edit PM schedule">
  <div class="engr-page-head">
    <div>
      <h1>{schedule ? schedule.name : 'Schedule'}</h1>
      <p class="engr-lead">Edit the maintenance schedule.</p>
    </div>
    <a href="/pm" class="engr-btn engr-btn--secondary">Back</a>
  </div>

  {
    errorCode && (
      <p class="engr-error" role="alert">
        The schedule could not be saved. Check the details and try again.
      </p>
    )
  }
  {
    saved && (
      <p class="engr-notice" role="status">
        The schedule was saved.
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to preventive maintenance.
      </p>
    ) : !schedule ? (
      <p class="engr-empty">That schedule was not found in your organisation.</p>
    ) : (
      <PmScheduleForm
        action={`/api/pm/schedules/${schedule.id}`}
        schedule={schedule}
        stations={stations}
        categories={categories}
        contractors={contractors}
        templates={templates}
        slas={slas}
        automationEnabled={automationEnabled}
        submitLabel="Save changes"
      />
    )
  }
</EngrLayout>
