---
export const prerender = false;

/** Create an LPO for a contractor with a base station. Gate: workorder.create and workorder.assign. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listActiveContractors, type Option } from '@engr/repos/pm';
import { listStations, type StationOption } from '@engr/repos/requests';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'workorder.create') && can(Astro.locals, 'workorder.assign');
const errorCode = Astro.url.searchParams.get('error');

let contractors: Option[] = [];
let stations: StationOption[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv());
  [contractors, stations] = await Promise.all([
    listActiveContractors(db, engr.orgId),
    listStations(db, engr.orgId),
  ]);
}
---

<EngrLayout title="New LPO">
  <div class="engr-page-head">
    <div>
      <h1>New LPO</h1>
      <p class="engr-lead">Group work orders across stations for one contractor.</p>
    </div>
    <a href="/lpos" class="engr-btn engr-btn--secondary">Back</a>
  </div>

  {
    errorCode && (
      <p class="engr-error" role="alert">
        The LPO could not be created. Check the details and try again.
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to create LPOs.
      </p>
    ) : contractors.length === 0 ? (
      <p class="engr-empty">No active contractors to raise an LPO for.</p>
    ) : (
      <form method="post" action="/api/lpos" class="engr-form" style="max-width:44rem">
        <div class="engr-field">
          <label for="lpo-contractor">Contractor</label>
          <select id="lpo-contractor" class="engr-select" name="contractor_id" required>
            <option value="">Choose a contractor</option>
            {contractors.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div class="engr-field">
          <label for="lpo-base">Base station</label>
          <select id="lpo-base" class="engr-select" name="base_station_id">
            <option value="">Not set</option>
            {stations.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
          <p class="engr-field__hint">
            The depot the trip starts from, used as the mileage origin.
          </p>
        </div>
        <div class="engr-actionbar">
          <button type="submit" class="engr-btn engr-btn--primary">
            Create LPO
          </button>
        </div>
      </form>
    )
  }
</EngrLayout>
