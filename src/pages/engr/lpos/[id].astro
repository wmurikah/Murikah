---
export const prerender = false;

/**
 * The audit view of an LPO: the full linked, sealed document so an auditor can
 * read everything on its face. A draft is still built here (add work orders,
 * running subtotal, mileage and total) and approved; an approved LPO is issued
 * and sealed; a sealed LPO is read-only and can only change through a linked
 * amendment, or be cancelled. Gate: workorder.view to see; build/issue/amend/
 * cancel on workorder.create and workorder.assign; approve on cost.approve.l2.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listAttachableWorkOrders, type LpoWorkOrder } from '@engr/repos/lpos';
import {
  getLpoAuditDetail,
  verifyLpoSeal,
  type LpoAuditDetail,
  type VerifyResult,
} from '@engr/repos/lpoAudit';
import {
  listStations,
  listAssetCategories,
  type StationOption,
  type CategoryOption,
} from '@engr/repos/requests';
import { listSlas, type SlaOption } from '@engr/repos/requestActions';
import { can } from '@engr/auth/rbac';
import { formatMoneyMinor, shortDate } from '@engr/format';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'workorder.view');
const canBuild = can(Astro.locals, 'workorder.create') && can(Astro.locals, 'workorder.assign');
const canApprove = can(Astro.locals, 'cost.approve.l2');
const { id } = Astro.params;
const params = Astro.url.searchParams;
const errorCode = params.get('error');
const done = ['approved', 'issued', 'cancelled', 'amended', 'attached', 'created'].find(
  (k) => params.get(k) === '1',
);

let lpo: LpoAuditDetail | null = null;
let verify: VerifyResult | null = null;
let attachable: LpoWorkOrder[] = [];
let stations: StationOption[] = [];
let categories: CategoryOption[] = [];
let slas: SlaOption[] = [];

if (allowed && id) {
  const db = await getDb(getEngrEnv());
  lpo = await getLpoAuditDetail(db, engr.orgId, id);
  if (lpo) {
    if (lpo.sealedAt) verify = await verifyLpoSeal(db, engr.orgId, id);
    if (canBuild && lpo.state === 'DRAFT') {
      [attachable, stations, categories, slas] = await Promise.all([
        listAttachableWorkOrders(db, engr.orgId, id),
        listStations(db, engr.orgId),
        listAssetCategories(db, engr.orgId),
        listSlas(db, engr.orgId),
      ]);
    }
  }
}
if (allowed && !lpo) Astro.response.status = 404;

const lpoId = lpo?.id ?? '';
const stateLabel: Record<string, string> = {
  DRAFT: 'Draft',
  APPROVED: 'Approved',
  ISSUED: 'Issued and sealed',
  AMENDED: 'Amended (superseded)',
  CANCELLED: 'Cancelled',
};
const showBuilder = lpo != null && canBuild && lpo.state === 'DRAFT';
const showApprove = lpo != null && canApprove && lpo.state === 'DRAFT';
const showIssue = lpo != null && canBuild && lpo.state === 'APPROVED';
const showAmend = lpo != null && canBuild && lpo.state === 'ISSUED';
const showCancel = lpo != null && canBuild && lpo.state !== 'CANCELLED';
const assetOrCategory = (a: string | null, c: string | null): string => a ?? c ?? 'Not set';
---

<EngrLayout title="LPO">
  <div class="engr-page-head">
    <div>
      <h1>{lpo ? lpo.lpoNo : 'LPO'}</h1>
      <p class="engr-lead">
        {lpo ? `Local purchase order, version ${lpo.version}.` : 'Local purchase order.'}
      </p>
    </div>
    <a href="/lpos" class="engr-btn engr-btn--secondary">Back to LPOs</a>
  </div>

  {
    errorCode && (
      <p class="engr-error" role="alert">
        That action could not be completed. Refresh and try again.
      </p>
    )
  }
  {
    done && (
      <p class="engr-notice" role="status">
        Done.
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to LPOs.
      </p>
    ) : !lpo ? (
      <p class="engr-empty">That LPO was not found in your organisation.</p>
    ) : (
      <>
        <dl class="engr-detail">
          <dt>Document state</dt>
          <dd>
            <span class="engr-pill">{stateLabel[lpo.state] ?? lpo.state}</span>
          </dd>
          <dt>Contractor</dt>
          <dd>{lpo.contractorName}</dd>
          <dt>Base station</dt>
          <dd>{lpo.baseStationName ?? 'Not set'}</dd>
          <dt>Region</dt>
          <dd>{lpo.regionName ?? 'Not set'}</dd>
          <dt>Currency</dt>
          <dd>{lpo.currency}</dd>
          {lpo.notes && <dt>Notes</dt>}
          {lpo.notes && <dd>{lpo.notes}</dd>}
        </dl>

        <section class="engr-panel" aria-labelledby="lpo-lines">
          <h2 id="lpo-lines">Lines</h2>
          {lpo.lines.length === 0 ? (
            <p class="engr-empty">No work orders on this LPO yet.</p>
          ) : (
            <div class="engr-tablewrap">
              <table class="engr-table" aria-label="LPO lines">
                <caption class="engr-vh">
                  {lpo.frozen
                    ? 'Frozen LPO lines. Asset or category, SLA and description are hidden on small screens.'
                    : 'Draft LPO lines from the covered work orders.'}
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Work order</th>
                    <th scope="col">Station</th>
                    <th scope="col" class="engr-col-mid">
                      Asset or category
                    </th>
                    <th scope="col" class="engr-col-lo">
                      SLA
                    </th>
                    <th scope="col" class="engr-col-lo">
                      Description
                    </th>
                    <th scope="col" class="engr-num">
                      Amount
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {lpo.lines.map((l) => (
                    <tr>
                      <td>
                        {l.workOrderId ? (
                          <a href={`/workorders/${l.workOrderId}`}>{l.woNo}</a>
                        ) : (
                          l.woNo
                        )}
                      </td>
                      <td>{l.stationName}</td>
                      <td class="engr-col-mid">{assetOrCategory(l.assetTag, l.categoryName)}</td>
                      <td class="engr-col-lo">{l.slaName ?? 'Not set'}</td>
                      <td class="engr-col-lo engr-trunc">{l.description}</td>
                      <td class="engr-num">{formatMoneyMinor(l.amountMinor, lpo.currency)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <dl class="engr-detail engr-detail--money">
            <dt>Subtotal</dt>
            <dd>{formatMoneyMinor(lpo.subtotalMinor, lpo.currency)}</dd>
            <dt>Mileage</dt>
            <dd>{formatMoneyMinor(lpo.mileageMinor, lpo.currency)}</dd>
            <dt>Total</dt>
            <dd>
              <strong>{formatMoneyMinor(lpo.totalMinor, lpo.currency)}</strong>
            </dd>
            <dt>Reconciliation</dt>
            <dd>
              {lpo.reconciles
                ? 'Total ties to the lines plus mileage.'
                : 'Total does not reconcile to the lines plus mileage.'}
            </dd>
          </dl>
        </section>

        {lpo.sealedAt && verify && (
          <section class="engr-panel" aria-labelledby="lpo-seal">
            <h2 id="lpo-seal">Seal</h2>
            <dl class="engr-detail">
              <dt>Hash</dt>
              <dd>
                <code class="engr-code" title={lpo.sealedHash ?? ''}>
                  {lpo.sealedHash}
                </code>
              </dd>
              <dt>Verification</dt>
              <dd>
                {verify.state === 'verified' ? (
                  <span class="engr-pill engr-pill--ok">Verified</span>
                ) : (
                  <span class="engr-pill engr-pill--alert">Changed</span>
                )}
              </dd>
            </dl>
            <p class="engr-field__hint">
              {verify.state === 'verified'
                ? 'The stored seal matches a fresh hash of the frozen document.'
                : 'The stored seal does not match a fresh hash; the record has changed since it was sealed.'}
            </p>
            <div class="engr-actionbar">
              <a href={`/lpos/${lpoId}`} class="engr-btn engr-btn--secondary">
                Re-check seal
              </a>
            </div>
          </section>
        )}

        <section class="engr-panel" aria-labelledby="lpo-trail">
          <h2 id="lpo-trail">Attribution and trail</h2>
          <dl class="engr-detail">
            <dt>Raised by</dt>
            <dd>
              {lpo.createdByName ?? 'Unknown'}, {shortDate(lpo.createdAt)}
            </dd>
            {lpo.approvedAt && <dt>Approved by</dt>}
            {lpo.approvedAt && (
              <dd>
                {lpo.approvedByName ?? 'Unknown'}, {shortDate(lpo.approvedAt)}
              </dd>
            )}
            {lpo.issuedAt && <dt>Issued by</dt>}
            {lpo.issuedAt && (
              <dd>
                {lpo.issuedByName ?? 'Unknown'}, {shortDate(lpo.issuedAt)}
              </dd>
            )}
            {lpo.sealedAt && <dt>Sealed</dt>}
            {lpo.sealedAt && <dd>{shortDate(lpo.sealedAt)}</dd>}
            {lpo.cancelledAt && <dt>Cancelled</dt>}
            {lpo.cancelledAt && (
              <dd>
                {shortDate(lpo.cancelledAt)}
                {lpo.cancelReason ? `, ${lpo.cancelReason}` : ''}
              </dd>
            )}
            {lpo.supersedesNo && <dt>Supersedes</dt>}
            {lpo.supersedesNo && (
              <dd>
                <a href={`/lpos/${lpo.supersedesId}`}>{lpo.supersedesNo}</a>
              </dd>
            )}
            {lpo.supersededByNo && <dt>Superseded by</dt>}
            {lpo.supersededByNo && (
              <dd>
                <a href={`/lpos/${lpo.supersededById}`}>{lpo.supersededByNo}</a>
              </dd>
            )}
          </dl>
        </section>

        {showBuilder && (
          <section class="engr-panel" aria-labelledby="lpo-build">
            <h2 id="lpo-build">Add work orders</h2>
            {attachable.length > 0 && (
              <form method="post" action={`/api/lpos/${lpoId}/attach`} class="engr-form">
                <div class="engr-field">
                  <label for="attach-wo">Attach an existing work order</label>
                  <select id="attach-wo" class="engr-select" name="work_order_id" required>
                    <option value="">Choose a work order</option>
                    {attachable.map((w) => (
                      <option value={w.id}>
                        {w.woNo}, {w.stationName}
                      </option>
                    ))}
                  </select>
                </div>
                <div class="engr-actionbar">
                  <button type="submit" class="engr-btn engr-btn--secondary">
                    Attach
                  </button>
                </div>
              </form>
            )}

            <form method="post" action={`/api/lpos/${lpoId}/attach`} class="engr-form">
              <p class="engr-field__hint">
                Or create a new work order at a station under this LPO.
              </p>
              <div class="engr-field">
                <label for="new-station">Station</label>
                <select id="new-station" class="engr-select" name="station_id" required>
                  <option value="">Choose a station</option>
                  {stations.map((st) => (
                    <option value={st.id}>{st.name}</option>
                  ))}
                </select>
              </div>
              <div class="engr-field">
                <label for="new-category">
                  Category <span class="engr-field__hint">(optional)</span>
                </label>
                <select id="new-category" class="engr-select" name="category_id">
                  <option value="">Not set</option>
                  {categories.map((c) => (
                    <option value={c.id}>{c.name}</option>
                  ))}
                </select>
              </div>
              <div class="engr-field">
                <label for="new-sla">
                  SLA <span class="engr-field__hint">(optional)</span>
                </label>
                <select id="new-sla" class="engr-select" name="sla_id">
                  <option value="">Not set</option>
                  {slas.map((sl) => (
                    <option value={sl.id}>{sl.name}</option>
                  ))}
                </select>
              </div>
              <div class="engr-field">
                <label for="new-ref">
                  Mileage reference station <span class="engr-field__hint">(optional)</span>
                </label>
                <select id="new-ref" class="engr-select" name="mileage_reference_station_id">
                  <option value="">Not set</option>
                  {stations.map((st) => (
                    <option value={st.id}>{st.name}</option>
                  ))}
                </select>
              </div>
              <div class="engr-actionbar">
                <button type="submit" class="engr-btn engr-btn--primary">
                  Create work order
                </button>
              </div>
            </form>
          </section>
        )}

        {(showApprove || showIssue || showAmend || showCancel) && (
          <section class="engr-panel" aria-labelledby="lpo-actions">
            <h2 id="lpo-actions">Lifecycle</h2>
            <div class="engr-actionbar">
              {showApprove && (
                <form method="post" action={`/api/lpos/${lpoId}/approve`}>
                  <button type="submit" class="engr-btn engr-btn--primary">
                    Approve
                  </button>
                </form>
              )}
              {showIssue && (
                <form method="post" action={`/api/lpos/${lpoId}/issue`}>
                  <button type="submit" class="engr-btn engr-btn--primary">
                    Issue and seal
                  </button>
                </form>
              )}
              {showAmend && (
                <form method="post" action={`/api/lpos/${lpoId}/amend`}>
                  <button type="submit" class="engr-btn engr-btn--secondary">
                    Amend (new version)
                  </button>
                </form>
              )}
            </div>
            {showApprove && (
              <p class="engr-field__hint">
                An LPO is a financial commitment, so it must be approved before it can be issued.
              </p>
            )}
            {showIssue && (
              <p class="engr-field__hint">
                Issuing freezes the lines, reconciles the total and seals the document. After that
                it cannot be edited.
              </p>
            )}
            {showCancel && (
              <form method="post" action={`/api/lpos/${lpoId}/cancel`} class="engr-form">
                <div class="engr-field">
                  <label for="cancel-reason">Cancel this LPO</label>
                  <input
                    id="cancel-reason"
                    class="engr-input"
                    name="reason"
                    required
                    minlength="3"
                    maxlength="200"
                    placeholder="Reason for cancelling"
                  />
                </div>
                <div class="engr-actionbar">
                  <button type="submit" class="engr-btn engr-btn--danger">
                    Cancel LPO
                  </button>
                </div>
              </form>
            )}
          </section>
        )}
      </>
    )
  }
</EngrLayout>
