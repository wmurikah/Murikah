---
export const prerender = false;

/**
 * Forgotten password (public): ask for the account email and request a reset
 * link. The confirmation copy is the same whether or not the address exists,
 * mirroring the endpoint's neutral answer, so this screen never discloses
 * account existence either.
 */
import GrcAuthLayout from '@/layouts/GrcAuthLayout.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
---

<GrcAuthLayout title="Forgotten password">
  <h1>Forgotten password</h1>
  <p class="grc-authcard__lead">
    Enter your account email and we will send a link to set a new password.
  </p>

  {
    sent && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        If that address has an account, a reset link is on its way. The link is valid for 45 minutes
        and works once. Check your spam folder if it does not arrive.
      </p>
    )
  }

  <form method="post" action="/api/auth/forgot-password">
    <div class="grc-field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        class="grc-input"
        autocomplete="username"
        required
      />
    </div>
    <button type="submit" class="grc-btn grc-btn--primary">Send reset link</button>
  </form>

  <p class="grc-authmeta"><a href="/login">Back to sign in</a></p>
</GrcAuthLayout>
