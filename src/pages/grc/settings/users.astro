---
export const prerender = false;

/**
 * Users Setup: manage the organisation's users. Gated on the matrix (USER
 * read; the mutations gate per action on /api/setup/users), platform owner
 * always. Create, edit email, name, role, affiliate and phone, reset the
 * password, and activate or deactivate. Every account requires a valid email:
 * it is the sign-in identity and the address the universal second-factor code
 * goes to (Build Prompt 37), so both forms mark it required and the endpoint
 * refuses a missing, malformed or duplicate one.
 *
 * Nobody types a password here (Build Prompt 39). Creating a user, and
 * resetting one, mint a temporary password, email it to its owner and bring it
 * back to this page once, in the panel below the banners: it is read out of a
 * sealed, single-use row, so a refresh will not show it again, which is exactly
 * what the copy promises. When the email could not be sent the panel says so,
 * and the admin still has the password to pass on themselves.
 *
 * A platform-owner account is shown but never edited here. Every mutation posts
 * to /api/setup/users and returns with a saved, error or credential banner.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import GrcIcon from '@/components/grc/GrcIcon.astro';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { guardPageLoad } from '@grc/pageGuard';
import { listUsers, type ManagedUser } from '@grc/repos/usersAdmin';
import { takeTemporaryPassword } from '@grc/repos/tempPasswordHandoff';
import { listRoleCodes } from '@grc/repos/permissionsAdmin';
import { listAffiliates, type Affiliate } from '@grc/repos/affiliatesAdmin';
import { can } from '@grc/auth/rbac';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');
const allowed = grc.isPlatformOwner || can(Astro.locals, 'read', 'USER');

const url = Astro.url;
const saved = url.searchParams.get('saved');
const error = url.searchParams.get('error');
const editId = url.searchParams.get('edit');
// A password was just generated for this account. Reading it clears it, so the
// panel below shows it exactly once however many times the page is refreshed.
const credentialFor = url.searchParams.get('credential');
const mailError = url.searchParams.get('mailerror');

let users: ManagedUser[] = [];
let roles: string[] = [];
let affiliates: Affiliate[] = [];
let temporaryPassword: string | null = null;
let loadError = false;
if (allowed) {
  loadError = !(await guardPageLoad('setup.users', async () => {
    const env = getGrcEnv();
    const db = await getDb(env);
    [users, roles, affiliates] = await Promise.all([
      listUsers(db, grc.organizationId),
      listRoleCodes(db),
      listAffiliates(db, grc.organizationId),
    ]);
    if (credentialFor) {
      const handoff = await takeTemporaryPassword(
        db,
        env.sessionSecret,
        grc.organizationId,
        credentialFor,
        grc.userId,
      );
      temporaryPassword = handoff?.password ?? null;
    }
  }));
}
const activeAffiliates = affiliates.filter((a) => a.isActive);
const editing = editId
  ? (users.find((u) => u.userId === editId && !u.isPlatformOwner) ?? null)
  : null;
const credentialUser = credentialFor
  ? (users.find((u) => u.userId === credentialFor) ?? null)
  : null;
const roleLabel = (code: string): string => code.replace(/_/g, ' ');
---

<GrcLayout title="Users">
  <div class="grc-page-head">
    <div>
      <h1>Users</h1>
      <p class="grc-lead">The people who can sign in to this organisation, and what they may do.</p>
    </div>
    <a class="grc-btn grc-btn--secondary" href="/settings">Back to settings</a>
  </div>

  {
    saved && (
      <p class="grc-notice" role="status">
        {saved}
      </p>
    )
  }
  {
    error && (
      <p class="grc-error" role="alert">
        {error}
      </p>
    )
  }

  {
    credentialFor && allowed && !loadError && (
      <div class="grc-credential" role="status">
        <h2 class="grc-credential__title">
          {temporaryPassword ? 'Temporary password' : 'Password already shown'}
        </h2>
        {mailError ? (
          <p class="grc-credential__warn">
            The account is ready, but the email could not be sent: {decodeURIComponent(mailError)}{' '}
            Pass the password on yourself.
          </p>
        ) : (
          <p class="grc-credential__note">
            Emailed to {credentialUser?.email ?? 'the user'} with a sign-in link.
          </p>
        )}
        {temporaryPassword ? (
          <>
            <div class="grc-credential__row">
              <code class="grc-credential__value" id="grc-temp-pw">
                {temporaryPassword}
              </code>
              <button
                type="button"
                class="grc-btn grc-btn--secondary"
                id="grc-temp-copy"
                data-password={temporaryPassword}
              >
                Copy
              </button>
            </div>
            <p class="grc-credential__note">
              This will not be shown again. {credentialUser?.fullName ?? 'The user'} must change it
              at their first sign-in.
            </p>
          </>
        ) : (
          <p class="grc-credential__note">
            It was shown once already and cannot be retrieved. Reset the password to issue a new
            one.
          </p>
        )}
        <p class="grc-credential__note">
          <a href="/settings/users">Dismiss</a>
        </p>
      </div>
    )
  }

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        Users are managed by administrators.
      </p>
    ) : loadError ? (
      <GrcErrorCard subject="Users" />
    ) : (
      <>
        {!editing && (
          <details class="grc-editpanel" open={users.length <= 1}>
            <summary>
              <strong>Add a user</strong>
            </summary>
            <form method="post" action="/api/setup/users" class="grc-form grc-formgrid">
              <input type="hidden" name="op" value="create" />
              <div class="grc-field">
                <label for="n-name">Full name</label>
                <input id="n-name" name="full_name" class="grc-input" required maxlength="160" />
              </div>
              <div class="grc-field">
                <label for="n-email">Email</label>
                <input id="n-email" name="email" type="email" class="grc-input" required />
                <p class="grc-field__hint">
                  Used to sign in and to receive the two-step verification code, so every account
                  needs one.
                </p>
              </div>
              <div class="grc-field">
                <label for="n-role">Role</label>
                <select id="n-role" name="role_code" class="grc-select" required>
                  {roles.map((r) => (
                    <option value={r}>{roleLabel(r)}</option>
                  ))}
                </select>
              </div>
              <div class="grc-field">
                <label for="n-aff">Affiliate</label>
                <select id="n-aff" name="affiliate_code" class="grc-select">
                  <option value="">None</option>
                  {activeAffiliates.map((a) => (
                    <option value={a.code}>{a.name}</option>
                  ))}
                </select>
              </div>
              <div class="grc-field">
                <label for="n-phone">Phone</label>
                <input id="n-phone" name="phone" class="grc-input" maxlength="40" />
              </div>
              <p class="grc-field__hint" style="grid-column:1/-1">
                A temporary password is generated for you, emailed to the user with a sign-in link,
                and shown here once. They choose their own at first sign-in.
              </p>
              <div class="grc-actions">
                <button type="submit" class="grc-btn grc-btn--primary">
                  Create user
                </button>
              </div>
            </form>
          </details>
        )}

        {editing && (
          <div class="grc-editpanel" id={`u-${editing.userId}`}>
            <h2>Edit {editing.fullName ?? editing.email}</h2>
            <form method="post" action="/api/setup/users" class="grc-form grc-formgrid">
              <input type="hidden" name="op" value="update" />
              <input type="hidden" name="user_id" value={editing.userId} />
              <div class="grc-field">
                <label for="e-name">Full name</label>
                <input
                  id="e-name"
                  name="full_name"
                  class="grc-input"
                  required
                  maxlength="160"
                  value={editing.fullName ?? ''}
                />
              </div>
              <div class="grc-field">
                <label for="e-email">Email</label>
                <input
                  id="e-email"
                  name="email"
                  type="email"
                  class="grc-input"
                  required
                  value={editing.email}
                  aria-invalid={editing.email === '' ? 'true' : undefined}
                />
                <p class="grc-field__hint">
                  {editing.email === ''
                    ? 'This account has no email, so it cannot receive a sign-in code. Add one to fix it.'
                    : 'Used to sign in and to receive the two-step verification code.'}
                </p>
              </div>
              <div class="grc-field">
                <label for="e-role">Role</label>
                <select id="e-role" name="role_code" class="grc-select" required>
                  {roles.map((r) => (
                    <option value={r} selected={r === editing.roleCode}>
                      {roleLabel(r)}
                    </option>
                  ))}
                </select>
              </div>
              <div class="grc-field">
                <label for="e-aff">Affiliate</label>
                <select id="e-aff" name="affiliate_code" class="grc-select">
                  <option value="" selected={!editing.affiliateCode}>
                    None
                  </option>
                  {activeAffiliates.map((a) => (
                    <option value={a.code} selected={a.code === editing.affiliateCode}>
                      {a.name}
                    </option>
                  ))}
                </select>
              </div>
              <div class="grc-field">
                <label for="e-phone">Phone</label>
                <input
                  id="e-phone"
                  name="phone"
                  class="grc-input"
                  maxlength="40"
                  value={editing.phone ?? ''}
                />
              </div>
              <div class="grc-actions">
                <button type="submit" class="grc-btn grc-btn--primary">
                  Save changes
                </button>
                <a class="grc-btn grc-btn--secondary" href="/settings/users">
                  Cancel
                </a>
              </div>
            </form>

            <form method="post" action="/api/setup/users" class="grc-form" style="margin-top:1rem">
              <input type="hidden" name="op" value="reset_password" />
              <input type="hidden" name="user_id" value={editing.userId} />
              <div class="grc-field">
                <p class="grc-field__hint">
                  Generates a new temporary password, emails it to {editing.email} with a sign-in
                  link, and shows it here once. They must change it at their next sign-in.
                </p>
              </div>
              <div class="grc-actions">
                <button type="submit" class="grc-btn grc-btn--secondary">
                  <GrcIcon name="key" size={15} /> Reset password
                </button>
              </div>
            </form>
          </div>
        )}

        {users.length === 0 ? (
          <p class="grc-empty">No users yet.</p>
        ) : (
          <div class="grc-tablewrap">
            <table class="grc-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Affiliate</th>
                  <th>Status</th>
                  <th>
                    <span class="grc-visually-hidden">Actions</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {users.map((u) => (
                  <tr class={u.isActive ? '' : 'is-inactive'}>
                    <td>
                      {u.fullName ?? '-'}
                      {u.isPlatformOwner && (
                        <span class="grc-chip" style="margin-left:.4rem">
                          Platform owner
                        </span>
                      )}
                    </td>
                    <td>{u.email}</td>
                    <td>{u.roleCode ? roleLabel(u.roleCode) : '-'}</td>
                    <td>{u.affiliateCode ?? '-'}</td>
                    <td>
                      <span
                        class={`grc-statuspill ${u.isActive ? 'grc-statuspill--on' : 'grc-statuspill--off'}`}
                      >
                        {u.isActive ? 'Active' : 'Inactive'}
                      </span>
                      {u.mustChangePassword && u.isActive && (
                        <span class="grc-chip" style="margin-left:.4rem">
                          Must change password
                        </span>
                      )}
                    </td>
                    <td>
                      {u.isPlatformOwner ? (
                        <span class="grc-muted">Managed at platform level</span>
                      ) : (
                        <div class="grc-actions grc-actions--end">
                          <a
                            class="grc-iconbtn"
                            href={`/settings/users?edit=${encodeURIComponent(u.userId)}#u-${u.userId}`}
                            aria-label={`Edit ${u.fullName ?? u.email}`}
                            title="Edit"
                          >
                            <GrcIcon name="pencil" size={16} />
                          </a>
                          {u.userId !== grc.userId && (
                            <form method="post" action="/api/setup/users">
                              <input
                                type="hidden"
                                name="op"
                                value={u.isActive ? 'deactivate' : 'activate'}
                              />
                              <input type="hidden" name="user_id" value={u.userId} />
                              <button
                                type="submit"
                                class="grc-btn grc-btn--secondary grc-btn--tiny"
                              >
                                {u.isActive ? 'Deactivate' : 'Activate'}
                              </button>
                            </form>
                          )}
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</GrcLayout>

<script>
  // Copy the shown-once temporary password. The value rides on the button's
  // data attribute rather than being read back out of the DOM text, so the
  // exact string generated is what reaches the clipboard, separators and all.
  const copy = document.getElementById('grc-temp-copy');
  if (copy instanceof HTMLButtonElement) {
    const original = copy.textContent ?? 'Copy';
    copy.addEventListener('click', () => {
      const value = copy.dataset.password ?? '';
      const done = (label: string): void => {
        copy.textContent = label;
        window.setTimeout(() => (copy.textContent = original), 2000);
      };
      // The clipboard API needs a secure context; fall back to selecting the
      // value so the admin can copy it by hand rather than being stuck.
      navigator.clipboard?.writeText(value).then(
        () => done('Copied'),
        () => {
          const el = document.getElementById('grc-temp-pw');
          if (el) {
            const range = document.createRange();
            range.selectNodeContents(el);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
          done('Select and copy');
        },
      );
    });
  }
</script>
