---
export const prerender = false;

/**
 * GRC sign-in. Email and password only (no organisation slug): the user is
 * resolved by email across the platform and placed in their home organisation.
 * Any failure returns one generic message, so it never reveals whether the email
 * or the password was wrong. The premium two-pane layout carries the Murikah
 * brand; the form posts to the sign-in endpoint.
 */
import GrcAuthLayout from '@/layouts/GrcAuthLayout.astro';
import { safeNextPath } from '@grc/routing';

const failed = Astro.url.searchParams.get('error') === '1';
const reset = Astro.url.searchParams.get('reset') === '1';
// Where the visitor was heading before the guard sent them here, e.g. the
// review queue linked from a digest email (Build Prompt 53). Validated on the
// way in as well as on the way out, so a hostile value never reaches the form.
const next = safeNextPath(Astro.url.searchParams.get('next'));
---

<GrcAuthLayout title="Sign in">
  <h1>Sign in</h1>
  <p class="grc-authcard__lead">Access your organisation's audit workspace.</p>

  {
    failed && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        That email and password did not match. Please try again.
      </p>
    )
  }
  {
    reset && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        Your password has been reset. Sign in with the new password.
      </p>
    )
  }

  {
    next && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        Sign in to continue to the page you were opening.
      </p>
    )
  }

  <form method="post" action="/api/auth/login">
    {next && <input type="hidden" name="next" value={next} />}
    <div class="grc-field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        class="grc-input"
        autocomplete="username"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <div class="grc-field">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        class="grc-input"
        autocomplete="current-password"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <button type="submit" class="grc-btn grc-btn--primary">Sign in</button>
  </form>

  <p class="grc-authmeta"><a href="/forgot-password">Forgot your password?</a></p>
  <p class="grc-authmeta">Trouble signing in? Contact your organisation's audit administrator.</p>
</GrcAuthLayout>
