---
export const prerender = false;

/**
 * Settings home. Links to the configuration screens: access control (the
 * permission matrix), managed dropdowns (control fields and the audit
 * universe), and AI settings. Gated on the matrix (CONFIG or USER read), so
 * the access-control screen can delegate setup to other roles; a platform
 * owner always passes.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import { can } from '@grc/auth/rbac';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');
const allowed =
  grc.isPlatformOwner || can(Astro.locals, 'read', 'CONFIG') || can(Astro.locals, 'read', 'USER');

const cards = [
  {
    href: '/settings/users',
    title: 'Users',
    body: 'The people who can sign in, their roles, affiliates and passwords.',
  },
  {
    href: '/settings/affiliates',
    title: 'Affiliates',
    body: 'The business units a work paper or action plan can be scoped to.',
  },
  {
    href: '/settings/audit-universe',
    title: 'Audit universe',
    body: 'Audit areas and their sub-areas, which seed the work-paper templates.',
  },
  {
    href: '/settings/access-control',
    title: 'Access control',
    body: 'The permission matrix for each role, and the pages it unlocks.',
  },
  {
    href: '/settings/dropdowns',
    title: 'Dropdowns',
    body: 'The control-field vocabularies: risk ratings, classification, type and frequency.',
  },
  {
    href: '/settings/general',
    title: 'General settings',
    body: 'Workflow deadlines, reminder cadence and notification sender defaults.',
  },
  {
    href: '/settings/ai',
    title: 'AI settings',
    body: 'The AI assistance providers, model and evaluation defaults.',
  },
];
// Provisioning a new customer organisation is a platform-owner action.
if (grc.isPlatformOwner) {
  cards.push({
    href: '/settings/provision',
    title: 'Provision organisation',
    body: 'Create a customer organisation, seeded with its config, dropdowns, admin and trial.',
  });
}
---

<GrcLayout title="Settings">
  <div class="grc-page-head">
    <div>
      <h1>Settings</h1>
      <p class="grc-lead">Configure the audit workspace for your organisation.</p>
    </div>
  </div>

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        Settings are restricted to administrators.
      </p>
    ) : (
      <div class="grc-cards">
        {cards.map((c) => (
          <a href={c.href} class="grc-card grc-card--link">
            <p class="grc-card__label">{c.title}</p>
            <p class="grc-card__note">{c.body}</p>
          </a>
        ))}
      </div>
    )
  }
</GrcLayout>
