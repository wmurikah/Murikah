---
export const prerender = false;

/**
 * Change password. Reached two ways: forced, when the account carries a
 * temporary password (the middleware redirects every route here until it is
 * changed), and voluntarily, from the account menu. The same form and endpoint
 * serve both; the copy and the escape hatch differ. Three fields (current, new,
 * confirm) in the Murikah house style; the endpoint verifies the current
 * password, enforces the rules, rotates the session and audits the change.
 */
import GrcAuthLayout from '@/layouts/GrcAuthLayout.astro';
import { MIN_PASSWORD_LENGTH } from '@grc/auth/passwordPolicy';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const forced = grc.mustChangePassword;
const error = Astro.url.searchParams.get('error');
---

<GrcAuthLayout
  title="Change password"
  brandHeadline="Keep your account secure"
  brandSub="Choose a strong, private password. A passphrase of a few words is ideal."
>
  <h1>Change password</h1>
  {
    forced ? (
      <p class="grc-authcard__lead">
        You are signed in with a temporary password. Choose a new one to continue to your workspace.
      </p>
    ) : (
      <p class="grc-authcard__lead">Update the password you use to sign in.</p>
    )
  }

  {
    error && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        {error}
      </p>
    )
  }

  <form method="post" action="/api/auth/change-password">
    <div class="grc-field">
      <label for="current_password">Current password</label>
      <input
        type="password"
        id="current_password"
        name="current_password"
        class="grc-input"
        autocomplete="current-password"
        required
        aria-invalid={error ? 'true' : undefined}
      />
    </div>
    <div class="grc-field">
      <label for="new_password">New password</label>
      <input
        type="password"
        id="new_password"
        name="new_password"
        class="grc-input"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
        aria-describedby="new_password_hint"
      />
      <p id="new_password_hint" class="grc-field__hint">
        At least {MIN_PASSWORD_LENGTH} characters, and different from your current password.
      </p>
    </div>
    <div class="grc-field">
      <label for="confirm_password">Confirm new password</label>
      <input
        type="password"
        id="confirm_password"
        name="confirm_password"
        class="grc-input"
        autocomplete="new-password"
        minlength={MIN_PASSWORD_LENGTH}
        required
      />
    </div>
    <div class="grc-authactions">
      <button type="submit" class="grc-btn grc-btn--primary">Change password</button>
      {
        !forced && (
          <a class="grc-btn grc-btn--secondary" href="/">
            Back to dashboard
          </a>
        )
      }
    </div>
  </form>
</GrcAuthLayout>
