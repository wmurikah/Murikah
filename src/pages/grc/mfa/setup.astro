---
export const prerender = false;

/**
 * Account security (Build Prompt 37). Two-step verification is universal and
 * email codes are the automatic default, so there is nothing to set up and
 * no wall: this screen shows how the account verifies, manages the backup
 * codes (minted with the account at first sign-in, viewable as a remaining
 * count, regenerable, shown once), and, for roles allowed by
 * MFA_AUTHENTICATOR_ROLES (the
 * platform owner always qualifies), carries the minimised "use an
 * authenticator app instead" link into the existing TOTP enrolment: a sealed
 * secret shown as a QR rendered in-worker plus the manual key, fresh backup
 * codes shown once, and a first app code confirmed at /api/auth/mfa/confirm.
 * The active method keeps working until the pending one confirms; switching
 * back to email codes is immediate.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import { renderSVG } from 'uqr';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { guardPageLoad } from '@grc/pageGuard';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getMfaRecord, type MfaRecord } from '@grc/repos/mfa';
import { withEmailDefault } from '@grc/auth/mfaRecord';
import { authenticatorAllowedForRole, MFA_AUTHENTICATOR_ROLES_KEY } from '@grc/auth/mfaPolicy';
import { getConfigValues } from '@grc/repos/orgConfig';
import { open } from '@grc/auth/secretBox';
import { otpauthUrl } from '@grc/auth/totp';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const done = Astro.url.searchParams.get('done') === '1';
const emailSwitched = Astro.url.searchParams.get('email') === '1';
const codesShown = Astro.url.searchParams.get('codes') === '1';
const error = Astro.url.searchParams.get('error');

let loaded = null as MfaRecord | null;
let secret = null as string | null;
let backupCodes: string[] = [];
let qrSvg = '';
let appAllowed = false;
let loadError = false;

loadError = !(await guardPageLoad('mfa.setup', async () => {
  const env = getGrcEnv();
  const db = await getDb(env);
  loaded = await getMfaRecord(db, grc.homeOrganizationId, grc.userId);
  const rule = await getConfigValues(db, grc.homeOrganizationId, [MFA_AUTHENTICATOR_ROLES_KEY]);
  appAllowed =
    grc.isPlatformOwner ||
    authenticatorAllowedForRole(grc.roleCode, rule.get(MFA_AUTHENTICATOR_ROLES_KEY));
  if (loaded?.backupPlain) {
    const plain = await open(env.sessionSecret, loaded.backupPlain);
    if (plain) backupCodes = JSON.parse(plain) as string[];
  }
  if (loaded?.pendingMethod === 'totp' && loaded.pendingSecret) {
    secret = await open(env.sessionSecret, loaded.pendingSecret);
    if (secret) {
      qrSvg = renderSVG(otpauthUrl(grc.userEmail ?? grc.userId, secret), {
        pixelSize: 4,
      });
    }
  }
}));

const record = withEmailDefault(loaded as MfaRecord | null);
const pendingTotp = record.pendingMethod === 'totp' && secret != null;
const grouped = secret ? (secret.match(/.{1,4}/g) ?? []).join(' ') : '';
const remaining = record.backup.length;

const email = grc.userEmail ?? '';
const at = email.indexOf('@');
const maskedEmail = at > 0 ? `${email[0]}***${email.slice(at)}` : 'your address';
---

<GrcLayout title="Account security">
  <div class="grc-page-head">
    <div>
      <h1>Account security</h1>
      <p class="grc-lead">
        Every sign-in asks for a 6-digit code on top of your password. Email codes work
        automatically; backup codes cover you when your usual method is unavailable.
      </p>
    </div>
  </div>

  {
    done && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        The authenticator app is now your sign-in method. You will be asked for an app code at your
        next sign-in.
      </p>
    )
  }
  {
    emailSwitched && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        Sign-in verification now uses email codes. A code is emailed to you automatically at each
        sign-in.
      </p>
    )
  }
  {
    error && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        {decodeURIComponent(error)}
      </p>
    )
  }

  {
    loadError ? (
      <GrcErrorCard subject="Account security" />
    ) : (
      <>
        <div class="grc-panel">
          <h2>Sign-in verification</h2>
          {record.method === 'email' ? (
            <p>
              A 6-digit code is emailed to {maskedEmail} automatically at each sign-in. There is
              nothing to set up.
            </p>
          ) : (
            <p>
              Sign-in asks for a 6-digit code from your authenticator app. If you lose the app, a
              backup code works instead.
            </p>
          )}
          {record.pendingMethod === 'totp' && (
            <p class="grc-field__hint">
              An authenticator app setup is in progress below. Email codes keep working until you
              confirm it.
            </p>
          )}
          {record.method === 'totp' && !record.pendingMethod && (
            <form method="post" action="/api/auth/mfa/enrol" style="margin-top:0.75rem">
              <input type="hidden" name="method" value="email" />
              <button type="submit" class="grc-btn grc-btn--secondary">
                Switch back to email codes
              </button>
            </form>
          )}
          {record.method === 'email' && !record.pendingMethod && appAllowed && (
            <form method="post" action="/api/auth/mfa/enrol" style="margin-top:0.75rem">
              <input type="hidden" name="method" value="totp" />
              <button type="submit" class="grc-btn--link">
                Use an authenticator app instead
              </button>
            </form>
          )}
        </div>

        <div class="grc-panel">
          <h2>Backup codes</h2>
          <p>
            Each backup code passes the sign-in step once, when your usual method is unavailable.
            You have {remaining} unused {remaining === 1 ? 'code' : 'codes'}.
          </p>
          {!record.pendingMethod && backupCodes.length > 0 && (
            <>
              <p class="grc-notice" role="status">
                {codesShown
                  ? 'Your new backup codes are ready. They are shown only now; store them somewhere safe.'
                  : 'These codes are shown only until you confirm you have saved them; store them somewhere safe.'}
              </p>
              <ul>
                {backupCodes.map((c) => (
                  <li>
                    <code>{c}</code>
                  </li>
                ))}
              </ul>
              <form method="post" action="/api/auth/mfa/backup">
                <input type="hidden" name="op" value="hide" />
                <button type="submit" class="grc-btn grc-btn--secondary">
                  I have saved these codes
                </button>
              </form>
            </>
          )}
          {!record.pendingMethod && backupCodes.length === 0 && (
            <form method="post" action="/api/auth/mfa/backup" style="margin-top:0.75rem">
              <button type="submit" class="grc-btn grc-btn--primary">
                Generate new backup codes
              </button>
            </form>
          )}
          {record.pendingMethod === 'totp' && (
            <p class="grc-field__hint">
              Fresh backup codes come with the authenticator app setup below and replace these when
              you confirm it.
            </p>
          )}
        </div>

        {pendingTotp && (
          <>
            <div class="grc-panel">
              <h2>1. Scan the code</h2>
              <p>Scan with your authenticator app, or enter the key manually.</p>
              <div
                style="max-width:13rem;background:#fff;padding:0.5rem;border-radius:8px"
                set:html={qrSvg}
              />
              <p>
                Manual key: <code>{grouped}</code>
              </p>
            </div>
            <div class="grc-panel">
              <h2>2. Save your backup codes</h2>
              <p>
                Each code works once, when your authenticator app is unavailable. They are shown
                only now; store them somewhere safe.
              </p>
              <ul>
                {backupCodes.map((c) => (
                  <li>
                    <code>{c}</code>
                  </li>
                ))}
              </ul>
            </div>
            <div class="grc-panel">
              <h2>3. Confirm a code</h2>
              <form method="post" action="/api/auth/mfa/confirm">
                <div class="grc-field" style="max-width:14rem">
                  <label for="code">Code from the app</label>
                  <input
                    type="text"
                    id="code"
                    name="code"
                    class="grc-input"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    required
                  />
                </div>
                <button type="submit" class="grc-btn grc-btn--primary">
                  Activate the authenticator app
                </button>
              </form>
              <form method="post" action="/api/auth/mfa/enrol" style="margin-top:0.75rem">
                <input type="hidden" name="method" value="email" />
                <button type="submit" class="grc-btn--link">
                  Cancel and stay on email codes
                </button>
              </form>
            </div>
          </>
        )}
      </>
    )
  }
</GrcLayout>
