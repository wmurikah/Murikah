---
export const prerender = false;

/**
 * MFA enrolment. Any signed-in user can enrol voluntarily; a user whose role
 * requires a second factor is locked to this screen by the middleware until
 * they confirm. Enrolment starts with a POST to /api/auth/mfa/enrol (a fresh
 * sealed secret and backup codes); this screen then shows the QR (rendered
 * in-worker, no external service), the manual key and the backup codes, and
 * confirming a first code at /api/auth/mfa/confirm activates the factor and
 * keeps only the backup-code hashes. A confirmed factor is shown as active;
 * replacing it is an administrative reset, not self-service.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import { renderSVG } from 'uqr';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { guardPageLoad } from '@grc/pageGuard';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getMfaRecord, type MfaRecord } from '@grc/repos/mfa';
import { open } from '@grc/auth/secretBox';
import { otpauthUrl } from '@grc/auth/totp';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const done = Astro.url.searchParams.get('done') === '1';
const error = Astro.url.searchParams.get('error');

let record = null as MfaRecord | null;
let secret = null as string | null;
let backupCodes: string[] = [];
let qrSvg = '';
let loadError = false;

loadError = !(await guardPageLoad('mfa.setup', async () => {
  const env = getGrcEnv();
  const db = await getDb(env);
  record = await getMfaRecord(db, grc.homeOrganizationId, grc.userId);
  if (record && !record.confirmed) {
    secret = await open(env.sessionSecret, record.secret);
    if (record.backupPlain) {
      const plain = await open(env.sessionSecret, record.backupPlain);
      if (plain) backupCodes = JSON.parse(plain) as string[];
    }
    if (secret) {
      qrSvg = renderSVG(otpauthUrl(grc.userEmail ?? grc.userId, secret), {
        pixelSize: 4,
      });
    }
  }
}));

const confirmed = record?.confirmed === true;
const pending = record != null && !confirmed && secret != null;
const grouped = secret ? (secret.match(/.{1,4}/g) ?? []).join(' ') : '';
---

<GrcLayout title="Two-step verification">
  <div class="grc-page-head">
    <div>
      <h1>Two-step verification</h1>
      <p class="grc-lead">Protect your account with an authenticator app.</p>
    </div>
  </div>

  {
    done && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        Two-step verification is now active. You will be asked for a code at your next sign-in.
      </p>
    )
  }
  {
    error && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        {decodeURIComponent(error)}
      </p>
    )
  }

  {
    loadError ? (
      <GrcErrorCard subject="The enrolment state" />
    ) : confirmed ? (
      <div class="grc-panel">
        <h2>Active</h2>
        <p>
          Two-step verification is enabled for your account. Sign-in asks for a code from your
          authenticator app; a backup code works when the app is unavailable, once each. If you lose
          both, contact your administrator to reset the factor.
        </p>
      </div>
    ) : pending ? (
      <>
        <div class="grc-panel">
          <h2>1. Scan the code</h2>
          <p>Scan with your authenticator app, or enter the key manually.</p>
          <div
            style="max-width:13rem;background:#fff;padding:0.5rem;border-radius:8px"
            set:html={qrSvg}
          />
          <p>
            Manual key: <code>{grouped}</code>
          </p>
        </div>
        <div class="grc-panel">
          <h2>2. Save your backup codes</h2>
          <p>
            Each code works once, when your authenticator app is unavailable. They are shown only
            now; store them somewhere safe.
          </p>
          <ul>
            {backupCodes.map((c) => (
              <li>
                <code>{c}</code>
              </li>
            ))}
          </ul>
        </div>
        <div class="grc-panel">
          <h2>3. Confirm a code</h2>
          <form method="post" action="/api/auth/mfa/confirm">
            <div class="grc-field" style="max-width:14rem">
              <label for="code">Code from the app</label>
              <input
                type="text"
                id="code"
                name="code"
                class="grc-input"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                required
              />
            </div>
            <button type="submit" class="grc-btn grc-btn--primary">
              Activate two-step verification
            </button>
          </form>
        </div>
      </>
    ) : (
      <div class="grc-panel">
        <h2>Not enabled</h2>
        <p>
          Two-step verification asks for a 6-digit code from an authenticator app at sign-in, on top
          of your password.
        </p>
        <form method="post" action="/api/auth/mfa/enrol">
          <button type="submit" class="grc-btn grc-btn--primary">
            Start enrolment
          </button>
        </form>
      </div>
    )
  }
</GrcLayout>
