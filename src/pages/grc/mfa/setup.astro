---
export const prerender = false;

/**
 * MFA enrolment (Build Prompt 34: two methods). Any signed-in user can enrol
 * voluntarily; a user whose role requires a second factor is locked to this
 * screen by the middleware until they confirm. The user picks a method:
 * Authenticator app (a sealed secret shown as a QR rendered in-worker, plus
 * the manual key) or Email code (a 6-digit code emailed through the Graph
 * sender). Both show the backup codes once while pending, and confirming a
 * first code at /api/auth/mfa/confirm activates the factor, keeping only the
 * backup-code hashes. A confirmed user may switch to the other method; the
 * active factor keeps working until the new one confirms. Replacing the same
 * method's factor is an administrative reset, not self-service.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import { renderSVG } from 'uqr';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { guardPageLoad } from '@grc/pageGuard';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getMfaRecord, type MfaRecord } from '@grc/repos/mfa';
import { open } from '@grc/auth/secretBox';
import { otpauthUrl } from '@grc/auth/totp';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const done = Astro.url.searchParams.get('done') === '1';
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');

let loaded = null as MfaRecord | null;
let secret = null as string | null;
let backupCodes: string[] = [];
let qrSvg = '';
let loadError = false;

loadError = !(await guardPageLoad('mfa.setup', async () => {
  const env = getGrcEnv();
  const db = await getDb(env);
  loaded = await getMfaRecord(db, grc.homeOrganizationId, grc.userId);
  if (loaded?.pendingMethod) {
    if (loaded.backupPlain) {
      const plain = await open(env.sessionSecret, loaded.backupPlain);
      if (plain) backupCodes = JSON.parse(plain) as string[];
    }
    if (loaded.pendingMethod === 'totp' && loaded.pendingSecret) {
      secret = await open(env.sessionSecret, loaded.pendingSecret);
      if (secret) {
        qrSvg = renderSVG(otpauthUrl(grc.userEmail ?? grc.userId, secret), {
          pixelSize: 4,
        });
      }
    }
  }
}));

const record = loaded as MfaRecord | null;
const confirmed = record?.confirmed === true;
const pendingMethod = record?.pendingMethod;
const pendingTotp = pendingMethod === 'totp' && secret != null;
const pendingEmail = pendingMethod === 'email';
const activeMethod = confirmed ? (record?.method ?? 'totp') : null;
const grouped = secret ? (secret.match(/.{1,4}/g) ?? []).join(' ') : '';

const email = grc.userEmail ?? '';
const at = email.indexOf('@');
const maskedEmail = at > 0 ? `${email[0]}***${email.slice(at)}` : 'your address';
---

<GrcLayout title="Two-step verification">
  <div class="grc-page-head">
    <div>
      <h1>Two-step verification</h1>
      <p class="grc-lead">
        Protect your account with an authenticator app or a code emailed at sign-in.
      </p>
    </div>
  </div>

  {
    done && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        Two-step verification is now active. You will be asked for a code at your next sign-in.
      </p>
    )
  }
  {
    sent && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        A code has been emailed to {maskedEmail}. It works once and expires in ten minutes.
      </p>
    )
  }
  {
    error && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        {decodeURIComponent(error)}
      </p>
    )
  }

  {
    loadError ? (
      <GrcErrorCard subject="The enrolment state" />
    ) : (
      <>
        {confirmed && (
          <div class="grc-panel">
            <h2>Active</h2>
            <p>
              {activeMethod === 'email'
                ? 'Two-step verification is enabled with email codes: sign-in emails a 6-digit code to your address.'
                : 'Two-step verification is enabled with your authenticator app: sign-in asks for a code from the app.'}{' '}
              A backup code works when the method is unavailable, once each. If you lose both,
              contact your administrator to reset the factor.
            </p>
            {!pendingMethod && (
              <form method="post" action="/api/auth/mfa/enrol" style="margin-top:0.75rem">
                <input
                  type="hidden"
                  name="method"
                  value={activeMethod === 'email' ? 'totp' : 'email'}
                />
                <button type="submit" class="grc-btn grc-btn--secondary">
                  {activeMethod === 'email'
                    ? 'Switch to an authenticator app'
                    : 'Switch to email codes'}
                </button>
              </form>
            )}
            {pendingMethod && (
              <p class="grc-field__hint" style="margin-top:0.75rem">
                A switch to {pendingMethod === 'email' ? 'email codes' : 'an authenticator app'} is
                in progress below. Your current method keeps working until you confirm it.
              </p>
            )}
          </div>
        )}

        {pendingTotp && (
          <>
            <div class="grc-panel">
              <h2>1. Scan the code</h2>
              <p>Scan with your authenticator app, or enter the key manually.</p>
              <div
                style="max-width:13rem;background:#fff;padding:0.5rem;border-radius:8px"
                set:html={qrSvg}
              />
              <p>
                Manual key: <code>{grouped}</code>
              </p>
            </div>
            <div class="grc-panel">
              <h2>2. Save your backup codes</h2>
              <p>
                Each code works once, when your authenticator app is unavailable. They are shown
                only now; store them somewhere safe.
              </p>
              <ul>
                {backupCodes.map((c) => (
                  <li>
                    <code>{c}</code>
                  </li>
                ))}
              </ul>
            </div>
            <div class="grc-panel">
              <h2>3. Confirm a code</h2>
              <form method="post" action="/api/auth/mfa/confirm">
                <div class="grc-field" style="max-width:14rem">
                  <label for="code">Code from the app</label>
                  <input
                    type="text"
                    id="code"
                    name="code"
                    class="grc-input"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    required
                  />
                </div>
                <button type="submit" class="grc-btn grc-btn--primary">
                  Activate two-step verification
                </button>
              </form>
            </div>
          </>
        )}

        {pendingEmail && (
          <>
            <div class="grc-panel">
              <h2>1. Check your email</h2>
              <p>
                We emailed a 6-digit code to {maskedEmail}. It works once and expires in ten
                minutes.
              </p>
              <form method="post" action="/api/auth/mfa/send">
                <button type="submit" class="grc-btn grc-btn--secondary">
                  Send a new code
                </button>
              </form>
            </div>
            <div class="grc-panel">
              <h2>2. Save your backup codes</h2>
              <p>
                Each code works once, when your email is unavailable. They are shown only now; store
                them somewhere safe.
              </p>
              <ul>
                {backupCodes.map((c) => (
                  <li>
                    <code>{c}</code>
                  </li>
                ))}
              </ul>
            </div>
            <div class="grc-panel">
              <h2>3. Confirm the code</h2>
              <form method="post" action="/api/auth/mfa/confirm">
                <div class="grc-field" style="max-width:14rem">
                  <label for="code">Code from the email</label>
                  <input
                    type="text"
                    id="code"
                    name="code"
                    class="grc-input"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    required
                  />
                </div>
                <button type="submit" class="grc-btn grc-btn--primary">
                  Activate two-step verification
                </button>
              </form>
            </div>
          </>
        )}

        {!confirmed && !pendingMethod && (
          <div class="grc-panel">
            <h2>Choose a method</h2>
            <p>
              Two-step verification asks for a 6-digit code at sign-in, on top of your password.
              Pick how you want to receive it; you can switch later.
            </p>
            <div class="grc-actions" style="margin-top:0.75rem">
              <form method="post" action="/api/auth/mfa/enrol">
                <input type="hidden" name="method" value="totp" />
                <button type="submit" class="grc-btn grc-btn--primary">
                  Use an authenticator app
                </button>
              </form>
              <form method="post" action="/api/auth/mfa/enrol">
                <input type="hidden" name="method" value="email" />
                <button type="submit" class="grc-btn grc-btn--secondary">
                  Use email codes
                </button>
              </form>
            </div>
          </div>
        )}
      </>
    )
  }
</GrcLayout>
