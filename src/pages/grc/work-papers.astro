---
export const prerender = false;

/**
 * Work papers list (Workpaperslist): a full-width, dense, drillable list scoped
 * to the acting organisation, filterable by status, audit area, affiliate,
 * auditor, year and risk rating, with a full-text search over the observation
 * and recommendation. Gate: WORK_PAPERS.view. Each row drills through to the
 * detail with the shared affordance cues.
 *
 * An auditor can also release several drafts at once (Build Prompt 53): the
 * drafts they may submit carry a checkbox and one button submits them all
 * through the same transition engine the detail's Submit button uses. The
 * checkbox is offered only where the move would actually be allowed, so the
 * list never invites an action it will then refuse.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import GrcAffiliateNotice from '@/components/grc/GrcAffiliateNotice.astro';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { can } from '@grc/auth/rbac';
import { guardPageLoad } from '@grc/pageGuard';
import {
  listWorkPapers,
  type WorkPaperListRow,
  type WorkPaperFilters,
} from '@grc/repos/workPapers';
import {
  listAuditAreas,
  listAffiliates,
  listAuditors,
  type Option,
} from '@grc/repos/workPaperLookups';
import { loadEnumLabels, statusLabel } from '@grc/repos/enums';
import { loadEnumValues } from '@grc/workflow/transitions';
import { WORK_PAPER_ENUM_TYPE, WP_STATUS } from '@grc/workflow/workPaperActions';
import { holdsTransitionGrant } from '@grc/workflow/workPaperWorkflow';
import { loadDropdown, DROPDOWN_KEYS, DROPDOWN_DEFAULTS } from '@grc/repos/dropdowns';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'read', 'WORK_PAPER');
const canCreate = can(Astro.locals, 'create', 'WORK_PAPER');
// The permission the batch release needs, asked of the one guard the detail's
// Submit button and the batch endpoint both go through (Build Prompt 56). The
// batch is many submissions, not a different kind of submission, so this page
// may not carry its own idea of what submitting requires.
const canSubmit = holdsTransitionGrant(grc.matrix, WP_STATUS.DRAFT, WP_STATUS.SUBMITTED);
const p = Astro.url.searchParams;
const filters: WorkPaperFilters = {
  status: p.get('status') || undefined,
  auditAreaId: p.get('area') || undefined,
  affiliateCode: p.get('affiliate') || undefined,
  assignedAuditorId: p.get('auditor') || undefined,
  year: p.get('year') || undefined,
  riskRating: p.get('risk') || undefined,
  q: p.get('q') || undefined,
};

let rows: WorkPaperListRow[] = [];
let areas: Option[] = [];
let affiliates: Option[] = [];
let auditors: Option[] = [];
let statuses: string[] = [];
let riskRatings: string[] = [];
let labels = new Map<string, string>();
let loadError = false;
if (allowed) {
  loadError = !(await guardPageLoad('work-papers.list', async () => {
    const db = await getDb(getGrcEnv());
    [rows, areas, affiliates, auditors, statuses, riskRatings, labels] = await Promise.all([
      listWorkPapers(
        db,
        grc.organizationId,
        {
          userId: grc.userId,
          roleCode: grc.roleCode,
          perms: grc.perms,
          isPlatformOwner: grc.isPlatformOwner,
          affiliateScope: grc.affiliateScope,
        },
        filters,
      ),
      listAuditAreas(db, grc.organizationId),
      listAffiliates(db, grc.organizationId),
      listAuditors(db, grc.organizationId),
      loadEnumValues(db, WORK_PAPER_ENUM_TYPE),
      loadDropdown(
        db,
        grc.organizationId,
        DROPDOWN_KEYS.riskRatings,
        DROPDOWN_DEFAULTS.riskRatings,
      ),
      loadEnumLabels(db, WORK_PAPER_ENUM_TYPE),
    ]);
  }));
}

const riskClass = (r: string | null): string => {
  const v = (r ?? '').toUpperCase();
  if (v === 'CRITICAL') return 'grc-pill grc-pill--risk-critical';
  if (v === 'HIGH') return 'grc-pill grc-pill--risk-high';
  if (v === 'MEDIUM') return 'grc-pill grc-pill--risk-medium';
  if (v === 'LOW') return 'grc-pill grc-pill--risk-low';
  return 'grc-pill';
};
const fmtDate = (d: string | null): string => (d ? d.slice(0, 10) : '');
const done = p.get('done');
const error = p.get('error');

/**
 * Whether this row may be released in a batch: it must be a draft, and it must
 * be the acting auditor's own unless they are a reviewer (or the platform
 * owner), who may release on someone's behalf. The transition engine is still
 * the authority; this only decides whether to offer the checkbox, so the list
 * never shows a tick box for something the save would refuse.
 */
const canSubmitRow = (r: WorkPaperListRow): boolean =>
  canSubmit &&
  r.status === WP_STATUS.DRAFT &&
  (r.assignedAuditorId === grc.userId ||
    grc.isPlatformOwner ||
    grc.perms.includes('WORK_PAPERS.review'));
const submittable = rows.filter(canSubmitRow);
---

<GrcLayout title="Work papers">
  <div class="grc-work-paper-page">
  <div class="grc-page-head">
    <div>
      <h1>Work papers</h1>
      <p class="grc-lead">Audit observations for {grc.organizationName}.</p>
    </div>
    {
      canCreate && (
        <a href="/work-papers/new" class="grc-btn grc-btn--primary">
          New work paper
        </a>
      )
    }
  </div>

  <GrcAffiliateNotice subject="observations" />

  {
    done && (
      <p class="grc-notice" role="status" style="margin-bottom:1rem">
        {decodeURIComponent(done)}
      </p>
    )
  }
  {
    error && (
      <p class="grc-error" role="alert" style="margin-bottom:1rem">
        {decodeURIComponent(error)}
      </p>
    )
  }

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        You do not have access to work papers.
      </p>
    ) : loadError ? (
      <GrcErrorCard subject="The work papers list" />
    ) : (
      <>
        <form method="get" class="grc-filters" role="search" aria-label="Filter work papers">
          <div class="grc-field" style="min-width:14rem">
            <label for="f-q">Search</label>
            <input
              type="search"
              id="f-q"
              name="q"
              class="grc-input"
              value={filters.q ?? ''}
              placeholder="Observation or recommendation"
            />
          </div>
          <div class="grc-field">
            <label for="f-status">Status</label>
            <select id="f-status" name="status" class="grc-select">
              <option value="">All</option>
              {statuses.map((sv) => (
                <option value={sv} selected={filters.status === sv}>
                  {statusLabel(labels, sv)}
                </option>
              ))}
            </select>
          </div>
          <div class="grc-field">
            <label for="f-area">Audit area</label>
            <select id="f-area" name="area" class="grc-select">
              <option value="">All</option>
              {areas.map((a) => (
                <option value={a.id} selected={filters.auditAreaId === a.id}>
                  {a.label}
                </option>
              ))}
            </select>
          </div>
          <div class="grc-field">
            <label for="f-affiliate">Affiliate</label>
            <select id="f-affiliate" name="affiliate" class="grc-select">
              <option value="">All</option>
              {affiliates.map((a) => (
                <option value={a.id} selected={filters.affiliateCode === a.id}>
                  {a.label}
                </option>
              ))}
            </select>
          </div>
          <div class="grc-field">
            <label for="f-auditor">Auditor</label>
            <select id="f-auditor" name="auditor" class="grc-select">
              <option value="">All</option>
              {auditors.map((a) => (
                <option value={a.id} selected={filters.assignedAuditorId === a.id}>
                  {a.label}
                </option>
              ))}
            </select>
          </div>
          <div class="grc-field">
            <label for="f-risk">Risk rating</label>
            <select id="f-risk" name="risk" class="grc-select">
              <option value="">All</option>
              {riskRatings.map((rr) => (
                <option value={rr} selected={filters.riskRating === rr}>
                  {rr}
                </option>
              ))}
            </select>
          </div>
          <div class="grc-field" style="max-width:7rem">
            <label for="f-year">Year</label>
            <input
              type="number"
              id="f-year"
              name="year"
              class="grc-input"
              value={filters.year ?? ''}
            />
          </div>
          <button type="submit" class="grc-btn grc-btn--secondary">
            Apply
          </button>
        </form>

        {rows.length === 0 ? (
          <div class="grc-empty">
            <p>
              <strong>No work papers match.</strong> Adjust the filters, or create the first
              observation.
            </p>
          </div>
        ) : (
          <form method="post" action="/api/work-papers/submit-batch" data-batch-submit>
            {submittable.length > 0 && (
              <div class="grc-actionbar" style="margin:0 0 0.75rem">
                <p class="grc-lead" style="margin:0">
                  Tick the drafts to release, then submit them together. Each one goes through the
                  same review workflow as submitting it on its own.
                </p>
                <button type="submit" class="grc-btn grc-btn--primary" data-batch-button disabled>
                  Submit selected for review
                </button>
              </div>
            )}
            {/* Column priority is declared here, where the table is written
                (Build Prompt 70). The five the reader came for always fit:
                reference, observation, risk, status and updated. The affiliate,
                the audit area and the auditor give way on a narrower screen and
                reappear under the observation, so nothing is lost, it is simply
                read where there is room. */}
            <div class="grc-tablewrap grc-tablewrap--fit">
              <table class="grc-table grc-table--responsive" aria-label="Observations">
                <thead>
                  <tr>
                    {submittable.length > 0 && (
                      <th scope="col" class="grc-nowrap">
                        <span class="grc-vh">Select for submission</span>
                      </th>
                    )}
                    <th scope="col" class="grc-nowrap">
                      Reference
                    </th>
                    <th scope="col">Observation</th>
                    <th scope="col" class="grc-col--secondary">
                      Affiliate
                    </th>
                    <th scope="col" class="grc-col--secondary">
                      Audit area
                    </th>
                    <th scope="col" class="grc-nowrap">
                      Risk
                    </th>
                    <th scope="col" class="grc-col--secondary">
                      Auditor
                    </th>
                    <th scope="col" class="grc-nowrap">
                      Status
                    </th>
                    <th scope="col" class="grc-nowrap grc-col--tertiary">
                      Updated
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      {submittable.length > 0 && (
                        <td>
                          {canSubmitRow(r) ? (
                            <input
                              type="checkbox"
                              name="work_paper_id"
                              value={r.id}
                              data-batch-row
                              aria-label={`Submit ${r.reference} for review`}
                            />
                          ) : (
                            <span class="grc-vh">Not available for batch submission</span>
                          )}
                        </td>
                      )}
                      <td class="grc-nowrap">
                        <a href={`/work-papers/${r.id}`}>{r.reference}</a>
                      </td>
                      <td>
                        {r.observationTitle || 'Untitled'}
                        {/* What the collapsed columns said, on the line the
                            observation already occupies. */}
                        <span class="grc-cell__meta">
                          {[
                            r.affiliateName ?? r.affiliateCode,
                            r.auditAreaName,
                            r.assignedAuditorName,
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </span>
                      </td>
                      <td class="grc-col--secondary">
                        {r.affiliateName ?? r.affiliateCode ?? '-'}
                      </td>
                      <td class="grc-col--secondary">{r.auditAreaName ?? '-'}</td>
                      <td class="grc-nowrap">
                        {r.riskRating ? (
                          <span class={riskClass(r.riskRating)}>{r.riskRating}</span>
                        ) : (
                          '-'
                        )}
                      </td>
                      <td class="grc-col--secondary">{r.assignedAuditorName ?? '-'}</td>
                      <td class="grc-nowrap">
                        <span class="grc-pill">{statusLabel(labels, r.status)}</span>
                      </td>
                      <td class="grc-num grc-col--tertiary">{fmtDate(r.updatedAt)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </form>
        )}
      </>
    )
  }
  </div>
</GrcLayout>

<script>
  // The batch button is disabled until something is ticked, so it never poses
  // as an action with nothing to act on. Progressive: with no JavaScript the
  // button is simply enabled and the endpoint refuses an empty selection with a
  // message, which is the same answer arrived at a step later.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-batch-submit]')) {
    const button = form.querySelector<HTMLButtonElement>('[data-batch-button]');
    if (!button) continue;
    const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('[data-batch-row]'));
    const sync = (): void => {
      const chosen = boxes.filter((b) => b.checked).length;
      button.disabled = chosen === 0;
      button.textContent =
        chosen === 0 ? 'Submit selected for review' : `Submit ${chosen} for review`;
    };
    for (const box of boxes) box.addEventListener('change', sync);
    sync();
  }
</script>
