---
export const prerender = false;

/**
 * Edit an action plan (Actionplanform, edit). Gate: ACTION_PLANS.edit, and only
 * while the plan is not yet verified or closed (a completed plan is part of the
 * record). Prefills the action, owners and due date; on submit the endpoint
 * updates the fields and re-syncs the owners.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import GrcRichText from '@/components/grc/GrcRichText.astro';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { can } from '@grc/auth/rbac';
import { guardPageLoad } from '@grc/pageGuard';
import {
  getActionPlan,
  listWorkPaperOptions,
  PRIORITIES,
  type WorkPaperOption,
} from '@grc/repos/actionPlans';
import { parseOwnerIds } from '@grc/repos/actionPlanOwners';
import { listAuditors, type Option } from '@grc/repos/workPaperLookups';
import { isEditableByAuditor } from '@grc/workflow/actionPlanActions';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');
const { id } = Astro.params;

const allowed = can(Astro.locals, 'update', 'ACTION_PLAN');
const failed = Astro.url.searchParams.get('error');

let plan = null as Awaited<ReturnType<typeof getActionPlan>>;
let workPapers: WorkPaperOption[] = [];
let users: Option[] = [];
let ownerIds: string[] = [];
let loadError = false;
if (allowed && id) {
  loadError = !(await guardPageLoad('action-plans.edit', async () => {
    const db = await getDb(getGrcEnv());
    plan = await getActionPlan(db, grc.organizationId, id);
    if (plan) {
      [workPapers, users] = await Promise.all([
        listWorkPaperOptions(db, grc.organizationId),
        listAuditors(db, grc.organizationId),
      ]);
      ownerIds = parseOwnerIds(plan.ownerIds);
    }
  }));
}
const editable = plan ? isEditableByAuditor(plan.status) : false;
const val = (key: string): string => {
  const raw = plan?.[key];
  return raw == null ? '' : String(raw);
};
---

<GrcLayout title="Edit action plan">
  <div class="grc-page-head">
    <div>
      <h1>Edit action plan</h1>
      <p class="grc-lead">{plan ? String(plan.actionNumber) : ''}</p>
    </div>
    <a href={`/action-plans/${id}`} class="grc-btn grc-btn--secondary">Back to plan</a>
  </div>

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        You do not have permission to edit an action plan.
      </p>
    ) : loadError ? (
      <GrcErrorCard subject="This action plan" />
    ) : !plan ? (
      <p class="grc-empty">That action plan was not found in your organisation.</p>
    ) : !editable ? (
      <p class="grc-error" role="alert">
        A verified or closed plan cannot be edited.
      </p>
    ) : (
      <>
        {failed && (
          <p class="grc-error" role="alert" style="margin-bottom:1rem">
            The action plan could not be saved. Check the fields and try again.
          </p>
        )}
        <form method="post" action={`/api/action-plans/${id}`} class="grc-form">
          <div class="grc-field">
            <label for="work-paper">Work paper (finding)</label>
            <select id="work-paper" name="work_paper_id" class="grc-select" required>
              <option value="">Choose the parent finding</option>
              {workPapers.map((w) => (
                <option value={w.id} selected={val('work_paper_id') === w.id}>
                  {w.label}
                </option>
              ))}
            </select>
          </div>

          <div class="grc-field">
            <label for="desc">Action description</label>
            <GrcRichText
              id="desc"
              name="action_description"
              rows={4}
              maxlength={2000}
              required
              value={val('action_description')}
            />
          </div>

          <div class="grc-field">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" class="grc-select">
              {PRIORITIES.map((pr) => (
                <option value={pr} selected={val('priority') === pr}>
                  {pr}
                </option>
              ))}
            </select>
          </div>

          <div class="grc-field">
            <label for="target">Target date</label>
            <input
              type="date"
              id="target"
              name="target_date"
              class="grc-input"
              value={val('target_date').slice(0, 10)}
            />
            <p class="grc-field__hint">
              The agreed remediation date. The due date defaults to it when left blank.
            </p>
          </div>

          <div class="grc-field">
            <label for="due">Due date</label>
            <input
              type="date"
              id="due"
              name="due_date"
              class="grc-input"
              value={val('due_date').slice(0, 10)}
            />
          </div>

          <div class="grc-field">
            <label for="notes">Implementation notes</label>
            <GrcRichText
              id="notes"
              name="implementation_notes"
              rows={3}
              maxlength={2000}
              value={val('implementation_notes')}
            />
          </div>

          <div class="grc-field">
            <label for="owners">Owners</label>
            <select id="owners" name="owner_ids" class="grc-select" multiple size="6">
              {users.map((u) => (
                <option value={u.id} selected={ownerIds.includes(u.id)}>
                  {u.label}
                </option>
              ))}
            </select>
            <p class="grc-field__hint">Hold Ctrl or Cmd to select more than one owner.</p>
          </div>

          <div class="grc-actionbar">
            <button type="submit" class="grc-btn grc-btn--primary">
              Save changes
            </button>
            <a href={`/action-plans/${id}`} class="grc-btn grc-btn--secondary">
              Cancel
            </a>
          </div>
        </form>
      </>
    )
  }
</GrcLayout>
