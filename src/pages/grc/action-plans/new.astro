---
export const prerender = false;

/**
 * Create an action plan (Actionplanform, new). Gate: ACTION_PLANS.create, or
 * AUDITEE.respond for an auditee proposing a plan (recorded as auditee_proposed).
 * Captures the finding it remediates, the action, its owners and the due date.
 * On submit the endpoint creates the plan, seeds its owners and redirects to the
 * detail.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import GrcRichText from '@/components/grc/GrcRichText.astro';
import GrcEvidence from '@/components/grc/GrcEvidence.astro';
import { storageConfigured } from '@grc/storage';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { can } from '@grc/auth/rbac';
import { guardPageLoad } from '@grc/pageGuard';
import { listWorkPaperOptions, PRIORITIES, type WorkPaperOption } from '@grc/repos/actionPlans';
import { listAuditors, type Option } from '@grc/repos/workPaperLookups';
import { aiEnabled } from '@grc/ai/gate';
import { AI_DISCLAIMER } from '@grc/ai/validation';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');

const canCreate = can(Astro.locals, 'create', 'ACTION_PLAN');
const canPropose = can(Astro.locals, 'create', 'AUDITEE_RESPONSE');
const draftToken = storageConfigured() ? crypto.randomUUID() : null;
const allowed = canCreate || canPropose;
const hasAi = aiEnabled((f) => grc.hasFeature(f));
const failed = Astro.url.searchParams.get('error');
const presetWorkPaper = Astro.url.searchParams.get('work_paper') ?? '';

let workPapers: WorkPaperOption[] = [];
let users: Option[] = [];
let loadError = false;
if (allowed) {
  loadError = !(await guardPageLoad('action-plans.new', async () => {
    const db = await getDb(getGrcEnv());
    [workPapers, users] = await Promise.all([
      listWorkPaperOptions(db, grc.organizationId),
      listAuditors(db, grc.organizationId),
    ]);
  }));
}
---

<GrcLayout title="New action plan">
  <div class="grc-page-head">
    <div>
      <h1>New action plan</h1>
      <p class="grc-lead">
        {
          canCreate
            ? 'Raise a remediation action against a finding.'
            : 'Propose a remediation action for review.'
        }
      </p>
    </div>
    <a href="/action-plans" class="grc-btn grc-btn--secondary">Back to list</a>
  </div>

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        You do not have permission to create an action plan.
      </p>
    ) : loadError ? (
      <GrcErrorCard subject="The action plan form" />
    ) : (
      <>
        {failed && (
          <p class="grc-error" role="alert" style="margin-bottom:1rem">
            {failed === 'invalid'
              ? 'The action plan could not be saved. Check the fields and try again.'
              : decodeURIComponent(failed)}
          </p>
        )}
        <form id="ap-form" method="post" action="/api/action-plans" class="grc-form">
          <div class="grc-field">
            <label for="work-paper">Work paper (finding)</label>
            <select id="work-paper" name="work_paper_id" class="grc-select" required>
              <option value="">Choose the parent finding</option>
              {workPapers.map((w) => (
                <option value={w.id} selected={presetWorkPaper === w.id}>
                  {w.label}
                </option>
              ))}
            </select>
          </div>

          <div class="grc-field">
            <label for="desc">Action description</label>
            <GrcRichText id="desc" name="action_description" rows={4} maxlength={2000} required />
          </div>

          <div class="grc-field">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" class="grc-select">
              {PRIORITIES.map((pr) => (
                <option value={pr} selected={pr === 'Medium'}>
                  {pr}
                </option>
              ))}
            </select>
          </div>

          <div class="grc-field">
            <label for="target">Target date</label>
            <input type="date" id="target" name="target_date" class="grc-input" />
            <p class="grc-field__hint">
              The agreed remediation date. The due date defaults to it when left blank.
            </p>
          </div>

          <div class="grc-field">
            <label for="due">Due date</label>
            <input type="date" id="due" name="due_date" class="grc-input" />
          </div>

          <div class="grc-field">
            <label for="notes">Implementation notes</label>
            <GrcRichText id="notes" name="implementation_notes" rows={3} maxlength={2000} />
          </div>

          <div class="grc-field">
            <label for="owners">Owners</label>
            <select id="owners" name="owner_ids" class="grc-select" multiple size="6">
              {users.map((u) => (
                <option value={u.id}>{u.label}</option>
              ))}
            </select>
            <p class="grc-field__hint">Hold Ctrl or Cmd to select more than one owner.</p>
          </div>

          {hasAi && (
            <div class="grc-field">
              <div class="grc-actionbar" style="margin:0 0 0.5rem;justify-content:space-between">
                <label style="margin:0">SMART quality check</label>
                <button type="button" id="ap-validate-btn" class="grc-btn grc-btn--secondary">
                  Check SMART quality
                </button>
              </div>
              <p class="grc-field__hint">{AI_DISCLAIMER}</p>
              <div id="ap-validate-status" class="grc-lead" role="status" aria-live="polite" />
              <div id="ap-validate-out" class="grc-ai-out" hidden />
            </div>
          )}

          <GrcEvidence
            entityType="action_plan_draft"
            entityId={draftToken ?? ''}
            canUpload={true}
            canDelete={true}
            draftToken={draftToken}
            storageReady={draftToken !== null}
            nested={true}
            heading="Supporting evidence"
          />

          <div class="grc-actionbar">
            <button type="submit" class="grc-btn grc-btn--primary">
              {canCreate ? 'Create action plan' : 'Propose action plan'}
            </button>
            <a href="/action-plans" class="grc-btn grc-btn--secondary">
              Cancel
            </a>
          </div>
        </form>
      </>
    )
  }
</GrcLayout>

<script>
  // On-demand SMART quality check. Posts the current form fields to the AI
  // validation endpoint (which falls back to a non-AI check when AI is off) and
  // renders the outcome as plain text, so nothing from the model becomes HTML.
  const btn = document.getElementById('ap-validate-btn');
  const form = document.getElementById('ap-form') as HTMLFormElement | null;
  const out = document.getElementById('ap-validate-out');
  const status = document.getElementById('ap-validate-status');
  interface Outcome {
    isValid?: boolean;
    score?: number;
    issues?: string[];
    suggestions?: string[];
    strengths?: string[];
    aiUsed?: boolean;
    error?: string;
  }
  btn?.addEventListener('click', async () => {
    if (!form || !out || !status) return;
    btn.setAttribute('disabled', 'true');
    status.textContent = 'Checking...';
    out.hidden = true;
    try {
      const res = await fetch('/api/ai/validate', { method: 'POST', body: new FormData(form) });
      const data = (await res.json()) as Outcome;
      if (data.error) {
        status.textContent = data.error;
        return;
      }
      const lines: string[] = [];
      lines.push(`Score: ${data.score ?? 0}/100${data.aiUsed ? '' : ' (basic check)'}`);
      lines.push(
        data.isValid ? 'Assessment: meets the SMART standard.' : 'Assessment: needs strengthening.',
      );
      const section = (title: string, items?: string[]): void => {
        if (items && items.length > 0) {
          lines.push('', `${title}:`);
          items.forEach((i) => lines.push(`- ${i}`));
        }
      };
      section('Issues', data.issues);
      section('Suggestions', data.suggestions);
      section('Strengths', data.strengths);
      out.textContent = lines.join('\n');
      out.hidden = false;
      status.textContent = '';
    } catch {
      status.textContent = 'The request failed. Try again.';
    } finally {
      btn.removeAttribute('disabled');
    }
  });
</script>
