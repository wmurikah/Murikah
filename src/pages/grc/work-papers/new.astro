---
export const prerender = false;

/**
 * Create a work paper (Workpaperform, new). Gate: WORK_PAPERS.create. Captures
 * the section 1 fields; the sub-area auto-populate runs client-side. On submit
 * the endpoint creates the draft and redirects to its detail.
 */
import GrcLayout from '@/layouts/GrcLayout.astro';
import WorkPaperForm from '@/components/grc/WorkPaperForm.astro';
import { aiEnabled } from '@grc/ai/gate';
import GrcErrorCard from '@/components/grc/GrcErrorCard.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { can } from '@grc/auth/rbac';
import { storageConfiguredFor } from '@grc/storage';
import { guardPageLoad } from '@grc/pageGuard';
import {
  listAuditAreas,
  listAffiliates,
  listAuditors,
  listSubAreas,
  type Option,
  type SubAreaTemplate,
} from '@grc/repos/workPaperLookups';
import {
  loadControlDropdowns,
  DROPDOWN_DEFAULTS,
  type ControlDropdowns,
} from '@grc/repos/dropdowns';

const grc = Astro.locals.grc;
if (!grc) return Astro.redirect('/login');
const hasAi = aiEnabled((f) => grc.hasFeature(f));

const allowed = can(Astro.locals, 'create', 'WORK_PAPER');
const failed = Astro.url.searchParams.get('error');
// Evidence staged on this form binds to the finding on save; without storage
// the section simply does not render.
const draftToken = (await storageConfiguredFor(grc.organizationId)) ? crypto.randomUUID() : null;

let areas: Option[] = [];
let affiliates: Option[] = [];
let auditors: Option[] = [];
let subAreas: SubAreaTemplate[] = [];
let dropdowns: ControlDropdowns = DROPDOWN_DEFAULTS;
let loadError = false;
if (allowed) {
  loadError = !(await guardPageLoad('work-papers.new', async () => {
    const db = await getDb(getGrcEnv());
    [areas, affiliates, auditors, subAreas, dropdowns] = await Promise.all([
      listAuditAreas(db, grc.organizationId),
      listAffiliates(db, grc.organizationId),
      listAuditors(db, grc.organizationId),
      listSubAreas(db, grc.organizationId),
      loadControlDropdowns(db, grc.organizationId),
    ]);
  }));
}
---

<GrcLayout title="New work paper">
  <div class="grc-page-head">
    <div>
      <h1>New work paper</h1>
      <p class="grc-lead">Record a finding as a draft.</p>
    </div>
    <a href="/work-papers" class="grc-btn grc-btn--secondary">Back to list</a>
  </div>

  {
    !allowed ? (
      <p class="grc-error" role="alert">
        You do not have permission to create a work paper.
      </p>
    ) : loadError ? (
      <GrcErrorCard subject="The work paper form" />
    ) : (
      <>
        {failed && (
          <p class="grc-error" role="alert" style="margin-bottom:1rem">
            The work paper could not be saved. Check the fields and try again.
          </p>
        )}
        <WorkPaperForm
          action="/api/work-papers"
          submitLabel="Create draft"
          areas={areas}
          affiliates={affiliates}
          auditors={auditors}
          subAreas={subAreas}
          dropdowns={dropdowns}
          values={null}
          hasAi={hasAi}
          evidence={{
            entityType: 'work_paper_draft',
            entityId: draftToken ?? '',
            items: [],
            canDelete: true,
            draftToken,
            storageReady: draftToken !== null,
          }}
        />
      </>
    )
  }
</GrcLayout>
