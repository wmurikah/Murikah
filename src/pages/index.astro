---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Card from '@/components/primitives/Card.astro';
import FeatureGrid from '@/components/primitives/FeatureGrid.astro';
import Faq from '@/components/primitives/Faq.astro';
import CtaSection from '@/components/primitives/CtaSection.astro';
import FaqPageSchema from '@/components/schema/FaqPage.astro';
import Container from '@/components/primitives/Container.astro';
import Button from '@/components/primitives/Button.astro';
import ProductLinks from '@/components/ProductLinks.astro';
import HeroFilm from '@/components/hero/HeroFilm.astro';
import { SITE, SERVICES, AUDIENCE } from '@/site.config';
import type { FaqItem } from '@/lib/types';

const topGuides = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const why = [
  {
    title: 'Nothing gets lost in the handover',
    body: 'The service, the platform and your board reporting share one structure, so evidence carries straight from fieldwork to the board pack without being rebuilt at each step.',
  },
];

const faqs: FaqItem[] = [
  {
    question: 'What does Murikah do?',
    answer:
      'Murikah helps organisations run, prove and improve internal audit and AI governance. We deliver co-sourced and outsourced internal audit, Assurance OS, advisory, training and automation builds in one joined-up relationship.',
  },
  {
    question: 'Who is Murikah for?',
    answer:
      'Heads of internal audit, audit committee and board chairs, CFOs, CEOs, and heads of risk and compliance at regulated mid-market organisations. Our first focus is SACCOs, banks, microfinance institutions, fintechs, donor-funded NGOs and family businesses with active boards.',
  },
  {
    question: 'Can we use the software and services separately?',
    answer:
      'We combine senior assurance judgement and the platform it runs on. You get people who can reason through the work, software that keeps evidence and follow-up moving, and a cost model designed for the mid-market.',
  },
];
---

<BaseLayout titleFull="Internal audit and AI governance | Murikah" description={SITE.description}>
  <section class="border-b border-hairline bg-surface py-6 lg:py-4" aria-labelledby="home-title">
    <Container>
      <div class="grid items-center gap-6 lg:grid-cols-2">
        <div>
          <p class="eyebrow">Internal audit · Governance · Software</p>
          <h1
            id="home-title"
            class="mt-6 font-serif text-[clamp(2.6rem,5vw,4.5rem)] leading-[1.06] tracking-tight text-navy"
          >
            Clear evidence.<br />Confident decisions.
          </h1>
          <p class="mt-6 max-w-xl text-xl leading-relaxed text-slate">
            Internal audit, AI governance and practical software for teams accountable to boards,
            regulators and customers.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/contact" size="lg">Discuss your requirements</Button>
            <Button href="/products" variant="ghost" size="lg">Explore products</Button>
          </div>
          <p class="mt-6 text-sm text-slate">
            Kenya and East Africa · Services scoped to your organisation
          </p>
        </div>
        <HeroFilm />
      </div>
    </Container>
  </section>
  <Section tone="paper" aria-labelledby="proof-title" class="border-b border-hairline">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <p class="eyebrow">See the work</p><h2
          id="proof-title"
          class="mt-4 font-serif text-3xl text-navy"
        >
          Working products you can explore.
        </h2>
      </div>
      <div>
        <p class="text-lg text-slate">
          Explore CMS for customer operations, GRC for audit, Tutor for learning and ENGR for
          maintenance.
        </p>
        <div class="mt-5 flex flex-wrap gap-6">
          <a href="/products">Explore the products →</a><a href="/about#how-we-work"
            >Review our approach →</a
          >
        </div>
      </div>
    </div>
  </Section>
  <Section tone="surface" aria-labelledby="products-title">
    <div class="mb-5">
      <p class="eyebrow">Products</p><h2
        id="products-title"
        class="mt-4 font-serif text-4xl text-navy"
      >
        Your work. The right workspace.
      </h2><p class="mt-4 text-slate">Open a product directly, or explore our services below.</p>
    </div>
    <ProductLinks />
  </Section>
  <Section tone="surface" aria-labelledby="services-title" class="border-b border-hairline">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow is-centred">What we do</p>
      <h2
        id="services-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.1] font-semibold tracking-[-0.015em] text-navy"
      >
        Specialist support where you need it.
      </h2>
      <p class="mt-5 text-lg text-slate">
        Five service lines, scoped to your priorities. Software is available separately through our
        products.
      </p>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.filter((s) => s.slug !== 'audit-os').map((s, i) => (
          <a href={s.href} class="group flex flex-col border-t border-hairline py-4 no-underline">
            <span class="text-sm font-semibold tracking-[0.16em] text-gold uppercase">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 text-2xl text-navy">{s.fullName}</h3>
            <p class="mt-3 text-slate">{s.summary}</p>
            <span class="mt-auto inline-flex items-center gap-2 pt-6 font-medium text-blue">
              View service{' '}
              <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section tone="paper" aria-labelledby="experience-title">
    <div class="grid items-start gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="reveal lg:sticky lg:top-28 lg:col-span-5">
        <p class="eyebrow">Why it works</p>
        <h2
          id="experience-title"
          class="mt-5 text-[length:var(--text-title)] leading-[1.1] font-semibold tracking-[-0.015em] text-navy"
        >
          From fieldwork to follow-up.
        </h2>
      </div>
      <div class="lg:col-span-7">
        {
          why.map((w) => (
            <div class="reveal border-t border-hairline py-4 first:border-t-0 first:pt-0">
              <h3 class="text-2xl text-navy">{w.title}</h3>
              <p class="mt-3 max-w-2xl text-lg text-slate">{w.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section tone="surface" aria-labelledby="audience-title" class="border-y border-hairline">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow is-centred">Who it is for</p>
      <h2
        id="audience-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.1] font-semibold tracking-[-0.015em] text-navy"
      >
        For teams accountable to boards, regulators and funders.
      </h2>
    </div>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
      {
        AUDIENCE.map((seg) => (
          <div class="reveal rounded-[1.6rem] bg-paper p-6 ring-1 ring-hairline">
            <p class="font-medium text-navy">{seg.name}</p>
            <p class="mt-2 text-sm text-slate">{seg.note}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {
    topGuides.length > 0 && (
      <Section tone="paper" aria-labelledby="guides-title">
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Insights</p>
            <h2
              id="guides-title"
              class="mt-5 text-[length:var(--text-title)] leading-[1.1] font-semibold tracking-[-0.015em] text-navy"
            >
              Learn the thinking behind the system
            </h2>
          </div>
          <a
            href="/insights"
            class="font-medium text-blue no-underline hover:text-blue-deep hover:underline"
          >
            All insights &rarr;
          </a>
        </div>
        <FeatureGrid cols={3} class="mt-6">
          {topGuides.map((g) => (
            <Card href={`/insights/${g.id}/`} class="reveal flex flex-col">
              {g.data.category && <p class="eyebrow text-xs">{g.data.category}</p>}
              <h3 class="mt-3 text-lg text-navy">{g.data.title}</h3>
              <p class="mt-2 grow text-slate">{g.data.description}</p>
              <span
                aria-hidden="true"
                class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-blue"
              >
                Read guide <span>&rarr;</span>
              </span>
            </Card>
          ))}
        </FeatureGrid>
      </Section>
    )
  }

  <Section tone="surface" aria-labelledby="home-faq" class="border-t border-hairline">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Questions</p>
      <h2
        id="home-faq"
        class="mt-5 text-[length:var(--text-title)] leading-[1.1] font-semibold tracking-[-0.015em] text-navy"
      >
        Questions before you enquire
      </h2>
    </div>
    <Faq items={faqs} class="reveal mt-6 max-w-3xl" />
    <FaqPageSchema items={faqs} />
  </Section>

  <CtaSection
    eyebrow="Discuss your requirements"
    title="Start with the work that matters most"
    body="Tell us what you need. We will respond within two working days."
    secondaryLabel="Explore products"
    secondaryHref="/products"
  />
</BaseLayout>
