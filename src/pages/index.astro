---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import CtaSection from '@/components/primitives/CtaSection.astro';
import Container from '@/components/primitives/Container.astro';
import Button from '@/components/primitives/Button.astro';
import AuditOsWalkthrough from '@/components/audit-os/AuditOsWalkthrough';
import { SITE, SERVICES, AUDIENCE, STANDARDS, PRIMARY_CTA, FOUNDER } from '@/site.config';

const serviceCards = SERVICES.filter((service) => service.slug !== 'assurance-os').map(
  (service, index) => ({
    ...service,
    shortSummary: [
      'Independent assurance over operations, systems, governance and data protection.',
      'Workflow automation and internal tools built after the process is understood.',
      'AI governance, analytics and decision support for executives and boards.',
      'Practical training for audit, risk, AI governance and assurance teams.',
      'Benchmarking and research that turns assurance data into context.',
    ][index],
  }),
);

---

<BaseLayout
  titleFull="Internal audit and Assurance OS | Murikah"
  description="Internal audit and Assurance OS for teams accountable to boards, regulators and customers. Plan, evidence, report and follow up in one connected workflow."
>
  <section
    id="hero"
    class="ceramic-hero overflow-hidden border-b border-hairline bg-paper"
    aria-labelledby="home-title"
  >
    <Container>
      <div class="mx-auto max-w-[70rem] pt-20 text-center md:pt-24 lg:pt-[6.5rem]">
        <h1
          id="home-title"
          class="mx-auto max-w-[13ch] font-sans text-[clamp(2.5rem,6vw,5rem)] leading-[1.05] font-semibold tracking-[-0.03em] text-balance text-navy"
        >
          <span class="block">Audit you can trace.</span>
          <span class="block">From plan to board pack.</span>
        </h1>

        <p
          class="mx-auto mt-6 max-w-[60ch] text-[clamp(1.25rem,2vw,1.375rem)] leading-[1.55] text-slate"
        >
          Murikah pairs senior internal audit with Assurance OS, so evidence, findings and actions
          stay linked.
        </p>

        <div class="mx-auto mt-10 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
          <Button href={PRIMARY_CTA.href} size="lg" class="w-full rounded-[12px] sm:w-auto">
            {PRIMARY_CTA.label}
          </Button>
          <Button
            href="/assurance-os/sandbox"
            variant="secondary"
            size="lg"
            class="w-full rounded-[12px] sm:w-auto"
          >
            Try with sample data →
          </Button>
        </div>

        <p class="mt-5 text-sm text-slate">
          Guided by IIA Standards · ISO/IEC 27001 · ISO/IEC 42001
        </p>
      </div>

      <figure
        class="hero-product-frame mx-auto mt-12 max-w-[1120px] overflow-hidden rounded-[16px] bg-surface ring-1 ring-hairline"
      >
        <img
          src="/images/assurance-os-trace.webp"
          alt="Assurance OS trace view linking an audit plan, evidence, a high-risk finding, an owned remediation action and the board pack."
          width="960"
          height="651"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-product-shot h-auto w-full"
        />
        <figcaption class="sr-only">
          Product-derived Assurance OS preview using fictional Murikah Demo records; no client data is shown.
        </figcaption>
      </figure>
    </Container>
  </section>

  <Section id="proof" tone="paper" aria-labelledby="proof-title" class="border-b border-hairline">
    <div class="max-w-3xl">
      <p class="eyebrow">Proof</p>
      <h2
        id="proof-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Evidence before claims.
      </h2>
      <p class="mt-4 text-lg text-slate">
        The person behind the work, the professional credentials and a quantified prior assurance
        programme are visible before you buy.
      </p>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <article class="rounded-card bg-surface p-6 ring-1 ring-hairline lg:col-span-5">
        <div class="flex items-start gap-4">
          <span
            aria-hidden="true"
            class="inline-flex size-14 shrink-0 items-center justify-center rounded-full bg-navy text-sm font-semibold tracking-[0.12em] text-paper"
          >
            WM
          </span>
          <div>
            <p class="text-xs font-semibold tracking-[0.12em] text-gold uppercase">Founder</p>
            <h3 class="mt-1 text-2xl text-navy">{FOUNDER.name}</h3>
            <p class="mt-1 text-sm text-slate">{FOUNDER.role}</p>
          </div>
        </div>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Founder credentials">
          {
            FOUNDER.credentials.map((credential) => (
              <li class="rounded-full bg-paper px-3 py-1.5 text-sm font-medium text-navy ring-1 ring-hairline">
                {credential}
              </li>
            ))
          }
        </ul>

        <p class="mt-5 text-sm leading-relaxed text-slate">{FOUNDER.research}</p>
        <a
          href={FOUNDER.scholarUrl}
          class="mt-4 inline-flex font-medium text-blue no-underline hover:underline"
        >
          View research record ↗
        </a>
      </article>

      <article class="rounded-card bg-navy p-6 text-paper shadow-card lg:col-span-7">
        <p class="text-xs font-semibold tracking-[0.12em] text-brass-on-dark uppercase">
          Anonymised prior assurance programme
        </p>
        <h3 class="mt-3 text-2xl text-white">From dispersed findings to one board-ready evidence trail.</h3>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-paper/75">
          These are real engagement metrics from prior practitioner work led by the founder. Client,
          system and location identifiers have been removed.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">93</p>
            <p class="mt-1 text-sm text-paper/70">observations consolidated across the programme</p>
          </div>
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">5</p>
            <p class="mt-1 text-sm text-paper/70">high-priority issues in one critical-platform review</p>
          </div>
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">1</p>
            <p class="mt-1 text-sm text-paper/70">management tracker carried into board reporting</p>
          </div>
        </div>

        <a
          href="/proof/report-extract"
          class="mt-6 inline-flex min-h-11 items-center font-medium text-white underline decoration-gold underline-offset-4"
        >
          Open the redacted report extract →
        </a>
      </article>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" aria-label="Standards our work follows">
      {
        STANDARDS.map((standard) => (
          <span class="rounded-full bg-paper px-3 py-1.5 text-sm text-navy ring-1 ring-hairline">
            {standard.short}
          </span>
        ))
      }
    </div>
  </Section>

  <Section id="platform" tone="surface" aria-labelledby="platform-title" class="border-b border-hairline">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow">Platform</p>
        <h2
          id="platform-title"
          class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
        >
          Assurance OS is the operating layer for the audit.
        </h2>
        <p class="mt-5 max-w-prose text-lg text-slate">
          Plan engagements, capture work papers, review evidence, raise findings, track actions and
          prepare committee reporting without rebuilding the trail in separate files.
        </p>
        <div class="mt-7">
          <Button href="/assurance-os/sandbox" size="lg">Try the public sandbox</Button>
        </div>
        <p class="mt-4 text-sm">
          <a href="/assurance-os" class="font-medium text-blue no-underline hover:underline">
            See Assurance OS →
          </a>
        </p>
      </div>
      <div class="lg:col-span-7">
        <AuditOsWalkthrough client:visible />
      </div>
    </div>
  </Section>

  <Section id="services" tone="paper" aria-labelledby="services-title" class="border-b border-hairline">
    <div class="max-w-3xl">
      <p class="eyebrow">Services</p>
      <h2
        id="services-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Specialist work around the platform.
      </h2>
      <p class="mt-4 text-lg text-slate">
        Start with the service you need. The Services page compares who each line is for, what it
        produces and how it starts.
      </p>
    </div>

    <div class="mt-8 grid gap-x-8 gap-y-2 md:grid-cols-2">
      {
        serviceCards.map((service, index) => (
          <a
            href={service.href}
            class="group grid grid-cols-[2.4rem_1fr] gap-3 border-t border-hairline py-5 no-underline"
          >
            <span class="pt-1 text-xs font-semibold tracking-[0.14em] text-gold uppercase">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>
              <span class="block text-xl font-semibold text-navy">{service.fullName}</span>
              <span class="mt-1.5 block text-sm leading-relaxed text-slate">{service.shortSummary}</span>
              <span class="mt-3 inline-flex text-sm font-medium text-blue group-hover:underline">
                Compare this service →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="audience" tone="surface" aria-labelledby="audience-title" class="border-b border-hairline">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow is-centred">Audience</p>
      <h2
        id="audience-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Built for teams accountable to boards, regulators and funders.
      </h2>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
      {
        AUDIENCE.map((segment) =>
          segment.href ? (
            <a
              href={segment.href}
              class="group rounded-[1.4rem] bg-paper p-5 no-underline ring-1 ring-hairline transition-shadow hover:shadow-card"
            >
              <h3 class="font-medium text-navy">{segment.name}</h3>
              <p class="mt-2 text-sm text-slate">{segment.note}</p>
              <span class="mt-4 inline-flex text-sm font-medium text-blue group-hover:underline">
                View your path →
              </span>
            </a>
          ) : (
            <article class="rounded-[1.4rem] bg-paper p-5 ring-1 ring-hairline">
              <h3 class="font-medium text-navy">{segment.name}</h3>
              <p class="mt-2 text-sm text-slate">{segment.note}</p>
            </article>
          ),
        )
      }
    </div>
    <p class="mt-6 text-center text-sm text-slate">{SITE.areaServed}</p>
  </Section>

  <CtaSection
    id="contact"
    eyebrow="Contact"
    title="Book a 20-minute call"
    body="Tell us what you are trying to improve. We will confirm a short call and the right next step."
    primaryLabel={PRIMARY_CTA.label}
    primaryHref={PRIMARY_CTA.href}
  />
</BaseLayout>
