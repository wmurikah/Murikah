---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import Breadcrumb from '@/components/primitives/Breadcrumb.astro';
import CtaSection from '@/components/primitives/CtaSection.astro';
import { SERVICES, PRIMARY_CTA } from '@/site.config';

const serviceLines = SERVICES.filter((service) => service.slug !== 'assurance-os');

const comparison: Record<string, { bestFor: string; output: string; start: string }> = {
  'internal-audit': {
    bestFor: 'Heads of internal audit, audit committees and organisations that need an independent function or specialist capacity.',
    output: 'Risk-based plan, evidenced fieldwork, findings, committee reporting and tracked remediation.',
    start: 'Usually within a few weeks once scope, access and reporting lines are agreed.',
  },
  automation: {
    bestFor: 'Finance, operations and compliance teams carrying repetitive manual workflows or disconnected systems.',
    output: 'A mapped process, working automation or integration, testing and handover.',
    start: 'After a process walk-through and build scope are agreed.',
  },
  advisory: {
    bestFor: 'Boards and executives making decisions on AI, governance, risk, analytics or strategy.',
    output: 'A decision-ready roadmap, analysis, executive deck or board paper.',
    start: 'After the decision question, evidence needs and deliverable are agreed.',
  },
  training: {
    bestFor: 'Audit, risk, finance and governance teams building practical capability or preparing for CISA and ISO 42001 work.',
    output: 'A focused cohort or in-house learning programme grounded in applied work.',
    start: 'At the next published cohort or on an agreed in-house date.',
  },
  research: {
    bestFor: 'Organisations that want sector context on control maturity, findings and remediation performance.',
    output: 'Benchmark participation and research outputs as the founding dataset develops.',
    start: 'Founding-cohort onboarding is agreed directly while the benchmark is being built.',
  },
};

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
];
---

<BaseLayout
  titleFull="Compare internal audit, automation, advisory and training services | Murikah"
  description="Compare Murikah service lines by who they are for, the output you receive and how quickly each engagement can start."
>
  <Section
    tone="surface"
    aria-labelledby="page-title"
    class="relative overflow-hidden border-b border-hairline"
  >
    <div aria-hidden="true" class="aperture -top-40 -right-24 h-[30rem] w-[40rem] opacity-50"></div>
    <div class="relative max-w-3xl">
      <Breadcrumb items={crumbs} class="mb-7" />
      <p class="eyebrow">Services</p>
      <h1
        id="page-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.05] font-semibold tracking-[-0.015em] text-balance text-navy"
      >
        Choose the service by the outcome you need.
      </h1>
      <p class="mt-6 max-w-2xl text-xl text-slate">
        Compare each line by who it is for, what you receive and how it starts. Assurance OS is the
        platform beneath the audit workflow, not another consulting service.
      </p>
      <div class="mt-8">
        <Button href={PRIMARY_CTA.href} size="lg">{PRIMARY_CTA.label}</Button>
      </div>
      <p class="mt-4 text-sm text-slate">
        Need software rather than a service?{' '}
        <a href="/assurance-os" class="font-medium text-blue no-underline hover:underline">
          See Assurance OS →
        </a>
      </p>
    </div>
  </Section>

  <Section tone="paper" aria-labelledby="compare-title">
    <div class="max-w-3xl">
      <p class="eyebrow">Comparison</p>
      <h2
        id="compare-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        What each line is for.
      </h2>
      <p class="mt-4 text-slate">
        Start timing depends on scope and availability. Where a fixed date is not published, the
        table shows the practical condition that must be agreed before kickoff.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto rounded-card ring-1 ring-hairline">
      <table class="min-w-[62rem] w-full border-collapse bg-surface text-left">
        <thead class="bg-paper-shade">
          <tr class="border-b border-hairline">
            <th scope="col" class="px-5 py-4 text-sm font-semibold text-navy">Service</th>
            <th scope="col" class="px-5 py-4 text-sm font-semibold text-navy">Best for</th>
            <th scope="col" class="px-5 py-4 text-sm font-semibold text-navy">What you get</th>
            <th scope="col" class="px-5 py-4 text-sm font-semibold text-navy">Typical start</th>
          </tr>
        </thead>
        <tbody>
          {
            serviceLines.map((service) => {
              const detail = comparison[service.slug];
              return (
                <tr class="border-b border-hairline last:border-b-0 align-top">
                  <th scope="row" class="w-48 px-5 py-5">
                    <a href={service.href} class="font-semibold text-blue no-underline hover:underline">
                      {service.fullName}
                    </a>
                  </th>
                  <td class="max-w-xs px-5 py-5 text-sm leading-relaxed text-slate">{detail.bestFor}</td>
                  <td class="max-w-xs px-5 py-5 text-sm leading-relaxed text-slate">{detail.output}</td>
                  <td class="max-w-xs px-5 py-5 text-sm leading-relaxed text-slate">{detail.start}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </Section>

  <CtaSection
    eyebrow="Choose a starting point"
    title="Book a 20-minute call"
    body="Tell us the outcome you need. We will help you identify the smallest useful starting scope."
    primaryLabel={PRIMARY_CTA.label}
    primaryHref={PRIMARY_CTA.href}
  />
</BaseLayout>
