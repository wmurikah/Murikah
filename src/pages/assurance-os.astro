---
export const prerender = true;

import ServiceLayout from '@/layouts/ServiceLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Card from '@/components/primitives/Card.astro';
import FeatureGrid from '@/components/primitives/FeatureGrid.astro';
import AuditOsWalkthrough from '@/components/audit-os/AuditOsWalkthrough';
import { PRICING, PRIMARY_CTA } from '@/site.config';
import type { FaqItem } from '@/lib/types';

const features = [
  {
    title: 'Engagements and work papers',
    body: 'Plan engagements, prepare work papers, attach evidence, and route everything for review and sign-off in one reviewable place.',
  },
  {
    title: 'Findings and remediation',
    body: 'Raise findings, assign action plans, and track remediation with automatic follow-up and overdue escalation, so issues close.',
  },
  {
    title: 'Board and committee reporting',
    body: 'Generate board and audit-committee reporting from live data. Your quarterly pack is a click, not a week of copying spreadsheets.',
  },
  {
    title: 'AI assistant',
    body: 'An embedded assistant helps with drafting and analysis. It supports the reviewer and never replaces professional judgement.',
  },
  {
    title: 'Access control and audit logging',
    body: 'Role-based permissions and a full audit log of every action, so you always know who did what, and when.',
  },
];

const forWho = [
  {
    title: 'Small teams that are stretched',
    body: 'Do more with the people you have, and stop running audit out of email and shared drives.',
  },
  {
    title: 'Multi-entity groups',
    body: 'Run several entities and countries from one place, with a consolidated view for the group.',
  },
  {
    title: 'Regulator-facing organisations',
    body: 'Keep the evidence and reporting a SASRA, Central Bank or ODPC review will ask for.',
  },
];

const security = [
  'Role-based access, so people see only what they should',
  'A full audit log of every action in the platform',
  'Encryption in transit and at rest',
  'Defined data retention, set to your policy',
  'Request the applicable privacy and processing documentation',
  'Clear controller and processor terms in writing',
];

const faqs: FaqItem[] = [
  {
    question: 'How much does internal audit software cost in Kenya?',
    answer:
      'Most mid-market teams pay a monthly subscription rather than a large annual licence. Assurance OS is indicative at KES 15,000 to 35,000 a month for a single small team, KES 45,000 to 120,000 for multiple entities or an active board, and from KES 150,000 for groups and regulator-facing organisations. These are positioning ranges, validated on enquiry against your size and needs.',
  },
  {
    question: 'Can we run our own audits on Assurance OS, or only with your team?',
    answer:
      'Both. You can subscribe to the platform and run your own internal audit function on it, or use it as part of a co-sourced internal audit engagement with Murikah. Many teams start co-sourced and take more in-house over time, keeping the same system of record throughout.',
  },
  {
    question: 'Is our audit data secure, and where is it stored?',
    answer:
      'Ask us for the hosting locations, data processing terms, access controls, retention and export arrangements for your deployment. Confirm any residency requirements with us before uploading sensitive information.',
  },
  {
    question: 'Does it work across multiple entities and countries?',
    answer:
      'Yes. Assurance OS is built for groups. You can run several entities and countries in one place, keep their work separate where it needs to be, and give the group a consolidated view of plans, findings and remediation.',
  },
  {
    question: 'How hard is it to move off spreadsheets?',
    answer:
      'It is straightforward. You can bring your current plan and open findings across at the start, and most teams are running their next engagement on Assurance OS within days. We help with the move as part of onboarding, so nothing is lost in the change.',
  },
];
---

<ServiceLayout
  slug="assurance-os"
  metaTitle="Assurance OS | Internal audit software | Murikah"
  metaDescription="Assurance OS, Murikah's assurance platform, runs work papers, findings, remediation and board reporting in one place, with an AI assistant. Built for mid-market audit teams."
  heading="Assurance OS: the platform your audit work runs on."
  intro="Plan engagements, review work papers, track findings and prepare committee reports in one workspace. Assurance OS brings the audit workflow together with an AI assistant to support drafting and analysis."
  primaryCta={{ label: 'Try the public sandbox', href: '/assurance-os/sandbox' }}
  secondaryCta={{ label: PRIMARY_CTA.label, href: PRIMARY_CTA.href }}
  faqs={faqs}
  closingTitle="Put your audit on a system built to be proven"
  closingBody="Explore the workflow with sample data first. If it fits, book a short call to discuss onboarding and reporting needs."
>
  <Section tone="paper" aria-labelledby="what-it-does">
    <h2
      id="what-it-does"
      class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
    >
      What it does
    </h2>
    <FeatureGrid cols={3} class="mt-8">
      {
        features.map((f) => (
          <Card>
            <h3 class="text-lg text-navy">{f.title}</h3>
            <p class="mt-2 text-slate">{f.body}</p>
          </Card>
        ))
      }
    </FeatureGrid>
  </Section>

  <Section tone="surface" aria-labelledby="who-for">
    <h2
      id="who-for"
      class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
    >
      Who it is for
    </h2>
    <FeatureGrid cols={3} class="mt-8">
      {
        forWho.map((w) => (
          <Card>
            <h3 class="text-lg text-navy">{w.title}</h3>
            <p class="mt-2 text-slate">{w.body}</p>
          </Card>
        ))
      }
    </FeatureGrid>
  </Section>

  <Section tone="paper" aria-labelledby="security">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2
          id="security"
          class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
        >
          Security and trust
        </h2>
        <p class="mt-4 max-w-prose text-slate">
          Audit software holds sensitive findings, so the controls around it matter as much as the
          features.
        </p>
      </div>
      <ul class="grid gap-2.5 sm:grid-cols-2 lg:col-span-7">
        {
          security.map((s) => (
            <li class="flex items-start gap-2.5">
              <svg
                class="mt-1 size-4 shrink-0 text-gold"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 8.5l3 3 7-7.5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="text-ink">{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="surface" aria-labelledby="pricing">
    <h2
      id="pricing"
      class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
    >
      Pricing
    </h2>
    <p class="mt-3 max-w-prose text-slate">
      Indicative monthly ranges, validated on enquiry against your size and needs. Contract terms
      are confirmed in writing.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-3 sm:gap-6">
      {
        PRICING.map((tier) => (
          <div class="rounded-card bg-paper p-6 ring-1 ring-hairline/70">
            <h3 class="text-lg text-navy">{tier.name}</h3>
            <p class="mt-1 text-sm text-slate">{tier.forWho}</p>
            <p class="mt-4 text-xl font-semibold text-navy">{tier.price}</p>
            <p class="text-sm text-slate">{tier.period}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6">
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 font-medium text-blue no-underline hover:text-blue-deep hover:underline"
      >
        See full pricing and what each tier covers <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </Section>

  <Section tone="paper" aria-labelledby="related">
    <h2
      id="related"
      class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
    >
      Related reading
    </h2>
    <ul class="mt-6 grid max-w-3xl gap-3">
      <li>
        <a
          href="/insights/internal-audit-software-cost-kenya"
          class="font-medium text-blue hover:text-blue-deep"
        >
          How much does internal audit software cost in Kenya? A plain buyer's guide
        </a>
      </li>
      <li>
        <a href="/internal-audit" class="font-medium text-blue hover:text-blue-deep">
          See how co-sourced internal audit uses the platform
        </a>
      </li>
    </ul>
  </Section>

  {/* Animated how-it-works walkthrough, placed just before the closing CTA. */}
  <Section slot="pre-cta" tone="paper" aria-labelledby="how-it-works">
    <h2
      id="how-it-works"
      class="font-serif text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.02em] text-navy"
    >
      How Assurance OS works
    </h2>
    <p class="mt-3 max-w-prose text-slate">
      Watch the workflow play through stage by stage, or jump to any stage you want to see.
    </p>
    <div class="mt-8">
      <AuditOsWalkthrough client:visible />
    </div>
  </Section>
</ServiceLayout>
