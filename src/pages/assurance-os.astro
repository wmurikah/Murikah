---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Button from '@/components/primitives/Button.astro';
import Breadcrumb from '@/components/primitives/Breadcrumb.astro';
import Faq from '@/components/primitives/Faq.astro';
import ServiceSchema from '@/components/schema/Service.astro';
import FaqPageSchema from '@/components/schema/FaqPage.astro';
import AssuranceOsWorkflow from '@/components/assurance-os/AssuranceOsWorkflow';
import { PRICING, PRIMARY_CTA, SERVICES } from '@/site.config';
import type { FaqItem } from '@/lib/types';

const service = SERVICES.find((item) => item.slug === 'assurance-os');
if (!service) throw new Error('Assurance OS service configuration is missing');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Platform', href: '/products' },
  { label: 'Assurance OS', href: '/assurance-os' },
];

const features = [
  {
    title: 'Engagements and work papers',
    body: 'Plan the engagement, document procedures, attach evidence and route work for review without leaving the audit record.',
    image: '/images/assurance-os/fieldwork.webp',
    className: 'assurance-bento__wide',
  },
  {
    title: 'Findings that keep their evidence',
    body: 'Carry the supporting evidence, risk rating, owner and due date with the finding from review into follow-up.',
    image: '/images/assurance-os/findings.webp',
    className: '',
  },
  {
    title: 'Reviewer sign-off',
    body: 'Return, approve and sign off work papers while preserving the review trail that explains what changed.',
    image: '/images/assurance-os/review.webp',
    className: '',
  },
  {
    title: 'Remediation follow-up',
    body: 'Track action plans, due dates and closure evidence so the status presented to management can be checked.',
    image: '/images/assurance-os/remediation.webp',
    className: '',
  },
  {
    title: 'Committee and board reporting',
    body: 'Prepare reporting from the same reviewed findings and actions instead of rebuilding the trail in a separate tracker.',
    image: '/images/assurance-os/report.webp',
    className: 'assurance-bento__wide',
  },
];

const audiences = [
  {
    title: 'Small teams that are stretched',
    result: 'One reviewable place for the audit instead of email threads, shared drives and separate trackers.',
  },
  {
    title: 'Multi-entity groups',
    result: 'A consolidated view of plans, findings and remediation without manually merging entity trackers.',
  },
  {
    title: 'Regulator-facing organisations',
    result: 'A documented evidence trail that can be reviewed, challenged and produced when assurance is requested.',
  },
];

const security = [
  {
    title: 'Role and entity scoping',
    body: 'Server-enforced permissions restrict workflow actions and can scope access by organisation, affiliate and role.',
  },
  {
    title: 'Audit logging',
    body: 'Material workflow, report and administration actions are written to the product audit trail.',
  },
  {
    title: 'Sealed integration credentials',
    body: 'Stored connector and MFA secrets are sealed with AES-GCM using the deployment secret before they are persisted.',
  },
  {
    title: 'Evidence storage choice',
    body: 'Evidence can be configured for Cloudflare R2, Google Drive, SharePoint or OneDrive, and Dropbox according to the deployment.',
  },
  {
    title: 'Retention and legal holds',
    body: 'Evidence deletion is governed through retention rules and legal holds rather than an untracked hard-delete path.',
  },
  {
    title: 'Deployment terms in writing',
    body: 'Hosting region, residency, processing terms and any customer-specific security requirements are confirmed before production use.',
  },
];

const tierFeatures: Record<string, string[]> = {
  Starter: [
    'Single-entity workspace',
    'Engagements and work papers',
    'Findings and action plans',
    'Standard committee reports',
  ],
  Growth: [
    'Multiple entities',
    'Reviewer workflows and approvals',
    'Board and committee reporting',
    'Follow-up and overdue escalation',
  ],
  Enterprise: [
    'Group and regulator-facing setups',
    'Advanced access scopes',
    'Evidence-store configuration',
    'Onboarding and integration scope agreed in writing',
  ],
};

const faqs: FaqItem[] = [
  {
    question: 'Can we run our own audits on Assurance OS?',
    answer:
      'Yes. Your team can subscribe and run the internal audit function on Assurance OS, or use the same workspace in a co-sourced engagement with Murikah.',
  },
  {
    question: 'Where is our audit data stored?',
    answer:
      'Evidence storage is deployment-specific. Assurance OS supports configured stores including Cloudflare R2, Google Drive, SharePoint or OneDrive, and Dropbox. Hosting region, residency and processing terms are confirmed before production use.',
  },
  {
    question: 'How are access and audit trails handled?',
    answer:
      'The product uses server-enforced role permissions and organisation or affiliate scoping. Material workflow, reporting and administration actions are recorded in the product audit trail.',
  },
  {
    question: 'Does Assurance OS support several entities?',
    answer:
      'Yes. The workspace is designed to keep entity-level work scoped while giving authorised group users a consolidated view of plans, findings and remediation.',
  },
  {
    question: 'How do we move from spreadsheets?',
    answer:
      'Start with the current audit plan, open findings and action owners. Onboarding and any migration scope are agreed before production use so the source records and responsibilities are clear.',
  },
];
---

<BaseLayout
  titleFull="Assurance OS | Internal audit software | Murikah"
  description="Assurance OS connects audit planning, work papers, evidence, findings, remediation and board reporting in one reviewable workspace."
>
  <ServiceSchema
    slot="head"
    name={service.fullName}
    description={service.summary}
    serviceType={service.serviceType}
    path={service.href}
  />
  <FaqPageSchema slot="head" items={faqs} />

  <div class="assurance-page">
    <section id="hero" class="assurance-section assurance-hero" aria-labelledby="page-title">
      <Container>
        <div class="mx-auto max-w-[70rem] text-center">
          <Breadcrumb items={crumbs} class="mb-10 text-left" />
          <h1 id="page-title">One workspace from audit plan to board pack.</h1>
          <p class="assurance-lead">
            Plan engagements, review work papers and track findings. AI helps you draft. You decide.
          </p>
          <div class="assurance-actions">
            <Button href="/assurance-os/sandbox" variant="primary" size="lg" class="rounded-[12px]">
              Try the public sandbox
            </Button>
            <Button href={PRIMARY_CTA.href} variant="ghost" size="lg" class="rounded-[12px]">
              Book a 20-minute call
            </Button>
          </div>
        </div>

        <figure class="assurance-hero-shot">
          <img
            src="/images/assurance-os-trace.webp"
            alt="Assurance OS finding view showing linked evidence, a high-risk finding, Head of ICT as owner, due date and board-pack trace using fictional Murikah Demo records."
            width="960"
            height="651"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <figcaption>Fictional Murikah Demo records. No client data is shown.</figcaption>
        </figure>
      </Container>
    </section>

    <section id="trust" class="assurance-trust" aria-label="Standards that guide the platform and audit approach">
      <Container>
        <p><span>Guided by</span> IIA Standards <i aria-hidden="true">·</i> ISO/IEC 27001 <i aria-hidden="true">·</i> ISO/IEC 42001</p>
      </Container>
    </section>

    <section id="how-it-works" class="assurance-section" aria-labelledby="how-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="how-title">Follow one audit from plan to report.</h2>
          <p>
            Move through the six stages below. Each screen uses fictional sample data and the same
            workflow language as Assurance OS.
          </p>
        </div>
        <div class="mt-10">
          <AssuranceOsWorkflow client:visible />
        </div>
      </Container>
    </section>

    <section id="features" class="assurance-section assurance-section--white" aria-labelledby="features-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="features-title">The audit record stays connected.</h2>
          <p>
            The platform keeps the work, evidence, review decisions, findings and reporting close
            enough to trace without repeating the same card pattern across the page.
          </p>
        </div>

        <div class="assurance-bento">
          {features.map((feature) => (
            <article class:list={['assurance-card assurance-bento__tile', feature.className]}>
              <div class="assurance-bento__image">
                <img src={feature.image} alt="" width="640" height="400" loading="lazy" decoding="async" />
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section id="ai-assistant" class="assurance-section" aria-labelledby="ai-title">
      <Container>
        <div class="assurance-ai">
          <div>
            <p class="assurance-kicker">AI assistant</p>
            <h2 id="ai-title">Draft faster. Keep judgement human.</h2>
            <p>
              AI can help structure a draft from the evidence already in the engagement. A reviewer
              decides what is accepted into the audit record. It never replaces professional judgement.
            </p>
          </div>
          <div class="assurance-ai__proof" aria-label="Example AI draft and reviewer decision">
            <div class="assurance-card">
              <span class="assurance-chip">AI draft</span>
              <h3>User access review</h3>
              <p>
                Quarterly privileged-access review evidence was incomplete for two sampled accounts.
                The draft links the exception to the supporting work paper for reviewer assessment.
              </p>
            </div>
            <div class="assurance-ai__arrow" aria-hidden="true">→</div>
            <div class="assurance-card">
              <span class="assurance-chip assurance-chip--navy">Reviewer decision</span>
              <h3>Approve, edit or return</h3>
              <p>
                The reviewer checks the evidence, wording and rating before the finding enters the
                approved audit record.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section id="audience" class="assurance-section assurance-section--white" aria-labelledby="audience-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="audience-title">Built for teams that need a defensible trail.</h2>
        </div>
        <div class="assurance-three">
          {audiences.map((item) => (
            <article class="assurance-card">
              <h3>{item.title}</h3>
              <p>{item.result}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section id="security" class="assurance-section" aria-labelledby="security-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="security-title">Security facts, not generic ticks.</h2>
          <p>
            Audit data is sensitive. These are product and deployment controls the current
            implementation supports; residency and processing terms are confirmed for each deployment.
          </p>
        </div>
        <div class="assurance-security">
          {security.map((item) => (
            <article class="assurance-security__item">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <div class="assurance-security__links">
          <a href="/privacy">Read the privacy policy →</a>
          <a href="/contact?intent=assurance-os-security">Request processing and security terms →</a>
        </div>
      </Container>
    </section>

    <section id="pricing" class="assurance-section assurance-section--white" aria-labelledby="pricing-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="pricing-title">Pricing</h2>
          <p>
            Published monthly budget ranges. Final pricing depends on users, entities, onboarding or
            migration, support and agreed integrations.
          </p>
        </div>

        <div class="assurance-pricing">
          {PRICING.map((tier) => {
            const growth = tier.name === 'Growth';
            const enterprise = tier.name === 'Enterprise';
            return (
              <article class:list={['assurance-card assurance-tier', growth && 'assurance-tier--featured']}>
                {growth && <span class="assurance-tier__label">Most common</span>}
                <h3>{tier.name}</h3>
                <p class="assurance-tier__for">{tier.forWho}</p>
                <p class="assurance-tier__price">{tier.price}</p>
                <p class="assurance-tier__period">{tier.period}</p>
                <ul>
                  {(tierFeatures[tier.name] ?? []).map((feature) => <li>{feature}</li>)}
                </ul>
                <Button
                  href={enterprise ? PRIMARY_CTA.href : '/assurance-os/sandbox'}
                  variant={growth ? 'primary' : 'ghost'}
                  size="lg"
                  class="mt-auto w-full rounded-[12px]"
                >
                  {enterprise ? 'Book a call' : 'Try the sandbox'}
                </Button>
              </article>
            );
          })}
        </div>
        <p class="assurance-contract">Contract terms are confirmed in writing.</p>
      </Container>
    </section>

    <section id="faq" class="assurance-section" aria-labelledby="faq-title">
      <Container>
        <div class="assurance-heading">
          <h2 id="faq-title">Frequently asked questions</h2>
          <p>Start with the answer. We can document deployment-specific details before production use.</p>
        </div>
        <Faq items={faqs} class="mt-10 max-w-3xl" />
      </Container>
    </section>

    <section id="final-cta" class="assurance-section assurance-section--white" aria-labelledby="final-title">
      <Container>
        <div class="mx-auto max-w-3xl text-center">
          <h2 id="final-title">See the audit trail before you buy.</h2>
          <p class="assurance-final-copy">
            Open the sample workspace first. If the workflow fits, book a short call to discuss
            onboarding, reporting and deployment requirements.
          </p>
          <div class="assurance-actions">
            <Button href="/assurance-os/sandbox" variant="primary" size="lg" class="rounded-[12px]">
              Try the public sandbox
            </Button>
            <Button href={PRIMARY_CTA.href} variant="ghost" size="lg" class="rounded-[12px]">
              Book a 20-minute call
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>

<style>
  .assurance-page {
    --assurance-paper: #f7f5f0;
    --assurance-white: #ffffff;
    --assurance-navy: #071d35;
    --assurance-body: #3b4a5c;
    --assurance-gold: #7a5a12;
    background: var(--assurance-paper);
    color: var(--assurance-body);
    font-family: var(--font-sans);
  }

  .assurance-section {
    padding-block: 7rem;
    border-bottom: 1px solid rgba(7, 29, 53, 0.08);
    background: var(--assurance-paper);
  }

  .assurance-section--white {
    background: var(--assurance-white);
  }

  .assurance-hero {
    padding-top: 5rem;
    background: var(--assurance-paper);
  }

  .assurance-page h1,
  .assurance-page h2,
  .assurance-page h3 {
    font-family: var(--font-sans);
    color: var(--assurance-navy);
  }

  .assurance-page h1 {
    max-width: 16ch;
    margin-inline: auto;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .assurance-page h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .assurance-page h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .assurance-lead,
  .assurance-heading > p,
  .assurance-ai > div:first-child > p,
  .assurance-final-copy {
    color: var(--assurance-body);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .assurance-lead {
    max-width: 50rem;
    margin: 1.5rem auto 0;
  }

  .assurance-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .assurance-hero-shot {
    max-width: 70rem;
    margin: 4rem auto 0;
  }

  .assurance-hero-shot img {
    width: 100%;
    height: auto;
    border: 1px solid rgba(7, 29, 53, 0.08);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 30px 80px rgba(7, 29, 53, 0.12);
  }

  .assurance-hero-shot figcaption {
    margin-top: 0.75rem;
    color: #657281;
    font-size: 0.78rem;
    text-align: center;
  }

  .assurance-trust {
    border-bottom: 1px solid rgba(7, 29, 53, 0.08);
    background: #fff;
    padding-block: 1.1rem;
  }

  .assurance-trust p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.85rem;
    margin: 0;
    color: var(--assurance-navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }

  .assurance-trust span {
    color: var(--assurance-gold);
  }

  .assurance-trust i {
    color: rgba(7, 29, 53, 0.3);
    font-style: normal;
  }

  .assurance-heading {
    max-width: 48rem;
  }

  .assurance-heading > p {
    margin-top: 1rem;
  }

  .assurance-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid rgba(7, 29, 53, 0.08);
    border-radius: 16px;
    background: #fff;
    padding: 2rem;
    box-shadow: 0 1px 2px rgba(7, 29, 53, 0.04);
  }

  .assurance-card > p:not(.assurance-tier__price):not(.assurance-tier__period) {
    color: var(--assurance-body);
    line-height: 1.6;
  }

  .assurance-bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .assurance-bento__tile {
    grid-column: span 2;
  }

  .assurance-bento__wide {
    grid-column: span 3;
  }

  .assurance-bento__image {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin: -0.75rem -0.75rem 1.5rem;
    border: 1px solid rgba(7, 29, 53, 0.06);
    border-radius: 12px;
    background: var(--assurance-paper);
  }

  .assurance-bento__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .assurance-bento h3 + p {
    margin-top: 0.7rem;
  }

  .assurance-ai {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .assurance-kicker {
    margin: 0 0 0.8rem;
    color: var(--assurance-gold) !important;
    font-size: 0.78rem !important;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .assurance-ai > div:first-child > p:not(.assurance-kicker) {
    margin-top: 1rem;
  }

  .assurance-ai__proof {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.8rem;
  }

  .assurance-ai__proof .assurance-card {
    height: 100%;
  }

  .assurance-ai__arrow {
    color: var(--assurance-gold);
    font-size: 1.5rem;
  }

  .assurance-chip,
  .assurance-tier__label {
    align-self: flex-start;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: #f3eee1;
    padding: 0.32rem 0.65rem;
    color: var(--assurance-gold);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .assurance-chip--navy {
    background: #edf1f4;
    color: var(--assurance-navy);
  }

  .assurance-three,
  .assurance-pricing {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .assurance-three .assurance-card {
    min-height: 13rem;
  }

  .assurance-three h3 + p {
    margin-top: 1rem;
  }

  .assurance-security {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
    border-top: 1px solid rgba(7, 29, 53, 0.1);
  }

  .assurance-security__item {
    padding: 1.5rem 1.5rem 1.5rem 0;
    border-bottom: 1px solid rgba(7, 29, 53, 0.1);
  }

  .assurance-security__item:nth-child(odd) {
    padding-right: 2.5rem;
    border-right: 1px solid rgba(7, 29, 53, 0.1);
  }

  .assurance-security__item:nth-child(even) {
    padding-left: 2.5rem;
  }

  .assurance-security__item p {
    margin-top: 0.55rem;
    color: var(--assurance-body);
    line-height: 1.6;
  }

  .assurance-security__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }

  .assurance-security__links a {
    color: #102f49;
    font-weight: 600;
    text-decoration: none;
  }

  .assurance-security__links a:hover {
    text-decoration: underline;
  }

  .assurance-tier {
    gap: 0;
    min-height: 31rem;
  }

  .assurance-tier--featured {
    border: 2px solid var(--assurance-navy);
    padding: calc(2rem - 1px);
  }

  .assurance-tier__for {
    min-height: 3.25rem;
    margin-top: 0.45rem;
    color: var(--assurance-body);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .assurance-tier__price {
    margin-top: 1.4rem;
    color: var(--assurance-navy);
    font-size: 1.7rem;
    font-weight: 650;
    line-height: 1.15;
  }

  .assurance-tier__period {
    margin-top: 0.25rem;
    color: #687482;
    font-size: 0.85rem;
  }

  .assurance-tier ul {
    display: grid;
    gap: 0.65rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
    color: var(--assurance-body);
  }

  .assurance-tier li {
    position: relative;
    padding-left: 1.25rem;
  }

  .assurance-tier li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--assurance-gold);
    font-weight: 700;
  }

  .assurance-contract {
    margin-top: 1.25rem;
    color: #687482;
    font-size: 0.82rem;
  }

  .assurance-final-copy {
    margin: 1.1rem auto 0;
    max-width: 42rem;
  }

  @media (max-width: 900px) {
    .assurance-bento__tile,
    .assurance-bento__wide {
      grid-column: span 3;
    }

    .assurance-ai {
      grid-template-columns: 1fr;
    }

    .assurance-pricing {
      grid-template-columns: 1fr;
    }

    .assurance-tier {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .assurance-section {
      padding-block: 4rem;
    }

    .assurance-hero {
      padding-top: 3rem;
    }

    .assurance-actions {
      flex-direction: column;
    }

    .assurance-actions :global(.btn) {
      width: 100%;
    }

    .assurance-hero-shot {
      margin-top: 3rem;
      max-height: 18rem;
      overflow: hidden;
      border-radius: 16px;
    }

    .assurance-hero-shot img {
      min-height: 18rem;
      object-fit: cover;
      object-position: top;
    }

    .assurance-bento {
      grid-template-columns: 1fr;
    }

    .assurance-bento__tile,
    .assurance-bento__wide {
      grid-column: auto;
    }

    .assurance-ai__proof,
    .assurance-three,
    .assurance-security {
      grid-template-columns: 1fr;
    }

    .assurance-ai__arrow {
      transform: rotate(90deg);
      justify-self: center;
    }

    .assurance-security__item,
