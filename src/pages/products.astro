---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import ProductLinks from '@/components/ProductLinks.astro';
import CtaSection from '@/components/primitives/CtaSection.astro';
import { PRODUCTS } from '@/site.config';

const labProducts = PRODUCTS.filter((product) => product.label !== 'Assurance OS');
---

<BaseLayout
  titleFull="More from Murikah Labs | CMS, Tutor and ENGR"
  description="Explore Murikah Labs products beyond the core assurance platform: CMS for customer operations, Tutor for AI-assisted learning and ENGR for maintenance workflows."
>
  <Section tone="surface" aria-labelledby="products-title" class="border-b border-hairline">
    <div class="max-w-3xl">
      <p class="eyebrow">More from Murikah Labs</p>
      <h1
        id="products-title"
        class="mt-5 font-serif text-[length:var(--text-title)] leading-tight text-navy"
      >
        Useful products, kept separate from the assurance offer.
      </h1>
      <p class="mt-6 max-w-2xl text-xl text-slate">
        CMS, Tutor and ENGR solve different operating problems. They live here so Assurance OS can
        remain the clear platform for internal audit and remediation.
      </p>
      <p class="mt-5 text-sm text-slate">
        Looking for the audit platform?{' '}
        <a href="/assurance-os" class="font-medium text-blue no-underline hover:underline">
          Explore Assurance OS →
        </a>
      </p>
    </div>

    <div class="mt-10">
      <ProductLinks products={labProducts} />
    </div>
  </Section>

  <CtaSection
    eyebrow="Core platform"
    title="Looking for internal audit software?"
    body="Assurance OS is Murikah's platform for planning, evidence, findings, remediation and board reporting."
    primaryLabel="Explore Assurance OS"
    primaryHref="/assurance-os"
  />
</BaseLayout>
