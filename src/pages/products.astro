---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import ProductLinks from '@/components/ProductLinks.astro';
import CtaSection from '@/components/primitives/CtaSection.astro';
import { PRODUCTS } from '@/site.config';
---

<BaseLayout
  title="Products: CMS, Assurance OS, Tutor and ENGR"
  description="Open Murikah CMS, Assurance OS, Tutor and ENGR. Workspaces for customer operations, internal audit, AI-assisted learning and engineering maintenance."
>
  <Section tone="surface" aria-labelledby="products-title">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <p class="eyebrow">Murikah products</p>
        <h1
          id="products-title"
          class="mt-5 max-w-3xl font-serif text-[length:var(--text-title)] leading-tight text-navy"
        >
          Choose your workspace.
        </h1>
        <p class="mt-6 max-w-2xl text-xl text-slate">
          Start with the task you need to complete. Each card shows a representative workflow and
          how access works before you leave Murikah.com.
        </p>
        <p class="mt-4 max-w-2xl text-sm text-slate">
          <strong class="font-medium text-navy">Assurance OS</strong> is Murikah's audit and risk workspace. <a href="/assurance-os"
            >Explore its workflow and subscription pricing →</a
          >
        </p>
      </div>
      <nav
        aria-label="Choose a product by task"
        class="rounded-card bg-paper p-6 ring-1 ring-hairline lg:col-span-5"
      >
        <p class="text-sm font-semibold tracking-[0.08em] text-gold uppercase">Choose by task</p>
        <ul class="mt-3 divide-y divide-hairline">
          {
            PRODUCTS.map((product) => (
              <li>
                <a
                  href={`#product-${product.label.toLowerCase()}`}
                  class="group flex min-h-11 items-center justify-between gap-4 py-2 text-navy no-underline hover:text-blue"
                >
                  <span>
                    <span class="font-medium">{product.fullName}</span>
                    <span class="ml-2 text-sm text-slate">{product.label}</span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="text-gold transition-transform group-hover:translate-y-0.5"
                  >
                    ↓
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="mt-6"><ProductLinks /></div>
  </Section>
  <CtaSection
    title="Find the right fit for your team"
    body="Tell us about the work you need to manage. We will respond within two working days."
  />
</BaseLayout>
