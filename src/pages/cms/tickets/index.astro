---
export const prerender = false;

/**
 * Staff tickets list. Scoped to the acting tenant, filterable by search,
 * status and priority. RBAC-gated via can('tickets.view'); wrapped by the error
 * boundary; an empty result shows a clear empty state.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsError from '@/components/cms/CmsError.astro';
import { getCmsEnv } from '@cms/env';
import { getDb } from '@cms/db';
import { listTickets, type TicketRow, type TicketFilters } from '@cms/repos/tickets';

const cms = Astro.locals.cms;
if (!cms) return Astro.redirect('/login');
const allowed = cms.userType === 'STAFF' && (cms.isPlatformOwner || cms.can('tickets.view'));

const p = Astro.url.searchParams;
const filters: TicketFilters = {
  q: p.get('q') || undefined,
  status: p.get('status') || undefined,
  priority: p.get('priority') || undefined,
};
const priorities = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'];

let rows: TicketRow[] = [];
let loadError = false;
if (allowed) {
  try {
    rows = await listTickets(await getDb(getCmsEnv()), filters);
  } catch (err) {
    loadError = true;
    console.error('[cms.tickets] list failed', err);
  }
}
const day = (d: string | null): string => (d ? d.slice(0, 10) : '-');
---

<CmsLayout title="Tickets">
  <div class="cms-page-head">
    <div>
      <h1>Tickets</h1>
      <p class="cms-lead">Support tickets for {cms.tenantName}.</p>
    </div>
  </div>

  {
    !allowed ? (
      <p class="cms-error" role="alert">
        You do not have access to tickets.
      </p>
    ) : loadError ? (
      <CmsError tag="[cms.tickets]" area="Tickets" />
    ) : (
      <>
        <form method="get" class="cms-card" role="search" style="margin-bottom:1rem">
          <div class="cms-field" style="margin:0">
            <label for="f-q">Search</label>
            <input
              type="search"
              id="f-q"
              name="q"
              class="cms-input"
              value={filters.q ?? ''}
              placeholder="Ticket number or subject"
            />
          </div>
          <div class="cms-field" style="margin-top:0.5rem">
            <label for="f-priority">Priority</label>
            <select id="f-priority" name="priority" class="cms-input">
              <option value="">Any priority</option>
              {priorities.map((pr) => (
                <option value={pr} selected={filters.priority === pr}>
                  {pr}
                </option>
              ))}
            </select>
          </div>
          <div style="margin-top:0.5rem">
            <button type="submit" class="cms-btn cms-btn--primary">
              Apply
            </button>
          </div>
        </form>

        {rows.length === 0 ? (
          <div class="cms-card">
            <p class="cms-lead">No tickets match. Adjust the search.</p>
          </div>
        ) : (
          <div class="cms-card" style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
              <thead>
                <tr>
                  <th style="text-align:left;padding:0.4rem">Ticket</th>
                  <th style="text-align:left;padding:0.4rem">Subject</th>
                  <th style="text-align:left;padding:0.4rem">Customer</th>
                  <th style="text-align:left;padding:0.4rem">Priority</th>
                  <th style="text-align:left;padding:0.4rem">Status</th>
                  <th style="text-align:left;padding:0.4rem">Raised</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td style="padding:0.4rem">
                      <a href={`/tickets/${r.ticketId}`}>{r.ticketNumber}</a>
                    </td>
                    <td style="padding:0.4rem">{r.subject}</td>
                    <td style="padding:0.4rem">{r.companyName ?? '-'}</td>
                    <td style="padding:0.4rem">{r.priority ?? '-'}</td>
                    <td style="padding:0.4rem">{r.status ?? '-'}</td>
                    <td style="padding:0.4rem">{day(r.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</CmsLayout>
