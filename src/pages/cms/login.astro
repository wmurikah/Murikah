---
export const prerender = false;

/**
 * Staff sign-in. Email and password; the endpoint routes to the staff shell (or
 * the TOTP step when MFA is on). One generic message on failure, so it never
 * reveals whether the email or the password was wrong. The Murikah two-pane
 * layout carries the brand.
 */
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';

const grc = Astro.locals.cms;
if (grc) return Astro.redirect('/');
const failed = Astro.url.searchParams.get('error') === '1';
---

<CmsAuthLayout title="Staff sign in" sub="Sign in to the staff workspace.">
  <h1>Staff sign in</h1>
  <p class="cms-authcard__lead">Access your customer, order and support workspace.</p>

  {
    failed && (
      <p class="cms-error" role="alert" style="margin-bottom:1rem">
        That email and password did not match. Please try again.
      </p>
    )
  }

  <form method="post" action="/api/auth/login">
    <input type="hidden" name="user_type" value="STAFF" />
    <div class="cms-field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        class="cms-input"
        autocomplete="username"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <div class="cms-field">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        class="cms-input"
        autocomplete="current-password"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <button type="submit" class="cms-btn cms-btn--primary">Sign in</button>
  </form>

  <p class="cms-field__hint" style="margin-top:1rem">
    Are you a customer? <a href="/portal/login">Use the customer portal</a>.
  </p>
</CmsAuthLayout>
