---
/**
 * The CMS sign-in screen, served at /login on cms.murikah.com.
 *
 * The file lives at src/pages/cms/login.astro, not src/pages/login.astro: the
 * worker rewrites a cms-host request to the internal /cms path before Astro
 * sees it, so a page at the repository root would appear on the marketing site
 * instead. Every link written here is root-relative on the host, because the
 * rewrite has already happened by the time this renders.
 *
 * There is no authentication in this phase and no pretence of any. The form
 * calls submitCredentials from the isolated client, which returns
 * `not_implemented` without touching the network, and the page renders that in
 * its server-error region. No fake success exists anywhere in this file.
 *
 * Nothing here links to a destination that does not exist: no "forgot
 * password", no "create an account", no social sign-in. A dead link on a login
 * screen is worse than an absent one, because it costs a user a click and a
 * page load to discover it does not work.
 */
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsIcon from '@/components/cms/CmsIcon.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsWordmark from '@/components/cms/CmsWordmark.astro';
import { EXPIRED_FLAG, EXPIRED_MESSAGE } from '@/lib/cms/routes';

// The guard sets this flag when it clears a session that had run out or been
// revoked, so a returning user is told why they are here rather than being
// dropped on a sign-in page with no explanation. A request that never carried
// a cookie gets no notice, because there is nothing to explain.
const sessionExpired = Astro.url.searchParams.get(EXPIRED_FLAG) === '1';
// Rendered on the server for every request, never prerendered. Without this the
// page is baked at build time, the middleware guard runs once during the build
// instead of per request, and the route protection becomes a static artefact:
// a signed-in user would be served whatever the build decided.
export const prerender = false;
---

<CmsAuthLayout title="Sign in">
  <div class="flex flex-col gap-7">
    <div class="flex flex-col gap-3">
      <!-- The wordmark repeats here for the mobile column, where the navy brand
           panel is collapsed to a band and the form is the page. -->
      <CmsWordmark tone="onLight" size="sm" class="lg:hidden" />
      <div class="flex flex-col gap-1.5">
        <h1 class="text-cms-page font-semibold text-cms-navy">Sign in</h1>
        <p class="text-cms-body-sm text-cms-muted">
          Customer Relationship, Service &amp; SLA Management System
        </p>
      </div>
    </div>

    {
      sessionExpired && (
        <div
          role="status"
          class="flex items-start gap-2.5 rounded-cms border border-cms-warning/30 bg-cms-warning-tint px-3.5 py-3"
        >
          <CmsIcon name="statusWarn" size={17} class="mt-0.5 shrink-0 text-cms-warning" />
          <p class="text-cms-body-sm text-cms-ink">{EXPIRED_MESSAGE}</p>
        </div>
      )
    }

    <!--
      novalidate hands validation to the page rather than the browser's own
      bubbles, so a message can be placed beside its field, associated with
      aria-describedby and announced. The fields keep their type and required
      attributes regardless, so a password manager and the mobile keyboard
      still behave correctly.
    -->
    <form id="cms-login-form" method="post" action="/login" novalidate class="flex flex-col gap-5">
      <!-- The server-error region. Present and empty rather than injected, so a
           screen reader is watching it before the first failure happens. -->
      <div
        id="cms-login-error"
        role="alert"
        hidden
        class="flex items-start gap-2.5 rounded-cms border border-cms-danger/30 bg-cms-danger-tint px-3.5 py-3"
      >
        <CmsIcon name="statusBreach" size={17} class="mt-0.5 shrink-0 text-cms-danger" />
        <p class="text-cms-body-sm text-cms-ink" data-error-text></p>
      </div>

      <CmsInput
        id="cms-email"
        name="email"
        label="Email address"
        type="email"
        autocomplete="username"
        inputmode="email"
        required
        autofocus
      />

      <CmsInput
        id="cms-password"
        name="password"
        label="Password"
        type="password"
        autocomplete="current-password"
        required
        revealable
      />

      <CmsButton type="submit" variant="primary" size="lg" full id="cms-login-submit">
        Sign in
      </CmsButton>
    </form>

    <p class="text-cms-caption text-cms-muted">
      Trouble signing in? Contact your system administrator.
    </p>
  </div>
</CmsAuthLayout>

<script>
  import { submitCredentials, authResultMessage } from '@/lib/cms/auth/client';

  const form = document.getElementById('cms-login-form');
  if (form instanceof HTMLFormElement) {
    const email = document.getElementById('cms-email') as HTMLInputElement;
    const password = document.getElementById('cms-password') as HTMLInputElement;
    const submit = document.getElementById('cms-login-submit') as HTMLButtonElement;
    const errorBox = document.getElementById('cms-login-error') as HTMLElement;
    const errorText = errorBox.querySelector('[data-error-text]') as HTMLElement;

    /** Show or clear one field's message, and keep aria-invalid in step. */
    const setFieldError = (field: HTMLInputElement, message: string | null) => {
      const box = document.getElementById(`${field.id}-error`);
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      field.classList.toggle('border-cms-danger', Boolean(message));
      field.classList.toggle('border-cms-border', !message);
      if (!box) return;
      box.textContent = message ?? '';
      box.classList.toggle('hidden', !message);
    };

    const setServerError = (message: string | null) => {
      errorText.textContent = message ?? '';
      errorBox.hidden = !message;
      if (message) {
        // role="alert" announces it; moving focus puts a keyboard user at the
        // message rather than leaving them wherever they pressed Enter. The
        // region is not in the tab order, so tabindex=-1 makes it focusable
        // without adding a stop.
        errorBox.setAttribute('tabindex', '-1');
        errorBox.focus();
      }
    };

    /**
     * Prevention before messages: this runs on submit, and again on blur once a
     * field has already been marked, so a corrected field clears as soon as the
     * user leaves it rather than only on the next submit.
     */
    const validate = (): boolean => {
      let ok = true;
      const address = email.value.trim();
      if (!address) {
        setFieldError(email, 'Enter your email address.');
        ok = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address)) {
        setFieldError(email, 'Enter a complete email address, for example name@hass.co.ke.');
        ok = false;
      } else {
        setFieldError(email, null);
      }

      if (!password.value) {
        setFieldError(password, 'Enter your password.');
        ok = false;
      } else {
        setFieldError(password, null);
      }
      return ok;
    };

    for (const field of [email, password]) {
      field.addEventListener('blur', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate();
      });
    }

    const setLoading = (loading: boolean) => {
      submit.disabled = loading;
      submit.setAttribute('aria-busy', String(loading));
      submit.textContent = loading ? 'Signing in...' : 'Sign in';
    };

    form.addEventListener('submit', async (event) => {
      // Handled here in every case: the page never posts, because there is no
      // endpoint behind it in this phase.
      event.preventDefault();
      setServerError(null);
      if (!validate()) {
        // Send focus to the first field that failed, so the keyboard user is
        // taken to the problem rather than left to hunt for it.
        (email.getAttribute('aria-invalid') === 'true' ? email : password).focus();
        return;
      }

      setLoading(true);
      try {
        const result = await submitCredentials({
          email: email.value.trim(),
          password: password.value,
        });
        // Deliberately exhaustive over the union, so a new outcome added to the
        // client cannot silently fall through to nothing on this screen.
        switch (result.status) {
          case 'success': {
            // The server has set the HttpOnly cookie on this response. All that
            // remains is a normal navigation: the middleware resolves the
            // cookie server-side and renders the right surface. Nothing is
            // fetched from /api/auth/me, and no session state is kept here.
            //
            // The password is not cleared first on purpose: the page is about
            // to be replaced entirely, and clearing it would only interfere
            // with a password manager's save prompt.
            // The server decided this, from the permissions it holds and this
            // page does not. Hard-coding /app here is what made the executive
            // dashboard something every user had to go and find.
            window.location.assign(result.landing);
            // Keep the control disabled through the navigation, so a second
            // click during the page swap cannot fire another request.
            return;
          }
          case 'password_change_required':
            // The password was correct. Say so, and stop: the change-password
            // screen does not exist yet, and sending them to a 404 or
            // pretending the sign-in failed would both be worse.
            setServerError(
              'Your password must be changed before you can sign in. The change-password screen is not available yet; contact your administrator.',
            );
            break;
          case 'mfa_required':
            setServerError(
              'This account requires a second factor. Verification is not available yet; contact your administrator.',
            );
            break;
          case 'invalid_credentials':
          case 'account_locked':
          case 'transport_error':
          case 'not_implemented':
            setServerError(authResultMessage(result));
            break;
        }
        // The email survives a failed attempt so it need not be retyped. The
        // password never does, and is not written to any store.
        password.value = '';
        password.focus();
      } finally {
        setLoading(false);
      }
    });
  }
</script>
