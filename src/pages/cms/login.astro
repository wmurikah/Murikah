---
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsLoginCharacter from '@/components/cms/CmsLoginCharacter.astro';
import CmsAuthProviders from '@/components/cms/CmsAuthProviders.astro';
import CmsQuoteCurtain from '@/components/cms/CmsQuoteCurtain.astro';
import { EXPIRED_FLAG, EXPIRED_MESSAGE } from '@/lib/cms/routes';
export const prerender = false;
const notice =
  Astro.url.searchParams.get(EXPIRED_FLAG) === '1'
    ? EXPIRED_MESSAGE
    : Astro.url.searchParams.get('reason') === 'not_provisioned'
      ? 'Your Hass Petroleum account has not been provisioned. Contact your system administrator.'
      : Astro.url.searchParams.has('provider_error')
        ? "We couldn't complete provider sign-in. Try again or use another sign-in method."
        : null;
---

<CmsAuthLayout title="Sign in">
  <CmsLoginCharacter slot="brand-character" />
  <div class="flex flex-col gap-6">
    <header class="space-y-1.5">
      <p class="text-cms-label font-semibold tracking-[0.12em] text-cms-gold-ink uppercase">
        HASS Petroleum
      </p>
      <h1 class="text-cms-display font-semibold text-cms-ink">Welcome back</h1>
      <p class="text-cms-body-sm text-cms-muted">Sign in to customer operations.</p>
    </header>
    {
      notice && (
        <div
          role="status"
          class="rounded-cms border border-cms-caution-border bg-cms-caution-tint px-3.5 py-3 text-cms-body-sm"
        >
          {notice}
        </div>
      )
    }
    <CmsAuthProviders purpose="SIGN_IN" apple />
    <div class="flex items-center gap-3 text-cms-caption text-cms-muted" aria-hidden="true">
      <span class="h-px flex-1 bg-cms-line"></span><span>or use your work email</span><span
        class="h-px flex-1 bg-cms-line"></span>
    </div>
    <form id="cms-login-form" class="flex flex-col gap-4" novalidate>
      <div class="min-h-14">
        <div
          id="cms-login-error"
          role="alert"
          aria-live="assertive"
          class="flex max-h-14 items-start gap-2.5 overflow-y-auto rounded-cms border border-cms-negative-border bg-cms-negative-tint px-3.5 py-3 text-cms-body-sm text-cms-negative data-[empty]:invisible"
          data-empty
        >
          <span data-error-text></span>
        </div>
      </div>
      <section data-email-step>
        <CmsInput
          id="cms-email"
          name="email"
          label="Work email"
          type="email"
          autocomplete="username"
          inputmode="email"
          required
          autofocus
        /><CmsButton type="button" variant="primary" size="lg" full id="cms-continue" class="mt-4"
          >Continue</CmsButton
        >
      </section>
      <section data-password-step hidden class="flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <strong data-selected-email class="truncate text-cms-body-sm"></strong><button
            type="button"
            data-change-email
            class="text-cms-body-sm font-semibold text-cms-royal">Change</button
          >
        </div><CmsInput
          id="cms-password"
          name="password"
          label="Password"
          type="password"
          autocomplete="current-password"
          required
          revealable
        /><CmsButton type="submit" variant="primary" size="lg" full id="cms-login-submit"
          >Sign in</CmsButton
        >
      </section>
    </form>
    <div class="flex flex-wrap items-center justify-between gap-3 text-cms-body-sm">
      <a href="/forgot-password" class="font-semibold text-cms-royal hover:underline"
        >Forgot password?</a
      >
      <span class="text-cms-muted"
        >New customer? <a href="/register" class="font-semibold text-cms-royal hover:underline"
          >Create customer access</a
        ></span
      >
    </div>
  </div>
  <CmsQuoteCurtain />
</CmsAuthLayout>
<script>
  import { submitCredentials, authResultMessage } from '@/lib/cms/auth/client';
  import { pickQuote, LAST_QUOTE_KEY } from '@/lib/cms/auth/quotes';
  const form = document.querySelector<HTMLFormElement>('#cms-login-form'),
    email = document.querySelector<HTMLInputElement>('#cms-email'),
    password = document.querySelector<HTMLInputElement>('#cms-password'),
    emailStep = document.querySelector<HTMLElement>('[data-email-step]'),
    passwordStep = document.querySelector<HTMLElement>('[data-password-step]'),
    errorBox = document.querySelector<HTMLElement>('#cms-login-error'),
    error = errorBox?.querySelector<HTMLElement>('[data-error-text]');
  const character = document.querySelector<HTMLElement>('[data-cms-login-character]');
  const curtain = document.querySelector<HTMLElement>('[data-cms-quote-curtain]');
  // The Quote Curtain fills and shows ONLY from the success branch below, and
  // navigation starts in the same tick — the curtain covers the wait for the
  // authenticated page, it never creates one. One quote per sign-in: the
  // previous pick is remembered in sessionStorage so two sign-ins in a row
  // read differently. Storage may be unavailable (private mode); a repeated
  // quote is an acceptable failure, a thrown error on sign-in is not.
  const showQuoteCurtain = () => {
    if (!curtain) return;
    let last: number | null = null;
    try {
      const raw = window.sessionStorage.getItem(LAST_QUOTE_KEY);
      if (raw !== null && Number.isInteger(Number(raw))) last = Number(raw);
    } catch {
      /* no storage: any quote will do */
    }
    const { quote, index } = pickQuote(last);
    try {
      window.sessionStorage.setItem(LAST_QUOTE_KEY, String(index));
    } catch {
      /* no storage: nothing to remember */
    }
    const text = curtain.querySelector<HTMLElement>('[data-quote-text]');
    const author = curtain.querySelector<HTMLElement>('[data-quote-author]');
    if (text) text.textContent = `“${quote.text}”`;
    if (author) author.textContent = `— ${quote.author}`;
    curtain.hidden = false;
  };
  // Back/forward cache can restore this page with the curtain still up and the
  // button still disabled: put both back. A fresh load ships the curtain
  // hidden, so refresh never traps anyone behind an overlay.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    if (curtain) curtain.hidden = true;
    const submit = document.querySelector<HTMLButtonElement>('#cms-login-submit');
    if (submit) {
      submit.disabled = false;
      submit.textContent = 'Sign in';
    }
  });
  let settle = 0;
  const pose = (state: string) => {
    if (character) character.dataset.state = state;
  };
  const setError = (message: string) => {
    if (error) error.textContent = message;
    if (errorBox) errorBox.toggleAttribute('data-empty', !message);
  };
  const valid = () => email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
  email?.addEventListener('focus', () => pose('email'));
  email?.addEventListener('input', () => {
    pose(valid() ? 'valid' : 'typing');
    window.clearTimeout(settle);
    settle = window.setTimeout(() => pose(valid() ? 'valid' : 'email'), 240);
  });
  email?.addEventListener('blur', () => pose('rest'));
  password?.addEventListener('focus', () => pose(password.type === 'text' ? 'peek' : 'password'));
  password?.addEventListener('blur', () => pose('rest'));
  document
    .querySelector('[data-reveal-for="cms-password"]')
    ?.addEventListener('click', () => pose(password?.type === 'text' ? 'password' : 'peek'));
  document.querySelector('#cms-continue')?.addEventListener('click', () => {
    if (!valid()) {
      setError('Enter a complete work email address.');
      email?.focus();
      return;
    }
    setError('');
    if (emailStep) emailStep.hidden = true;
    if (passwordStep) passwordStep.hidden = false;
    const selected = document.querySelector('[data-selected-email]');
    if (selected) selected.textContent = email!.value.trim();
    pose('success');
    window.setTimeout(() => password?.focus(), 120);
  });
  document.querySelector('[data-change-email]')?.addEventListener('click', () => {
    if (passwordStep) passwordStep.hidden = true;
    if (emailStep) emailStep.hidden = false;
    email?.focus();
  });
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!email || !password) return;
    if (!password.value) {
      setError('Enter your password.');
      password.focus();
      pose('password');
      return;
    }
    const submit = document.querySelector<HTMLButtonElement>('#cms-login-submit');
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Signing in…';
    }
    pose('loading');
    const result = await submitCredentials({ email: email.value.trim(), password: password.value });
    password.value = '';
    if (result.status === 'success') {
      // Curtain up and navigation started in the same tick: the old 140ms
      // pause before location.assign was manufactured latency and is gone.
      // The button stays disabled — the curtain owns the screen from here,
      // and pageshow restores the form if the reader comes Back.
      pose('success');
      showQuoteCurtain();
      location.assign(result.landing);
      return;
    }
    // Every failure keeps the form: error line, retry pose, NO curtain.
    pose('retry');
    setError(authResultMessage(result) ?? 'Sign-in could not be completed. Try again.');
    window.setTimeout(() => pose('password'), 260);
    if (submit) {
      submit.disabled = false;
      submit.textContent = 'Sign in';
    }
  });
</script>
