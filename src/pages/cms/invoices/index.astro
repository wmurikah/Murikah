---
export const prerender = false;

/**
 * Staff invoices list. Scoped to the acting tenant, filterable by search and
 * status. RBAC-gated via can('invoices.view'); wrapped by the error boundary; an
 * empty result shows a clear empty state.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsError from '@/components/cms/CmsError.astro';
import { getCmsEnv } from '@cms/env';
import { getDb } from '@cms/db';
import { listInvoices, type InvoiceRow, type InvoiceFilters } from '@cms/repos/invoices';

const cms = Astro.locals.cms;
if (!cms) return Astro.redirect('/login');
const allowed = cms.userType === 'STAFF' && (cms.isPlatformOwner || cms.can('invoices.view'));

const p = Astro.url.searchParams;
const filters: InvoiceFilters = {
  q: p.get('q') || undefined,
  status: p.get('status') || undefined,
};

let rows: InvoiceRow[] = [];
let loadError = false;
if (allowed) {
  try {
    rows = await listInvoices(await getDb(getCmsEnv()), filters);
  } catch (err) {
    loadError = true;
    console.error('[cms.invoices] list failed', err);
  }
}
const money = (v: number | null, cur: string | null): string =>
  v == null ? '-' : `${cur ?? ''} ${v.toLocaleString('en-KE')}`.trim();
const day = (d: string | null): string => (d ? d.slice(0, 10) : '-');
---

<CmsLayout title="Invoices">
  <div class="cms-page-head">
    <div>
      <h1>Invoices</h1>
      <p class="cms-lead">Invoices for {cms.tenantName}.</p>
    </div>
  </div>

  {
    !allowed ? (
      <p class="cms-error" role="alert">
        You do not have access to invoices.
      </p>
    ) : loadError ? (
      <CmsError tag="[cms.invoices]" area="Invoices" />
    ) : (
      <>
        <form method="get" class="cms-card" role="search" style="margin-bottom:1rem">
          <div class="cms-field" style="margin:0">
            <label for="f-q">Search</label>
            <input
              type="search"
              id="f-q"
              name="q"
              class="cms-input"
              value={filters.q ?? ''}
              placeholder="Invoice number"
            />
          </div>
          <div style="margin-top:0.5rem">
            <button type="submit" class="cms-btn cms-btn--primary">
              Apply
            </button>
          </div>
        </form>

        {rows.length === 0 ? (
          <div class="cms-card">
            <p class="cms-lead">No invoices match. Adjust the search.</p>
          </div>
        ) : (
          <div class="cms-card" style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
              <thead>
                <tr>
                  <th style="text-align:left;padding:0.4rem">Invoice</th>
                  <th style="text-align:left;padding:0.4rem">Customer</th>
                  <th style="text-align:left;padding:0.4rem">Issued</th>
                  <th style="text-align:left;padding:0.4rem">Due</th>
                  <th style="text-align:left;padding:0.4rem">Status</th>
                  <th style="text-align:left;padding:0.4rem">Payment</th>
                  <th style="text-align:right;padding:0.4rem">Total</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <td style="padding:0.4rem">
                      <a href={`/invoices/${r.invoiceId}`}>{r.invoiceNumber}</a>
                    </td>
                    <td style="padding:0.4rem">{r.companyName ?? '-'}</td>
                    <td style="padding:0.4rem">{day(r.issueDate)}</td>
                    <td style="padding:0.4rem">{day(r.dueDate)}</td>
                    <td style="padding:0.4rem">{r.status ?? '-'}</td>
                    <td style="padding:0.4rem">{r.paymentStatus ?? '-'}</td>
                    <td style="padding:0.4rem;text-align:right">
                      {money(r.totalAmount, r.currencyCode)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</CmsLayout>
