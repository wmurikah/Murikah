---
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
export const prerender = false;
---

<CmsAuthLayout title="Reset password"
  ><div class="flex flex-col gap-6">
    <header>
      <h1 class="text-cms-display font-semibold">Reset your password</h1><p
        class="mt-2 text-cms-body text-cms-muted"
      >
        We will send instructions if your account is eligible.
      </p>
    </header><form id="reset-request" class="flex flex-col gap-4">
      <p role="status" data-message class="min-h-6 text-cms-body-sm"></p><CmsInput
        id="reset-email"
        name="email"
        label="Work email"
        type="email"
        autocomplete="email"
        required
      /><CmsButton type="submit" variant="primary" size="lg" full>Send reset link</CmsButton>
    </form><a href="/login" class="text-cms-body-sm font-semibold text-cms-royal"
      >Back to sign in</a>
  </div></CmsAuthLayout
>
<script>
  document
    .querySelector<HTMLFormElement>('#reset-request')
    ?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.querySelector<HTMLInputElement>('#reset-email');
      const message = document.querySelector<HTMLElement>('[data-message]');
      const response = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: email?.value }),
      });
      const data = (await response.json()) as { message: string };
      if (message) message.textContent = data.message;
    });
</script>
