---
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
---

<CmsAuthLayout title="Choose a password"
  ><div class="flex flex-col gap-6">
    <h1 class="text-cms-display font-semibold">Choose a new password</h1><form
      id="reset-complete"
      class="flex flex-col gap-4"
    >
      <input type="hidden" name="token" value={token} /><p
        role="alert"
        data-message
        class="min-h-6 text-cms-body-sm"
      >
      </p><CmsInput
        id="new-password"
        name="password"
        label="New password"
        type="password"
        autocomplete="new-password"
        required
        revealable
      /><CmsButton type="submit" variant="primary" size="lg" full>Change password</CmsButton>
    </form><a href="/login" class="text-cms-body-sm font-semibold text-cms-royal">Back to sign in</a
    >
  </div></CmsAuthLayout
>
<script>
  import { busy } from '@/lib/cms/ui/busy';
  document
    .querySelector<HTMLFormElement>('#reset-complete')
    ?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const restore = busy(form.querySelector<HTMLButtonElement>('[type="submit"]'), 'Saving…');
      try {
        const response = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = (await response.json()) as { ok: boolean; message: string };
        const message = document.querySelector<HTMLElement>('[data-message]');
        if (message) message.textContent = data.message;
        if (data.ok) {
          // Stays disabled: the password is changed and this page is leaving.
          setTimeout(() => location.assign('/login'), 900);
          return;
        }
        restore();
      } catch (error) {
        restore();
        throw error;
      }
    });
</script>
