---
export const prerender = false;

/**
 * The TOTP step. Reached with a half-authorised session after the password step
 * when MFA is enabled for the user; the code is verified by /api/auth/mfa, which
 * promotes the session on success. Public route: it renders the form for a
 * pending session, and the endpoint enforces the session on submit.
 */
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';

const failed = Astro.url.searchParams.get('error') === '1';
---

<CmsAuthLayout title="Two-step verification" sub="Confirm the code from your authenticator app.">
  <h1>Two-step verification</h1>
  <p class="cms-authcard__lead">Enter the 6-digit code from your authenticator app.</p>

  {
    failed && (
      <p class="cms-error" role="alert" style="margin-bottom:1rem">
        That code was not valid. Please try again.
      </p>
    )
  }

  <form method="post" action="/api/auth/mfa">
    <div class="cms-field">
      <label for="code">Verification code</label>
      <input
        type="text"
        id="code"
        name="code"
        class="cms-input"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <button type="submit" class="cms-btn cms-btn--primary">Verify</button>
  </form>

  <form method="post" action="/api/auth/logout" style="margin-top:1rem">
    <button
      type="submit"
      class="cms-signout"
      style="color:var(--cms-muted);border-color:var(--cms-line)"
    >
      Cancel and sign out
    </button>
  </form>
</CmsAuthLayout>
