---
/**
 * The CMS root, `/` on cms.murikah.com.
 *
 * This is a redirect, not a page. The Build Prompt 02 shell that lived here has
 * moved to `/app`, so that the whole internal application sits under one prefix
 * and "an EXTERNAL user never renders an /app path" is a single check rather
 * than a list.
 *
 * The file has to exist even though the middleware guard redirects `/` before
 * it renders. Astro only runs middleware for a path that matches a route: with
 * no file here, `/cms` matched nothing, middleware never ran, and the request
 * fell through to a 404 instead of being redirected. The route existing is what
 * gives the guard a chance to act.
 *
 * The redirect below is the fallback for the case the guard does not cover: an
 * authenticated request whose principal resolved after the guard ran, which
 * should not happen, and an anonymous one, which the guard sends to /login.
 */
import { homeFor, LOGIN_PATH } from '@/lib/cms/routes';

export const prerender = false;

const principal = Astro.locals.cms;
return Astro.redirect(principal ? homeFor(principal.user.userType) : LOGIN_PATH, 302);
---
