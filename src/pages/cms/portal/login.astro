---
export const prerender = false;

/**
 * Customer portal sign-in. Email and password for a portal-enabled contact; the
 * endpoint routes to the portal (or the TOTP step when MFA is on). One generic
 * message on failure. Separate surface from staff sign-in: a customer never
 * reaches staff routes.
 */
import CmsAuthLayout from '@/layouts/CmsAuthLayout.astro';

const failed = Astro.url.searchParams.get('error') === '1';
---

<CmsAuthLayout
  title="Customer sign in"
  headline="Your orders, invoices and support in one place"
  sub="Sign in to your customer portal."
>
  <h1>Customer sign in</h1>
  <p class="cms-authcard__lead">Track your orders, invoices and tickets.</p>

  {
    failed && (
      <p class="cms-error" role="alert" style="margin-bottom:1rem">
        That email and password did not match. Please try again.
      </p>
    )
  }

  <form method="post" action="/api/auth/login">
    <input type="hidden" name="user_type" value="CUSTOMER" />
    <div class="cms-field">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        class="cms-input"
        autocomplete="username"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <div class="cms-field">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        class="cms-input"
        autocomplete="current-password"
        required
        aria-invalid={failed ? 'true' : undefined}
      />
    </div>
    <button type="submit" class="cms-btn cms-btn--primary">Sign in</button>
  </form>

  <p class="cms-field__hint" style="margin-top:1rem">
    Are you a member of staff? <a href="/login">Use the staff sign-in</a>.
  </p>
</CmsAuthLayout>
