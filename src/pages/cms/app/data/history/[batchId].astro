---
/**
 * Data → Import History → one batch.
 *
 * Overview, exception queues, rows, and a row inspector. What the inspector
 * shows depends on what the reader may see: the Upload Centre permission
 * says a row exists and what happened to it, and the source values inside
 * need the data type's own module access.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsDrawer from '@/components/cms/CmsDrawer.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { canUploadImportType, canViewImports } from '@/lib/cms/permissions';
import {
  exceptionQueues,
  REPROCESSABLE,
  FILE_STORAGE_CONNECTED,
  NO_FILE_STORAGE_MESSAGE,
  listBatches,
  escapeForDisplay,
  IMPORT_TYPE_LABELS,
  type BatchSummaryRow,
  type ExceptionQueue,
  type ImportType,
} from '@/lib/cms/import/uploadCentre';

export const prerender = false;

const batchId = Astro.params.batchId ?? '';
const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayView = canViewImports(permissions);

interface RowLine {
  importRowId: string;
  sourceRowNumber: number;
  sourceRecordKey: string | null;
  rowStatus: string;
  errorMessage: string | null;
  entityId: string | null;
}

let batch: BatchSummaryRow | undefined;
let queues: ExceptionQueue[] = [];
let rows: RowLine[] = [];
let audits: { eventType: string; action: string; at: string; after: string | null }[] = [];
let loadFailed = false;
if (mayView) {
  try {
    const db = await getDb(getCmsEnv());
    batch = (await listBatches(db, 200)).find((candidate) => candidate.batchId === batchId);
    if (batch !== undefined) {
      queues = await exceptionQueues(db, batchId);
      const rowResult = await db.execute({
        sql: `SELECT import_row_id, source_row_number, source_record_key, row_status,
                error_message, entity_id
              FROM import_rows WHERE import_batch_id = ?
              ORDER BY CASE row_status WHEN 'REJECTED' THEN 0 WHEN 'UNRESOLVED' THEN 1 ELSE 2 END,
                       source_row_number
              LIMIT 200`,
        args: [batchId],
      });
      rows = rowResult.rows.map((raw) => ({
        importRowId: String(raw.import_row_id),
        sourceRowNumber: Number(raw.source_row_number),
        sourceRecordKey: raw.source_record_key === null ? null : String(raw.source_record_key),
        rowStatus: String(raw.row_status),
        errorMessage:
          raw.error_message === null ? null : escapeForDisplay(String(raw.error_message)),
        entityId: raw.entity_id === null ? null : String(raw.entity_id),
      }));
      const auditResult = await db.execute({
        sql: `SELECT event_type, action, event_at, after_json FROM audit_events
              WHERE entity_type = 'IMPORT_BATCH' AND entity_id = ? ORDER BY event_at`,
        args: [batchId],
      });
      audits = auditResult.rows.map((raw) => ({
        eventType: String(raw.event_type),
        action: String(raw.action),
        at: String(raw.event_at),
        after: raw.after_json === null ? null : String(raw.after_json),
      }));
    }
  } catch (error) {
    console.error('[cms.data.batch] load failed', error);
    loadFailed = true;
  }
}
/**
 * Whether validation actually classified anything.
 *
 * A batch at VALIDATING has not finished; a REJECTED batch with no rows never
 * got as far as classifying one. Either way the exception panel must say so
 * rather than report a clean run. Read from the rows themselves, so it stays
 * true whatever wrote the batch.
 */
const validationRan =
  rows.length > 0 ||
  batch?.status === 'READY' ||
  batch?.status === 'IMPORTED' ||
  batch?.status === 'PARTIAL';

const mayCommit =
  batch !== undefined && canUploadImportType(permissions, batch.importType as ImportType);
const statusTone = (status: string) =>
  status === 'IMPORTED'
    ? 'success'
    : status === 'PARTIAL'
      ? 'warning'
      : status === 'REJECTED'
        ? 'danger'
        : 'neutral';
const rowTone = (status: string) =>
  status === 'REJECTED'
    ? 'danger'
    : status === 'UNRESOLVED'
      ? 'warning'
      : status === 'CHANGED'
        ? 'info'
        : 'neutral';
---

<CmsLayout title="Import batch">
  {
    !mayView ? (
      <CmsErrorState
        title="You do not have access to import history"
        description="Ask a system administrator for the DATA.IMPORTS.VIEW permission."
      />
    ) : loadFailed ? (
      <CmsErrorState
        title="The batch could not be loaded"
        description="The database did not answer."
      />
    ) : batch === undefined ? (
      <CmsErrorState
        title="That batch could not be found"
        description="It may have been removed from view."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          title={batch.filename}
          crumbs={[
            { label: 'Home', href: '/app' },
            { label: 'Data', href: '/app/data' },
            { label: 'History', href: '/app/data/history' },
            { label: 'Batch' },
          ]}
        >
          {mayCommit && (
            <Fragment slot="actions">
              <CmsButton id="cms-batch-revalidate" variant="ghost">
                Revalidate unresolved rows
              </CmsButton>
              {REPROCESSABLE.has(batch.status) && FILE_STORAGE_CONNECTED && (
                <CmsButton id="cms-batch-reprocess" variant="secondary" icon="data">
                  Reprocess
                </CmsButton>
              )}
              {batch.status === 'READY' && (
                <CmsButton id="cms-batch-commit" variant="primary" icon="check">
                  Import valid records
                </CmsButton>
              )}
            </Fragment>
          )}
        </CmsPageHeader>

        {/*
         * A batch that cannot be recovered says so, here, without anybody
         * having to press a button to find out. The action is absent rather
         * than disabled-and-silent, and the sentence names what is missing.
         */}
        {REPROCESSABLE.has(batch.status) && !FILE_STORAGE_CONNECTED && (
          <CmsErrorState
            class="mb-4"
            title="This batch cannot be reprocessed"
            description={NO_FILE_STORAGE_MESSAGE}
          />
        )}

        <p
          id="cms-batch-message"
          role="status"
          aria-live="polite"
          class="mb-4 text-cms-body-sm text-cms-muted"
        />

        <div class="grid gap-4 lg:grid-cols-2">
          <CmsCard title="Overview">
            <dl class="text-cms-body-sm text-cms-muted">
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Status</dt>
                <dd>
                  <CmsBadge tone={statusTone(batch.status)} label={batch.status.toLowerCase()} />
                </dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Data type</dt>
                <dd class="text-cms-ink">
                  {IMPORT_TYPE_LABELS[batch.importType as ImportType] ?? batch.importType}
                </dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Source system</dt>
                <dd class="text-cms-ink">{batch.sourceSystem}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Uploaded by</dt>
                <dd class="text-cms-ink">{batch.uploadedBy}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Uploaded at</dt>
                <dd class="text-cms-ink tabular-nums">{batch.uploadedAt}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Rows received</dt>
                <dd class="text-cms-ink tabular-nums">{batch.rowsReceived}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Documents</dt>
                <dd class="text-cms-ink tabular-nums">{batch.uniqueDocuments}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>New rows</dt>
                <dd class="text-cms-ink tabular-nums">{batch.rowsNew}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Changed rows</dt>
                <dd class="text-cms-ink tabular-nums">{batch.rowsChanged}</dd>
              </div>
              <div class="flex justify-between border-b border-cms-line py-1.5">
                <dt>Exact duplicate rows</dt>
                <dd class="text-cms-ink tabular-nums">{batch.rowsDuplicate}</dd>
              </div>
              <div class="flex justify-between py-1.5">
                <dt>Rejected rows</dt>
                <dd class="text-cms-ink tabular-nums">{batch.rowsRejected}</dd>
              </div>
            </dl>
          </CmsCard>

          <CmsCard title="Exception queues">
            {/*
             * THREE STATES, BECAUSE TWO OF THEM ARE NOT THE SAME THING.
             * A batch still validating, or one that was rejected before it
             * classified a row, has no exceptions in the sense that nothing
             * has been examined. Rendering that as "No exceptions. Every row
             * resolved." tells the operator the run succeeded, on a batch
             * where nothing ran, which is how the stuck validation looked
             * like a clean one.
             */}
            {validationRan === false ? (
              <CmsEmptyState
                icon="data"
                title="Not validated"
                description={
                  batch.status === 'VALIDATING'
                    ? 'This batch is still validating. No row has been classified yet.'
                    : 'This batch was rejected before any row was classified.'
                }
              />
            ) : queues.length === 0 ? (
              <CmsEmptyState
                icon="check"
                title="No exceptions"
                description={`Validated. All ${batch.rowsReceived} rows resolved.`}
              />
            ) : (
              <ul class="flex flex-col gap-2 text-cms-body-sm">
                {queues.map((queue) => (
                  <li class="flex items-start justify-between gap-3 border-b border-cms-line pb-2 last:border-0">
                    <span class="text-cms-ink">
                      {queue.queue}
                      {queue.example && <span class="block text-cms-muted">{queue.example}</span>}
                    </span>
                    <span class="text-cms-muted tabular-nums">{queue.rows}</span>
                  </li>
                ))}
              </ul>
            )}
          </CmsCard>
        </div>

        <div class="mt-6">
          <CmsDataTable
            caption="Rows"
            columns={[
              { key: 'row', label: 'Row', numeric: true },
              { key: 'key', label: 'Source key' },
              { key: 'status', label: 'Status' },
              { key: 'error', label: 'Message' },
              { key: 'entity', label: 'Record' },
              { key: 'actions', label: 'Actions' },
            ]}
            empty={rows.length === 0}
          >
            {rows.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">
                  {row.sourceRowNumber}
                </td>
                <td class="px-4 py-2.5 text-cms-muted">{row.sourceRecordKey ?? 'Not available'}</td>
                <td class="px-4 py-2.5">
                  <CmsBadge tone={rowTone(row.rowStatus)} label={row.rowStatus.toLowerCase()} />
                </td>
                <td class="px-4 py-2.5 text-cms-muted">{row.errorMessage ?? ''}</td>
                <td class="px-4 py-2.5 text-cms-muted">{row.entityId ?? 'Not imported'}</td>
                <td class="px-4 py-2.5">
                  <button
                    type="button"
                    data-cms-row-inspect={row.importRowId}
                    class="rounded-cms px-2 py-1 text-cms-body-sm font-medium text-cms-royal outline-none hover:bg-cms-canvas focus-visible:ring-2 focus-visible:ring-focus"
                  >
                    Inspect
                  </button>
                </td>
              </tr>
            ))}
            <Fragment slot="empty">
              <CmsEmptyState icon="data" title="No rows" description="This batch holds no rows." />
            </Fragment>
          </CmsDataTable>
        </div>

        <div class="mt-6">
          <CmsCard title="Audit">
            {audits.length === 0 ? (
              <CmsEmptyState
                icon="data"
                title="No audit entries"
                description="Nothing recorded yet."
              />
            ) : (
              <ul class="flex flex-col gap-2 text-cms-body-sm text-cms-muted">
                {audits.map((entry) => (
                  <li class="border-b border-cms-line pb-2 last:border-0">
                    <span class="font-medium text-cms-ink">{entry.eventType}</span>
                    <span class="ml-2">{entry.at}</span>
                    {entry.after && <span class="block break-words">{entry.after}</span>}
                  </li>
                ))}
              </ul>
            )}
          </CmsCard>
        </div>

        <CmsDrawer id="cms-row-drawer" tone="form" title="Import row">
          <div id="cms-row-body" class="text-cms-body-sm text-cms-muted">
            Loading.
          </div>
          <Fragment slot="actions">
            <CmsButton variant="ghost" data-cms-modal-close>
              Close
            </CmsButton>
          </Fragment>
        </CmsDrawer>
      </Fragment>
    )
  }
</CmsLayout>

<script>
  const drawer = document.getElementById('cms-row-drawer') as HTMLDialogElement | null;
  const body = document.getElementById('cms-row-body');
  const message = document.getElementById('cms-batch-message');
  const batchId = window.location.pathname.split('/').pop() ?? '';

  document.addEventListener('click', async (event) => {
    const target = (event.target as HTMLElement | null)?.closest('[data-cms-row-inspect]');
    if (!target || !drawer || !body) return;
    const rowId = target.getAttribute('data-cms-row-inspect') ?? '';
    body.textContent = 'Loading.';
    drawer.showModal();
    const response = await fetch(`/api/data/rows/${rowId}`);
    if (!response.ok) {
      body.textContent = 'That row could not be read.';
      return;
    }
    const payload = (await response.json()) as { row?: Record<string, unknown> };
    const row = payload.row ?? {};
    const raw = row.rawSource as Record<string, string> | null;
    const pair = (label: string, value: string) =>
      `<div class="flex justify-between gap-3 border-b border-cms-line py-1.5 last:border-0"><span>${label}</span><span class="font-medium text-cms-ink break-all">${value}</span></div>`;
    body.innerHTML =
      pair('Source row', String(row.sourceRowNumber ?? '')) +
      pair('Source key', String(row.sourceRecordKey ?? 'Not available')) +
      pair('Status', String(row.rowStatus ?? '')) +
      pair('Message', String(row.errorMessage ?? '')) +
      pair('Row hash', String(row.rowHash ?? '')) +
      pair('Record', String(row.entityId ?? 'Not imported')) +
      pair(
        'Snapshot version',
        row.snapshotVersion === null ? 'Not available' : String(row.snapshotVersion),
      ) +
      (raw === null
        ? `<p class="mt-3 rounded-cms border border-cms-line bg-cms-canvas px-3 py-2">${String(row.withheld ?? '')}</p>`
        : `<p class="mt-3 font-medium text-cms-ink">Raw source</p>` +
          Object.entries(raw)
            .map(([key, value]) => pair(key, value))
            .join(''));
  });

  // Run the whole batch again from the stored file. Not offered on an
  // IMPORTED batch, and the server refuses it there too.
  document.getElementById('cms-batch-reprocess')?.addEventListener('click', async () => {
    const message = document.getElementById('cms-batch-message');
    if (message) message.textContent = 'Reprocessing';
    const response = await fetch(`/api/data/imports/${batchId}/reprocess`, { method: 'POST' });
    const body = (await response.json().catch(() => null)) as Record<string, unknown> | null;
    const result = (body ?? {}) as Record<string, unknown>;
    if (message) {
      message.textContent = response.ok
        ? `Reprocessed: ${String(result.previousStatus)} to ${String(result.newStatus)}.`
        : String(result.reason ?? 'The batch could not be reprocessed.');
    }
    if (response.ok) window.location.reload();
  });

  document.getElementById('cms-batch-commit')?.addEventListener('click', async () => {
    if (message) message.textContent = 'Importing.';
    const response = await fetch(`/api/data/imports/${batchId}/commit`, { method: 'POST' });
    const result = (await response.json().catch(() => null)) as Record<string, unknown> | null;
    if (!response.ok || result === null) {
      if (message) message.textContent = 'The import could not be completed.';
      return;
    }
    const skipped = (result.skippedReasons ?? []) as { reason: string; rows: number }[];
    if (message) {
      message.textContent =
        String(result.status) === 'PARTIAL'
          ? `Partial: ${String(result.documentsCreated)} created, ${String(result.documentsUpdated)} updated, ${String(result.documentsSkipped)} not imported. ${skipped.map((entry) => `${entry.rows} rows: ${entry.reason}`).join('; ')}`
          : `Imported: ${String(result.documentsCreated)} created, ${String(result.documentsUpdated)} updated, ${String(result.documentsUnchanged)} unchanged.`;
    }
    window.setTimeout(() => window.location.reload(), 1200);
  });

  document.getElementById('cms-batch-revalidate')?.addEventListener('click', async () => {
    if (message) message.textContent = 'Revalidating.';
    const response = await fetch(`/api/data/imports/${batchId}/revalidate`, { method: 'POST' });
    const result = (await response.json().catch(() => null)) as Record<string, unknown> | null;
    if (!response.ok || result === null) {
      if (message) message.textContent = 'The rows could not be revalidated.';
      return;
    }
    if (message) {
      message.textContent = `Examined ${String(result.rowsExamined)} rows: ${String(result.rowsResolved)} resolved, ${String(result.rowsStillUnresolved)} still waiting, ${String(result.actorsResolved)} names mapped.`;
    }
    window.setTimeout(() => window.location.reload(), 1500);
  });
</script>
