---
/**
 * Administration: the landing page for the configuration sections.
 *
 * No longer the shared placeholder, because most of these sections are now
 * real. The page says which is built and which is not, rather than presenting
 * equal tiles and letting a person find out by clicking.
 *
 * Each card is shown only to somebody who could actually use it. That is
 * presentation and not access control: the workspace behind Organisation checks
 * the permission for itself, and every endpoint under it refuses a caller who
 * lacks it whether or not this page ever rendered a link.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsIcon from '@/components/cms/CmsIcon.astro';
import {
  canManageCatalogue,
  canManageRoles,
  canManageUsers,
  canViewAudit,
  canViewOrganisation,
  canViewWorkflows,
  canManageWorkflowRoles,
} from '@/lib/cms/permissions';
import { ORGANISATION_PATH } from '@/lib/cms/admin/workspace';
import { WORKFLOW_PATH } from '@/lib/cms/admin/workflowWorkspace';

// Rendered on the server for every request, never prerendered. Without this the
// page is baked at build time and the permission check below runs once during
// the build rather than per request.
export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];

interface Section {
  label: string;
  href: string | null;
  description: string;
  ready: boolean;
  visible: boolean;
}

const sections: Section[] = [
  {
    label: 'Organisation',
    href: ORGANISATION_PATH,
    description:
      'Countries, affiliates, business units, departments and teams. The structures that drive visibility, assignments, approvals and reporting.',
    ready: true,
    visible: canViewOrganisation(permissions),
  },
  {
    label: 'Users',
    href: '/app/administration/users',
    description:
      'Accounts, organisational assignments, job titles, team membership and external account mappings.',
    ready: true,
    visible: canManageUsers(permissions),
  },
  {
    label: 'Roles and permissions',
    href: '/app/administration/roles',
    description: 'Access roles, the permission matrix, data scopes and who holds what.',
    ready: true,
    visible: canManageRoles(permissions),
  },
  {
    label: 'Workflows',
    href: WORKFLOW_PATH,
    description:
      'Workflow roles and scoped approval authority, versioned approval chains, and the preview that answers who would approve a transaction before one exists.',
    ready: true,
    visible: canViewWorkflows(permissions),
  },
  {
    label: 'Product catalogue',
    href: '/app/administration/catalogue',
    description:
      'One product master for the whole platform: groups, nested categories and the products beneath them. Orders, cases, SLA reporting and approval authority all read these same records.',
    ready: true,
    visible: canManageCatalogue(permissions),
  },
  {
    label: 'Audit trail',
    href: '/app/administration/audit',
    description:
      'Who changed what, and when. Every row is evidence, and two database triggers refuse any attempt to alter or delete one, including by a system administrator.',
    ready: true,
    visible: canViewAudit(permissions),
  },
  {
    label: 'System health',
    href: '/app/administration/health',
    description:
      'Configuration checks with a stated rule each, including the workflow roles nobody currently holds, which is how a transaction ends up with no approver.',
    ready: true,
    visible: canManageUsers(permissions) || canManageWorkflowRoles(permissions),
  },
  {
    label: 'Access review',
    href: '/app/administration/access-review',
    description:
      'Application access and approval authority, side by side and never merged. They are different things, and reading them as one list is how authority gets granted by accident.',
    ready: true,
    visible: canManageUsers(permissions) || canManageWorkflowRoles(permissions),
  },
  {
    label: 'Design reference',
    href: '/app/administration/components',
    description:
      'Every interface primitive in every state, rendered from the real components. One page, no build tooling, so it cannot drift from what a user sees.',
    ready: true,
    visible: canManageUsers(permissions),
  },
  {
    label: 'Workflow authority review',
    href: '/app/administration/authority',
    description:
      'Who can approve this today. Assignments are effective-dated, so the configuration can look correct while nobody actually holds the authority any more.',
    ready: true,
    visible: canManageUsers(permissions) || canManageWorkflowRoles(permissions),
  },
];

const visible = sections.filter((section) => section.visible);
---

<CmsLayout title="Administration">
  <CmsPageHeader
    title="Administration"
    crumbs={[{ label: 'Home', href: '/app' }, { label: 'Administration' }]}
  />

  {
    visible.length === 0 ? (
      <CmsCard>
        <p class="text-cms-body-sm text-cms-muted">
          You do not hold any administration permission, so there is nothing here for you to
          configure. Ask a system administrator if you believe that is wrong.
        </p>
      </CmsCard>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {visible.map((section) =>
          section.ready && section.href ? (
            <a
              href={section.href}
              class="flex flex-col gap-2 rounded-cms-lg border border-cms-line bg-cms-surface p-5 transition-colors duration-150 outline-none hover:border-cms-royal focus-visible:ring-2 focus-visible:ring-focus"
            >
              <span class="flex items-center justify-between gap-2">
                <span class="text-cms-card font-semibold text-cms-navy">{section.label}</span>
                <CmsIcon name="chevronRight" size={17} class="text-cms-muted" />
              </span>
              <span class="text-cms-body-sm text-cms-muted">{section.description}</span>
            </a>
          ) : (
            <div class="flex flex-col gap-2 rounded-cms-lg border border-dashed border-cms-line bg-cms-canvas p-5">
              <span class="flex items-center justify-between gap-2">
                <span class="text-cms-card font-semibold text-cms-muted">{section.label}</span>
                <CmsBadge tone="neutral" label="Not built yet" />
              </span>
              <span class="text-cms-body-sm text-cms-muted">{section.description}</span>
            </div>
          ),
        )}
      </div>
    )
  }
</CmsLayout>
