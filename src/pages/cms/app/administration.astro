---
/**
 * Administration: the landing page for the configuration sections.
 *
 * No longer the shared placeholder, because one of these sections is now real.
 * Organisation is built; users, roles, workflows and the product catalogue are
 * not, and the page says which is which rather than presenting eight equal
 * tiles and letting a person find out by clicking.
 *
 * Each card is shown only to somebody who could actually use it. That is
 * presentation and not access control: the workspace behind Organisation checks
 * the permission for itself, and every endpoint under it refuses a caller who
 * lacks it whether or not this page ever rendered a link.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsIcon from '@/components/cms/CmsIcon.astro';
import { canManageUsers, canViewOrganisation } from '@/lib/cms/permissions';
import { ORGANISATION_PATH } from '@/lib/cms/admin/workspace';

// Rendered on the server for every request, never prerendered. Without this the
// page is baked at build time and the permission check below runs once during
// the build rather than per request.
export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];

interface Section {
  label: string;
  href: string | null;
  description: string;
  ready: boolean;
  visible: boolean;
}

const sections: Section[] = [
  {
    label: 'Organisation',
    href: ORGANISATION_PATH,
    description:
      'Countries, affiliates, business units, departments and teams. The structures that drive visibility, assignments, approvals and reporting.',
    ready: true,
    visible: canViewOrganisation(permissions),
  },
  {
    label: 'Users',
    href: '/app/administration/users',
    description:
      'Accounts, organisational assignments, job titles, team membership and external account mappings.',
    ready: true,
    visible: canManageUsers(permissions),
  },
  {
    label: 'Roles and permissions',
    href: null,
    description: 'Access roles, data scopes and the permission matrix.',
    ready: false,
    visible: permissions.includes('ADMIN.ROLES.MANAGE'),
  },
  {
    label: 'Workflows',
    href: null,
    description: 'Approval chains, workflow roles and the routing behind them.',
    ready: false,
    visible: permissions.includes('ADMIN.WORKFLOWS.MANAGE'),
  },
  {
    label: 'Product catalogue',
    href: null,
    description: 'Product groups, categories and the products beneath them.',
    ready: false,
    visible: permissions.includes('ADMIN.PRODUCT_CATALOG.MANAGE'),
  },
];

const visible = sections.filter((section) => section.visible);
---

<CmsLayout title="Administration">
  <CmsPageHeader
    title="Administration"
    description="Configuration for the whole platform. Changes here reshape what everybody else sees."
    crumbs={[{ label: 'Home', href: '/app' }, { label: 'Administration' }]}
  />

  {
    visible.length === 0 ? (
      <CmsCard>
        <p class="text-cms-body-sm text-cms-muted">
          You do not hold any administration permission, so there is nothing here for you to
          configure. Ask a system administrator if you believe that is wrong.
        </p>
      </CmsCard>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {visible.map((section) =>
          section.ready && section.href ? (
            <a
              href={section.href}
              class="flex flex-col gap-2 rounded-cms-lg border border-cms-line bg-cms-surface p-5 shadow-cms-card transition-colors duration-150 outline-none hover:border-cms-royal focus-visible:ring-2 focus-visible:ring-focus"
            >
              <span class="flex items-center justify-between gap-2">
                <span class="text-cms-card font-semibold text-cms-navy">{section.label}</span>
                <CmsIcon name="chevronRight" size={17} class="text-cms-muted" />
              </span>
              <span class="text-cms-body-sm text-cms-muted">{section.description}</span>
            </a>
          ) : (
            <div class="flex flex-col gap-2 rounded-cms-lg border border-dashed border-cms-line bg-cms-canvas p-5">
              <span class="flex items-center justify-between gap-2">
                <span class="text-cms-card font-semibold text-cms-muted">{section.label}</span>
                <CmsBadge tone="neutral" label="Not built yet" />
              </span>
              <span class="text-cms-body-sm text-cms-muted">{section.description}</span>
            </div>
          ),
        )}
      </div>
    )
  }
</CmsLayout>
