---
/**
 * Home, and it answers one question: where is time being lost right now?
 *
 * THE ORDER IS THE ARGUMENT. Two charts, then the two leaderboards that sit
 * under their own chart, then the exceptions that need somebody today. A
 * purchase order chart above a purchase order leaderboard, a sales order chart
 * above a sales order leaderboard: the column reads downward, so the eye never
 * has to carry a figure across the page to find who it belongs to.
 *
 * THE TWO PROCESSES ARE NEVER BLENDED. Different approvers, different targets,
 * different volumes, and the same person may act in both. One table would let
 * a fast purchase order level flatter a slow credit release, and would answer
 * a question nobody asked. So there are two of everything, with identical
 * columns in identical order, which is what lets the eye move between them.
 *
 * EVERY FIGURE IS A LINK, AND EVERY DESTINATION HOLDS EXACTLY THAT MANY
 * RECORDS. A number on a dashboard that cannot be opened is a number nobody can
 * check. The count is exact by construction rather than by agreement: the list
 * behind a figure is the same query with the grouping removed, so the two can
 * only disagree if somebody writes the second one twice.
 *
 * WHAT THIS PAGE USED TO DO WRONG, RECORDED SO IT IS NOT REINTRODUCED. It read
 * a rolling ninety-day window that nothing on the page named, and the
 * statement behind both boards had never executed: it grouped by an alias that
 * was out of scope, so every load raised `no such column: d.fn` and both
 * leaderboards rendered empty while the footer still printed the ranking
 * threshold. That combination read as "ten completions exist and the window
 * found none of them", and sent the diagnosis after the window instead of the
 * SQL. Both are fixed, and they were two faults rather than one.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsChart from '@/components/cms/CmsChart.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsSectionHeader from '@/components/cms/CmsSectionHeader.astro';
import CmsPeriodControl from '@/components/cms/CmsPeriodControl.astro';
import CmsApprovalLeaderboard from '@/components/cms/CmsApprovalLeaderboard.astro';
import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { createBatcher, runSection } from '@/lib/cms/batching';
import { parseFilter, drillTo } from '@/lib/cms/analytics/filters';
import { formatDuration } from '@/lib/cms/analytics/stats';
import { attentionCustomers, type AttentionCustomer } from '@/lib/cms/repos/executive';
import { countSalesOrders } from '@/lib/cms/repos/soPerformance';
import { countPurchaseOrders } from '@/lib/cms/repos/poPerformance';
import {
  approvalBoard,
  MINIMUM_RANKED_VOLUME,
  type ApprovalBoard,
} from '@/lib/cms/repos/approvalSla';
import {
  calendarSql,
  choosePeriod,
  parsePeriod,
  periodHref,
  periodWasChosen,
  previousPeriod,
  readCalendars,
  periodHasData,
  periodFromToken,
  EMPTY_CALENDAR,
  type DataCalendar,
} from '@/lib/cms/analytics/period';
import { horizontalBarChart, type ChartPoint } from '@/lib/cms/charts/svg';
import { toDbTimestamp } from '@/lib/cms/auth/session';

export const prerender = false;

const principal = Astro.locals.cms;
const user = principal?.user;
const userId = user?.userId ?? '';
const params = Astro.url.searchParams;
const filter = parseFilter(params);
const today = new Date();
const now = toDbTimestamp(today);

/**
 * WHICH DATES COUNT AS ACTIVITY, AND FOR WHICH BOARD.
 *
 * THE FAULT THIS SHAPE FIXES, RECORDED BECAUSE IT COST A WHOLE PANEL. These
 * sources used to be unioned into one population with no `series` and no
 * entity_type restriction, so "does this period hold data" was answered for the
 * PAGE, over every entity type in `workflow_stage_instances` — leads and cases
 * included. On 30 August 2026 the calendar saw one lead and one sales order
 * completed in August, answered yes, and the fallback never fired. The purchase
 * order board, whose data runs 1 to 30 May, then drew an empty chart and an
 * empty table in silence while its own 2,624 completions sat one period away.
 *
 * The period is still resolved ONCE, from the combined calendar. Each panel now
 * also knows whether ITS OWN data is in that period, from the same single
 * statement, and says so when it is not.
 */
const CALENDAR_SOURCES = [
  {
    table: 'workflow_stage_instances',
    column: 'completed_at',
    series: 'PURCHASE_ORDER',
    where: `workflow_instance_id IN (
      SELECT workflow_instance_id FROM workflow_instances WHERE entity_type = 'PURCHASE_ORDER')`,
  },
  {
    table: 'workflow_stage_instances',
    column: 'completed_at',
    series: 'SALES_ORDER',
    where: `workflow_instance_id IN (
      SELECT workflow_instance_id FROM workflow_instances WHERE entity_type = 'SALES_ORDER')`,
  },
  { table: 'sales_orders', column: 'invoice_created_at', series: 'SALES_ORDER' },
  { table: 'sales_orders', column: 'loading_authority_at', series: 'SALES_ORDER' },
] as const;

/**
 * WHERE EACH FUNCTION'S QUEUE LIVES, AS A STATUS.
 *
 * A sales order sitting at PENDING_FINANCE is waiting on finance approval, one
 * at READY has been approved and not yet invoiced, and one at INVOICED is
 * waiting for its loading authority. Each function therefore has exactly one
 * status that means "waiting here", which is what makes the count and its
 * destination the same question.
 */
const SO_WAITING: Readonly<Record<string, string>> = {
  'Finance approval': 'PENDING_FINANCE',
  'Credit release': 'PENDING_CREDIT',
  Invoicing: 'READY',
  'Loading authority': 'INVOICED',
};
const PO_WAITING_STATUS = 'IN_APPROVAL';
/** The one sales order queue the page prints a figure for. */
const SO_LEAD_WAITING = 'PENDING_FINANCE';

const asked = parsePeriod(params, today);
const explicit = periodWasChosen(params);
const drillMonth = (asked.from ?? '').slice(0, 7);

let calendar: DataCalendar = EMPTY_CALENDAR;
/** Each board's own activity, so a panel's data check matches what it draws. */
let purchaseCalendar: DataCalendar = EMPTY_CALENDAR;
let salesCalendar: DataCalendar = EMPTY_CALENDAR;
let purchases: ApprovalBoard | null = null;
let sales: ApprovalBoard | null = null;
let previousPurchases: ApprovalBoard | null = null;
let previousSales: ApprovalBoard | null = null;
let soWaiting = 0;
let poWaiting = 0;
let customers: AttentionCustomer[] = [];
/** Which figures failed, so the message can name them rather than a number. */
let failed: string[] = [];
let traceId: string | null = null;
let connectionFailed = false;
let choice = {
  period: asked,
  fellBackFrom: null as typeof asked | null,
  notice: null as string | null,
};

if (user) {
  try {
    const db = await getDb(getCmsEnv());
    // ONE QUEUE FOR THE WHOLE PAGE, IN TWO WAVES.
    //
    // Wave one is everything that does not depend on which period is shown:
    // the exceptions, the two waiting counts, and the single statement behind
    // the period control. Wave two is the boards, which genuinely cannot be
    // issued earlier, because a fallback off an empty default changes what
    // they are asked for. Two waves is two round trips, and the whole page
    // costs six of a budget of fifteen.
    const batcher = createBatcher(db);
    const [cal, attention, poCount, soCount] = await Promise.all([
      runSection(batcher, 'home.calendar', (client) =>
        client.execute({ sql: calendarSql(CALENDAR_SOURCES), args: [drillMonth] }),
      ),
      runSection(batcher, 'home.attention', (client) =>
        attentionCustomers(client, userId, filter, now),
      ),
      runSection(batcher, 'home.po-waiting', (client) =>
        countPurchaseOrders(client, userId, { ...filter, status: PO_WAITING_STATUS }, now),
      ),
      runSection(batcher, 'home.so-waiting', (client) =>
        countSalesOrders(client, userId, { ...filter, status: SO_LEAD_WAITING }, now),
      ),
    ]);
    if (cal.ok) {
      const read = readCalendars(cal.value.rows as Record<string, unknown>[]);
      calendar = read.combined;
      purchaseCalendar = read.series.get('PURCHASE_ORDER') ?? EMPTY_CALENDAR;
      salesCalendar = read.series.get('SALES_ORDER') ?? EMPTY_CALENDAR;
    }
    if (attention.ok) customers = attention.value;
    if (poCount.ok) poWaiting = poCount.value;
    if (soCount.ok) soWaiting = soCount.value;

    choice = choosePeriod(asked, calendar, today, explicit);
    const shown = choice.period;
    const before = previousPeriod(shown);

    const [po, so, poPrev, soPrev] = await Promise.all([
      runSection(batcher, 'home.purchases', (client) =>
        approvalBoard(client, 'PURCHASE_ORDER', shown),
      ),
      runSection(batcher, 'home.sales', (client) => approvalBoard(client, 'SALES_ORDER', shown)),
      // THE COMPARISON FOLLOWS THE SELECTION AND IS NEVER CHOSEN SEPARATELY.
      // It rides in the same batch, so naming last month costs nothing.
      before === null
        ? Promise.resolve({ ok: true as const, value: null })
        : runSection(batcher, 'home.purchases-prev', (client) =>
            approvalBoard(client, 'PURCHASE_ORDER', before),
          ),
      before === null
        ? Promise.resolve({ ok: true as const, value: null })
        : runSection(batcher, 'home.sales-prev', (client) =>
            approvalBoard(client, 'SALES_ORDER', before),
          ),
    ]);
    if (po.ok) purchases = po.value;
    else {
      failed.push('purchase order approval');
      traceId = po.traceId;
    }
    if (so.ok) sales = so.value;
    else {
      failed.push('sales order approval');
      traceId = traceId ?? so.traceId;
    }
    if (poPrev.ok) previousPurchases = poPrev.value;
    if (soPrev.ok) previousSales = soPrev.value;
  } catch (error) {
    console.error('[cms.home] no database connection', error);
    connectionFailed = true;
  }
}

const shown = choice.period;
const before = previousPeriod(shown);

const count = (value: number) => value.toLocaleString('en-KE');

/** The record list behind a purchase order function. */
const toPurchases = (extra: Record<string, string | null> = {}) =>
  drillTo('/app/orders/purchases', filter, extra);
const toSales = (extra: Record<string, string | null> = {}) =>
  drillTo('/app/orders/sales', filter, extra);

const chartOf = (board: ApprovalBoard | null, link: (fn: string) => string) =>
  horizontalBarChart(
    {
      name: 'Typical turnaround',
      token: 'cms-series-1',
      points: (board?.functions ?? []).map<ChartPoint>((f) => ({
        label: f.fn,
        value: f.medianMinutes,
        marker: f.p90Minutes,
        target: f.targetMinutes,
        href: link(f.fn),
      })),
    },
    { unit: 'minutes', format: formatDuration, height: 30 * (board?.functions.length ?? 1) + 12 },
  );

const purchaseChart = chartOf(purchases, () => toPurchases({ status: PO_WAITING_STATUS }));
const salesChart = chartOf(sales, (fn) => toSales({ status: SO_WAITING[fn] ?? null }));

const volumeOf = (board: ApprovalBoard | null) =>
  (board?.functions ?? []).reduce((n, f) => n + f.volume, 0);

/**
 * The comparison sentence, which names the period it compares against.
 *
 * A percentage against an unnamed baseline is a number nobody can check, so
 * the previous period is spelled out. Where the previous period holds nothing
 * the sentence says that rather than dividing by zero and printing an infinity.
 */
const comparison = (board: ApprovalBoard | null, prior: ApprovalBoard | null): string | null => {
  if (board === null || before === null) return null;
  const nowVolume = volumeOf(board);
  const wasVolume = volumeOf(prior);
  // EACH HALF NAMES ITS OWN ROLE. "0 completed. Nothing completed in July 2026."
  // read as two claims about two periods, and next to a panel headed August it
  // looked like the page disagreed with itself. It never did: the first figure
  // is this period and the second is the one before it. The sentence now says
  // so.
  if (wasVolume === 0)
    return `${count(nowVolume)} completed in ${shown.label}, against none in ${before.label}.`;
  const change = Math.round(((nowVolume - wasVolume) / wasVolume) * 100);
  const direction = change > 0 ? 'up' : change < 0 ? 'down' : 'level';
  return `${count(nowVolume)} completed in ${shown.label}, ${direction}${
    change === 0 ? '' : ` ${Math.abs(change)}%`
  } on ${before.label} (${count(wasVolume)}).`;
};

/**
 * How many of THIS BOARD's completions lie outside the period.
 *
 * It used to be `calendar.total`, the page's whole mixed population — leads,
 * cases, sales orders and purchase orders together — printed under one board as
 * though it were that board's own. A wrong number in the wrong place is worse
 * than no number, because it is checkable and it is checkably false.
 */
const outsideFor = (own: DataCalendar, board: ApprovalBoard | null) =>
  Math.max(0, own.total - volumeOf(board));

/**
 * The one line a panel says when it is empty and its own data is elsewhere.
 *
 * The page-level fallback moves the period when NOTHING on the page has data.
 * This is the other half: the period is right for the page, and wrong for this
 * board. Never an empty chart in silence.
 */
const elsewhere = (own: DataCalendar, board: ApprovalBoard | null) => {
  if (volumeOf(board) > 0 || own.total === 0 || own.latest === null) return null;
  const target = periodFromToken(own.latest.slice(0, 7), today);
  if (target === null || periodHasData(shown, own)) return null;
  return {
    line:
      `Nothing here in ${shown.label}. ${count(own.total)} ` +
      `${own.total === 1 ? 'completion sits' : 'completions sit'} in other periods, the most ` +
      `recent in ${target.label}.`,
    href: periodHref('/app', target),
    label: `Show ${target.label}`,
  };
};

const peopleByFunction = (board: ApprovalBoard | null) =>
  (board?.functions ?? []).map((fn) => ({
    fn,
    people: (board?.leaders ?? []).filter((row) => row.fn === fn.fn && row.userId !== null),
  }));
const omittedFunctions = (board: ApprovalBoard | null) =>
  (board?.functions ?? [])
    .filter((fn) => !(board?.leaders ?? []).some((row) => row.fn === fn.fn && row.userId !== null))
    .map((fn) => fn.fn);

const peopleByFunction = (board: ApprovalBoard | null) =>
  (board?.functions ?? []).map((fn) => ({
    fn,
    people: (board?.leaders ?? []).filter((row) => row.fn === fn.fn && row.userId !== null),
  }));
const omittedFunctions = (board: ApprovalBoard | null) =>
  (board?.functions ?? [])
    .filter((fn) => !(board?.leaders ?? []).some((row) => row.fn === fn.fn && row.userId !== null))
    .map((fn) => fn.fn);

const peopleByFunction = (board: ApprovalBoard | null) =>
  (board?.functions ?? []).map((fn) => ({
    fn,
    people: (board?.leaders ?? []).filter((row) => row.fn === fn.fn && row.userId !== null),
  }));
const omittedFunctions = (board: ApprovalBoard | null) =>
  (board?.functions ?? [])
    .filter((fn) => !(board?.leaders ?? []).some((row) => row.fn === fn.fn && row.userId !== null))
    .map((fn) => fn.fn);

/**
 * The definition every figure on this page shares, one control away.
 *
 * The measurement basis belongs somewhere a reader can reach it and nowhere it
 * has to be read past: the bars are elapsed minutes and the dashed target is
 * configured against a business calendar, which agree inside a working day and
 * diverge across a weekend.
 */
const DEFINITION =
  `Elapsed minutes from the start of a function to its completion, over ${shown.label}. ` +
  'Purchase order functions are the configured approval levels; sales order functions are finance ' +
  'approval, credit release, invoicing and loading authority. Invoicing and loading authority record ' +
  'no actor in the source extract. The dashed target is the configured SLA target for that function, ' +
  'which is measured in business hours, so it and an elapsed figure agree within a working day and ' +
  'diverge across a weekend. A person is listed from the first approval and ranked from ' +
  `${MINIMUM_RANKED_VOLUME}.`;
---

<CmsLayout title="Home" width="data">
  <CmsPageHeader title="Home" definition={DEFINITION} />

  <CmsPeriodControl
    action="/app"
    period={shown}
    calendar={calendar}
    today={today}
    open={params.get('pick') === '1'}
    notice={choice.notice}
    revertHref={choice.fellBackFrom === null
      ? null
      : periodHref('/app', choice.fellBackFrom, { pick: null })}
    revertLabel={choice.fellBackFrom === null ? null : `Show ${choice.fellBackFrom.label} anyway`}
  />

  {connectionFailed && <CmsErrorState title="The dashboard could not be loaded" />}
  {
    /*
      A MESSAGE THAT NAMES WHAT FAILED AND WHAT TO DO. The old one printed a
      reference number and nothing else, which told a reader neither which
      figures were missing nor whether the rest of the page could be trusted.
    */
  }
  {
    failed.length > 0 && (
      <CmsErrorState
        title={`The ${failed.join(' and ')} figures could not be loaded`}
        description={
          `Everything else on this page loaded and is correct. The charts and leaderboards ` +
          `above are the only figures affected. Try ${shown.label} again, or choose another ` +
          `period; if it keeps failing, send your administrator reference ${traceId ?? 'unknown'} ` +
          `and the period you chose, which is what the server log is keyed on.`
        }
      />
    )
  }

  {
    /*
      TWO COLUMNS, EACH READ DOWNWARD. On a narrow screen they stack, purchase
      orders first, and each leaderboard stays under its own chart because the
      grid places them in that order rather than because a second layout says
      so.
    */
  }
  <div class="grid gap-6 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      <CmsChart
        title="Purchase order approval"
        definition={DEFINITION}
        chart={purchaseChart}
        unit="minutes"
        coverage={`${count(volumeOf(purchases))} approvals in ${shown.label}`}
      />
      {
        comparison(purchases, previousPurchases) !== null && (
          <p class="text-cms-body-sm text-cms-muted">{comparison(purchases, previousPurchases)}</p>
        )
      }
      <p class="text-cms-body-sm text-cms-muted">
        <a
          class="font-semibold text-cms-royal hover:underline"
          href={toPurchases({ status: PO_WAITING_STATUS })}
        >
          {count(poWaiting)}
        </a>{' '}
        in approval
      </p>
      {
        /*
          NEVER AN EMPTY CHART IN SILENCE. The page-level fallback moves the
          period when NOTHING on the page has data; this is the other half,
          where the period is right for the page and wrong for this board.
        */
      }
      {
        elsewhere(purchaseCalendar, purchases) !== null && (
          <p class="text-cms-body-sm text-cms-muted">
            {elsewhere(purchaseCalendar, purchases)!.line}{' '}
            <a
              class="font-semibold text-cms-royal underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
              href={elsewhere(purchaseCalendar, purchases)!.href}
            >
              {elsewhere(purchaseCalendar, purchases)!.label}
            </a>
          </p>
        )
      }
      <CmsApprovalLeaderboard
        caption="Purchase order approvers"
        process="PURCHASE_ORDER"
        board={purchases}
        period={shown}
        totalOutside={outsideFor(purchaseCalendar, purchases)}
        widenHref={periodHref('/app', { ...shown, key: 'all', from: null, to: null })}
        orderPath="/app/orders/purchases"
      />
    </div>

    <div class="flex flex-col gap-4">
      <CmsChart
        title="Sales order approval"
        definition={DEFINITION}
        chart={salesChart}
        unit="minutes"
        coverage={`${count(volumeOf(sales))} completions in ${shown.label}`}
      />
      {
        comparison(sales, previousSales) !== null && (
          <p class="text-cms-body-sm text-cms-muted">{comparison(sales, previousSales)}</p>
        )
      }
      <p class="text-cms-body-sm text-cms-muted">
        <a
          class="font-semibold text-cms-royal hover:underline"
          href={toSales({ status: SO_WAITING['Finance approval'] ?? null })}
        >
          {count(soWaiting)}
        </a>{' '}
        awaiting finance approval
      </p>
      {
        /*
          NEVER AN EMPTY CHART IN SILENCE. The page-level fallback moves the
          period when NOTHING on the page has data; this is the other half,
          where the period is right for the page and wrong for this board.
        */
      }
      {
        elsewhere(salesCalendar, sales) !== null && (
          <p class="text-cms-body-sm text-cms-muted">
            {elsewhere(salesCalendar, sales)!.line}{' '}
            <a
              class="font-semibold text-cms-royal underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
              href={elsewhere(salesCalendar, sales)!.href}
            >
              {elsewhere(salesCalendar, sales)!.label}
            </a>
          </p>
        )
      }
      <CmsApprovalLeaderboard
        caption="Sales order approvers"
        process="SALES_ORDER"
        board={sales}
        period={shown}
        totalOutside={outsideFor(salesCalendar, sales)}
        widenHref={periodHref('/app', { ...shown, key: 'all', from: null, to: null })}
        orderPath="/app/orders/sales"
      />
    </div>
  </div>

  {
    /*
      THE ONLY OTHER THING ON THE PAGE, AND EVERY ROW OPENS. An exception that
      cannot be drilled into is a worry rather than a task.
    */
  }
  <section>
    <CmsSectionHeader id="attention" title="Needs attention" />
    {
      customers.length === 0 ? (
        <CmsEmptyState title="No customer is showing an exception." />
      ) : (
        <CmsCard>
          <CmsDataTable
            caption="Customers needing attention"
            columns={[
              { key: 'customer', label: 'Customer' },
              { key: 'orders', label: 'Open orders', numeric: true },
              { key: 'cases', label: 'Open cases', numeric: true },
              { key: 'breaches', label: 'SLA breaches', numeric: true },
              { key: 'manager', label: 'Account manager', secondary: true },
            ]}
            rowCount={customers.length}
          >
            {customers.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="px-3 py-2">
                  <a
                    class="font-medium text-cms-royal hover:underline"
                    href={`/app/operations/customers/${row.accountId}`}
                  >
                    {row.customerName}
                  </a>
                </td>
                <td class="px-3 py-2 text-right tabular-nums">
                  <a
                    class="text-cms-royal hover:underline"
                    href={toSales({ accountId: row.accountId })}
                  >
                    {count(row.openOrders)}
                  </a>
                </td>
                <td class="px-3 py-2 text-right tabular-nums">
                  <a
                    class="text-cms-royal hover:underline"
                    href={drillTo('/app/helpdesk', filter, { accountId: row.accountId })}
                  >
                    {count(row.openCases)}
                  </a>
                </td>
                <td class="px-3 py-2 text-right tabular-nums">
                  <a
                    class="text-cms-royal hover:underline"
                    href={drillTo('/app/performance', filter, { accountId: row.accountId })}
                  >
                    {count(row.slaBreaches)}
                  </a>
                </td>
                <td class="hidden px-3 py-2 sm:table-cell">
                  {row.accountManager ?? 'Not assigned'}
                </td>
              </tr>
            ))}
          </CmsDataTable>
        </CmsCard>
      )
    }
  </section>
</CmsLayout>
