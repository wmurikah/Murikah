---
/**
 * The dashboard. One of them, at /app, and it is what a person lands on.
 *
 * THERE USED TO BE TWO. A verbose Home carrying a profile card and a grid of
 * workspace tiles that duplicated the navigation rail, and an Executive page
 * carrying the figures. A person signing in met the one with no numbers on it
 * and had to go and find the other. They are merged here: Executive is a
 * redirect, its rail entry is gone, and this is the only dashboard.
 *
 * SLA FIRST, because it is the reason this system exists. The segmented
 * control at the top chooses Internal or External and lives in the URL, so a
 * view can be sent to somebody else and the browser's back button works.
 *
 * THE SWITCH COSTS NOTHING. Both families are read from figures the Orders and
 * Service sections already load, so choosing one does not fetch anything the
 * other did not. Fetching an "SLA payload" per family would have added round
 * trips to a page that is already at its budget.
 *
 * COMPOSED FROM PERMISSIONS, AND IT DOES NOT SAY SO ON THE PAGE. A section
 * renders where the caller holds the permission its module requires and the
 * scope resolver decides what it counts. That is how the system works; it is
 * not something a manager needs read to them, and the paragraph that used to
 * explain it here has gone.
 *
 * WHAT WENT WITH THE OLD HOME. The profile card (the same facts are on the
 * account menu), the workspace tiles (the rail is the navigation), and the
 * personal SLA and follow-up counters, which cost four round trips and two
 * write sweeps on the landing page. The sweep still runs: on the SLA monitor,
 * on notifications, on both of their endpoints, and on every domain event
 * through the SLA wiring, so nothing stops being settled because this page
 * stopped doing it.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsSectionHeader from '@/components/cms/CmsSectionHeader.astro';
import CmsKpiCard from '@/components/cms/CmsKpiCard.astro';
import CmsStatusPill from '@/components/cms/CmsStatusPill.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsFilterBar from '@/components/cms/CmsFilterBar.astro';
import CmsChart from '@/components/cms/CmsChart.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import { SALES_ORDER_VIEW, PURCHASE_ORDER_VIEW } from '@/lib/cms/permissions';
import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { createBatcher, runSection } from '@/lib/cms/batching';
import { parseFilter, drillTo, filterToQuery } from '@/lib/cms/analytics/filters';
import { formatDuration, formatRate } from '@/lib/cms/analytics/stats';
import {
  dashboard,
  attentionCustomers,
  entityComparison,
  type Dashboard,
  type AttentionCustomer,
  type EntityComparisonRow,
} from '@/lib/cms/repos/executive';
import { lineChart, horizontalBarChart, sparkline } from '@/lib/cms/charts/svg';
import { toDbTimestamp } from '@/lib/cms/auth/session';
import { SLA_FAMILIES, readSlaFamily, slaFamilyView } from '@/lib/cms/dashboard/sla';
import { approvals, alignBuckets, type ApprovalsView } from '@/lib/cms/dashboard/approvals';
import CmsLeaderboardRow from '@/components/cms/CmsLeaderboardRow.astro';

export const prerender = false;

const principal = Astro.locals.cms;
const user = principal?.user;
const permissions = user?.permissions ?? [];
const userId = user?.userId ?? '';
const filter = parseFilter(Astro.url.searchParams);
const now = toDbTimestamp(new Date());
/** Internal or External, from the URL, so the view can be shared. */
const family = readSlaFamily(Astro.url.searchParams);

let board: Dashboard | null = null;
let customers: AttentionCustomer[] = [];
let entities: EntityComparisonRow[] = [];
let approvalsView: ApprovalsView | null = null;
let boardFailure: { traceId: string } | null = null;
let connectionFailed = false;

if (user) {
  try {
    const db = await getDb(getCmsEnv());
    // ONE QUEUE FOR THE WHOLE PAGE. Every read issued in the same microtask
    // leaves as a single batch, which is how a dashboard of this size costs a
    // handful of round trips rather than one per figure.
    const batcher = createBatcher(db);
    const [boardResult, customersResult, entitiesResult, approvalsResult] = await Promise.all([
      runSection(batcher, 'dashboard.board', (client) =>
        dashboard(client, userId, permissions, filter, now),
      ),
      runSection(batcher, 'dashboard.attention-customers', (client) =>
        attentionCustomers(client, userId, filter, now),
      ),
      runSection(batcher, 'dashboard.entities', (client) =>
        entityComparison(client, userId, permissions, filter, now),
      ),
      // The approval functions, issued alongside everything else so its
      // statements join the same batch rather than starting a new round trip.
      runSection(batcher, 'dashboard.approvals', (client) =>
        approvals(client, userId, filter, now, {
          salesOrders: permissions.includes(SALES_ORDER_VIEW),
          purchaseOrders: permissions.includes(PURCHASE_ORDER_VIEW),
        }),
      ),
    ]);
    if (boardResult.ok) board = boardResult.value;
    else boardFailure = { traceId: boardResult.traceId };
    if (customersResult.ok) customers = customersResult.value;
    if (entitiesResult.ok) entities = entitiesResult.value;
    if (approvalsResult.ok) approvalsView = approvalsResult.value;
  } catch (error) {
    console.error('[cms.dashboard] no database connection', error);
    connectionFailed = true;
  }
}

const money = (value: number, currency: string) =>
  `${currency} ${Math.round(value).toLocaleString('en-KE')}`;
const count = (value: number) => value.toLocaleString('en-KE');

/** The four module destinations, each carrying the whole filter. */
const toService = drillTo('/app/service/analytics', filter);
const toCrm = drillTo('/app/crm/analytics', filter);
const toSales = drillTo('/app/orders/sales/performance', filter);
const toPurchases = drillTo('/app/orders/purchases/performance', filter);

/** A compliance percentage read as a state, so a pill can carry a judgement. */
const slaTone = (percent: number | null) =>
  percent === null
    ? ('neutral' as const)
    : percent >= 95
      ? ('positive' as const)
      : percent >= 85
        ? ('caution' as const)
        : ('negative' as const);
const slaState = (percent: number | null) =>
  percent === null
    ? 'Not available'
    : percent >= 95
      ? 'Met'
      : percent >= 85
        ? 'At Risk'
        : 'Breached';

// ---- The SLA section, derived from figures the page already holds ---------
const sla = board === null ? null : slaFamilyView(family, board);

// ---- Charts, every one drawn from data already loaded --------------------
const trend = board?.salesOrders ?? null;
const volumeSpark =
  trend === null || trend.trend.length === 0
    ? undefined
    : sparkline(
        {
          name: 'Sales orders raised',
          token: 'cms-series-1',
          points: trend.trend.map((row) => ({ label: row.bucket, value: row.orders })),
        },
        { unit: 'orders' },
      );

/**
 * The affiliates a reader may narrow to, from the comparison the page already
 * loaded, so the control costs nothing and can only offer an affiliate the
 * reader is actually allowed to see.
 *
 * Five affiliates all called "Hass Petroleum X" put the same two words on every
 * chip, so the company name is dropped and the chip reads Kenya, Uganda,
 * Tanzania. The full name is in the Affiliates table further down the page.
 */
const shortAffiliate = (name: string) => name.replace(/^Hass Petroleum\s+/i, '');
const affiliateChoices = [
  { id: null, label: 'All affiliates' },
  ...entities.map((row) => ({ id: row.affiliateId, label: shortAffiliate(row.affiliateName) })),
];

/**
 * The approval function chart: the one question both processes share.
 *
 * The axis is the function, because a function is a thing somebody owns and can
 * be asked about. The bars carry their own targets where a target is
 * configured, and a function nobody set a target for has no mark rather than
 * being measured against somebody else’s.
 *
 * Every bar drills to the orders behind it, carrying the function and the whole
 * filter, so the reader lands on the population the bar was computed from.
 */
const processLabel = (processType: string) =>
  processType === 'SALES_ORDER' ? 'sales orders' : 'purchase orders';
const processPath = (processType: string) =>
  processType === 'SALES_ORDER' ? '/app/orders/sales' : '/app/orders/purchases';

const functionChart =
  approvalsView === null || approvalsView.functions.length === 0
    ? null
    : horizontalBarChart(
        {
          name: 'Median turnaround by approval function',
          token: 'cms-series-1',
          points: approvalsView.functions.map((one) => ({
            label: `${one.functionName}, ${processLabel(one.processType)}`,
            value: one.medianMinutes,
            target: one.targetMinutes,
            href: drillTo(processPath(one.processType), filter, { stageCode: one.stageCode }),
          })),
        },
        { unit: 'minutes', format: formatDuration, height: undefined },
      );

/**
 * One trend line per process, on one pair of axes.
 *
 * Both are medians in minutes, so they share a scale honestly. The buckets are
 * the union of the two, and a period a process had no completed cycles in is a
 * gap in its line rather than a zero, because zero minutes would claim the
 * approvals were instant.
 */
const cycleAlignment =
  approvalsView === null
    ? null
    : alignBuckets(
        (trend?.trend ?? []).map((row) => ({
          bucket: row.bucket,
          medianMinutes: row.orderToInvoiceMedianMinutes,
        })),
        approvalsView.purchaseTrend,
      );

const cycleChart =
  cycleAlignment === null || cycleAlignment.buckets.length === 0
    ? null
    : lineChart(
        [
          {
            name: 'Sales orders',
            token: 'cms-series-1',
            points: cycleAlignment.buckets.map((bucket, index) => ({
              label: bucket,
              value: cycleAlignment.first[index] ?? null,
              href: toSales,
            })),
          },
          {
            name: 'Purchase orders',
            token: 'cms-series-2',
            points: cycleAlignment.buckets.map((bucket, index) => ({
              label: bucket,
              value: cycleAlignment.second[index] ?? null,
              href: toPurchases,
            })),
          },
        ],
        { unit: 'minutes', format: formatDuration, endLabels: true, height: 200 },
      );

/**
 * Stage one splits by what was being bought, so the chart is by product group.
 * Three bars from the current extract, and however many the next one carries.
 */
const stageOneChart =
  approvalsView === null || approvalsView.stageOneByProductGroup.length === 0
    ? null
    : horizontalBarChart(
        {
          name: 'Median stage one turnaround by product group',
          token: 'cms-series-3',
          points: approvalsView.stageOneByProductGroup.map((row) => ({
            label: row.productGroupName,
            value: row.medianMinutes,
            href: drillTo('/app/orders/purchases', filter, { productGroupId: row.productGroupId }),
          })),
        },
        { unit: 'minutes', format: formatDuration },
      );

/**
 * Credit release turnaround, by the person who released it.
 *
 * HOLD_RELEASED_BY in the sales order extract is a person, and the importer
 * resolves it to the credit stage’s actor through `source_identities`, so this
 * is that column read back rather than a second reading of it.
 */
const creditReleaseChart =
  approvalsView === null || approvalsView.creditRelease.length === 0
    ? null
    : horizontalBarChart(
        {
          name: 'Credit release turnaround by approver',
          token: 'cms-series-2',
          points: approvalsView.creditRelease.slice(0, 6).map((row) => ({
            label: row.approver,
            value: row.medianMinutes,
            href: drillTo('/app/orders/sales', filter, {
              stageCode: row.stageCode,
              ownerId: row.userId,
            }),
          })),
        },
        { unit: 'minutes', format: formatDuration },
      );

/**
 * Customers to look at, as a horizontal bar.
 *
 * Horizontal because a customer's name is words: "Sirikwa Haulage Limited"
 * rotated under a vertical bar is a truncation, and on its own line it is a
 * name. The bar is open cases, which is the count the reader acts on.
 */
const customerChart =
  customers.length === 0
    ? null
    : horizontalBarChart(
        {
          name: 'Open cases by customer',
          token: 'cms-series-4',
          points: customers.slice(0, 6).map((row) => ({
            label: row.customerName,
            value: row.openCases,
            href: drillTo('/app/customers', filter, { accountId: row.accountId }),
          })),
        },
        { unit: 'cases', format: (v) => (v === null ? 'Not available' : count(v)) },
      );

const composition = board?.composition ?? null;
const nothingVisible =
  composition !== null &&
  !composition.needsAttention &&
  !composition.commercial &&
  !composition.salesOrders &&
  !composition.purchaseOrders &&
  !composition.service &&
  !composition.freshness;
---

<CmsLayout title="Dashboard">
  {
    connectionFailed || board === null ? (
      <CmsErrorState
        title="The dashboard could not be loaded"
        description={
          boardFailure
            ? `The database did not answer. Quote reference ${boardFailure.traceId} when reporting this.`
            : 'The database did not answer.'
        }
      />
    ) : (
      <Fragment>
        <CmsPageHeader title={`Good day, ${user?.firstName ?? ''}`.trim()}>
          <CmsButton
            slot="actions"
            variant="secondary"
            href={`/api/orders/sales/export${filterToQuery(filter)}`}
          >
            Export
          </CmsButton>
        </CmsPageHeader>

        {/*
          The filter row: one line of small controls and a reset, on the canvas
          rather than inside a bordered panel. The panel it replaces was a card
          with a heading, which gave three date fields the weight of a section
          and pushed the first real figure below the fold.
        */}
        <CmsFilterBar action="/app" class="-mt-1">
          <input type="hidden" name="sla" value={family} />
          <CmsInput
            id="d-from"
            name="from"
            label="From"
            type="date"
            size="sm"
            value={filter.from ?? ''}
          />
          <CmsInput id="d-to" name="to" label="To" type="date" size="sm" value={filter.to ?? ''} />
          <CmsSelect
            id="d-grain"
            name="grain"
            label="Trend"
            size="sm"
            value={filter.grain}
            options={[
              { value: 'DAY', label: 'Daily' },
              { value: 'WEEK', label: 'Weekly' },
              { value: 'MONTH', label: 'Monthly' },
            ]}
          />
        </CmsFilterBar>

        {nothingVisible ? (
          <CmsEmptyState
            icon="performance"
            title="No dashboard sections are available to you yet"
            description="Your access roles do not currently reach orders, opportunities, cases or imports. Contact your administrator."
          />
        ) : (
          <Fragment>
            {/* ---- 1. SLA ------------------------------------------------ */}
            {sla !== null && (
              <section aria-labelledby="sla" class="flex flex-col gap-3">
                <CmsSectionHeader id="sla" title="SLA">
                  {/*
                    A segmented control, built from two links rather than a
                    script: the choice is in the URL, so it survives a reload,
                    a share and the back button, and it works with no
                    JavaScript at all.
                  */}
                  <div
                    slot="actions"
                    role="group"
                    aria-label="SLA family"
                    class="inline-flex rounded-cms bg-cms-sunken p-0.5"
                  >
                    {SLA_FAMILIES.map((option) => (
                      <a
                        href={drillTo('/app', filter, { sla: option.key })}
                        aria-current={option.key === family ? 'true' : undefined}
                        class:list={[
                          'inline-flex h-8 items-center rounded-cms px-3 text-cms-caption font-semibold outline-none focus-visible:ring-2 focus-visible:ring-focus',
                          option.key === family
                            ? 'bg-cms-surface text-cms-ink'
                            : 'text-cms-muted hover:text-cms-ink',
                        ]}
                      >
                        {option.label}
                      </a>
                    ))}
                  </div>
                </CmsSectionHeader>

                {/*
                  The affiliate filter, at the top of the section and applied to
                  everything below it. It is the page filter rather than a
                  second one: two affiliate controls that can disagree would
                  show SLA figures for one company above order figures for
                  another, and both would look authoritative.

                  Chips rather than a select with an Apply button, because the
                  list is a handful of affiliates and a chip is one click. Each
                  one is a link carrying the whole filter, so it works with no
                  JavaScript and the choice lives in the URL.
                */}
                {affiliateChoices.length > 1 && (
                  <div role="group" aria-label="Affiliate" class="-mt-1 flex flex-wrap gap-1.5">
                    {affiliateChoices.map((choice) => (
                      <a
                        href={drillTo('/app', filter, { affiliateId: choice.id, sla: family })}
                        aria-current={
                          (choice.id ?? null) === (filter.affiliateId ?? null) ? 'true' : undefined
                        }
                        class:list={[
                          'inline-flex h-7 items-center rounded-cms border px-2.5 text-cms-caption font-medium outline-none focus-visible:ring-2 focus-visible:ring-focus',
                          (choice.id ?? null) === (filter.affiliateId ?? null)
                            ? 'border-cms-royal bg-cms-royal text-white'
                            : 'border-cms-line bg-cms-surface text-cms-muted hover:text-cms-ink',
                        ]}
                      >
                        {choice.label}
                      </a>
                    ))}
                  </div>
                )}

                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                  {sla.measures.map((measure) => (
                    <CmsKpiCard
                      label={measure.label}
                      value={measure.value}
                      context={measure.context}
                      tone={measure.tone}
                      href={measure.href}
                      definition={measure.definition}
                      denominator={measure.denominator}
                      dateBasis={measure.dateBasis}
                    />
                  ))}
                </div>

                {functionChart && (
                  <CmsChart
                    title="Median turnaround by approval function"
                    definition="Median minutes from a stage becoming answerable to it being decided, for every approval function the selected orders actually used. The functions are read from the workflow, not from a list: a level nobody used has no bar and a level somebody adds appears on its own. A dashed mark is that function's own configured target, shown only where every workflow definition contributing to it agrees on the number. Purchase orders carry the affiliate chosen on upload, not one from the file."
                    chart={functionChart}
                    unit="minutes"
                  />
                )}

                {cycleChart && (
                  <CmsChart
                    title="Median cycle over the period"
                    definition="One line per process. Sales orders are measured from the order being created to its invoice being created; purchase orders from submission for approval to the last approval stage being decided. A period with no completed cycles is a gap, never a zero."
                    chart={cycleChart}
                    unit="minutes"
                  />
                )}

                {/*
                  The leaderboard, grouped by function and ranked within it.

                  A single ranking down the whole list would put the fastest
                  invoicing clerk above the slowest credit approver and call it a
                  league table. Within a function the comparison is between
                  people facing the same queue, which is the only comparison
                  that means anything. A person who approves at two functions
                  appears once under each and is never blended into one average.
                */}
                {approvalsView !== null && approvalsView.groups.length > 0 && (
                  <div class="grid gap-3 xl:grid-cols-2">
                    {approvalsView.groups.map((one) => (
                      <div class="rounded-cms-lg bg-cms-surface p-4">
                        <div class="flex items-baseline justify-between gap-2 pb-1">
                          <h3 class="text-cms-body-sm font-semibold text-cms-ink">
                            {one.functionName}
                          </h3>
                          <span class="text-cms-caption text-cms-muted">
                            {processLabel(one.processType)}
                          </span>
                        </div>
                        {one.rows.map((row) => (
                          <CmsLeaderboardRow
                            rank={row.rank}
                            name={row.approver}
                            href={drillTo(processPath(one.processType), filter, {
                              stageCode: one.stageCode,
                              ownerId: row.userId,
                            })}
                            volume={row.transactions}
                            median={formatDuration(row.medianMinutes)}
                            p90={formatDuration(row.p90Minutes)}
                            compliance={row.withinSlaPercent}
                            pending={row.pending}
                            oldestPending={
                              row.oldestPendingAt === null ? 'Not available' : row.oldestPendingAt
                            }
                            minimumVolume={approvalsView.minimumVolume}
                          />
                        ))}
                      </div>
                    ))}
                  </div>
                )}

                {(stageOneChart || creditReleaseChart) && (
                  <div class="grid gap-3 xl:grid-cols-2">
                    {stageOneChart && (
                      <CmsChart
                        title="Stage one turnaround by product group"
                        definition="Median minutes on the purchase order's first stage, by the product group of its lines. An order with lines in two groups is counted once in each, because apportioning one turnaround between them would invent a split the data does not carry."
                        chart={stageOneChart}
                        unit="minutes"
                      />
                    )}
                    {creditReleaseChart && (
                      <CmsChart
                        title="Credit release turnaround by approver"
                        definition="Median minutes from the credit stage opening to the release being recorded, by the person who released it. HOLD_RELEASED_BY from the extract, resolved to that person through source identities."
                        chart={creditReleaseChart}
                        unit="minutes"
                      />
                    )}
                  </div>
                )}
              </section>
            )}

            {/* ---- 2. Needs attention ------------------------------------ */}
            {composition?.needsAttention && (
              <section aria-labelledby="attention" class="flex flex-col gap-3">
                <CmsSectionHeader id="attention" title="Needs attention" />
                {board.attention.length === 0 ? (
                  <p class="rounded-cms bg-cms-surface p-4 text-cms-body-sm text-cms-muted">
                    Nothing outstanding in this period within your scope.
                  </p>
                ) : (
                  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                    {board.attention.slice(0, 4).map((signal) => (
                      <CmsKpiCard
                        label={signal.label}
                        value={count(signal.count)}
                        tone={signal.count > 0 ? 'caution' : 'positive'}
                        href={drillTo(signal.href, filter, signal.destination)}
                        definition={signal.definition}
                      />
                    ))}
                  </div>
                )}
              </section>
            )}

            {/* ---- 3. Orders --------------------------------------------- */}
            {(composition?.salesOrders || composition?.purchaseOrders) && (
              <section aria-labelledby="orders" class="flex flex-col gap-3">
                <CmsSectionHeader id="orders" title="Orders" />
                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                  {board.salesOrders && (
                    <Fragment>
                      <CmsKpiCard
                        label="Sales orders"
                        value={count(board.salesOrders.orders)}
                        context="Raised in this period"
                        href={drillTo('/app/orders/sales', filter)}
                        spark={volumeSpark}
                        definition="Sales orders raised in this period."
                        denominator="Sales orders in your scope"
                        dateBasis="Order created at"
                      />
                      <CmsKpiCard
                        label="Order to invoice"
                        value={formatDuration(board.salesOrders.orderToInvoiceMedianMinutes)}
                        context="Median, elapsed"
                        href={toSales}
                        definition="Median time from the order being created to its invoice being created."
                        denominator="Orders that carried both timestamps"
                        dateBasis="Order created at"
                      />
                    </Fragment>
                  )}
                  {board.purchaseOrders && (
                    <Fragment>
                      <CmsKpiCard
                        label="Awaiting Oracle posting"
                        value={count(board.purchaseOrders.awaitingOraclePosting)}
                        context="Received, not yet posted"
                        tone={
                          board.purchaseOrders.awaitingOraclePosting > 0 ? 'caution' : 'positive'
                        }
                        href={drillTo('/app/orders/purchases', filter)}
                        definition="Purchase orders physically received where Oracle has not yet been posted. Stock the yard has and the system does not."
                        denominator="Purchase orders in your scope"
                        dateBasis="Purchase order created at"
                      />
                      <CmsKpiCard
                        label="Posting coverage"
                        value={formatRate(board.purchaseOrders.postingCoveragePercent)}
                        context="Of orders received"
                        tone={slaTone(board.purchaseOrders.postingCoveragePercent)}
                        href={toPurchases}
                        definition="Received purchase orders that have an Oracle posting timestamp."
                        denominator="Purchase orders physically received in this period"
                        dateBasis="Purchase order created at"
                      />
                    </Fragment>
                  )}
                </div>

                {entities.length > 0 && (
                  <CmsDataTable
                    caption="Affiliates"
                    columns={[
                      { key: 'affiliate', label: 'Affiliate' },
                      { key: 'so', label: 'Sales order SLA', numeric: true },
                      { key: 'po', label: 'Purchase order SLA', numeric: true },
                      { key: 'cases', label: 'Cases', numeric: true },
                      { key: 'exception', label: 'Key exception', secondary: true },
                    ]}
                    empty={false}
                  >
                    {entities.map((row) => (
                      <tr class="border-b border-cms-line last:border-0 hover:bg-cms-sunken">
                        <td class="px-4 py-2.5">
                          <a
                            href={drillTo('/app/orders/sales/performance', filter, {
                              affiliateId: row.affiliateId,
                            })}
                            class="rounded-cms font-medium text-cms-ink outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                          >
                            {row.affiliateName}
                          </a>
                        </td>
                        <td class="px-4 py-2.5 text-right">
                          <CmsStatusPill
                            value={formatRate(row.salesOrderSlaPercent)}
                            tone={slaTone(row.salesOrderSlaPercent)}
                            state={slaState(row.salesOrderSlaPercent)}
                          />
                        </td>
                        <td class="px-4 py-2.5 text-right">
                          <CmsStatusPill
                            value={formatRate(row.purchaseOrderSlaPercent)}
                            tone={slaTone(row.purchaseOrderSlaPercent)}
                            state={slaState(row.purchaseOrderSlaPercent)}
                          />
                        </td>
                        <td class="px-4 py-2.5 text-right text-cms-ink tabular-nums">
                          {count(row.cases)}
                        </td>
                        <td class="hidden px-4 py-2.5 text-cms-muted sm:table-cell">
                          {row.keyException}
                        </td>
                      </tr>
                    ))}
                  </CmsDataTable>
                )}
              </section>
            )}

            {/* ---- 4. Commercial ----------------------------------------- */}
            {composition?.commercial && board.commercial && (
              <section aria-labelledby="commercial" class="flex flex-col gap-3">
                <CmsSectionHeader id="commercial" title="Commercial" />
                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                  <CmsKpiCard
                    label="New leads"
                    value={count(board.commercial.newLeads)}
                    context="Captured in this period"
                    href={toCrm}
                    definition="Leads captured in this period."
                    denominator="Leads in your scope"
                    dateBasis="Lead captured at"
                  />
                  <CmsKpiCard
                    label="Lead conversion"
                    value={formatRate(board.commercial.conversionRatePercent)}
                    context="Of leads that qualified"
                    href={toCrm}
                    definition="Leads that reached Converted."
                    denominator="Leads that qualified"
                    dateBasis="Lead captured at"
                  />
                  <CmsKpiCard
                    label="Win rate"
                    value={formatRate(board.commercial.winRatePercent)}
                    context={`Of ${count(board.commercial.winRateDenominator)} decided`}
                    href={toCrm}
                    definition="Opportunities won, as a share of those decided. An open opportunity is not in the denominator: open is not lost."
                    denominator="Opportunities won plus opportunities lost"
                    dateBasis="Actual close date"
                  />
                  <CmsKpiCard
                    label="Open opportunities"
                    value={count(board.commercial.closingSoon)}
                    context="Still open at period end"
                    href={toCrm}
                    definition="Opportunities still open at the end of the period."
                    denominator="Opportunities in your scope"
                    dateBasis="Expected close date"
                  />
                </div>
                {board.commercial.openPipelineByCurrency.length > 0 && (
                  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                    {board.commercial.openPipelineByCurrency.map((row) => (
                      <CmsKpiCard
                        label={`Open pipeline (${row.currencyCode})`}
                        value={money(row.openValue, row.currencyCode)}
                        context={`Weighted ${money(row.weightedValue, row.currencyCode)}`}
                        href={drillTo('/app/crm/analytics', filter, { currency: row.currencyCode })}
                        definition="Value of opportunities still open, and the same value weighted by each stage probability. Never summed across currencies."
                        denominator="Open opportunities in your scope"
                        dateBasis="Expected close date"
                      />
                    ))}
                  </div>
                )}
              </section>
            )}

            {/* ---- 5. Service -------------------------------------------- */}
            {composition?.service && board.service && (
              <section aria-labelledby="service" class="flex flex-col gap-3">
                <CmsSectionHeader id="service" title="Service" />
                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
                  <div class="grid gap-3 sm:grid-cols-2">
                    <CmsKpiCard
                      label="Open cases"
                      value={count(board.service.openCases)}
                      context="Not resolved, closed or cancelled"
                      href={toService}
                      definition="Cases not Resolved, Closed or Cancelled."
                      denominator="Cases in your scope"
                      dateBasis="Case raised at"
                    />
                    <CmsKpiCard
                      label="First response"
                      value={formatRate(board.service.firstResponseWithinSlaPercent)}
                      context="Within SLA"
                      tone={slaTone(board.service.firstResponseWithinSlaPercent)}
                      href={toService}
                      definition="First-response SLA instances that were Met. An internal note is not a first response."
                      denominator="First-response SLA instances settled in this period"
                      dateBasis="SLA settled at"
                    />
                    <CmsKpiCard
                      label="Median resolution"
                      value={formatDuration(board.service.medianResolutionElapsedMinutes)}
                      context="Elapsed, not accountable"
                      href={toService}
                      definition="Median wall-clock time from a case being raised to it being resolved. Time waiting on the customer is still in it."
                      denominator="Cases resolved in this period"
                      dateBasis="Case resolved at"
                    />
                    <CmsKpiCard
                      label="Satisfaction"
                      value={
                        board.service.satisfactionScore === null
                          ? 'Not available'
                          : String(board.service.satisfactionScore)
                      }
                      context={`${count(board.service.satisfactionResponses)} responses`}
                      href={toService}
                      definition="Mean survey score, on the scale the survey itself defines."
                      denominator="Survey responses received in this period"
                      dateBasis="Response received at"
                    />
                  </div>
                  {customerChart && (
                    <CmsChart
                      title="Open cases by customer"
                      definition="Customers with the most cases still open, in your scope."
                      chart={customerChart}
                      unit="cases"
                    />
                  )}
                </div>
              </section>
            )}

            {/* ---- 6. Data freshness ------------------------------------- */}
            {composition?.freshness && board.freshness.length > 0 && (
              <section aria-labelledby="freshness" class="flex flex-col gap-3">
                <CmsSectionHeader id="freshness" title="Data freshness" />
                <CmsDataTable
                  caption="Data freshness"
                  columns={[
                    { key: 'source', label: 'Source' },
                    { key: 'state', label: 'State' },
                    { key: 'at', label: 'Last updated', numeric: true },
                  ]}
                  empty={false}
                >
                  {board.freshness.map((row) => (
                    <tr class="border-b border-cms-line last:border-0">
                      <td class="px-4 py-2 text-cms-ink">{row.source}</td>
                      <td class="px-4 py-2">
                        <CmsBadge
                          tone={row.live ? 'success' : 'info'}
                          label={row.live ? 'Live' : 'Imported'}
                        />
                      </td>
                      <td class="px-4 py-2 text-right text-cms-muted tabular-nums">
                        {row.lastImportedAt ?? 'Never'}
                      </td>
                    </tr>
                  ))}
                </CmsDataTable>
              </section>
            )}
          </Fragment>
        )}
      </Fragment>
    )
  }
</CmsLayout>
