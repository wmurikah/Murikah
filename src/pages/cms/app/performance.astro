---
/**
 * Placeholder destination for the performance section.
 *
 * It exists so the navigation is real: every entry in CMS_NAV leads somewhere,
 * and a rail full of dead links cannot be reviewed for structure. It builds no
 * module, reads no data and makes no promise about what the section will look
 * like.
 *
 * The title and the summary come from the navigation model rather than being
 * typed again here, so a change to the model updates the rail, the page title
 * and this copy together.
 */
import CmsSectionPlaceholder from '@/components/cms/CmsSectionPlaceholder.astro';
// Rendered on the server for every request, never prerendered. Without this the
// page is baked at build time, the middleware guard runs once during the build
// instead of per request, and the route protection becomes a static artefact:
// a signed-in user would be served whatever the build decided.
export const prerender = false;
---

<CmsSectionPlaceholder href="/app/performance" />
