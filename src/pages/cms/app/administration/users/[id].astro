---
/**
 * A user: who they are, where they sit, and what the record says about them.
 *
 * Nine tabs, driven by the URL rather than by client state, so a tab can be
 * bookmarked and survives a reload.
 *
 * EDIT IS CURRENT STATE; THE OTHER TABS ARE THE RECORD. The Edit tab now
 * carries a Position & Access panel — job title, access roles, what those
 * roles grant, workflow authority — because setting somebody up was four
 * screens and no screen showed the result. Assignments, Roles and Workflow
 * authority stay exactly where they were: they carry the effective dates, the
 * superseded rows and the history that a current-state panel would have to
 * hide to stay usable.
 *
 * WHAT IS EDITABLE IS DECIDED BY THREE SEPARATE PERMISSIONS —
 * ADMIN.USERS.MANAGE for the title, ADMIN.ROLES.MANAGE for access roles,
 * ADMIN.WORKFLOW_ROLES.MANAGE for authority — and by the server, every time.
 * Nothing here is a control: each endpoint checks its own code, and the
 * repository refuses a grant whose subject is the caller, so an administrator
 * cannot escalate themselves by editing their own record however the markup is
 * rewritten.
 *
 * The Security tab shows whether a credential exists and whether MFA is on. It
 * never shows a hash, a token or a secret, and the queries behind it select
 * booleans rather than values, so there is nothing to leak by accident.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsTabs from '@/components/cms/CmsTabs.astro';
import CmsUserEditForm from '@/components/cms/CmsUserEditForm.astro';
import CmsAuditTable from '@/components/cms/CmsAuditTable.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsAvatar from '@/components/cms/CmsAvatar.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsUserRoleDrawer from '@/components/cms/CmsUserRoleDrawer.astro';
import CmsUserAccessPanel from '@/components/cms/CmsUserAccessPanel.astro';
import CmsUserAuthorityDrawer from '@/components/cms/CmsUserAuthorityDrawer.astro';
import CmsApplyDefaultsDrawer from '@/components/cms/CmsApplyDefaultsDrawer.astro';

import { userActivity, type AuditRow as AuditTrailRow } from '@/lib/cms/repos/auditTrail';
import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { canManageRoles, canManageUsers, canManageWorkflowRoles } from '@/lib/cms/permissions';
import { rolePermissionMap, type RolePermissionMap } from '@/lib/cms/repos/rbacAdmin';
import { mappingsForTitle, type MappingRow } from '@/lib/cms/repos/jobTitleMappings';
import {
  listAffiliates,
  listBusinessUnits,
  listCountries,
  listTeams,
} from '@/lib/cms/repos/organisationAdmin';
import {
  getSecurity,
  getUser,
  listAssignments,
  listSourceIdentities,
  listUserRoles,
  listJobTitles,
  listUserTeams,
  listWorkflowAuthority,
  type AssignmentRow,
  type JobTitleRow,
  type RoleView,
  type SecurityView,
  type SourceIdentityRow,
  type TeamMembershipView,
  type UserRow,
  type WorkflowAuthorityView,
} from '@/lib/cms/repos/userAdmin';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayManage = canManageUsers(permissions);
// Build Prompt 06 made this tab read-only. Build Prompt 07 makes it writable,
// for a viewer who holds the role permission and not merely the user one. Those
// are different capabilities and conflating them would let a user administrator
// grant access, which is the escalation the read-only tab was protecting
// against.
const mayManageRoles = canManageRoles(permissions);
// Approval authority is its own capability. A person who may grant access
// roles does not thereby become able to make somebody an approver, and the
// endpoints behind both controls check their own code rather than this.
const mayManageAuthority = canManageWorkflowRoles(permissions);
const userId = Astro.params.id ?? '';
// The reader, not the subject. The audit scope belongs to whoever is looking.
const viewerUserId = Astro.locals.cms?.user.userId ?? '';

const TABS = [
  'overview',
  'edit',
  'assignments',
  'teams',
  'roles',
  'authority',
  'identities',
  'security',
  'audit',
] as const;
type Tab = (typeof TABS)[number];
const requested = Astro.url.searchParams.get('tab');
const tab: Tab = (TABS as readonly string[]).includes(requested ?? '')
  ? (requested as Tab)
  : 'overview';

let user: UserRow | null = null;
let assignments: AssignmentRow[] = [];
let teams: TeamMembershipView[] = [];
let roles: RoleView[] = [];
let authority: WorkflowAuthorityView[] = [];
let identities: SourceIdentityRow[] = [];
let security: SecurityView | null = null;
// The Edit tab's Position & Access panel: the title catalogue, what every
// active role grants (so the preview needs no round trip), and what the
// person's current title suggests. All read once, with everything else.
let jobTitles: JobTitleRow[] = [];
let permissionMap: RolePermissionMap = { granted: {}, permissions: [] };
let suggested: { access: MappingRow[]; workflow: MappingRow[] } = { access: [], workflow: [] };
let scopeTargets = {
  countries: [] as { value: string; label: string }[],
  affiliates: [] as { value: string; label: string }[],
  units: [] as { value: string; label: string }[],
  teams: [] as { value: string; label: string }[],
};
// The Audit tab is what this person CHANGED, read through the audit
// repository so it carries the same scope, the same security gate and the
// same masking as the workspace. The previous query here selected events
// ABOUT the user, applied no scope and rendered before_json raw, which the
// phase 26 masking control exists to prevent.
let audit: AuditTrailRow[] = [];
let loadFailed = false;

if (mayManage) {
  try {
    const db = await getDb(getCmsEnv());
    user = await getUser(db, userId);
    if (user) {
      [
        assignments,
        teams,
        roles,
        authority,
        identities,
        security,
        audit,
        jobTitles,
        permissionMap,
      ] = await Promise.all([
        listAssignments(db, userId),
        listUserTeams(db, userId),
        listUserRoles(db, userId),
        listWorkflowAuthority(db, userId),
        listSourceIdentities(db, userId),
        getSecurity(db, userId),
        userActivity(db, viewerUserId, userId),
        listJobTitles(db),
        rolePermissionMap(db),
      ]);
      // Second round, because the title's defaults depend on which title the
      // first round found. The scope lookups ride along with it rather than
      // taking a third.
      const currentTitle =
        assignments.find((a) => a.current && a.isPrimary)?.jobTitleId ??
        assignments.find((a) => a.current)?.jobTitleId ??
        '';
      const [titleDefaults, countries, affiliates, units, teamRows] = await Promise.all([
        mappingsForTitle(db, currentTitle),
        listCountries(db),
        listAffiliates(db),
        listBusinessUnits(db),
        listTeams(db),
      ]);
      suggested = titleDefaults;
      scopeTargets = {
        countries: countries
          .filter((c) => c.active)
          .map((c) => ({ value: c.countryId, label: c.countryName })),
        // `affiliate_name` is not unique in this schema; the code disambiguates.
        affiliates: affiliates
          .filter((a) => a.active)
          .map((a) => ({ value: a.affiliateId, label: `${a.affiliateName} (${a.affiliateCode})` })),
        units: units
          .filter((b) => b.active)
          .map((b) => ({ value: b.businessUnitId, label: b.businessUnitName })),
        teams: teamRows
          .filter((t) => t.active)
          .map((t) => ({ value: t.teamId, label: t.teamName })),
      };
    }
  } catch (error) {
    console.error('[cms.users.detail] load failed', error);
    loadFailed = true;
  }
}

const base = `/app/administration/users/${userId}`;
const href = (t: Tab) => `${base}?tab=${t}`;
const label = (value: string) => value.charAt(0) + value.slice(1).toLowerCase().replace(/_/g, ' ');
const statusTone = (status: string) =>
  status === 'ACTIVE'
    ? 'success'
    : status === 'SUSPENDED'
      ? 'danger'
      : status === 'INVITED'
        ? 'info'
        : 'neutral';

const tabs = [
  { label: 'Overview', href: href('overview') },
  { label: 'Edit', href: href('edit') },
  { label: 'Assignments', href: href('assignments'), count: assignments.length },
  { label: 'Teams', href: href('teams'), count: teams.length },
  { label: 'Roles', href: href('roles'), count: roles.length },
  { label: 'Workflow authority', href: href('authority'), count: authority.length },
  { label: 'Source identities', href: href('identities'), count: identities.length },
  { label: 'Security', href: href('security') },
  { label: 'Audit', href: href('audit'), count: audit.length },
];

/**
 * The organisational line, rendered naturally.
 *
 * A GROUP assignment is the group, said in words. An external user with no
 * assignment gets no organisational line at all rather than an empty one: the
 * absence is the fact, and a dangling separator would misreport it as a
 * rendering fault.
 */
const primary =
  assignments.find((a) => a.current && a.isPrimary) ?? assignments.find((a) => a.current);
const entity =
  primary === undefined
    ? null
    : primary.level === 'GROUP'
      ? 'Hass Petroleum Group'
      : (primary.businessUnitName ?? primary.affiliateName ?? primary.countryName ?? null);
const organisationLine =
  primary === undefined
    ? null
    : [primary.jobTitle, entity].filter((part): part is string => Boolean(part)).join(', ');
const portalLine = user?.userType === 'EXTERNAL' ? 'Customer portal account' : null;
---

<CmsLayout title={user?.displayName ?? 'User'}>
  {
    !mayManage ? (
      <CmsErrorState
        title="You do not have access to user administration"
        description="Contact your administrator if you think this is a mistake."
      />
    ) : loadFailed ? (
      <CmsErrorState
        title="This user could not be loaded"
        description="Please try again in a moment."
      />
    ) : !user ? (
      <CmsErrorState
        title="That user could not be found"
        description="They may have been renamed, or the link may be out of date. Nobody is ever deleted, so the record still exists somewhere."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          auditEntityType="USER"
          auditEntityId={userId}
          title={user.displayName}
          crumbs={[
            { label: 'Administration', href: '/app/administration' },
            { label: 'Users', href: '/app/administration/users' },
            { label: user.displayName },
          ]}
        >
          <CmsBadge slot="actions" tone={statusTone(user.status)} label={label(user.status)} />
        </CmsPageHeader>

        <CmsCard>
          <div class="flex items-start gap-4">
            <CmsAvatar name={user.displayName} size="md" />
            <div class="flex min-w-0 flex-col gap-0.5">
              <p class="text-cms-card font-semibold text-cms-navy">{user.displayName}</p>
              <p class="truncate text-cms-body-sm text-cms-muted">{user.email}</p>
              {organisationLine && (
                <p class="text-cms-body-sm text-cms-muted">{organisationLine}</p>
              )}
              {portalLine && <p class="text-cms-body-sm text-cms-muted">{portalLine}</p>}
            </div>
          </div>
        </CmsCard>

        <CmsTabs tabs={tabs} current={href(tab)} label="User sections" />

        {tab === 'edit' && user !== null && (
          <Fragment>
            {/*
              NO PAGE DESCRIPTION. The tab is called Edit and the fields name
              themselves. What DOES belong on the screen is the consequence of
              changing an address, and that appears next to the address rather
              than in a paragraph at the top nobody reads.
            */}
            <CmsCard>
              <CmsUserEditForm user={user} />
            </CmsCard>
            <CmsCard>
              <CmsUserAccessPanel
                userId={userId}
                userType={user.userType}
                assignments={assignments}
                jobTitles={jobTitles}
                roles={roles}
                authority={authority}
                permissionMap={permissionMap}
                suggested={suggested}
                mayManageUsers={mayManage}
                mayManageRoles={mayManageRoles}
                mayManageAuthority={mayManageAuthority}
                isSelf={userId === viewerUserId}
              />
            </CmsCard>
            {/*
              THE DRAWERS ARE RENDERED ONLY FOR A VIEWER WHO MAY USE THEM, and
              that is presentation rather than protection: each endpoint behind
              them checks its own permission code, and the self-grant refusal
              lives in the repository. Not rendering them simply means a screen
              that does not offer what it cannot do.
            */}
            {mayManageRoles && userId !== viewerUserId && <CmsUserRoleDrawer userId={userId} />}
            {mayManageAuthority && userId !== viewerUserId && (
              <CmsUserAuthorityDrawer userId={userId} />
            )}
            {(mayManageRoles || mayManageAuthority) &&
              (suggested.access.length > 0 || suggested.workflow.length > 0) && (
                <CmsApplyDefaultsDrawer
                  userId={userId}
                  suggested={suggested}
                  primary={
                    assignments.find((a) => a.current && a.isPrimary) ??
                    assignments.find((a) => a.current)
                  }
                  heldRoleIds={roles.filter((r) => r.active).map((r) => r.roleId)}
                  countries={scopeTargets.countries}
                  affiliates={scopeTargets.affiliates}
                  units={scopeTargets.units}
                  teams={scopeTargets.teams}
                  mayManageRoles={mayManageRoles}
                  mayManageAuthority={mayManageAuthority}
                />
              )}
          </Fragment>
        )}

        {tab === 'overview' && (
          <CmsCard>
            <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {(
                [
                  ['Employee number', user.employeeNo ?? 'Not recorded'],
                  ['Phone', user.phone ?? 'Not recorded'],
                  ['User type', label(user.userType)],
                  ['Time zone', user.timezone],
                  ['Locale', user.locale],
                  ['Email verified', user.emailVerifiedAt ?? 'Not verified'],
                  ['Last login', user.lastLoginAt ?? 'Never'],
                  ['Created', user.createdAt],
                  ['Updated', user.updatedAt],
                ] as [string, string][]
              ).map(([term, value]) => (
                <div class="flex flex-col gap-0.5">
                  <dt class="text-cms-caption text-cms-muted">{term}</dt>
                  <dd class="text-cms-body-sm text-cms-ink">{value}</dd>
                </div>
              ))}
            </dl>
          </CmsCard>
        )}

        {tab === 'assignments' && (
          <CmsDataTable
            caption="Assignments"
            columns={[
              { key: 'title', label: 'Job title' },
              { key: 'department', label: 'Department' },
              { key: 'level', label: 'Level' },
              { key: 'where', label: 'Where' },
              { key: 'from', label: 'From' },
              { key: 'to', label: 'To' },
              { key: 'primary', label: 'Primary' },
              { key: 'status', label: 'Status' },
            ]}
            empty={assignments.length === 0}
          >
            {assignments.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="px-4 py-2.5 font-medium text-cms-ink">{row.jobTitle}</td>
                <td class="px-4 py-2.5 text-cms-muted">{row.department}</td>
                <td class="px-4 py-2.5 text-cms-muted">{label(row.level)}</td>
                <td class="px-4 py-2.5 text-cms-muted">
                  {row.level === 'GROUP'
                    ? 'Hass Petroleum Group'
                    : (row.businessUnitName ?? row.affiliateName ?? row.countryName ?? '—')}
                </td>
                <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveFrom}</td>
                <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveTo ?? 'Open'}</td>
                <td class="px-4 py-2.5">
                  {row.isPrimary && <CmsBadge tone="info" label="Primary" />}
                </td>
                <td class="px-4 py-2.5">
                  <CmsBadge
                    tone={row.current ? 'success' : 'neutral'}
                    label={row.current ? 'Current' : row.active ? 'Not yet current' : 'Ended'}
                  />
                </td>
              </tr>
            ))}
            <Fragment slot="empty">
              <CmsEmptyState
                icon="customers"
                title="No assignment"
                description="An external portal user holds no organisational assignment, which is why this is empty rather than broken."
              />
            </Fragment>
          </CmsDataTable>
        )}

        {tab === 'teams' && (
          <CmsDataTable
            caption="Teams"
            columns={[
              { key: 'team', label: 'Team' },
              { key: 'role', label: 'Role on the team' },
              { key: 'from', label: 'From' },
              { key: 'to', label: 'To' },
              { key: 'status', label: 'Status' },
            ]}
            empty={teams.length === 0}
          >
            {teams.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="px-4 py-2.5 font-medium text-cms-ink">{row.teamName}</td>
                <td class="px-4 py-2.5 text-cms-muted">{row.memberRole ?? 'Member'}</td>
                <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveFrom}</td>
                <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveTo ?? 'Open'}</td>
                <td class="px-4 py-2.5">
                  <CmsBadge
                    tone={row.active ? 'success' : 'neutral'}
                    label={row.active ? 'Current' : 'Former'}
                  />
                </td>
              </tr>
            ))}
            <Fragment slot="empty">
              <CmsEmptyState
                icon="customers"
                title="Not on any team"
                description="Team membership is managed under Administration → Organisation."
              />
            </Fragment>
          </CmsDataTable>
        )}

        {tab === 'roles' && (
          <Fragment>
            {mayManageRoles && userId !== viewerUserId ? (
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-cms-body-sm text-cms-muted">
                  An access role says what this person may do. A data scope says which records it
                  reaches. A scope is never inferred from a job title, a department or a team.
                </p>
                <CmsButton variant="primary" icon="plus" data-cms-userrole-create>
                  Assign a role
                </CmsButton>
              </div>
            ) : mayManageRoles ? (
              <p class="rounded-cms border border-cms-line bg-cms-canvas px-3 py-2 text-cms-body-sm text-cms-muted">
                <strong class="font-semibold text-cms-ink">Your own record.</strong> Nobody grants
                themselves access; the server refuses it whatever the screen offers. Ask another
                administrator.
              </p>
            ) : (
              <p class="rounded-cms border border-cms-line bg-cms-canvas px-3 py-2 text-cms-body-sm text-cms-muted">
                Read-only for you.
              </p>
            )}
            <CmsDataTable
              caption="Access roles"
              columns={[
                { key: 'role', label: 'Role' },
                { key: 'scopes', label: 'Scopes' },
                { key: 'from', label: 'From' },
                { key: 'to', label: 'To' },
                { key: 'status', label: 'Status' },
              ]}
              empty={roles.length === 0}
            >
              {roles.map((row) => (
                <tr class="border-b border-cms-line last:border-0">
                  <td class="px-4 py-2.5 font-medium text-cms-ink">
                    {row.roleName}
                    {row.isSystemRole && (
                      <CmsBadge tone="warning" label="System role" class="ms-2" />
                    )}
                  </td>
                  <td class="px-4 py-2.5 text-cms-muted">
                    {row.scopes.length === 0
                      ? 'None'
                      : row.scopes
                          .map((s) =>
                            s.target ? `${label(s.scopeType)}: ${s.target}` : label(s.scopeType),
                          )
                          .join('; ')}
                  </td>
                  <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveFrom}</td>
                  <td class="px-4 py-2.5 text-cms-muted tabular-nums">
                    {row.effectiveTo ?? 'Open'}
                  </td>
                  <td class="px-4 py-2.5">
                    <CmsBadge
                      tone={row.active ? 'success' : 'neutral'}
                      label={row.active ? 'Active' : 'Inactive'}
                    />
                  </td>
                </tr>
              ))}
              <Fragment slot="empty">
                <CmsEmptyState
                  icon="administration"
                  title="No access role"
                  description="This person holds no access role yet."
                />
              </Fragment>
            </CmsDataTable>
            {mayManageRoles && userId !== viewerUserId && <CmsUserRoleDrawer userId={userId} />}
          </Fragment>
        )}

        {tab === 'authority' && (
          <Fragment>
            {mayManageAuthority && userId !== viewerUserId ? (
              <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-cms-body-sm text-cms-muted">
                  What this person may approve in a business process. A different thing from an
                  access role and from a job title, and never inferred from either.
                </p>
                <CmsButton variant="primary" icon="plus" data-cms-authority-create>
                  Add authority
                </CmsButton>
              </div>
            ) : (
              <p class="rounded-cms border border-cms-line bg-cms-canvas px-3 py-2 text-cms-body-sm text-cms-muted">
                <strong class="font-semibold text-cms-ink">Read-only for you.</strong> Workflow
                authority is what a person may approve in a business process, which is a different
                thing from an access role and from a job title.
              </p>
            )}
            <CmsDataTable
              caption="Workflow authority"
              columns={[
                { key: 'role', label: 'Workflow role' },
                { key: 'scope', label: 'Scope' },
                { key: 'priority', label: 'Priority', numeric: true },
                { key: 'from', label: 'From' },
                { key: 'to', label: 'To' },
                { key: 'status', label: 'Status' },
              ]}
              empty={authority.length === 0}
            >
              {authority.map((row) => (
                <tr class="border-b border-cms-line last:border-0">
                  <td class="px-4 py-2.5 font-medium text-cms-ink">{row.roleName}</td>
                  <td class="px-4 py-2.5 text-cms-muted">
                    {row.scopeType === 'GROUP'
                      ? 'Hass Petroleum Group'
                      : (row.target ?? label(row.scopeType))}
                  </td>
                  <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">{row.priority}</td>
                  <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.effectiveFrom}</td>
                  <td class="px-4 py-2.5 text-cms-muted tabular-nums">
                    {row.effectiveTo ?? 'Open'}
                  </td>
                  <td class="px-4 py-2.5">
                    <CmsBadge
                      tone={row.active ? 'success' : 'neutral'}
                      label={row.active ? 'Active' : 'Inactive'}
                    />
                  </td>
                </tr>
              ))}
              <Fragment slot="empty">
                <CmsEmptyState
                  icon="performance"
                  title="No workflow authority"
                  description="This person approves nothing in any configured workflow."
                />
              </Fragment>
            </CmsDataTable>
            {mayManageAuthority && userId !== viewerUserId && (
              <CmsUserAuthorityDrawer userId={userId} />
            )}
          </Fragment>
        )}

        {tab === 'identities' && (
          <CmsDataTable
            caption="Source identities"
            columns={[
              { key: 'system', label: 'Source system' },
              { key: 'username', label: 'External username' },
              { key: 'affiliate', label: 'Affiliate' },
              { key: 'status', label: 'Status' },
            ]}
            empty={identities.length === 0}
          >
            {identities.map((row) => (
              <tr class="border-b border-cms-line last:border-0">
                <td class="px-4 py-2.5 font-medium text-cms-ink">{row.sourceSystem}</td>
                <td class="px-4 py-2.5 font-mono text-cms-body-sm text-cms-muted">
                  {row.externalUsername}
                </td>
                <td class="px-4 py-2.5 text-cms-muted">{row.affiliateName ?? 'Any'}</td>
                <td class="px-4 py-2.5">
                  <CmsBadge
                    tone={row.active ? 'success' : 'neutral'}
                    label={row.active ? 'Active' : 'Inactive'}
                  />
                </td>
              </tr>
            ))}
            <Fragment slot="empty">
              <CmsEmptyState
                icon="data"
                title="No external accounts mapped"
                description="A mapping links an account in another system, such as Oracle, to this person. It never creates a user."
              />
            </Fragment>
          </CmsDataTable>
        )}

        {tab === 'security' && security && (
          <Fragment>
            <CmsCard>
              <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {(
                  [
                    ['Status', label(security.status)],
                    ['Email verified', security.emailVerifiedAt ?? 'Not verified'],
                    ['Last login', security.lastLoginAt ?? 'Never'],
                    ['Password set', security.hasCredential ? 'Yes' : 'No'],
                    ['Two-factor', security.mfaEnabled ? 'Enabled' : 'Not enabled'],
                  ] as [string, string][]
                ).map(([term, value]) => (
                  <div class="flex flex-col gap-0.5">
                    <dt class="text-cms-caption text-cms-muted">{term}</dt>
                    <dd class="text-cms-body-sm text-cms-ink">{value}</dd>
                  </div>
                ))}
              </dl>
              {/*
                Whether a credential exists, never what it is. The queries behind
                this select COUNT(*) rather than the hash, so there is nothing
                here to leak.
              */}
              <p class="mt-4 text-cms-caption text-cms-muted">
                Passwords, tokens and two-factor secrets are never shown, and are not read by this
                page.
              </p>
            </CmsCard>

            <CmsDataTable
              caption="Recent sign-in attempts"
              columns={[
                { key: 'at', label: 'When' },
                { key: 'result', label: 'Result' },
                { key: 'reason', label: 'Reason' },
                { key: 'ip', label: 'Address', secondary: true },
              ]}
              empty={security.recentAttempts.length === 0}
            >
              {security.recentAttempts.map((row) => (
                <tr class="border-b border-cms-line last:border-0">
                  <td class="px-4 py-2.5 text-cms-muted tabular-nums">{row.at}</td>
                  <td class="px-4 py-2.5">
                    <CmsBadge
                      tone={row.success ? 'success' : 'danger'}
                      label={row.success ? 'Signed in' : 'Refused'}
                    />
                  </td>
                  <td class="px-4 py-2.5 text-cms-muted">{row.reason ?? '—'}</td>
                  <td class="hidden px-4 py-2.5 font-mono text-cms-caption text-cms-muted sm:table-cell">
                    {row.ip ?? '—'}
                  </td>
                </tr>
              ))}
              <Fragment slot="empty">
                <CmsEmptyState
                  icon="clock"
                  title="No recorded attempts"
                  description="Nobody has tried to sign in as this person."
                />
              </Fragment>
            </CmsDataTable>
          </Fragment>
        )}

        {tab === 'audit' && (
          <div class="flex flex-col gap-3">
            <p class="max-w-prose text-cms-body-sm text-cms-muted">
              What this person changed.{' '}
              <span class="font-semibold text-cms-ink">Not their sign-in history</span>:
              authentication events belong in the security view, behind its own permission, because
              a list of somebody's sign-in times on their profile page is surveillance wearing an
              audit badge and is the wrong place to investigate a compromise anyway.
            </p>
            <CmsAuditTable
              rows={audit}
              emptyTitle="This person has changed nothing you can see"
              emptyDescription="An empty list here is bounded by your own audit scope, not a claim that they have never changed anything."
            />
          </div>
        )}
      </Fragment>
    )
  }
</CmsLayout>
