---
/** Administration → AI. */
import { env } from 'cloudflare:workers';
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import CmsCheckbox from '@/components/cms/CmsCheckbox.astro';
import CmsModal from '@/components/cms/CmsModal.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import { requestDb } from '@/lib/cms/db';
import { canManageAi } from '@/lib/cms/ai/access';
import { listProviders, PURPOSES, type AiProvider } from '@/lib/cms/ai/providers';
import {
  APPROVED_AI_PROVIDER_TYPES,
  approvedProviderSecretPresent,
} from '@/lib/cms/ai/security';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayManage = canManageAi(permissions);

let providers: AiProvider[] = [];
let loadFailed = false;
if (mayManage) {
  try {
    providers = await listProviders(await requestDb(Astro.locals));
  } catch (error) {
    console.error('[cms.admin.ai] load failed', error);
    loadFailed = true;
  }
}

const environment = env as unknown as Record<string, unknown>;
const present = new Map(
  providers.map((p) => [p.aiProviderId, approvedProviderSecretPresent(p, environment)]),
);

const VERIFY_TONE: Readonly<Record<string, 'success' | 'danger' | 'warning' | 'neutral'>> = {
  OK: 'success',
  UNAUTHORISED: 'danger',
  UNREACHABLE: 'warning',
  ERROR: 'danger',
};
const VERIFY_WORD: Readonly<Record<string, string>> = {
  OK: 'Answered',
  UNAUTHORISED: 'Key refused',
  UNREACHABLE: 'Could not be reached',
  ERROR: 'Failed',
};
---

<CmsLayout title="AI">
  <CmsPageHeader
    title="AI"
    crumbs={[
      { label: 'Home', href: '/app' },
      { label: 'Administration', href: '/app/administration' },
      { label: 'AI' },
    ]}
    definition={'Configure approved AI services. Credential names and provider endpoints are fixed by the application and cannot be entered or changed from this screen.'}
  >
    {
      mayManage && (
        <CmsButton slot="actions" variant="primary" data-cms-modal-open="cms-ai-new">
          Add a provider
        </CmsButton>
      )
    }
  </CmsPageHeader>

  {
    !mayManage && (
      <CmsEmptyState
        title="You do not have permission to configure AI"
        description="Ask an administrator for access."
      />
    )
  }
  {
    loadFailed && (
      <CmsErrorState
        title="The providers could not be loaded"
        description="Please try again in a moment."
      />
    )
  }

  {
    mayManage && !loadFailed && providers.length === 0 && (
      <CmsEmptyState
        title="No provider is configured"
        description="Add one to switch the assistant and the message classifier on."
      />
    )
  }

  {
    mayManage && providers.length > 0 && (
      <CmsCard title="Providers">
        <ul class="flex flex-col gap-2">
          {providers.map((p) => (
            <li class="rounded-cms border border-cms-line px-3 py-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-cms-body-sm font-semibold text-cms-ink">{p.providerName}</span>
                <span class="flex items-center gap-2">
                  <CmsBadge
                    tone={p.active ? 'success' : 'neutral'}
                    label={p.active ? 'Active' : 'Off'}
                  />
                  <CmsBadge
                    tone={present.get(p.aiProviderId) === true ? 'success' : 'danger'}
                    label={
                      present.get(p.aiProviderId) === true ? 'Secret present' : 'Secret missing'
                    }
                  />
                  {p.lastVerifyStatus !== null && (
                    <CmsBadge
                      tone={VERIFY_TONE[p.lastVerifyStatus] ?? 'neutral'}
                      label={VERIFY_WORD[p.lastVerifyStatus] ?? p.lastVerifyStatus}
                    />
                  )}
                </span>
              </div>
              <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-cms-caption text-cms-muted sm:grid-cols-4">
                <div>
                  <dt class="inline">Type</dt> <dd class="inline text-cms-ink">{p.providerType}</dd>
                </div>
                <div>
                  <dt class="inline">Model</dt> <dd class="inline text-cms-ink">{p.model}</dd>
                </div>
                <div>
                  <dt class="inline">For</dt> <dd class="inline text-cms-ink">{p.purpose}</dd>
                </div>
                <div>
                  <dt class="inline">Secret</dt>{' '}
                  <dd class="inline font-mono text-cms-ink">{p.secretName}</dd>
                </div>
                {p.lastVerifiedAt !== null && (
                  <div class="col-span-2">
                    <dt class="inline">Checked</dt>{' '}
                    <dd class="inline text-cms-ink">{p.lastVerifiedAt}</dd>
                  </div>
                )}
              </dl>
              <div class="mt-2">
                <CmsButton variant="ghost" data-cms-ai-verify={p.aiProviderId}>
                  Test the connection
                </CmsButton>
              </div>
            </li>
          ))}
        </ul>
      </CmsCard>
    )
  }

  <p
    id="cms-ai-message"
    role="status"
    aria-live="polite"
    class="mt-4 text-cms-body-sm text-cms-muted"
  >
  </p>

  {
    mayManage && (
      <CmsModal id="cms-ai-new" title="Add a provider" confirmOnDirty>
        <form id="cms-ai-form" class="flex flex-col gap-4">
          <CmsInput id="ai-name" name="providerName" label="Name for this provider" required />
          <CmsSelect
            id="ai-type"
            name="providerType"
            label="Which service it calls"
            required
            options={APPROVED_AI_PROVIDER_TYPES.map((t) => ({ value: t, label: t }))}
          />
          <CmsInput id="ai-model" name="model" label="Model" required />
          <CmsSelect
            id="ai-purpose"
            name="purpose"
            label="What it is used for"
            required
            options={PURPOSES.map((p) => ({ value: p, label: p }))}
          />
          <CmsInput
            id="ai-max"
            name="maxOutputTokens"
            label="Longest reply, in tokens"
            type="number"
          />
          <CmsInput id="ai-temp" name="temperature" label="Temperature" type="number" step="0.1" />
          <CmsCheckbox id="ai-active" name="active" label="Available for use" />
        </form>
        <Fragment slot="actions">
          <CmsButton type="submit" variant="primary" form="cms-ai-form">
            Add provider
          </CmsButton>
          <CmsButton type="button" variant="ghost" data-cms-modal-close>
            Cancel
          </CmsButton>
        </Fragment>
      </CmsModal>
    )
  }
</CmsLayout>

<script>
  import { busy } from '@/lib/cms/ui/busy';
  const message = document.querySelector<HTMLElement>('#cms-ai-message');
  const say = (text: string) => {
    if (message) message.textContent = text;
  };

  document
    .querySelector<HTMLFormElement>('#cms-ai-form')
    ?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const restore = busy(form.querySelector<HTMLButtonElement>('[type="submit"]'), 'Saving…');
      const data = new FormData(form);
      const payload: Record<string, unknown> = {};
      for (const [key, value] of data.entries()) payload[key] = value;
      payload.active = data.get('active') !== null;
      try {
        const response = await fetch('/api/admin/ai', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = (await response.json().catch(() => null)) as Record<string, unknown> | null;
        if (!response.ok) {
          const errors = (body?.errors ?? []) as { message: string }[];
          say(errors.map((e) => e.message).join(' ') || 'The provider could not be saved.');
          return;
        }
        location.reload();
      } finally {
        restore();
      }
    });

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cms-ai-verify]')) {
    button.addEventListener('click', async () => {
      const id = button.dataset.cmsAiVerify ?? '';
      const restore = busy(button, 'Testing…');
      say('Testing.');
      const response = await fetch(`/api/admin/ai/${encodeURIComponent(id)}/verify`, {
        method: 'POST',
      }).finally(restore);
      const body = (await response.json().catch(() => null)) as Record<string, unknown> | null;
      const status = String(body?.status ?? 'ERROR');
      if (body?.secretPresent === false) {
        say('The approved provider credential is not available on this deployment.');
        return;
      }
      say(
        status === 'OK'
          ? 'The provider answered.'
          : status === 'UNAUTHORISED'
            ? 'The key was refused. Rotate it and test again.'
            : status === 'UNREACHABLE'
              ? 'The provider could not be reached. Try again shortly.'
              : 'The call failed.',
      );
    });
  }
</script>
