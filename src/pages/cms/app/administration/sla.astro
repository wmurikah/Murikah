---
/**
 * Administration → SLA Configuration.
 *
 * Calendars with their holidays, profiles with their precedence, rules with
 * their targets. Durations are typed as words ("30 minutes", "2 hours", "1
 * business day"); the server converts against the rule's own calendar and
 * the stored minutes are always shown beside the rule, so nobody has to do
 * arithmetic to check what the system will actually enforce.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsAuditHistoryLink from '@/components/cms/CmsAuditHistoryLink.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsDrawer from '@/components/cms/CmsDrawer.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import CmsCheckbox from '@/components/cms/CmsCheckbox.astro';

import { requestDb } from '@/lib/cms/db';
import { canManageSlaRules } from '@/lib/cms/permissions';
import {
  listCalendars,
  listProfiles,
  listRules,
  type CalendarRow,
  type ProfileRow,
  type RuleRow,
} from '@/lib/cms/repos/slaAdmin';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayManage = canManageSlaRules(permissions);

let calendars: CalendarRow[] = [];
let profiles: ProfileRow[] = [];
let rules: RuleRow[] = [];
let loadFailed = false;
if (mayManage) {
  try {
    const db = await requestDb(Astro.locals);
    [calendars, profiles, rules] = await Promise.all([
      listCalendars(db),
      listProfiles(db),
      listRules(db),
    ]);
  } catch (error) {
    console.error('[cms.admin.sla] load failed', error);
    loadFailed = true;
  }
}
const titleCase = (value: string) =>
  value.charAt(0) + value.slice(1).toLowerCase().replace(/_/g, ' ');
const DAY_NAMES = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<CmsLayout title="SLA Configuration">
  {
    !mayManage ? (
      <CmsErrorState
        title="You do not have access to SLA configuration"
        description="Contact your administrator if you think this is a mistake."
      />
    ) : loadFailed ? (
      <CmsErrorState
        title="Configuration could not be loaded"
        description="Please try again in a moment."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          title="SLA Configuration"
          definition="Precedence runs customer-specific, then segment, then affiliate, then the general default, resolved in one place. The higher configured precedence wins."
          crumbs={[
            { label: 'Home', href: '/app' },
            { label: 'Administration', href: '/app/administration' },
            { label: 'SLA' },
          ]}
        >
          <Fragment slot="actions">
            <CmsButton variant="secondary" href="/app/performance">
              Monitor
            </CmsButton>
            <CmsButton variant="primary" icon="plus" data-cms-rule-new>
              New rule
            </CmsButton>
          </Fragment>
        </CmsPageHeader>

        <CmsCard title="Business calendars">
          <div class="grid gap-3 lg:grid-cols-2">
            {calendars.map((cal) => (
              <section class="rounded-cms border border-cms-line p-3">
                <h3 class="flex items-center justify-between text-cms-body-sm font-semibold text-cms-ink">
                  {cal.calendarName}
                  <span class="text-cms-caption font-normal text-cms-muted">{cal.timezone}</span>
                </h3>
                <p class="mt-1 text-cms-caption text-cms-muted">
                  {cal.workdayStart} to {cal.workdayEnd} ·{' '}
                  {cal.days
                    .map((on, i) => (on ? DAY_NAMES[i] : null))
                    .filter(Boolean)
                    .join(' ')}
                </p>
                <p class="mt-2 text-cms-caption text-cms-muted">
                  {cal.holidays.length === 0
                    ? 'No holidays recorded.'
                    : cal.holidays.map((h) => `${h.holidayDate} ${h.holidayName}`).join(' · ')}
                </p>
                <div class="mt-2">
                  <CmsButton variant="ghost" data-cms-holiday-add={cal.businessCalendarId}>
                    Add holiday
                  </CmsButton>
                </div>
              </section>
            ))}
          </div>
        </CmsCard>

        <CmsCard title="Profiles">
          <ul class="flex flex-col gap-2">
            {profiles.map((p) => (
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-cms border border-cms-line px-3 py-2">
                <div class="flex items-center gap-2">
                  <span class="text-cms-body-sm font-medium text-cms-ink">{p.profileName}</span>
                  <CmsBadge
                    tone={p.slaType === 'EXTERNAL' ? 'info' : 'neutral'}
                    label={titleCase(p.slaType)}
                  />
                  {!p.active && <CmsBadge tone="neutral" label="Inactive" />}
                </div>
                <span class="text-cms-caption text-cms-muted tabular-nums">
                  precedence {p.precedenceLevel} ·{' '}
                  {p.accountName ??
                    p.segment ??
                    (p.affiliateId !== null ? 'affiliate' : 'general default')}{' '}
                  · {p.ruleCount} rule{p.ruleCount === 1 ? '' : 's'}
                </span>
              </li>
            ))}
          </ul>
        </CmsCard>

        <CmsCard title="Rules">
          <ul class="flex flex-col gap-2">
            {rules.map((r) => (
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-cms border border-cms-line px-3 py-2">
                <div>
                  <p class="text-cms-body-sm font-medium text-cms-ink">{r.ruleName}</p>
                  <p class="text-cms-caption text-cms-muted">
                    {titleCase(r.entityType)}
                    {r.stageCode !== null && ` · ${titleCase(r.stageCode)}`}
                    {r.priority !== null && ` · ${titleCase(r.priority)} priority`} ·{' '}
                    {r.profileName}
                  </p>
                </div>
                <span class="flex flex-wrap items-center gap-3">
                  <span class="text-cms-caption text-cms-muted tabular-nums">
                    target {r.targetMinutes} min
                    {r.warningMinutes !== null && ` · warn at ${r.warningMinutes} min left`} ·{' '}
                    {r.calendarName}
                    {r.businessHoursOnly ? ' · business hours' : ' · wall clock'}
                    {r.pauseAllowed ? ' · pausable' : ' · never pauses'}
                    {!r.active && ' · inactive'}
                  </span>
                  {/*
                    Changing an SLA target changes every compliance figure ever
                    measured against it, which is why the catalogue marks
                    SLA_RULE_UPDATED high-impact and why the history is one
                    click from the rule rather than buried in a workspace.
                  */}
                  <CmsAuditHistoryLink
                    entityType="SLA_RULE"
                    entityId={r.slaRuleId}
                    label="Audit history"
                  />
                </span>
              </li>
            ))}
          </ul>
        </CmsCard>

        <CmsDrawer id="cms-rule-drawer" tone="form" title="New SLA rule">
          <form id="cms-rule-form" novalidate class="flex flex-col gap-4">
            <p
              id="cms-rule-error"
              role="alert"
              hidden
              class="rounded-cms border border-cms-negative bg-cms-negative-tint px-3 py-2 text-cms-body-sm text-cms-negative"
            />
            <CmsInput id="r-ruleName" name="ruleName" label="Rule name" required />
            <CmsSelect
              id="r-slaProfileId"
              name="slaProfileId"
              label="Profile"
              required
              options={[
                { value: '', label: 'Choose a profile' },
                ...profiles.map((p) => ({ value: p.slaProfileId, label: p.profileName })),
              ]}
            />
            <CmsSelect
              id="r-entityType"
              name="entityType"
              label="Measures"
              required
              options={[
                'LEAD',
                'CASE',
                'SALES_ORDER',
                'PURCHASE_ORDER',
                'OPPORTUNITY',
                'WORKFLOW_STAGE',
              ].map((t) => ({ value: t, label: titleCase(t) }))}
            />
            <CmsInput
              id="r-stageCode"
              name="stageCode"
              label="Stage code"
              hint="For example FIRST_RESPONSE, FIRST_CONTACT or FINANCE_APPROVAL. Leave empty to match any stage."
            />
            <CmsInput
              id="r-priority"
              name="priority"
              label="Priority"
              hint="LOW, MEDIUM, HIGH or CRITICAL. Leave empty to match any."
            />
            <CmsInput
              id="r-target"
              name="target"
              label="Target"
              required
              hint='Type it as words: "30 minutes", "2 hours", "1 business day". The stored minutes are shown on the rule after saving.'
            />
            <CmsInput
              id="r-warning"
              name="warning"
              label="Warn when this much remains"
              hint='For example "15 minutes". Leave empty for no warning.'
            />
            <CmsSelect
              id="r-businessCalendarId"
              name="businessCalendarId"
              label="Calendar"
              required
              options={[
                { value: '', label: 'Choose a calendar' },
                ...calendars.map((cal) => ({
                  value: cal.businessCalendarId,
                  label: cal.calendarName,
                })),
              ]}
            />
            <CmsCheckbox
              id="r-businessHoursOnly"
              name="businessHoursOnly"
              label="Count business hours only"
              checked
            />
            <CmsCheckbox
              id="r-pauseAllowed"
              name="pauseAllowed"
              label="May pause while waiting on the customer"
              hint="Internal waiting never pauses regardless: it is precisely the thing worth measuring."
            />
            <CmsInput
              id="r-escalationAfter"
              name="escalationAfter"
              label="Escalate after"
              hint="Optional, as words."
            />
          </form>
          <Fragment slot="actions">
            <CmsButton variant="ghost" data-cms-modal-close>
              Cancel
            </CmsButton>
            <button
              type="submit"
              form="cms-rule-form"
              class="inline-flex h-10 items-center justify-center gap-2 rounded-cms bg-cms-royal px-4 text-cms-body-sm font-semibold text-white outline-none hover:bg-cms-royal-deep focus-visible:ring-2 focus-visible:ring-focus"
            >
              Save rule
            </button>
          </Fragment>
        </CmsDrawer>

        <CmsDrawer id="cms-holiday-drawer" tone="form" title="Add holiday">
          <form id="cms-holiday-form" novalidate class="flex flex-col gap-4">
            <p
              id="cms-holiday-error"
              role="alert"
              hidden
              class="rounded-cms border border-cms-negative bg-cms-negative-tint px-3 py-2 text-cms-body-sm text-cms-negative"
            />
            <input type="hidden" id="h-calendarId" name="calendarId" value="" />
            <CmsInput id="h-holidayDate" name="holidayDate" label="Date" type="date" required />
            <CmsInput id="h-holidayName" name="holidayName" label="Name" required />
          </form>
          <Fragment slot="actions">
            <CmsButton variant="ghost" data-cms-modal-close>
              Cancel
            </CmsButton>
            <button
              type="submit"
              form="cms-holiday-form"
              class="inline-flex h-10 items-center justify-center gap-2 rounded-cms bg-cms-royal px-4 text-cms-body-sm font-semibold text-white outline-none hover:bg-cms-royal-deep focus-visible:ring-2 focus-visible:ring-focus"
            >
              Add
            </button>
          </Fragment>
        </CmsDrawer>
      </Fragment>
    )
  }
</CmsLayout>

<script>
  import { busy } from '@/lib/cms/ui/busy';

  interface FieldError {
    field: string;
    message: string;
  }

  const ruleForm = document.getElementById('cms-rule-form') as HTMLFormElement | null;
  const ruleDrawer = document.getElementById('cms-rule-drawer') as HTMLDialogElement | null;
  const ruleError = document.getElementById('cms-rule-error');
  const holidayForm = document.getElementById('cms-holiday-form') as HTMLFormElement | null;
  const holidayDrawer = document.getElementById('cms-holiday-drawer') as HTMLDialogElement | null;
  const holidayError = document.getElementById('cms-holiday-error');

  if (ruleForm && ruleDrawer && holidayForm && holidayDrawer) {
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-cms-rule-new]')) {
        ruleForm.reset();
        if (ruleError) ruleError.hidden = true;
        ruleDrawer.showModal();
        return;
      }
      const holiday = target?.closest<HTMLElement>('[data-cms-holiday-add]');
      if (holiday) {
        holidayForm.reset();
        (document.getElementById('h-calendarId') as HTMLInputElement).value =
          holiday.dataset.cmsHolidayAdd ?? '';
        if (holidayError) holidayError.hidden = true;
        holidayDrawer.showModal();
      }
    });

    const wire = (form: HTMLFormElement, url: string, errorBox: HTMLElement | null) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const restore = busy(form.querySelector<HTMLButtonElement>('[type="submit"]'), 'Saving…');
        const body: Record<string, unknown> = {};
        for (const [name, value] of new FormData(form).entries()) {
          if (typeof value === 'string') body[name] = value;
        }
        for (const box of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
          body[box.name] = box.checked;
        }
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(body),
          });
          if (response.ok) {
            window.location.reload();
            return;
          }
          const answer = (await response.json().catch(() => null)) as {
            error?: { message?: string; fields?: FieldError[] };
          } | null;
          if (errorBox) {
            errorBox.hidden = false;
            errorBox.textContent =
              answer?.error?.fields?.map((f) => f.message).join(' ') ??
              answer?.error?.message ??
              'That could not be saved. Please try again.';
          }
        } catch {
          if (errorBox) {
            errorBox.hidden = false;
            errorBox.textContent =
              'There was a problem reaching the server. Check your connection.';
          }
        } finally {
          restore();
        }
      });
    };
    wire(ruleForm, '/api/admin/sla/rules', ruleError);
    wire(holidayForm, '/api/admin/sla/calendars', holidayError);
  }
</script>
