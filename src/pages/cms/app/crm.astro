---
/**
 * CRM → Leads.
 *
 * The lead list. Search, filters, sort and paging all happen in the database
 * with the scope predicate as the first clause of the WHERE, so the total
 * beside the list counts exactly the leads this person may open.
 *
 * The four cards at the top come from `leadIndicators`, which runs the same
 * scope predicate as the list. They are counts of a stated condition, never a
 * score: "needs first contact" means `first_contact_at IS NULL` and nothing
 * more. A card that used a different predicate from the list would advertise a
 * lead that returns 404, which is the failure section 0d names.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsKpiCard from '@/components/cms/CmsKpiCard.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsDrawer from '@/components/cms/CmsDrawer.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import CmsLeadCreateDrawer from '@/components/cms/CmsLeadCreateDrawer.astro';

import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { canViewLeads, canCreateLeads, canManageLeadSources } from '@/lib/cms/permissions';
import {
  ageInDays,
  leadIndicators,
  leadOptions,
  listLeads,
  LEAD_STATUSES,
  type LeadIndicators,
  type LeadOptions,
  type LeadPage,
} from '@/lib/cms/repos/leadAdmin';
import { readLeadQuery } from '@/lib/cms/admin/leadInput';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayRead = canViewLeads(permissions);
const mayCreate = canCreateLeads(permissions);
const maySources = canManageLeadSources(permissions);
const userId = Astro.locals.cms?.user.userId ?? '';

const params = Astro.url.searchParams;
const query = readLeadQuery(params);

let page: LeadPage = { items: [], total: 0, page: 1, pageSize: 25 };
let indicators: LeadIndicators = { total: 0, fresh: 0, needsFirstContact: 0, qualified: 0 };
let options: LeadOptions = {
  sources: [],
  campaigns: [],
  businessUnits: [],
  owners: [],
  pipelines: [],
};
let loadFailed = false;

if (mayRead) {
  try {
    const db = await getDb(getCmsEnv());
    [page, indicators, options] = await Promise.all([
      listLeads(db, userId, query),
      leadIndicators(db, userId),
      leadOptions(db),
    ]);
  } catch (error) {
    console.error('[cms.crm.leads] load failed', error);
    loadFailed = true;
  }
}

const now = new Date();
const blank = (label: string) => ({ value: '', label });
const asOptions = (list: { id: string; label: string }[], empty: string) => [
  blank(empty),
  ...list.map((o) => ({ value: o.id, label: o.label })),
];
const titleCase = (value: string) =>
  value.charAt(0) + value.slice(1).toLowerCase().replace(/_/g, ' ');

const statusTone = (status: string) =>
  status === 'CONVERTED'
    ? 'success'
    : status === 'DISQUALIFIED'
      ? 'danger'
      : status === 'QUALIFIED'
        ? 'info'
        : 'neutral';

const from = (query.page - 1) * page.pageSize + 1;
const to = Math.min(query.page * page.pageSize, page.total);
const lastPage = Math.max(1, Math.ceil(page.total / page.pageSize));

/** Keep every filter when moving between pages. */
function pageHref(target: number): string {
  const next = new URLSearchParams(params);
  next.set('page', String(target));
  return `/app/crm?${next.toString()}`;
}
---

<CmsLayout title="Leads">
  {
    !mayRead ? (
      <CmsErrorState
        title="You do not have access to leads"
        description="Ask a system administrator for the CRM.LEADS.VIEW permission. Nothing on this page is loaded without it."
      />
    ) : loadFailed ? (
      <CmsErrorState title="Leads could not be loaded" description="The database did not answer." />
    ) : (
      <Fragment>
        <CmsPageHeader
          title="Leads"
          description="Early interest, before it is an opportunity. A lead may sit against an existing customer or against nobody at all, which is why an account is optional here and required at conversion."
          crumbs={[{ label: 'Home', href: '/app' }, { label: 'CRM' }, { label: 'Leads' }]}
        >
          <Fragment slot="actions">
            <CmsButton variant="secondary" href="/app/crm/opportunities">
              Opportunities
            </CmsButton>
            <CmsButton variant="secondary" href="/app/crm/activities">
              My Work
            </CmsButton>
            {maySources && (
              <CmsButton variant="secondary" href="/app/crm/lead-sources">
                Lead sources
              </CmsButton>
            )}
            {mayCreate && (
              <CmsButton variant="primary" icon="plus" data-cms-lead-create>
                New lead
              </CmsButton>
            )}
          </Fragment>
        </CmsPageHeader>

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <CmsKpiCard label="Leads in your scope" value={String(indicators.total)} icon="crm" />
          <CmsKpiCard
            label="Captured in the last 7 days"
            value={String(indicators.fresh)}
            icon="clock"
          />
          <CmsKpiCard
            label="Awaiting first contact"
            value={String(indicators.needsFirstContact)}
            icon="statusWarn"
          />
          <CmsKpiCard label="Qualified" value={String(indicators.qualified)} icon="statusOk" />
        </div>
        <p class="text-cms-body-sm text-cms-muted">
          Each card is a count of a stated condition over the same leads the list can show. Awaiting
          first contact means no first contact has been recorded, not that anyone is late.
        </p>

        <CmsCard>
          <form method="get" class="flex flex-wrap items-end gap-3">
            <div class="min-w-56 grow">
              <CmsInput
                id="f-q"
                name="q"
                label="Search"
                type="search"
                value={query.search}
                hint="Lead number, title, description, product interest or account name. Case does not matter."
              />
            </div>
            <CmsSelect
              id="f-status"
              name="status"
              label="Status"
              value={query.status ?? ''}
              options={[
                blank('Every status'),
                ...LEAD_STATUSES.map((s) => ({ value: s, label: titleCase(s) })),
              ]}
            />
            <CmsSelect
              id="f-source"
              name="source"
              label="Source"
              value={query.leadSourceId ?? ''}
              options={asOptions(options.sources, 'Every source')}
            />
            <CmsSelect
              id="f-owner"
              name="owner"
              label="Owner"
              value={query.ownerUserId ?? ''}
              options={asOptions(options.owners, 'Anyone')}
            />
            <CmsSelect
              id="f-unit"
              name="unit"
              label="Business unit"
              value={query.businessUnitId ?? ''}
              options={asOptions(options.businessUnits, 'Every unit')}
            />
            <CmsSelect
              id="f-campaign"
              name="campaign"
              label="Campaign"
              value={query.campaignId ?? ''}
              options={asOptions(options.campaigns, 'Every campaign')}
            />
            <CmsSelect
              id="f-contact"
              name="contact"
              label="First contact"
              value={query.firstContact}
              options={[
                { value: 'all', label: 'Either' },
                { value: 'pending', label: 'Not yet recorded' },
                { value: 'done', label: 'Recorded' },
              ]}
            />
            <CmsInput
              id="f-from"
              name="from"
              label="Captured from"
              type="date"
              value={query.capturedFrom ?? ''}
            />
            <CmsInput
              id="f-to"
              name="to"
              label="Captured to"
              type="date"
              value={query.capturedTo ?? ''}
            />
            <CmsButton type="submit" variant="secondary">
              Apply
            </CmsButton>
          </form>
        </CmsCard>

        <CmsDataTable
          caption="Leads"
          columns={[
            { key: 'lead', label: 'Lead' },
            { key: 'number', label: 'Number', secondary: true },
            { key: 'account', label: 'Account', secondary: true },
            { key: 'source', label: 'Source', secondary: true },
            { key: 'owner', label: 'Owner', secondary: true },
            { key: 'value', label: 'Estimated value', numeric: true },
            { key: 'age', label: 'Age', numeric: true },
            { key: 'status', label: 'Status' },
          ]}
          empty={page.items.length === 0}
        >
          {page.items.map((row) => (
            <tr class="border-b border-cms-line last:border-0">
              <td class="px-4 py-2.5">
                <a
                  href={`/app/crm/${row.leadId}`}
                  class="rounded-cms font-medium text-cms-royal underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                >
                  {row.title}
                </a>
                {row.firstContactAt === null && row.status === 'NEW' && (
                  <span class="ms-2 text-cms-caption text-cms-muted">
                    No first contact recorded
                  </span>
                )}
              </td>
              <td class="hidden px-4 py-2.5 text-cms-muted tabular-nums sm:table-cell">
                {row.leadNumber}
              </td>
              <td class="hidden px-4 py-2.5 text-cms-muted sm:table-cell">
                {/*
                  Not available, never a dash that reads as a name. A lead with
                  no account is ordinary at this stage.
                */}
                {row.accountName === null ? (
                  'Not available'
                ) : (
                  <a
                    href={`/app/customers/${row.accountId}`}
                    class="rounded-cms underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                  >
                    {row.accountName}
                  </a>
                )}
              </td>
              <td class="hidden px-4 py-2.5 text-cms-muted sm:table-cell">{row.sourceName}</td>
              <td class="hidden px-4 py-2.5 text-cms-muted sm:table-cell">{row.ownerName}</td>
              <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">
                {/*
                  Estimated value is genuinely unknown on most early leads. Zero
                  would say the customer is worth nothing, which is a different
                  claim from nobody having estimated yet.
                */}
                {row.estimatedValue === null
                  ? 'Not available'
                  : `${row.currencyCode ?? ''} ${row.estimatedValue.toLocaleString('en-KE')}`.trim()}
              </td>
              <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">
                {ageInDays(row.capturedAt, now)} days
              </td>
              <td class="px-4 py-2.5">
                <CmsBadge tone={statusTone(row.status)} label={titleCase(row.status)} />
              </td>
            </tr>
          ))}
          <Fragment slot="empty">
            <CmsEmptyState
              icon="crm"
              title="No leads match"
              description="Adjust the search or the filters. A lead you cannot see here is one outside your data scope."
            />
          </Fragment>
        </CmsDataTable>

        {page.total > 0 && (
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-cms-body-sm text-cms-muted">
              Showing {from} to {to} of {page.total}. Searching, filtering and paging all happen on
              the server, so the whole lead list is never sent to the browser.
            </p>
            {lastPage > 1 && (
              <nav aria-label="Pages" class="flex items-center gap-2">
                <a
                  href={pageHref(Math.max(1, query.page - 1))}
                  aria-disabled={query.page === 1 ? 'true' : undefined}
                  class:list={[
                    'rounded-cms px-3 py-1.5 text-cms-body-sm font-medium outline-none',
                    'focus-visible:ring-2 focus-visible:ring-focus',
                    query.page === 1
                      ? 'pointer-events-none text-cms-muted opacity-50'
                      : 'text-cms-royal hover:bg-cms-canvas',
                  ]}
                >
                  Previous
                </a>
                <span class="text-cms-body-sm text-cms-muted">
                  Page {query.page} of {lastPage}
                </span>
                <a
                  href={pageHref(Math.min(lastPage, query.page + 1))}
                  aria-disabled={query.page === lastPage ? 'true' : undefined}
                  class:list={[
                    'rounded-cms px-3 py-1.5 text-cms-body-sm font-medium outline-none',
                    'focus-visible:ring-2 focus-visible:ring-focus',
                    query.page === lastPage
                      ? 'pointer-events-none text-cms-muted opacity-50'
                      : 'text-cms-royal hover:bg-cms-canvas',
                  ]}
                >
                  Next
                </a>
              </nav>
            )}
          </div>
        )}

        {mayCreate && (
          <CmsDrawer id="cms-lead-drawer" tone="form" title="New lead">
            <CmsLeadCreateDrawer
              sources={options.sources}
              campaigns={options.campaigns}
              businessUnits={options.businessUnits}
              owners={options.owners}
            />
            <Fragment slot="actions">
              <CmsButton variant="ghost" data-cms-modal-close>
                Cancel
              </CmsButton>
              <button
                type="submit"
                form="cms-lead-form"
                data-cms-lead-save
                class="inline-flex h-10 items-center justify-center gap-2 rounded-cms bg-cms-royal px-4 text-cms-body-sm font-semibold text-white transition-colors duration-150 outline-none hover:bg-cms-royal-deep focus-visible:ring-2 focus-visible:ring-focus disabled:cursor-not-allowed disabled:opacity-60"
              >
                Create lead
              </button>
            </Fragment>
          </CmsDrawer>
        )}
      </Fragment>
    )
  }
</CmsLayout>
