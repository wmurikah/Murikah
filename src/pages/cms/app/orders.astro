---
/**
 * Orders → the section landing.
 *
 * Two workspaces, each with an operations view and a performance view. The
 * split is deliberate: somebody chasing one order and somebody asking where
 * the month went want different screens, and a page that tries to be both is
 * bad at both.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import { canViewPurchaseOrders, canViewSalesOrders } from '@/lib/cms/permissions';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const maySeeSales = canViewSalesOrders(permissions);
const maySeePurchases = canViewPurchaseOrders(permissions);
---

<CmsLayout title="Orders">
  {
    !maySeeSales && !maySeePurchases ? (
      <CmsErrorState
        title="You do not have access to orders"
        description="Contact your administrator if you think this is a mistake."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          title="Orders"
          crumbs={[{ label: 'Home', href: '/app' }, { label: 'Orders' }]}
        />
        <div class="grid gap-4 lg:grid-cols-2">
          {maySeeSales && (
            <CmsCard title="Sales orders">
              <div class="flex flex-wrap gap-2">
                <CmsButton variant="primary" href="/app/orders/sales">
                  Operations
                </CmsButton>
                <CmsButton variant="ghost" href="/app/orders/sales/performance">
                  Performance
                </CmsButton>
              </div>
            </CmsCard>
          )}
          {maySeePurchases && (
            <CmsCard title="Purchase orders">
              <div class="flex flex-wrap gap-2">
                <CmsButton variant="primary" href="/app/orders/purchases">
                  Operations
                </CmsButton>
                <CmsButton variant="ghost" href="/app/orders/purchases/performance">
                  Performance
                </CmsButton>
              </div>
            </CmsCard>
          )}
        </div>
      </Fragment>
    )
  }
</CmsLayout>
