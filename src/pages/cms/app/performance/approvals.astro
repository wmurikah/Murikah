---
/**
 * The records behind a figure on Home's leaderboards.
 *
 * SIX FIGURES, SIX DESTINATIONS, ONE PAGE. Volume opens what a person
 * completed; Typical opens the same set sorted by duration with the median row
 * marked; Slowest 10% opens ONLY the slowest tenth, slowest first; Within SLA
 * opens the breaches, because those are the actionable half; Pending opens what
 * is still waiting on them, oldest first. The sixth, Oldest pending, opens the
 * order itself rather than landing here, because it is one record and a list of
 * one is a worse answer than the record.
 *
 * THE COUNT ON THIS PAGE EQUALS THE FIGURE THAT OPENED IT, and it is exact by
 * construction rather than by agreement. `approvalRecords` is the aggregate
 * query with the grouping removed: the same source expression, the same bound
 * period, the same `user_id IS ?` predicate, and the tail cut at the same
 * integer index the P90 is read at. Two queries written to agree eventually
 * disagree, and where an aggregate and its list disagree the cause is almost
 * never rounding — it is two different scope rules, which is a data-leak class
 * of defect. One query cannot have two scope rules.
 *
 * EVERY ROW SHOWS THE TIMESTAMPS ITS DURATION WAS COMPUTED FROM, so a figure
 * can be checked rather than trusted. A duration with no visible ends is an
 * assertion.
 *
 * NOTHING HERE RANKS ANYBODY. It is one person's records for one function over
 * one period, in duration order or waiting order. There is no comparison on the
 * page and no position in a field.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsCard from '@/components/cms/CmsCard.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import { requestDb } from '@/lib/cms/db';
import { createBatcher, runSection } from '@/lib/cms/batching';
import { formatDuration } from '@/lib/cms/analytics/stats';
import {
  approvalRecords,
  EVERYONE,
  RECORD_CLOCKS,
  RECORD_VIEWS,
  type ApprovalActor,
  type ApprovalProcess,
  type ApprovalRecord,
  type ApprovalScope,
  type RecordClock,
  type RecordView,
} from '@/lib/cms/repos/approvalSla';
import { parseFilter } from '@/lib/cms/analytics/filters';
import { parsePeriod, periodParams } from '@/lib/cms/analytics/period';
import { PRODUCT_GROUP_LABELS, UNGROUPED } from '@/lib/cms/analytics/productGroups';

export const prerender = false;

const params = Astro.url.searchParams;
const today = new Date();
const period = parsePeriod(params, today);
// THE SAME PARSER THE PANELS USE. The affiliate has to be read here by the same
// function that read it there, or the aggregate and this list narrow by two
// different rules and the count stops matching the figure that opened it.
const filter = parseFilter(params);

/**
 * WHICH PROCESS, AND WHY TWO NAMES REACH IT.
 *
 * The panel is called Loading Authority; the database is not, and was not
 * renamed with it. `process=SALES_ORDER` is the schema's own name and every
 * link written before the rename carries it, so it keeps working exactly as
 * it did. `process=LOADING_AUTHORITY` is the name a person now sees on the
 * panel, accepted so a link written from the screen is never a broken link.
 * Both resolve to the one process the tables call SALES_ORDER.
 */
const PROCESS_ALIASES: Readonly<Record<string, ApprovalProcess>> = {
  SALES_ORDER: 'SALES_ORDER',
  LOADING_AUTHORITY: 'SALES_ORDER',
  PURCHASE_ORDER: 'PURCHASE_ORDER',
};
const process: ApprovalProcess =
  PROCESS_ALIASES[(params.get('process') ?? '').toUpperCase()] ?? 'PURCHASE_ORDER';
const fn = (params.get('fn') ?? '').slice(0, 120);
// THREE STATES IN THE URL, BECAUSE THERE ARE THREE QUESTIONS.
//
// `all=1` is a whole function across everybody, which is what a bar on the
// chart measures. `person=none` is the null actor, which is how the two sales
// order functions that record nobody are addressed. Anything else is one named
// person. An absent `user` cannot mean both "everybody" and "the null actor",
// which is why neither is expressed by absence.
const actor: ApprovalActor =
  params.get('all') === '1'
    ? EVERYONE
    : {
        kind: 'PERSON',
        userId: params.get('person') === 'none' ? null : (params.get('user') ?? '') || null,
      };
const scope: ApprovalScope = {
  from: period.from,
  to: period.to,
  affiliateId: filter.affiliateId,
};
const viewRaw = params.get('view') ?? 'completed';
const view: RecordView = (RECORD_VIEWS as readonly string[]).includes(viewRaw)
  ? (viewRaw as RecordView)
  : 'completed';
// The purchase order chart's product group, where the figure carried one.
// Only the three configured labels are meaningful; anything else is ignored
// rather than filtering the list down to nothing on a typo.
// WHICH CLOCK THE FIGURE THAT OPENED THIS LIST WAS READ ON. The approver
// chart's figures are working-day minutes, so its lists rank, cut and judge
// on that clock; everything else keeps the wall clock it has always used. It
// arrives in the URL because only the figure knows which one it was.
const clockRaw = (params.get('clock') ?? '').toUpperCase();
const clock: RecordClock = (RECORD_CLOCKS as readonly string[]).includes(clockRaw)
  ? (clockRaw as RecordClock)
  : 'WALL';
const groupRaw = (params.get('group') ?? '').slice(0, 40);
const productGroup =
  process === 'PURCHASE_ORDER' && [...PRODUCT_GROUP_LABELS, UNGROUPED].includes(groupRaw)
    ? groupRaw
    : null;

/** What each view is, said in the words the column that opened it used. */
const TITLES: Readonly<Record<RecordView, string>> = {
  completed: 'Completed approvals',
  typical: 'Completed approvals, by duration',
  tail: 'The slowest tenth',
  breaches: 'Approvals outside the target',
  pending: 'Still waiting',
};

const EXPLANATIONS: Readonly<Record<RecordView, string>> = {
  completed: 'Every completion this figure counted, in duration order.',
  typical:
    'The same set, sorted by duration, with the row the median was read at marked. On an even ' +
    'count two rows are marked and the printed figure is their mean.',
  tail:
    'Only the completions at or past the 90th percentile, slowest first. This is the set the ' +
    'Slowest 10% figure describes, and it is cut at the same index that figure is read at.',
  breaches:
    'Only the completions that missed the configured target. Targets are business hours and these ' +
    'durations are elapsed, so the two agree within a working day and diverge across a weekend.',
  pending: 'What is still waiting, oldest first. These have no duration yet, which is the point.',
};

const functionLabel =
  (fn === '' ? 'every function' : fn) + (productGroup === null ? '' : `, ${productGroup}`);
const orderPath = process === 'SALES_ORDER' ? '/app/orders/sales' : '/app/orders/purchases';
// The name a person sees. The identifier above is the name the tables use.
const processLabel = process === 'SALES_ORDER' ? 'Loading Authority' : 'Purchase order';

let records: ApprovalRecord[] = [];
let traceId: string | null = null;
let connectionFailed = false;

// AN EMPTY FUNCTION IS A REAL QUESTION, and it is two of them.
//
// For everybody it is the panel's headline figure: every completion in the
// period across every function. For one person it is what the approver chart
// asks — this approver, every level they touched — which is the figure its
// name, its time and its count over target all open.
//
// THERE USED TO BE A GUARD HERE REFUSING THE SECOND, on the reasoning that a
// person named without a function was a mistake. It is not one any more, and
// while it stood every destination on the new panel answered with an empty
// list and a header reading "an unrecorded actor". Nothing is unaddressable
// now, so nothing is refused.

if (Astro.locals.cms?.user) {
  try {
    const db = await requestDb(Astro.locals);
    const batcher = createBatcher(db);
    const found = await runSection(batcher, 'approvals.records', (client) =>
      approvalRecords(client, process, view, fn, actor, scope, productGroup, clock),
    );
    if (found.ok) records = found.value;
    else traceId = found.traceId;
  } catch (error) {
    console.error('[cms.approvals] no database connection', error);
    connectionFailed = true;
  }
}

const person = records.find((record) => record.person !== null)?.person ?? null;
/**
 * Whose records these are, said in words rather than by absence.
 *
 * "Everybody" and "the actor the extract does not record" are different answers
 * and a blank is neither of them. Invoicing and loading authority genuinely
 * record nobody, so a list of them is honestly headed "not recorded" while a
 * function-wide list is headed "everybody".
 */
const actorLabel = actor.kind === 'EVERYONE' ? 'everybody' : (person ?? 'an unrecorded actor');
const count = (value: number) => value.toLocaleString('en-KE');
const backToHome = `/app?${new URLSearchParams(periodParams(period)).toString()}`;

/**
 * TWO DURATIONS, TWO COLUMNS, TWO HEADINGS. The same span measured two ways:
 * the working day is what the rule judges, the wall clock is what the
 * business waited. Neither is presented as the other and nothing here adds
 * them together. The working-day column appears only where a rule configures
 * a working day to count.
 */
const hasWorking = records.some((record) => record.workingMinutes !== null);

const COLUMNS = [
  { key: 'document', label: 'Order' },
  {
    key: 'started',
    label: 'Started',
    definition: 'The timestamp the duration was measured from.',
  },
  {
    key: 'completed',
    label: 'Completed',
    definition: 'The timestamp the duration was measured to.',
  },
  ...(hasWorking
    ? [
        {
          key: 'working',
          label: 'Working hours',
          numeric: true,
          definition:
            'The span on this row counted inside the working day the rule configures, 08:00 to ' +
            '17:00. This is the figure the target judges and the figure the approver chart ' +
            'plots. It is never added to the wall clock beside it.',
        },
      ]
    : []),
  {
    key: 'duration',
    label: 'Wall clock',
    numeric: true,
    definition:
      'The whole span between the two timestamps on this row, whatever the hour: what the ' +
      'business actually waited. It is the measure the leaderboard is computed from, so a ' +
      'figure there can be checked here rather than trusted.',
  },
  { key: 'target', label: 'Target', numeric: true, secondary: true },
  { key: 'outcome', label: 'Against target' },
];
---

<CmsLayout title={TITLES[view]} width="data">
  <CmsPageHeader title={TITLES[view]} definition={EXPLANATIONS[view]} />

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-cms-body-sm text-cms-ink">
      {processLabel} · {functionLabel} · {actorLabel} · {period.label}
    </span>
    {
      /*
        THE COUNT, STATED, so the check a reader came here to make can be made
        without counting rows by eye.
      */
    }
    <CmsBadge tone="info" label={`${count(records.length)} records`} />
    <a
      class="rounded-cms text-cms-body-sm font-semibold text-cms-royal underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
      href={backToHome}
    >
      Back to Home
    </a>
  </div>

  {connectionFailed && <CmsErrorState title="The records could not be loaded" />}
  {
    traceId !== null && (
      <CmsErrorState
        title="The records behind this figure could not be loaded"
        description={
          `The figure on Home is unaffected; only this list failed. Try again, or choose a ` +
          `different period. If it keeps failing, send your administrator reference ${traceId} ` +
          `and the address of this page.`
        }
      />
    )
  }

  <CmsCard>
    <CmsDataTable
      caption={`${TITLES[view]} for ${actorLabel} on ${functionLabel}, ${period.label}`}
      columns={COLUMNS}
      empty={records.length === 0}
      rowCount={records.length}
      emptyMessage={`Nothing matches ${functionLabel} for ${actorLabel} in ${period.label}.`}
      stickyHead={records.length > 20}
    >
      {
        records.map((record) => (
          <tr
            class:list={[
              'border-b border-cms-line last:border-0',
              record.isMedian && view === 'typical' ? 'bg-cms-royal-tint' : '',
            ]}
          >
            <td class="px-3 py-2">
              {record.entityId === null ? (
                (record.documentNumber ?? 'Not recorded')
              ) : (
                <a
                  class="rounded-cms font-medium text-cms-royal underline-offset-2 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                  href={`${orderPath}/${record.entityId}`}
                >
                  {record.documentNumber ?? record.entityId}
                </a>
              )}
              {record.isMedian && view === 'typical' && (
                <span class="ms-2 text-cms-caption font-semibold text-cms-royal">Median row</span>
              )}
            </td>
            <td class="px-3 py-2 tabular-nums">{record.startedAt ?? 'Not recorded'}</td>
            <td class="px-3 py-2 tabular-nums">{record.completedAt ?? 'Still waiting'}</td>
            {hasWorking && (
              <td class="px-3 py-2 text-right tabular-nums">
                {record.workingMinutes === null
                  ? 'Not measured'
                  : formatDuration(record.workingMinutes)}
              </td>
            )}
            <td class="px-3 py-2 text-right tabular-nums">
              {record.minutes === null ? 'Still waiting' : formatDuration(record.minutes)}
            </td>
            <td class="hidden px-3 py-2 text-right tabular-nums sm:table-cell">
              {record.targetMinutes === null ? 'No target' : formatDuration(record.targetMinutes)}
            </td>
            <td class="px-3 py-2">
              {record.withinTarget === null ? (
                <span class="text-cms-muted">Not measured</span>
              ) : (
                <CmsBadge
                  tone={record.withinTarget ? 'success' : 'danger'}
                  label={record.withinTarget ? 'Within target' : 'Outside target'}
                />
              )}
            </td>
          </tr>
        ))
      }
    </CmsDataTable>
  </CmsCard>
</CmsLayout>
