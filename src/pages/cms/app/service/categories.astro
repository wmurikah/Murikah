---
/**
 * Service → Categories.
 *
 * Two levels, category and subcategory, exactly as the table allows: there is
 * no deeper nesting to configure. Historical cases keep their category
 * through ON DELETE RESTRICT; this screen deactivates and never deletes.
 */
import CmsLayout from '@/layouts/CmsLayout.astro';
import CmsPageHeader from '@/components/cms/CmsPageHeader.astro';
import CmsButton from '@/components/cms/CmsButton.astro';
import CmsBadge from '@/components/cms/CmsBadge.astro';
import CmsDataTable from '@/components/cms/CmsDataTable.astro';
import CmsDrawer from '@/components/cms/CmsDrawer.astro';
import CmsEmptyState from '@/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@/components/cms/CmsErrorState.astro';
import CmsInput from '@/components/cms/CmsInput.astro';
import CmsSelect from '@/components/cms/CmsSelect.astro';
import CmsCheckbox from '@/components/cms/CmsCheckbox.astro';

import { getCmsEnv } from '@/lib/cms/env';
import { getDb } from '@/lib/cms/db';
import { canManageCaseCategories } from '@/lib/cms/permissions';
import {
  listCaseCategories,
  CASE_PRIORITIES,
  type CaseCategoryRow,
} from '@/lib/cms/repos/serviceAdmin';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayManage = canManageCaseCategories(permissions);

let categories: CaseCategoryRow[] = [];
let loadFailed = false;
if (mayManage) {
  try {
    categories = await listCaseCategories(await getDb(getCmsEnv()));
  } catch (error) {
    console.error('[cms.service.categories] load failed', error);
    loadFailed = true;
  }
}
const titleCase = (value: string) => value.charAt(0) + value.slice(1).toLowerCase();
---

<CmsLayout title="Case categories">
  {
    !mayManage ? (
      <CmsErrorState
        title="You do not have access to case categories"
        description="Ask a system administrator for the SERVICE.CATEGORIES.MANAGE permission."
      />
    ) : loadFailed ? (
      <CmsErrorState
        title="Categories could not be loaded"
        description="The database did not answer."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          title="Case categories"
          description="Two levels, category and subcategory, each pair unique, each with a default priority. Historical cases keep theirs; deactivation is the only removal."
          crumbs={[
            { label: 'Home', href: '/app' },
            { label: 'Service', href: '/app/service' },
            { label: 'Categories' },
          ]}
        >
          <CmsButton slot="actions" variant="primary" icon="plus" data-cms-category-new>
            New category
          </CmsButton>
        </CmsPageHeader>

        <CmsDataTable
          caption="Case categories"
          columns={[
            { key: 'category', label: 'Category' },
            { key: 'subcategory', label: 'Subcategory' },
            { key: 'priority', label: 'Default priority' },
            { key: 'cases', label: 'Cases', numeric: true },
            { key: 'state', label: 'State' },
            { key: 'actions', label: 'Actions' },
          ]}
          empty={categories.length === 0}
        >
          {categories.map((row) => (
            <tr class="border-b border-cms-line last:border-0">
              <td class="px-4 py-2.5 font-medium text-cms-ink">{row.categoryName}</td>
              <td class="px-4 py-2.5 text-cms-muted">{row.subcategoryName}</td>
              <td class="px-4 py-2.5">
                <CmsBadge
                  tone={
                    row.defaultPriority === 'CRITICAL'
                      ? 'danger'
                      : row.defaultPriority === 'HIGH'
                        ? 'warning'
                        : 'neutral'
                  }
                  label={titleCase(row.defaultPriority)}
                />
              </td>
              <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">{row.usageCount}</td>
              <td class="px-4 py-2.5">
                <CmsBadge
                  tone={row.active ? 'success' : 'neutral'}
                  label={row.active ? 'Active' : 'Inactive'}
                />
              </td>
              <td class="px-4 py-2.5">
                <button
                  type="button"
                  data-cms-category-edit={row.caseCategoryId}
                  data-cat-name={row.categoryName}
                  data-cat-sub={row.subcategoryName}
                  data-cat-priority={row.defaultPriority}
                  data-cat-active={row.active ? '1' : '0'}
                  class="rounded-cms px-2 py-1 text-cms-body-sm font-medium text-cms-royal outline-none hover:bg-cms-canvas focus-visible:ring-2 focus-visible:ring-focus"
                >
                  Edit
                </button>
              </td>
            </tr>
          ))}
          <Fragment slot="empty">
            <CmsEmptyState
              icon="service"
              title="No categories yet"
              description="A case cannot be raised without one."
            />
          </Fragment>
        </CmsDataTable>

        <CmsDrawer id="cms-category-drawer" tone="form" title="Case category">
          <form id="cms-category-form" novalidate class="flex flex-col gap-4">
            <p
              id="cms-category-error"
              role="alert"
              hidden
              class="rounded-cms border border-cms-danger bg-cms-danger-tint px-3 py-2 text-cms-body-sm text-cms-danger"
            />
            <CmsInput id="cat-categoryName" name="categoryName" label="Category" required />
            <CmsInput
              id="cat-subcategoryName"
              name="subcategoryName"
              label="Subcategory"
              required
            />
            <CmsSelect
              id="cat-defaultPriority"
              name="defaultPriority"
              label="Default priority"
              required
              options={CASE_PRIORITIES.map((p) => ({ value: p, label: titleCase(p) }))}
            />
            <CmsCheckbox id="cat-active" name="active" label="Active" checked />
          </form>
          <Fragment slot="actions">
            <CmsButton variant="ghost" data-cms-modal-close>
              Cancel
            </CmsButton>
            <button
              type="submit"
              form="cms-category-form"
              data-cms-category-save
              class="inline-flex h-10 items-center justify-center gap-2 rounded-cms bg-cms-royal px-4 text-cms-body-sm font-semibold text-white outline-none hover:bg-cms-royal-deep focus-visible:ring-2 focus-visible:ring-focus disabled:cursor-not-allowed disabled:opacity-60"
            >
              Save
            </button>
          </Fragment>
        </CmsDrawer>
      </Fragment>
    )
  }
</CmsLayout>

<script>
  interface FieldError {
    field: string;
    message: string;
  }

  const form = document.getElementById('cms-category-form') as HTMLFormElement | null;
  const drawer = document.getElementById('cms-category-drawer') as HTMLDialogElement | null;
  const errorBox = document.getElementById('cms-category-error');

  if (form && drawer) {
    let editing = '';
    const field = (id: string) => document.getElementById(id) as HTMLInputElement;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-cms-category-new]')) {
        editing = '';
        form.reset();
        if (errorBox) errorBox.hidden = true;
        drawer.showModal();
        return;
      }
      const edit = target?.closest<HTMLElement>('[data-cms-category-edit]');
      if (edit) {
        editing = edit.dataset.cmsCategoryEdit ?? '';
        field('cat-categoryName').value = edit.dataset.catName ?? '';
        field('cat-subcategoryName').value = edit.dataset.catSub ?? '';
        (document.getElementById('cat-defaultPriority') as unknown as HTMLSelectElement).value =
          edit.dataset.catPriority ?? 'MEDIUM';
        field('cat-active').checked = edit.dataset.catActive === '1';
        if (errorBox) errorBox.hidden = true;
        drawer.showModal();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = {
        categoryName: field('cat-categoryName').value,
        subcategoryName: field('cat-subcategoryName').value,
        defaultPriority: (
          document.getElementById('cat-defaultPriority') as unknown as HTMLSelectElement
        ).value,
        active: field('cat-active').checked,
      };
      try {
        const response = await fetch(
          editing === ''
            ? '/api/service/case-categories'
            : `/api/service/case-categories/${encodeURIComponent(editing)}`,
          {
            method: editing === '' ? 'POST' : 'PATCH',
            headers: { 'content-type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(body),
          },
        );
        if (response.ok) {
          window.location.reload();
          return;
        }
        const answer = (await response.json().catch(() => null)) as {
          error?: { message?: string; fields?: FieldError[] };
        } | null;
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.textContent =
            answer?.error?.fields?.map((f) => f.message).join(' ') ??
            answer?.error?.message ??
            'That could not be saved. Please try again.';
        }
      } catch {
        if (errorBox) {
          errorBox.hidden = false;
          errorBox.textContent = 'There was a problem reaching the server. Check your connection.';
        }
      }
    });
  }
</script>
