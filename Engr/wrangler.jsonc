{
  "name": "murikah-engr",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENGR_ENV": "production",
    "EMAIL_FROM": "wilberforce@murikah.com",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"],
  },
}
