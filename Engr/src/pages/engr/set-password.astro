---
export const prerender = false;
import EngrAuthLayout from '@/layouts/EngrAuthLayout.astro';
const token = Astro.url.searchParams.get('token') ?? '';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const error = Astro.url.searchParams.get('error');
const message =
  error === 'password'
    ? 'Use matching passwords between 12 and 128 characters.'
    : error === 'invalid'
      ? 'This link is invalid, expired or already used. Request a new link.'
      : null;
---

<EngrAuthLayout title="Set password">
  <div class="engr-authcard__head">
    <h1 class="engr-authcard__title">Set your password</h1>
    <p class="engr-authcard__sub">
      Invitation and recovery links work once and expire automatically.
    </p>
  </div>
  {
    message && (
      <p class="engr-error" role="alert">
        {message}
      </p>
    )
  }
  {
    token ? (
      <form method="post" action="/api/auth/set-password" class="engr-authform">
        <input type="hidden" name="token" value={token} />
        <div class="engr-field">
          <label for="password">New password</label>
          <input
            id="password"
            class="engr-input"
            name="password"
            type="password"
            minlength="12"
            maxlength="128"
            autocomplete="new-password"
            required
            autofocus
          />
        </div>
        <div class="engr-field">
          <label for="confirm_password">Confirm new password</label>
          <input
            id="confirm_password"
            class="engr-input"
            name="confirm_password"
            type="password"
            minlength="12"
            maxlength="128"
            autocomplete="new-password"
            required
          />
        </div>
        <button type="submit" class="engr-btn engr-btn--primary engr-authform__submit">
          Save password
        </button>
      </form>
    ) : (
      <p class="engr-error" role="alert">
        This recovery link is incomplete.
      </p>
    )
  }
  <div class="engr-authmeta"><a href="/login" class="engr-authmeta__link">Back to sign in</a></div>
</EngrAuthLayout>
