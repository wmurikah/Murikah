---
export const prerender = false;

/**
 * Region create and edit. The path segment is "new" to create, otherwise a
 * region id to edit. Gate: stations.manage. The form posts to the write
 * endpoint, which redirects back to the list on success.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { getRegion, listRegionAffiliates, type RegionDetail, type AffiliateOption } from '@engr/repos/adminRegions';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const canManage = can(Astro.locals, 'stations.manage');
const { id } = Astro.params;
const isNew = id === 'new';
const errorCode = Astro.url.searchParams.get('error');

let region: RegionDetail | null = null;
let affiliates: AffiliateOption[] = [];

if (canManage) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  const actor = { orgId: engr.orgId, homeOrgId: engr.homeOrgId, userId: engr.userId, isPlatformOwner: engr.isPlatformOwner, roles: engr.roles };
  affiliates = await listRegionAffiliates(db, actor);
  if (!isNew && id) region = await getRegion(db, actor, id);
}

const notFound = !isNew && region === null;
if (canManage && notFound) Astro.response.status = 404;

const s = region;
// A platform owner can list a child-owned region while acting as group root,
// but that child-owned region must keep its original affiliate classification.
const eligibleAffiliates = !isNew && s && s.orgId !== engr.orgId
  ? affiliates.filter((o) => o.id === s.orgId)
  : affiliates;
const formAffiliates = eligibleAffiliates;
const currentAffiliateSelectable = s != null && formAffiliates.some((o) => o.id === s.affiliateOrgId);
---

<EngrLayout title={isNew ? 'New region' : 'Edit region'}>
  <div class="engr-page-head">
    <div>
      <h1>{isNew ? 'New region' : 'Edit region'}</h1>
      <p class="engr-lead">An area that groups locations for setup.</p>
    </div>
    <a href="/admin/regions" class="engr-btn engr-btn--secondary">Back to regions</a>
  </div>

  {
    errorCode === 'conflict' && (
      <p class="engr-error" role="alert">
        The region was changed by another user or a new code could not be reserved. Reload and try again.
      </p>
    )
  }
  {
    errorCode === 'invalid' && (
      <p class="engr-error" role="alert">
        Choose a valid affiliate from this organisation's group and check the region name.
      </p>
    )
  }

  {
    !canManage ? (
      <p class="engr-error" role="alert">
        You do not have permission to manage regions.
      </p>
    ) : notFound ? (
      <p class="engr-error" role="alert">
        That region was not found.
      </p>
    ) : (
      <form method="post" action="/api/admin/regions" class="engr-formgrid engr-formgrid--setup">
        {!isNew && <input type="hidden" name="id" value={s!.id} />}
        <div class="engr-field">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            class="engr-input"
            name="name"
            maxlength="120"
            required
            value={s?.name ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="affiliate_org_id">Affiliate</label>
          <select id="affiliate_org_id" name="affiliate_org_id" class="engr-select" required>
            <option value="" disabled selected={!currentAffiliateSelectable}>Select affiliate</option>
            {formAffiliates.map((o) => (
              <option value={o.id} selected={s?.affiliateOrgId === o.id}>{o.name}</option>
            ))}
          </select>
          <p class="engr-field__hint">
            Select an affiliate under the currently selected tenant. The region and its locations retain their existing tenant ownership.
            {s && !currentAffiliateSelectable && ' This region has not yet been assigned to an affiliate.'}
          </p>
        </div>
        <div class="engr-field">
          <label for="display_region_code">Region code</label>
          <input id="display_region_code" type="text" class="engr-input"
            value={isNew ? 'Generated automatically on save' : s?.code ?? 'Pending legacy code backfill'}
            readonly aria-readonly="true" />
        </div>
        <div class="engr-actionbar engr-formgrid__full">
          <button type="submit" class="engr-btn engr-btn--primary">
            {isNew ? 'Create region' : 'Save changes'}
          </button>
        </div>
      </form>
    )
  }
</EngrLayout>
