---
export const prerender = false;

/** Assets list. Gate: assets.view; create/edit gates on assets.manage. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import EmptyState from '@/components/engr/EmptyState.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listAssetsAdmin, type AssetRow } from '@engr/repos/adminAssets';
import { shortDate } from '@engr/format';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'assets.view');
const canManage = can(Astro.locals, 'assets.manage');
const canSeeTransfers = engr.perms.some((key) => key.startsWith('assets.transfer.'));
const saved = Astro.url.searchParams.get('saved');
const errorCode = Astro.url.searchParams.get('error');

let rows: AssetRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  rows = await listAssetsAdmin(db, engr.orgId);
}
---

<EngrLayout title="Assets">
  <div class="engr-adminbar">
    <div>
      <h1>Assets</h1>
      <p class="engr-lead">Equipment tracked against each station.</p>
    </div>
    <div class="engr-actionbar">
      {allowed && <a href="/admin/asset-categories" class="engr-btn engr-btn--secondary">Categories</a>}
      {canSeeTransfers && (
        <a href="/admin/assets/transfers" class="engr-btn engr-btn--secondary engr-btn--with-count" data-asset-transfer-link>
          Asset transfers
          <span class="engr-navcount" data-asset-transfer-count hidden aria-hidden="true" />
        </a>
      )}
      {
        canManage && (
          <a href="/admin/assets/new" class="engr-btn engr-btn--primary">
            New asset
          </a>
        )
      }
    </div>
  </div>

  {
    saved && (
      <p class="engr-notice" role="status">
        Asset saved.
      </p>
    )
  }
  {
    errorCode && (
      <p class="engr-error" role="alert">
        That action could not be completed.
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        {canSeeTransfers
          ? 'Use Asset transfers above to review movements assigned to you. You do not have access to the asset register.'
          : 'You do not have access to assets.'}
      </p>
    ) : rows.length === 0 ? (
      <EmptyState
        message="No assets are set up yet."
        canAct={canManage}
        actionHref="/admin/assets/new"
        actionLabel="Add an asset"
        hint="Ask an administrator to add an asset."
      />
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table engr-table--edit" aria-label="Assets">
          <caption class="engr-vh">
            Assets. Manufacturer, model, serial number and install date are hidden on smaller
            screens; open a row for the full record.
          </caption>
          <thead>
            <tr>
              <th scope="col">Tag</th>
              <th scope="col">Name</th>
              <th scope="col" class="engr-col-mid">
                Station
              </th>
              <th scope="col" class="engr-col-mid">
                Category
              </th>
              <th scope="col" class="engr-col-lo">
                Manufacturer
              </th>
              <th scope="col" class="engr-col-lo">
                Model
              </th>
              <th scope="col" class="engr-col-lo">
                Serial
              </th>
              <th scope="col" class="engr-col-lo engr-num">
                Install date
              </th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{canManage ? <a href={`/admin/assets/${r.id}`}>{r.tag}</a> : r.tag}</td>
                <td class="engr-trunc">{r.name}</td>
                <td class="engr-col-mid">{r.stationName}</td>
                <td class="engr-col-mid">{r.categoryName ?? 'Not set'}</td>
                <td class="engr-col-lo">{r.manufacturer ?? '-'}</td>
                <td class="engr-col-lo">{r.model ?? '-'}</td>
                <td class="engr-col-lo">{r.serialNo ?? '-'}</td>
                <td class="engr-col-lo engr-num">{shortDate(r.installDate)}</td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</EngrLayout>

<script>
  // Use the same permission-scoped pending counts already loaded for the sidebar.
  // No duplicate API call or independent interpretation of transfer permissions.
  document.addEventListener('engr:pending-counts', (event: Event) => {
    const badge = document.querySelector<HTMLElement>('[data-asset-transfer-count]');
    const link = document.querySelector<HTMLAnchorElement>('[data-asset-transfer-link]');
    if (!badge || !link) return;
    const counts = (event as CustomEvent<Record<string, number>>).detail;
    const raw = Number(counts?.assetTransfers ?? 0);
    const n = Number.isSafeInteger(raw) && raw > 0 ? raw : 0;
    badge.textContent = n > 99 ? '99+' : String(n);
    badge.title = n ? n + ' transfers awaiting your action' : '';
    badge.toggleAttribute('hidden', n === 0);
    link.setAttribute('aria-label', n
      ? 'Asset transfers, ' + n + ' awaiting your action'
      : 'Asset transfers');
  });
</script>
