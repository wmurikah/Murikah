---
export const prerender = false;

/**
 * User create and edit. The path segment is "new" to create, otherwise a user id
 * to edit. User actions are separately gated. The roles checklist is only
 * shown, and only applied, when the viewer holds users.assign_roles. New users require a
 * temporary password or send a single-use invitation. Entering a password on an existing user resets their password,
 * revokes their sessions and forces replacement at the next login.
 */
import { displayLocationTerminology } from '@engr/format';
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { getUser, type UserDetail } from '@engr/repos/adminUsers';
import { listAssignableRoles } from '@engr/repos/adminRoles';
import { can } from '@engr/auth/rbac';
import {
  mayAssignRoleCode,
  mayManageTargetUser,
  userManagementScope,
} from '@engr/auth/adminPolicy';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const { id } = Astro.params;
const isNew = id === 'new';
const canManageUsers = can(Astro.locals, 'users.update');
const canInvite = can(Astro.locals, 'users.invite');
const canResetPassword = can(Astro.locals, 'users.reset_password');
const canSuspend = can(Astro.locals, 'users.suspend');
const canAssignRoles = can(Astro.locals, 'users.assign_roles');
const managementScope = userManagementScope(engr.roles, engr.isPlatformOwner);
const canOpen = isNew ? canInvite : canManageUsers;
const errorCode = Astro.url.searchParams.get('error');

let user: UserDetail | null = null;
let roles: { id: string; name: string; code: string }[] = [];

if (canOpen) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  if (canAssignRoles) {
    roles = await listAssignableRoles(db, engr.orgId, (code) =>
      mayAssignRoleCode(managementScope, code),
    );
  }
  if (!isNew && id) user = await getUser(db, engr.orgId, id);
}
const notFound = !isNew && user === null;
if (canOpen && notFound) Astro.response.status = 404;

const u = user;
const canManageTarget =
  isNew || (u !== null && mayManageTargetUser(managementScope, u.roleCodes, u.isPlatformOwner));
const selectedRoleIds = new Set(u?.roleIds ?? []);
---

<EngrLayout title={isNew ? 'New user' : 'Edit user'}>
  <div class="engr-page-head">
    <div>
      <h1>{isNew ? 'New user' : 'Edit user'}</h1>
      <p class="engr-lead">A person who can sign in and take part in the work.</p>
    </div>
    <a href="/admin/users" class="engr-btn engr-btn--secondary">Back to users</a>
  </div>

  {
    errorCode === 'conflict' && (
      <p class="engr-error" role="alert">
        That email is already used by another user.
      </p>
    )
  }
  {
    errorCode === 'invalid' && (
      <p class="engr-error" role="alert">
        Check the user details and use a temporary password of at least 12 characters.
      </p>
    )
  }
  {
    errorCode === 'not_found' && (
      <p class="engr-error" role="alert">
        That user was not found.
      </p>
    )
  }

  {
    !canOpen || !canManageTarget ? (
      <p class="engr-error" role="alert">
        This account requires a higher administrator.
      </p>
    ) : notFound ? (
      <p class="engr-error" role="alert">
        That user was not found.
      </p>
    ) : (
      <form method="post" action="/api/admin/users" class="engr-formgrid engr-formgrid--setup">
        {!isNew && <input type="hidden" name="id" value={u!.id} />}
        <div class="engr-field">
          <label for="full_name">Full name</label>
          <input
            type="text"
            id="full_name"
            class="engr-input"
            name="full_name"
            maxlength="120"
            required
            value={u?.fullName ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            class="engr-input"
            name="email"
            maxlength="200"
            required
            value={u?.email ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="phone">
            Phone <span class="engr-field__hint">(optional)</span>
          </label>
          <input
            type="text"
            id="phone"
            class="engr-input"
            name="phone"
            maxlength="40"
            value={u?.phone ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="status">Status</label>
          <select id="status" class="engr-select" name="status" disabled={!isNew && !canSuspend}>
            <option value="INVITED" selected={u?.status === 'INVITED'}>
              Invited
            </option>
            <option value="ACTIVE" selected={(u?.status ?? 'ACTIVE') === 'ACTIVE'}>
              Active
            </option>
            <option value="SUSPENDED" selected={u?.status === 'SUSPENDED'}>
              Suspended
            </option>
            <option value="DEACTIVATED" selected={u?.status === 'DEACTIVATED'}>
              Deactivated
            </option>
          </select>
          {!isNew && !canSuspend && (
            <input type="hidden" name="status" value={u?.status ?? 'ACTIVE'} />
          )}
        </div>
        {(isNew || canResetPassword) && (
          <div class="engr-field engr-formgrid__full">
            <label for="password">
              {isNew ? 'Temporary password' : 'Reset with a temporary password (optional)'}
            </label>
            <input
              type="password"
              id="password"
              class="engr-input"
              name="password"
              minlength="12"
              maxlength="128"
              autocomplete="new-password"
            />
            <span class="engr-field__hint">
              Pasting is allowed.{' '}
              {isNew
                ? 'Leave blank to email a single-use invitation, or enter a temporary password that must be replaced at first sign-in.'
                : 'The user must replace a reset password immediately after signing in. Leave blank to keep the current password.'}
            </span>
          </div>
        )}
        {!isNew && u?.mustChangePassword && (
          <p class="engr-field__hint engr-formgrid__full" role="status">
            This user must change their temporary password at the next sign-in.
          </p>
        )}
        {canAssignRoles && (
          <fieldset class="engr-field engr-formgrid__full">
            <legend>Roles</legend>
            <input type="hidden" name="roles_present" value="1" />
            <ul class="engr-checklist">
              {roles.map((role) => (
                <li>
                  <input
                    type="checkbox"
                    id={`role_${role.id}`}
                    name="role_ids"
                    value={role.id}
                    checked={selectedRoleIds.has(role.id)}
                  />
                  <label for={`role_${role.id}`}>{displayLocationTerminology(role.name)}</label>
                </li>
              ))}
            </ul>
          </fieldset>
        )}
        <div class="engr-actionbar engr-formgrid__full">
          <button type="submit" class="engr-btn engr-btn--primary">
            {isNew ? 'Create user' : 'Save changes'}
          </button>
        </div>
      </form>
    )
  }
</EngrLayout>
