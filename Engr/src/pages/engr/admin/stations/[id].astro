---
export const prerender = false;

/**
 * Station create and edit. The path segment is "new" to create, otherwise a
 * station id to edit. Gate: stations.manage. The form posts to the write
 * endpoint, which redirects back to the list on success.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { getStation, type StationDetail } from '@engr/repos/adminStations';
import { listRegionAffiliates, type AffiliateOption } from '@engr/repos/adminRegions';
import { listRegionOptions, listUserOptionsByRole, type Option } from '@engr/repos/adminOptions';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const canManage = can(Astro.locals, 'stations.manage');
const { id } = Astro.params;
const isNew = id === 'new';
const errorCode = Astro.url.searchParams.get('error');

let station: StationDetail | null = null;
let regions: Option[] = [];
let users: Option[] = [];
let affiliates: AffiliateOption[] = [];

if (canManage) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  [regions, users, affiliates] = await Promise.all([
    listRegionOptions(db, engr.orgId),
    listUserOptionsByRole(db, engr.orgId, ['STATION_MANAGER']),
    listRegionAffiliates(db, {
      orgId: engr.orgId, homeOrgId: engr.homeOrgId, userId: engr.userId,
      isPlatformOwner: engr.isPlatformOwner, roles: engr.roles,
    }),
  ]);
  if (!isNew && id) station = await getStation(db, engr.orgId, id);
}
const notFound = !isNew && station === null;
if (canManage && notFound) Astro.response.status = 404;

const s = station;
const selectedAffiliate = s?.affiliateOrgId ?? '';
const currentAffiliateSelectable = affiliates.some((a) => a.id === selectedAffiliate);
const formAffiliates = affiliates;
---

<EngrLayout title={isNew ? 'New location' : 'Edit location'}>
  <div class="engr-page-head">
    <div>
      <h1>{isNew ? 'New location' : 'Edit location'}</h1>
      <p class="engr-lead">A site where work is raised and carried out.</p>
    </div>
    <a href="/admin/stations" class="engr-btn engr-btn--secondary">Back to locations</a>
  </div>

  {
    errorCode === 'conflict' && (
      <p class="engr-error" role="alert">
        The location could not be saved because a code could not be reserved. Try again.
      </p>
    )
  }
  {
    errorCode === 'invalid' && (
      <p class="engr-error" role="alert">
        Check the name, region and status, then try again.
      </p>
    )
  }

  {
    !canManage ? (
      <p class="engr-error" role="alert">
        You do not have permission to manage locations.
      </p>
    ) : notFound ? (
      <p class="engr-error" role="alert">
        That location was not found.
      </p>
    ) : (
      <form method="post" action="/api/admin/stations" class="engr-formgrid engr-formgrid--setup">
        {!isNew && <input type="hidden" name="id" value={s!.id} />}
        <div class="engr-field">
          <label>Location code</label>
          <div class="engr-static-control" role="textbox" aria-label="Location code" aria-readonly="true">
            {isNew ? 'Generated on creation' : s?.code}
          </div>
        </div>
        <div class="engr-field">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            class="engr-input"
            name="name"
            maxlength="120"
            required
            value={s?.name ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="affiliate_org_id">Affiliate</label>
          <select id="affiliate_org_id" class="engr-select" name="affiliate_org_id" required>
            <option value="" disabled selected={!currentAffiliateSelectable}>Select affiliate</option>
            {formAffiliates.map((a) => (
              <option value={a.id} selected={a.id === selectedAffiliate}>{a.name}</option>
            ))}
          </select>
          <p class="engr-field__hint">
            Choose an affiliate under the current tenant. The location's owning tenant does not change.
            {s && !currentAffiliateSelectable && ' This location needs an affiliate assignment.'}
          </p>
        </div>
        <div class="engr-field">
          <label for="region_id">Region</label>
          <select id="region_id" class="engr-select" name="region_id">
            <option value="">Not set</option>
            {regions.map((r) => (
              <option value={r.id} data-affiliate-id={r.affiliateOrgId} selected={s?.regionId === r.id}>
                {r.label}
              </option>
            ))}
          </select>
          <p class="engr-field__hint">Only regions assigned to the selected affiliate are available.</p>
        </div>
        <div class="engr-field">
          <label for="station_manager_id">Location manager</label>
          <select id="station_manager_id" class="engr-select" name="station_manager_id">
            <option value="">Not set</option>
            {users.map((u) => (
              <option value={u.id} selected={s?.stationManagerId === u.id}>
                {u.label}
              </option>
            ))}
          </select>
        </div>
        <div class="engr-field engr-formgrid__full">
          <label for="address">
            Address <span class="engr-field__hint">(optional)</span>
          </label>
          <input
            type="text"
            id="address"
            class="engr-input"
            name="address"
            maxlength="200"
            value={s?.address ?? ''}
          />
        </div>
        <div class="engr-field">
          <label for="status">Status</label>
          <select id="status" class="engr-select" name="status">
            <option value="ACTIVE" selected={(s?.status ?? 'ACTIVE') === 'ACTIVE'}>
              Active
            </option>
            <option value="INACTIVE" selected={s?.status === 'INACTIVE'}>
              Inactive
            </option>
          </select>
        </div>
        <div class="engr-check engr-formgrid__full">
          <input type="checkbox" id="is_base" name="is_base" checked={s?.isBase ?? false} />
          <label for="is_base">Base location (origin for mileage)</label>
        </div>
        <div class="engr-actionbar engr-formgrid__full">
          <button type="submit" class="engr-btn engr-btn--primary">
            {isNew ? 'Create location' : 'Save changes'}
          </button>
        </div>
      </form>
    )
  }
</EngrLayout>

<script>
  // The API performs the authoritative affiliate/region validation. This
  // client filter only keeps the choices relevant on the form.
  document.addEventListener('astro:page-load', () => {
    const affiliate = document.getElementById('affiliate_org_id') as unknown as HTMLSelectElement | null;
    const region = document.getElementById('region_id') as unknown as HTMLSelectElement | null;
    if (!affiliate || !region) return;
    const filter = () => {
      for (const option of Array.from(region.options)) {
        if (!option.value) continue;
        const visible = option.dataset.affiliateId === affiliate.value;
        option.hidden = !visible;
        option.disabled = !visible;
        if (!visible && option.selected) region.value = '';
      }
    };
    affiliate.addEventListener('change', filter);
    filter();
  });
</script>
