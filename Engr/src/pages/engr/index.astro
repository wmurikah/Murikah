---
export const prerender = false;

/**
 * Dashboard. Count cards and analytics charts, each org-scoped and each a launch
 * surface: every card and every chart segment links to its corresponding
 * register or action queue. Primary navigation lives in the sidebar.
 *
 * Gate: the seeded permissions table has no dashboard.view key, so this gates on
 * reports.view ("View reports and dashboards"), the closest existing key, rather
 * than inventing a permission. The target list pages enforce their own access,
 * so a drill link never exposes anything the viewer could not already reach.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import EngrBarChart from '@/components/engr/EngrBarChart.astro';
import EngrDonut from '@/components/engr/EngrDonut.astro';
import EngrPipeline from '@/components/engr/EngrPipeline.astro';
import EngrLine from '@/components/engr/EngrLine.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { getDashboard, type Dashboard } from '@engr/repos/dashboard';
import { getDashboardCharts, type DashboardCharts, type ChartDatum } from '@engr/repos/analytics';
import { can } from '@engr/auth/rbac';
import { formatMoneyMinor } from '@engr/format';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'reports.view');
const canWorkOrders = can(Astro.locals, 'workorder.view');
const canRequests = can(Astro.locals, 'requests.view');
const canPm = can(Astro.locals, 'pm.view');
const canCosts = can(Astro.locals, 'cost.view');
const canBills = can(Astro.locals, 'bill.view');

if (!allowed) {
  if (engr.roles.includes('TECHNICIAN')) return Astro.redirect('/technician/workorders');
  if (engr.roles.includes('CONTRACTOR')) return Astro.redirect('/contractor/workorders');
  if (engr.roles.includes('STATION_MANAGER')) return Astro.redirect('/workorders');
  return Astro.redirect('/notifications');
}

const db = await getDb(getEngrEnv(), Astro.locals);

let data: Dashboard | null = null;
let charts: DashboardCharts | null = null;
if (allowed) {
  [data, charts] = await Promise.all([
    getDashboard(db, engr.orgId),
    getDashboardCharts(db, engr.orgId),
  ]);
}

// Attach a drill-through target to each datum, from its raw key.
const withHref = (rows: ChartDatum[], href: (d: ChartDatum) => string): ChartDatum[] =>
  rows.map((d) => ({ ...d, href: href(d) }));

const woByStatus = charts
  ? withHref(charts.workOrdersByStatus, (d) => `/workorders?status=${d.key}`)
  : [];
const reqByPriority = charts
  ? withHref(charts.requestsByPriority, (d) => `/requests?scope=all&priority=${d.key}`)
  : [];
const costPipeline = charts ? withHref(charts.costPipeline, () => '/costs') : [];
const billPipeline = charts ? withHref(charts.billPipeline, () => '/bills') : [];
const openByStation = charts
  ? withHref(charts.openWorkByStation, (d) => `/workorders?station=${d.key}`)
  : [];
const spendByContractor = charts
  ? charts.spendByContractorMinor.map((d) => ({
      ...d,
      display: formatMoneyMinor(d.value, 'KES'),
      href: `/admin/contractors/${d.key}`,
    }))
  : [];
---

<EngrLayout title="Dashboard">
  <div class="engr-page-head">
    <div>
      <h1>Dashboard</h1>
      <p class="engr-lead">A view of open work across your organisation.</p>
    </div>
    {
      (
        <div class="engr-actionbar">
          {can(Astro.locals, 'reports.export') && (
            <a href="/api/reports/export" class="engr-btn engr-btn--secondary">
              Export work orders
            </a>
          )}
          {can(Astro.locals, 'requests.create') && (
            <a href="/requests/new" class="engr-btn engr-btn--primary">
              Raise a request
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    (can(Astro.locals, 'arrival.confirm') ||
      can(Astro.locals, 'rfq.award') ||
      can(Astro.locals, 'cost.approve')) && (
      <nav class="engr-toggle" aria-label="Queues" style="margin:0 0 1.25rem;flex-wrap:wrap">
        {can(Astro.locals, 'arrival.confirm') && <a href="/station/confirmations">Confirmations</a>}
        {can(Astro.locals, 'rfq.award') && (
          <a href="/procurement/approvals">Procurement approvals</a>
        )}
        {can(Astro.locals, 'cost.approve') && <a href="/mileage/approvals">Mileage approvals</a>}
      </nav>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to the dashboard.
      </p>
    ) : (
      data && (
        <>
          <div class="engr-cards">
            {canWorkOrders && (
              <a class="engr-card" href="/workorders" aria-labelledby="card-wo">
                <h2 class="engr-card__label" id="card-wo">
                  Open work orders
                </h2>
                <p class="engr-card__count">{data.openWorkOrders.count}</p>
                <p class="engr-card__trend">{data.openWorkOrders.recent} new this week</p>
                <p class="engr-card__cue">View all work orders &rarr;</p>
              </a>
            )}

            {can(Astro.locals, 'cost.approve') && (
              <a class="engr-card" href="/costs/approvals" aria-labelledby="card-cost">
                <h2 class="engr-card__label" id="card-cost">
                  Pending cost approvals
                </h2>
                <p class="engr-card__count">{data.pendingCostApprovals.count}</p>
                <p class="engr-card__trend">{data.pendingCostApprovals.recent} new this week</p>
                <p class="engr-card__cue">Go to cost approvals &rarr;</p>
              </a>
            )}

            {(can(Astro.locals, 'bill.approve.engineering') ||
              can(Astro.locals, 'bill.approve.finance')) && (
              <a class="engr-card" href="/bills/approvals" aria-labelledby="card-bill">
                <h2 class="engr-card__label" id="card-bill">
                  Pending bill approvals
                </h2>
                <p class="engr-card__count">{data.pendingBillApprovals.count}</p>
                <p class="engr-card__trend">{data.pendingBillApprovals.recent} new this week</p>
                <p class="engr-card__cue">Go to bill approvals &rarr;</p>
              </a>
            )}

            {canPm && (
              <a class="engr-card" href="/pm/calendar" aria-labelledby="card-pm">
                <h2 class="engr-card__label" id="card-pm">
                  Upcoming maintenance
                </h2>
                <p class="engr-card__count">{data.upcomingPm.count}</p>
                <p class="engr-card__trend">{data.upcomingPm.recent} due this week</p>
                <p class="engr-card__cue">Open the maintenance calendar &rarr;</p>
              </a>
            )}
          </div>

          {charts && (
            <section aria-labelledby="charts-heading" style="margin-top:1.75rem">
              <h2 id="charts-heading">Analytics</h2>
              <div class="engr-charts">
                {canWorkOrders && (
                  <EngrDonut
                    title="Work orders by status"
                    description="Every work order by status. Select a slice to open that list."
                    valueHeading="Work orders"
                    data={woByStatus}
                  />
                )}
                {canRequests && (
                  <EngrDonut
                    title="Requests by priority"
                    description="Every request by priority. Select a slice to open that list."
                    valueHeading="Requests"
                    data={reqByPriority}
                  />
                )}
                {canCosts && (
                  <EngrPipeline
                    title="Cost approval pipeline"
                    description="Work costs waiting at each approval stage."
                    data={costPipeline}
                  />
                )}
                {canBills && (
                  <EngrPipeline
                    title="Bill approval pipeline"
                    description="Bills through the three levels to paid."
                    data={billPipeline}
                  />
                )}
                {canRequests && (
                  <EngrLine
                    title="Requests over time"
                    description="Service requests raised each month, last six months. Select a month to open its list."
                    valueHeading="Requests"
                    data={charts.requestsByMonth}
                  />
                )}
                {canPm && (
                  <EngrLine
                    title="Upcoming maintenance"
                    description="Occurrences due per week for the next eight weeks. Select a week to open its list."
                    valueHeading="Due"
                    data={charts.pmByWeek}
                  />
                )}
                {canCosts && (
                  <EngrBarChart
                    title="Approved cost by contractor"
                    description="Top ten contractors by approved cost value."
                    valueHeading="Approved cost"
                    data={spendByContractor}
                  />
                )}
                {canWorkOrders && (
                  <EngrBarChart
                    title="Open work by location"
                    description="Open work orders at each location, top ten. Select a location to open its list."
                    valueHeading="Open work orders"
                    data={openByStation}
                  />
                )}
              </div>
            </section>
          )}
        </>
      )
    )
  }
</EngrLayout>
