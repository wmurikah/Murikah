---
export const prerender = false;

/** Engineer RFQ list: every RFQ in the org, with invite and quote counts. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import ActionQueueLink from '@/components/engr/ActionQueueLink.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listRfqsForEngineer, type RfqListRow } from '@engr/repos/rfqs';
import { shortDate } from '@engr/format';
import { can } from '@engr/auth/rbac';
import { actorDataScope } from '@engr/auth/dataScope';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'rfq.view');
const canProcure = actorDataScope(engr.roles) === 'org' && can(Astro.locals, 'rfq.award');
let rows: RfqListRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  rows = await listRfqsForEngineer(db, engr.orgId);
}
---

<EngrLayout title="RFQs">
  <div class="engr-page-head">
    <div>
      <h1>RFQs</h1>
      <p class="engr-lead">Requests for quotation and their quotes.</p>
    </div>
    {canProcure && <ActionQueueLink href="/procurement/approvals" label="Procurement approvals" countKeys={['procurementApprovals']} />}
  </div>

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        {canProcure
          ? 'You may review procurement approvals above, but cannot view the full RFQ register.'
          : 'You do not have access to RFQs.'}
      </p>
    ) : rows.length === 0 ? (
      <p class="engr-empty">
        No RFQs yet. Raise one from an accepted request to invite contractors to quote.
      </p>
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table" aria-label="RFQs">
          <thead>
            <tr>
              <th scope="col">RFQ</th>
              <th scope="col" class="engr-col-mid">
                Request
              </th>
              <th scope="col">Station</th>
              <th scope="col" class="engr-col-lo engr-num">
                Due
              </th>
              <th scope="col" class="engr-num">
                Invited
              </th>
              <th scope="col" class="engr-num">
                Quoted
              </th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>
                  <a href={`/rfqs/${r.id}`}>{r.rfqNo}</a>
                </td>
                <td class="engr-col-mid">{r.requestNo}</td>
                <td>{r.stationName}</td>
                <td class="engr-col-lo engr-num">{shortDate(r.dueDate) || 'Not set'}</td>
                <td class="engr-num">{r.invited}</td>
                <td class="engr-num">{r.quoted}</td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</EngrLayout>
