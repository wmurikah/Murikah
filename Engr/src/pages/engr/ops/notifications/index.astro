---
export const prerender = false;

/** Legacy bookmark: the notification delivery ledger now lives in Audit history. */
const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');
if (!engr.perms.includes('audit.view') || !engr.perms.includes('notifications.monitor')) {
  Astro.response.status = 403;
} else {
  return Astro.redirect('/admin/audit?filter=delivery');
}
---
<p role="alert">You do not have permission to review notification delivery records.</p>
