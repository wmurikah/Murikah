---
export const prerender = false;

/**
 * Engineer queue. Lists the org's service requests, defaulting to those assigned
 * to the current engineer, with a filter to show all open requests. Sorted by
 * priority then age. Each row links to the request detail (a stub for now).
 * Gate: requests.view.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listQueue, type QueueRow } from '@engr/repos/requests';
import { can } from '@engr/auth/rbac';
import { relativeAge } from '@engr/format';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'requests.view');
const scope = Astro.url.searchParams.get('scope') === 'all' ? 'all' : 'mine';
const createdNo = Astro.url.searchParams.get('created');
const priority = Astro.url.searchParams.get('priority')?.toUpperCase() || undefined;
const priorityLabel = priority ? priority.charAt(0) + priority.slice(1).toLowerCase() : null;

// A month window, drilled from the "Requests over time" chart: from inclusive,
// to exclusive, both YYYY-MM-DD. A dated view shows every request raised in the
// month, open or closed.
const isDate = (v: string | null): v is string => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const fromRaw = Astro.url.searchParams.get('from');
const toRaw = Astro.url.searchParams.get('to');
const from = isDate(fromRaw) ? fromRaw : undefined;
const to = isDate(toRaw) ? toRaw : undefined;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const periodLabel = from ? `${MONTHS[Number(from.slice(5, 7)) - 1]} ${from.slice(0, 4)}` : null;

let rows: QueueRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv());
  rows = await listQueue(db, engr.orgId, engr.userId, scope, 100, { priority, from, to });
}

const badgeClass = (priority: string) => `engr-badge engr-badge--${priority.toLowerCase()}`;
const now = new Date();
---

<EngrLayout title="Requests">
  <div class="engr-page-head">
    <div>
      <h1>Engineer queue</h1>
      <p class="engr-lead">Service requests awaiting triage and assignment.</p>
    </div>
    <a href="/requests/new" class="engr-btn engr-btn--primary">Raise a request</a>
  </div>

  {
    createdNo && (
      <p class="engr-notice" role="status">
        Request {createdNo} was created.
      </p>
    )
  }

  {
    allowed && (
      <div class="engr-toggle" role="group" aria-label="Filter requests">
        <a href="/requests?scope=mine" aria-current={scope === 'mine' ? 'page' : undefined}>
          Assigned to me
        </a>
        <a href="/requests?scope=all" aria-current={scope === 'all' ? 'page' : undefined}>
          All open
        </a>
      </div>
    )
  }

  {
    priorityLabel && (
      <p class="engr-filterbar">
        <span>Filtered to {priorityLabel} priority</span>
        <a href={`/requests?scope=${scope}`}>Clear filter</a>
      </p>
    )
  }

  {
    periodLabel && (
      <p class="engr-filterbar">
        <span>Requests raised in {periodLabel}</span>
        <a href={`/requests?scope=${scope}`}>Clear period</a>
      </p>
    )
  }

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to requests.
      </p>
    ) : rows.length === 0 ? (
      <p class="engr-empty">
        {periodLabel
          ? `No requests were raised in ${periodLabel}.`
          : priorityLabel
            ? 'No open requests match this filter.'
            : scope === 'mine'
              ? 'No requests are assigned to you.'
              : 'No open requests.'}
      </p>
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table" aria-label="Open service requests, sorted by priority then age">
          <thead>
            <tr>
              <th scope="col">Request</th>
              <th scope="col">Station</th>
              <th scope="col">Issue</th>
              <th scope="col">Priority</th>
              <th scope="col">Status</th>
              <th scope="col">Age</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>
                  <a href={`/requests/${r.id}`}>{r.requestNo}</a>
                </td>
                <td>{r.stationName}</td>
                <td class="engr-wrap">{r.issue}</td>
                <td>
                  <span class={badgeClass(r.priority)}>{r.priority}</span>
                </td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
                <td>{relativeAge(r.createdAt, now)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</EngrLayout>
