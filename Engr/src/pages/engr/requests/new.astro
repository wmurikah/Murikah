---
export const prerender = false;

/**
 * Request intake. A station manager raises a request with the inputs the
 * workflow lists: station, asset or equipment, issue, nature of breakdown, a
 * repeat-call flag, priority, and a photo or video attachment (linked by URL,
 * since object storage is bound in a later prompt). Gate: requests.create.
 * Stations, categories and assets are all scoped to the organisation.
 */
import EngrLayout from '@/layouts/EngrLayout.astro';
import EmptyState from '@/components/engr/EmptyState.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import {
  listStations,
  listAssetCategories,
  listAssetOptions,
  PRIORITIES,
  type StationOption,
  type CategoryOption,
  type AssetOption,
} from '@engr/repos/requests';
import { can } from '@engr/auth/rbac';
import { actorDataScope } from '@engr/auth/dataScope';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'requests.create');

const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
  errorCode === 'validation'
    ? 'Check the required fields, then submit again.'
    : errorCode === 'station'
      ? 'Choose a station that belongs to your organisation.'
      : errorCode === 'attachment'
        ? 'Use an approved HTTPS file link, or leave the attachment blank.'
        : errorCode
          ? 'The request could not be created. Please try again.'
          : null;

let stations: StationOption[] = [];
let categories: CategoryOption[] = [];
let assets: AssetOption[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  const stationManagerId = actorDataScope(engr.roles) === 'station' ? engr.userId : undefined;
  [stations, categories, assets] = await Promise.all([
    listStations(db, engr.orgId, stationManagerId),
    listAssetCategories(db, engr.orgId),
    listAssetOptions(db, engr.orgId, stationManagerId),
  ]);
}
---

<EngrLayout title="Raise a request">
  <div class="engr-page-head">
    <div>
      <h1>Raise a request</h1>
      <p class="engr-lead">Report a breakdown or a service need at a location.</p>
    </div>
  </div>

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have permission to raise requests.
      </p>
    ) : locations.length === 0 ? (
      <EmptyState
        message="No locations are set up yet. A request is raised against a location."
        canAct={can(Astro.locals, 'stations.manage')}
        actionHref="/admin/stations/new"
        actionLabel="Add a location"
        hint="Ask an administrator to add a location before raising a request."
      />
    ) : (
      <>
        {errorMessage && (
          <p class="engr-error" role="alert">
            {errorMessage}
          </p>
        )}
        <form method="post" action="/api/requests" class="engr-form" enctype="multipart/form-data">
          <div class="engr-field">
            <label for="station">Location</label>
            <select id="station" class="engr-select" name="station_id" required>
              <option value="">Choose a location</option>
              {stations.map((s) => (
                <option value={s.id}>
                  {s.name} ({s.code})
                </option>
              ))}
            </select>
          </div>

          <div class="engr-field">
            <label for="category">
              Asset category <span class="engr-field__hint">(optional)</span>
            </label>
            <select id="category" class="engr-select" name="category_id">
              <option value="">Not specified</option>
              {categories.map((c) => (
                <option value={c.id}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="engr-field">
            <label for="asset">
              Asset or equipment <span class="engr-field__hint">(optional)</span>
            </label>
            <select id="asset" class="engr-select" name="asset_id">
              <option value="">Not specified</option>
              {assets.map((a) => (
                <option value={a.id} data-station-id={a.stationId}>{a.label}</option>
              ))}
            </select>
            <p class="engr-field__hint">Choose the specific asset at the location, if known.</p>
          </div>

          <div class="engr-field">
            <label for="issue">Issue</label>
            <input id="issue" class="engr-input" name="issue" required maxlength="200" />
          </div>

          <div class="engr-field">
            <label for="nature">
              Nature of breakdown <span class="engr-field__hint">(optional)</span>
            </label>
            <textarea
              id="nature"
              class="engr-textarea"
              name="nature_of_breakdown"
              maxlength="1000"
            />
          </div>

          <div class="engr-field">
            <label for="priority">Priority</label>
            <select id="priority" class="engr-select" name="priority">
              {PRIORITIES.map((p) => (
                <option value={p} selected={p === 'MEDIUM'}>
                  {p}
                </option>
              ))}
            </select>
          </div>

          <div class="engr-field engr-check">
            <input id="repeat" type="checkbox" name="is_repeat_call" value="1" />
            <label for="repeat">This is a repeat call for the same issue</label>
          </div>

          <div class="engr-field">
            <label for="attachment_url">
              Photo or video link <span class="engr-field__hint">(optional)</span>
            </label>
            <input
              id="attachment_url"
              class="engr-input"
              name="attachment_url"
              type="url"
              maxlength="500"
              placeholder="https://"
            />
            <p class="engr-field__hint">
              Paste an approved HTTPS file link. Ask your administrator which file hosts are
              allowed.
            </p>
          </div>

          <div class="engr-field">
            <label for="attachment_kind">Attachment type</label>
            <select id="attachment_kind" class="engr-select" name="attachment_kind">
              <option value="PHOTO">Photo</option>
              <option value="VIDEO">Video</option>
              <option value="DOCUMENT">Document</option>
            </select>
          </div>

          <div class="engr-actions">
            <button type="submit" class="engr-btn engr-btn--primary">
              Submit request
            </button>
            <a href="/requests" class="engr-btn engr-btn--secondary">
              Cancel
            </a>
          </div>
        </form>
      </>
    )
  }
</EngrLayout>

<script>
  // Keep the visible asset list consistent with the selected station.
  // The API independently validates the relationship against the database.
  document.addEventListener('astro:page-load', () => {
    // Cloudflare's DOM typings are not compatible with the querySelector<T>
    // Element constraint here. Use a checked lookup and a narrow DOM assertion.
    const station = document.getElementById('station') as unknown as HTMLSelectElement | null;
    const asset = document.getElementById('asset') as unknown as HTMLSelectElement | null;
    if (!station || !asset) return;
    const filter = () => {
      for (const option of Array.from(asset.options)) {
        if (!option.value) continue;
        const matches = !!station.value && option.dataset.stationId === station.value;
        option.disabled = !matches;
        option.hidden = !matches;
        if (option.selected && !matches) asset.value = '';
      }
    };
    station.addEventListener('change', filter);
    filter();
  });
</script>


