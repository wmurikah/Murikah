---
export const prerender = false;

/** PM schedules list. Viewing and each mutating action have separate gates. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { listSchedules, type ScheduleListRow } from '@engr/repos/pm';
import { shortDate } from '@engr/format';
import { can } from '@engr/auth/rbac';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'pm.view');
const canCreate = can(Astro.locals, 'pm.create');
const canActivate = can(Astro.locals, 'pm.activate');
const canArchive = can(Astro.locals, 'pm.archive');
let rows: ScheduleListRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  rows = await listSchedules(db, engr.orgId);
}
---

<EngrLayout title="Preventive maintenance">
  <div class="engr-page-head">
    <div>
      <h1>Preventive maintenance</h1>
      <p class="engr-lead">Schedules and their next due dates.</p>
    </div>
    <div class="engr-actionbar">
      <a href="/pm/calendar" class="engr-btn engr-btn--secondary">Calendar</a>
      {
        canCreate && (
          <a href="/pm/schedules/new" class="engr-btn engr-btn--primary">
            New schedule
          </a>
        )
      }
    </div>
  </div>

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        You do not have access to preventive maintenance.
      </p>
    ) : rows.length === 0 ? (
      <p class="engr-empty">No schedules yet. Create one to plan recurring maintenance.</p>
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table" aria-label="PM schedules">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Location</th>
              <th scope="col" class="engr-col-lo">
                Contractor
              </th>
              <th scope="col" class="engr-col-mid">
                Frequency
              </th>
              <th scope="col" class="engr-num">
                Next due
              </th>
              <th scope="col" class="engr-col-lo">
                Automated
              </th>
              <th scope="col">Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>
                  <a href={`/pm/schedules/${r.id}`}>{r.name}</a>
                </td>
                <td>{r.stationName ?? 'Any'}</td>
                <td class="engr-col-lo">{r.contractorName ?? 'Any'}</td>
                <td class="engr-col-mid">{r.frequency}</td>
                <td class="engr-num">{shortDate(r.nextDueDate) || 'Not set'}</td>
                <td class="engr-col-lo">{r.isAutomated ? 'Yes' : 'No'}</td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
                <td>
                  {(canActivate || canArchive) && (
                    <form
                      method="post"
                      action={`/api/pm/schedules/${r.id}`}
                      class="engr-actionbar"
                      style="gap:0.4rem"
                    >
                      {canActivate && r.status === 'ACTIVE' ? (
                        <button
                          type="submit"
                          name="action"
                          value="pause"
                          class="engr-btn engr-btn--ghost"
                        >
                          Pause
                        </button>
                      ) : canActivate && r.status === 'PAUSED' ? (
                        <button
                          type="submit"
                          name="action"
                          value="resume"
                          class="engr-btn engr-btn--ghost"
                        >
                          Resume
                        </button>
                      ) : null}
                      {canArchive && r.status !== 'ARCHIVED' && (
                        <button
                          type="submit"
                          name="action"
                          value="archive"
                          class="engr-btn engr-btn--ghost"
                        >
                          Archive
                        </button>
                      )}
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</EngrLayout>
