---
export const prerender = false;

import EngrAuthLayout from '@/layouts/EngrAuthLayout.astro';

const error = Astro.url.searchParams.get('error');
const messages: Record<string, string> = {
  current: 'The current or temporary password is incorrect.',
  mismatch: 'The new passwords do not match.',
  policy: 'Use a new password between 12 and 128 characters.',
  same: 'Choose a password different from the temporary or current password.',
  expired: 'Your password-change session expired. Sign in again.',
};
const errorMessage = error ? messages[error] : null;
---

<EngrAuthLayout title="Change password">
  <div class="engr-authcard__head">
    <h1 class="engr-authcard__title">Create your password</h1>
    <p class="engr-authcard__sub">
      Replace the temporary password before continuing to Engineering Rhythm.
    </p>
  </div>

  {
    errorMessage && (
      <p class="engr-error" role="alert">
        {errorMessage}
      </p>
    )
  }

  <form method="post" action="/api/auth/change-password" class="engr-authform">
    <div class="engr-field">
      <label for="current_password">Temporary or current password</label>
      <input
        id="current_password"
        class="engr-input"
        name="current_password"
        type="password"
        required
        maxlength="128"
        autocomplete="current-password"
        autofocus
      />
    </div>
    <div class="engr-field">
      <label for="new_password">New password</label>
      <input
        id="new_password"
        class="engr-input"
        name="new_password"
        type="password"
        required
        minlength="12"
        maxlength="128"
        autocomplete="new-password"
        aria-describedby="password-help"
      />
      <span id="password-help" class="engr-field__hint">
        Use at least 12 characters. Pasting and password managers are supported.
      </span>
    </div>
    <div class="engr-field">
      <label for="confirm_password">Confirm new password</label>
      <input
        id="confirm_password"
        class="engr-input"
        name="confirm_password"
        type="password"
        required
        minlength="12"
        maxlength="128"
        autocomplete="new-password"
      />
    </div>
    <button type="submit" class="engr-btn engr-btn--primary engr-authform__submit">
      Change password and continue
    </button>
  </form>

  <form method="post" action="/api/auth/logout" class="engr-authmeta">
    <button type="submit" class="engr-authmeta__link engr-authmeta__link--muted"> Sign out </button>
  </form>
</EngrAuthLayout>
