---
export const prerender = false;

/** Read-only organisation register. Contractor accounts use their own scoped portal. */
import EngrLayout from '@/layouts/EngrLayout.astro';
import ActionQueueLink from '@/components/engr/ActionQueueLink.astro';
import { getEngrEnv } from '@engr/env';
import { getDb } from '@engr/db';
import { can } from '@engr/auth/rbac';
import { actorDataScope } from '@engr/auth/dataScope';
import { listCostsForOrganisation, type CostListRow } from '@engr/repos/workCosts';
import { formatMoneyMinor } from '@engr/format';

const engr = Astro.locals.engr;
if (!engr) return Astro.redirect('/login');

const allowed = can(Astro.locals, 'cost.view') && actorDataScope(engr.roles) === 'org';
const canApprove = can(Astro.locals, 'cost.approve') && actorDataScope(engr.roles) === 'org';
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page =
  Number.isSafeInteger(requestedPage) && requestedPage >= 1 && requestedPage <= 10000
    ? requestedPage
    : 1;
const pageSize = 50;
let rows: CostListRow[] = [];
if (allowed) {
  const db = await getDb(getEngrEnv(), Astro.locals);
  rows = await listCostsForOrganisation(db, engr.orgId, (page - 1) * pageSize, pageSize);
}
const hasNext = rows.length > pageSize;
const visibleRows = rows.slice(0, pageSize);
---

<EngrLayout title="Work costs">
  <div class="engr-page-head">
    <div>
      <h1>Work costs</h1>
      <p class="engr-lead">
        Costs across your organisation, including submitted and completed records.
      </p>
    </div>
    {canApprove && (
      <div class="engr-actionbar">
        <ActionQueueLink href="/mileage/approvals" label="Mileage approvals" countKeys={['mileageApprovals']} />
        <ActionQueueLink href="/costs/approvals" label="Cost approvals" countKeys={['costApprovals']} />
      </div>
    )}
  </div>

  {
    !allowed ? (
      <p class="engr-error" role="alert">
        {canApprove
          ? 'You may review mileage and cost approvals above, but cannot view the full cost register.'
          : 'You do not have access to the work cost register.'}
      </p>
    ) : visibleRows.length === 0 ? (
      <p class="engr-empty">No costs found on this page.</p>
    ) : (
      <div class="engr-tablewrap">
        <table class="engr-table" aria-label="Organisation work costs">
          <thead>
            <tr>
              <th scope="col">Work order</th>
              <th scope="col">Contractor</th>
              <th scope="col">Created</th>
              <th scope="col">Total</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {visibleRows.map((r) => (
              <tr>
                <td>
                  <a href={`/costs/${r.id}`}>{r.workOrderNo}</a>
                </td>
                <td>{r.contractorName}</td>
                <td>{r.createdAt.slice(0, 10)}</td>
                <td>{formatMoneyMinor(r.totalMinor, r.currency)}</td>
                <td>
                  <span class="engr-status">{r.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    allowed && (page > 1 || hasNext) && (
      <nav class="engr-actionbar" aria-label="Cost register pages">
        {page > 1 && <a href={page === 2 ? '/costs' : `/costs?page=${page - 1}`}>Previous page</a>}
        <span>Page {page}</span>
        {hasNext && <a href={`/costs?page=${page + 1}`}>Next page</a>}
      </nav>
    )
  }
</EngrLayout>
