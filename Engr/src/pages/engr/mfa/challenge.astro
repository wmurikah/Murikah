---
export const prerender = false;
import EngrAuthLayout from '@/layouts/EngrAuthLayout.astro';
Astro.response.headers.set('Cache-Control', 'no-store');
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? '/';
---

<EngrAuthLayout title="Authenticator verification">
  <div class="engr-authcard__head">
    <h1 class="engr-authcard__title">Verify it is you</h1>
    <p class="engr-authcard__sub">Enter your authenticator code or a recovery code.</p>
  </div>
  {
    error === 'code' && (
      <p class="engr-error" role="alert">
        That code is invalid or has already been used.
      </p>
    )
  }
  {
    error === 'locked' && (
      <p class="engr-error" role="alert">
        Too many attempts. Try again in ten minutes.
      </p>
    )
  }
  <form method="post" action="/api/auth/mfa/challenge" class="engr-authform">
    <input type="hidden" name="next" value={next} />
    <div class="engr-field">
      <label for="code">Authenticator or recovery code</label>
      <input
        id="code"
        class="engr-input"
        name="code"
        required
        maxlength="20"
        autocomplete="one-time-code"
        autocapitalize="characters"
        autofocus
      />
    </div>
    <button class="engr-btn engr-btn--primary engr-authform__submit" type="submit">Verify</button>
  </form>
  <form method="post" action="/api/auth/logout" class="engr-authmeta">
    <button type="submit" class="engr-authmeta__link engr-authmeta__link--muted">Sign out</button>
  </form>
</EngrAuthLayout>
