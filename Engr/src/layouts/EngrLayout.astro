---
/**
 * Document shell for the Engineering Rhythm product (engr.murikah.com). Reuses
 * the marketing design tokens (via global.css) and the self-hosted Inter, with
 * product rules in engr.css. Semantic landmarks and a skip link throughout for
 * assistive tech. The product is marked noindex; it is an authenticated app.
 *
 * When signed in, a persistent left sidebar groups the destinations (Overview,
 * Operations, Procurement, Finance, Service Setup, Administration) into collapsible sections, each with a category
 * icon and user-specific pending-work counts. Only
 * items the user holds a permission for are rendered, so a contractor sees a
 * much shorter menu than an owner. All groups start closed and open when their
 * heading is selected; the active group is marked without forcing it open. On
 * narrow screens the sidebar is a drawer. Native details work without JavaScript.
 *
 * Navigation uses Astro view transitions with a top progress bar, so a click
 * gives feedback within a frame and never freezes. A single-signal guard
 * disables any mutating control on first submit, so repeated clicks send one
 * request (the server also guards every transition with optimistic concurrency).
 */
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import '@/styles/engr.css';
import { ClientRouter } from 'astro:transitions';
import EngrIcon from '@/components/engr/EngrIcon.astro';
import { orgDisplayName } from '@engr/format';
import { actorDataScope } from '@engr/auth/dataScope';
import type { PendingNavKey } from '@engr/repos/navigationPending';

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title}, Engineering Rhythm`;
const engr = Astro.locals.engr;

// The visitor-facing root-relative path, set by the worker before it rewrites to
// the internal /engr route. Astro.url shows the rewritten path, so the active-nav
// check must read this. Falls back to the URL off the subdomain.
const path = Astro.locals.engrPath ?? Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');

const has = (key: string) => engr?.perms.includes(key) ?? false;
const roles = engr?.roles ?? [];
const dataScope = actorDataScope(roles);
const isContractor = dataScope === 'contractor';
const isTechnician = dataScope === 'technician';

const orgName = engr ? orgDisplayName(engr.orgName, engr.orgSlug) : 'Engineering Rhythm';
const accountName = engr?.userName ?? engr?.userEmail ?? 'Account';
const accountEmail = engr?.userEmail ?? '';

// The acting organisation and, for a platform owner, the set to switch between.
const isPlatformOwner = engr?.isPlatformOwner ?? false;
const switchable = engr?.switchable ?? [];
const actingId = engr?.orgId ?? '';
const showSwitcher = isPlatformOwner && switchable.length > 1;

// Sidebar work counts load after the first paint rather than delaying every page.

// Role-aware destinations: staff land on the shared queues, a contractor or
// technician on their own portal.
const workOrdersHref = has('workorder.create')
  ? '/workorders'
  : isTechnician
    ? '/technician/workorders'
    : isContractor
      ? '/contractor/workorders'
      : has('workorder.view') || has('arrival.confirm') || has('jobcard.confirm')
        ? '/workorders'
        : null;
const rfqHref = has('rfq.view') || (dataScope === 'org' && has('rfq.award'))
  ? '/rfqs'
  : has('quotes.view') ? '/contractor/rfqs' : null;
const lpoHref = has('lpo.create')
  ? '/lpos'
  : isContractor && has('lpo.view')
    ? '/contractor/lpos'
    : has('lpo.view')
      ? '/lpos'
      : null;
const costsHref =
  (has('cost.view') || (dataScope === 'org' && has('cost.approve'))) && (dataScope === 'org' || isContractor)
    ? isContractor
      ? '/contractor/costs'
      : '/costs'
    : null;
const billsHref =
  (has('bill.view') || (dataScope === 'org' && (has('bill.approve.engineering') || has('bill.approve.finance')))) && (dataScope === 'org' || isContractor)
    ? isContractor
      ? '/contractor/bills'
      : '/bills'
    : null;

interface NavItem {
  href: string;
  label: string;
  icon: string;
  match?: string[];
  badgeKey?: PendingNavKey;
  extraBadgeKeys?: PendingNavKey[];
}
interface NavGroup {
  label: string;
  icon: string;
  items: NavItem[];
}

// Contextual typing avoids the Astro 7 / TypeScript 6 predicate error from PR #445.
const visibleNavItems = (items: Array<NavItem | null>): NavItem[] =>
  items.filter((item): item is NavItem => item !== null);

const rawGroups: NavGroup[] = [
  {
    label: 'Overview',
    icon: 'overview',
    items: visibleNavItems([
      has('reports.view')
        ? { href: '/', label: 'Dashboard', icon: 'dashboard', match: ['/'] }
        : null,
      has('reports.view')
        ? { href: '/reports', label: 'Report centre', icon: 'dashboard' }
        : null,
    ]),
  },
  {
    label: 'Operations',
    icon: 'operations',
    items: visibleNavItems([
      has('requests.view')
        ? { href: '/requests', label: 'Requests', icon: 'requests', badgeKey: 'requests' }
        : null,
      workOrdersHref
        ? {
            href: workOrdersHref,
            label: 'Work orders',
            icon: 'workorders',
            match: ['/workorders', workOrdersHref, '/station/confirmations'],
            badgeKey: 'workorders',
            extraBadgeKeys: ['stationConfirmations'],
          }
        : null,
      has('pm.view')
        ? { href: '/pm', label: 'Maintenance', icon: 'maintenance', badgeKey: 'maintenance' }
        : null,
      has('assets.view') || has('assets.transfer.request') || has('assets.transfer.approve') ||
      has('assets.transfer.dispatch') || has('assets.transfer.receive')
        ? { href: '/admin/assets', label: 'Assets', icon: 'assets', badgeKey: 'assetTransfers' }
        : null,
    ]),
  },
  {
    label: 'Procurement',
    icon: 'rfqs',
    items: visibleNavItems([
      rfqHref
        ? {
            href: rfqHref,
            label: 'RFQs',
            icon: 'rfqs',
            match: ['/rfqs', '/contractor/rfqs', '/procurement/approvals'],
            badgeKey: 'rfqs',
            extraBadgeKeys: ['procurementApprovals'],
          }
        : null,
      lpoHref
        ? { href: lpoHref, label: 'LPOs', icon: 'lpos', match: ['/lpos', '/contractor/lpos'], badgeKey: 'lpos' }
        : null,
      has('contractors.view')
        ? { href: '/admin/contractors', label: 'Contractors', icon: 'contractors' }
        : null,
      has('rates.view')
        ? { href: '/admin/rate-cards', label: 'Rate cards', icon: 'rates' }
        : null,
    ]),
  },
  {
    label: 'Finance',
    icon: 'finance',
    items: visibleNavItems([
      costsHref
        ? {
            href: costsHref,
            label: 'Costs',
            icon: 'costs',
            match: ['/costs', '/contractor/costs', '/costs/approvals', '/mileage/approvals'],
            badgeKey: 'costs',
            extraBadgeKeys: ['mileageApprovals', 'costApprovals'],
          }
        : null,
      billsHref
        ? {
            href: billsHref,
            label: 'Bills',
            icon: 'bills',
            match: ['/bills', '/contractor/bills', '/bills/approvals'],
            badgeKey: 'bills',
            extraBadgeKeys: ['billApprovals'],
          }
        : null,
      has('bill.view')
        ? { href: '/invoices', label: 'Invoices', icon: 'bills' }
        : null,
      has('payment.view') || has('payment.record')
        ? { href: '/payments', label: 'Payments', icon: 'payments', badgeKey: 'payments' }
        : null,
    ]),
  },
  {
    label: 'Service Setup',
    icon: 'setup',
    items: visibleNavItems([
      has('stations.view')
        ? { href: '/admin/stations', label: 'Stations', icon: 'stations' }
        : null,
      // Region setup shares the existing station permission.
      has('stations.view')
        ? { href: '/admin/regions', label: 'Regions', icon: 'regions' }
        : null,
      has('technicians.view')
        ? { href: '/admin/technicians', label: 'Technicians', icon: 'technicians' }
        : null,
      has('engineer_assignments.view')
        ? { href: '/admin/engineers', label: 'Engineers in charge', icon: 'engineers' }
        : null,
      has('slas.view')
        ? { href: '/admin/slas', label: 'SLAs', icon: 'slas' }
        : null,
    ]),
  },
  {
    label: 'Administration',
    icon: 'settings',
    items: visibleNavItems([
      isPlatformOwner && has('org.manage')
        ? { href: '/admin/affiliates', label: 'Affiliates', icon: 'affiliates' }
        : null,
      has('users.view')
        ? { href: '/admin/users', label: 'Users', icon: 'users' }
        : null,
      has('roles.view') || has('roles.manage')
        ? { href: '/admin/roles', label: 'Roles', icon: 'roles' }
        : null,
      has('notifications.configure')
        ? { href: '/admin/notifications', label: 'Notification settings', icon: 'bell' }
        : null,
      isPlatformOwner
        ? { href: '/admin/security', label: 'Security settings', icon: 'roles' }
        : null,
      has('audit.view')
        ? { href: '/admin/audit', label: 'Audit history', icon: 'roles' }
        : null,
    ]),
  },
];
const groups = rawGroups.filter((g) => g.items.length > 0);
const activeItem = (item: NavItem) =>
  (item.match ?? [item.href]).some((m) => (m === '/' ? path === '/' : isActive(m)));
const groupActive = (group: NavGroup) => group.items.some(activeItem);
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
  </head>
  <body class="engr">
    <div class="engr-toploader" data-toploader aria-hidden="true"></div>
    <a href="#engr-main" class="engr-skip">Skip to content</a>
    {
      engr ? (
        <div class="engr-shell">
          <div class="engr-appbar">
            <button
              type="button"
              class="engr-appbar__menu"
              data-navtoggle
              aria-controls="engr-sidebar"
              aria-expanded="false"
            >
              <span class="engr-appbar__bars" aria-hidden="true" />
              Menu
            </button>
            <a href="/" class="engr-appbar__org">
              {orgName}
            </a>
          </div>

          <div class="engr-navscrim" data-navscrim hidden />

          <aside id="engr-sidebar" class="engr-sidebar" aria-label="Primary">
            <div class="engr-orghead">
              <div class="engr-orghead__row">
                <a href="/" class="engr-orgid">
                  <span class="engr-orgid__mark" aria-hidden="true">
                    ER
                  </span>
                  <span class="engr-orgid__text">
                    <span class="engr-orgid__name">{orgName}</span>
                  </span>
                </a>
              </div>

              {showSwitcher && (
                <form method="post" action="/api/org/switch" class="engr-switcher">
                  <label for="engr-actingorg" class="engr-switcher__label">
                    Acting organisation
                  </label>
                  <div class="engr-switcher__row">
                    <select id="engr-actingorg" name="org_id" class="engr-switcher__select">
                      {switchable.map((o) => (
                        <option value={o.id} selected={o.id === actingId}>
                          {o.name}
                        </option>
                      ))}
                    </select>
                    <button type="submit" class="engr-btn engr-btn--secondary engr-switcher__go">
                      Switch
                    </button>
                  </div>
                </form>
              )}
            </div>

            <nav class="engr-sidenav" aria-label="Sections">
              {groups.map((group) => (
                <details
                  class="engr-navgroup"
                  data-nav-group
                  data-nav-group-label={group.label}
                  name="engr-nav"
                  data-active={groupActive(group) ? 'yes' : undefined}
                >
                  <summary class="engr-navgroup__summary">
                    <EngrIcon name={group.icon} class="engr-navgroup__icon" size={16} />
                    <span class="engr-navgroup__label">{group.label}</span>
                    <span class="engr-navcount" data-nav-group-count hidden aria-hidden="true" />
                    <span class="engr-navgroup__chevron" aria-hidden="true" />
                  </summary>
                  <ul class="engr-navgroup__list">
                    {group.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class="engr-navlink"
                          data-nav-label={item.label}
                          aria-current={activeItem(item) ? 'page' : undefined}
                        >
                          <EngrIcon name={item.icon} class="engr-navlink__icon" size={16} />
                          <span class="engr-navlink__label">{item.label}</span>
                          {item.badgeKey && (
                            <span class="engr-navcount" data-nav-key={item.badgeKey} data-nav-extra-keys={item.extraBadgeKeys?.join(',')} data-nav-count hidden aria-hidden="true" />
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </nav>

            <div class="engr-account">
              <div class="engr-account__id">
                <span class="engr-account__name">{accountName}</span>
                {accountEmail && <span class="engr-account__email">{accountEmail}</span>}
              </div>
              <a href="/mfa/enroll" class="engr-btn engr-btn--ghost engr-account__signout">
                Security
              </a>
              <form method="post" action="/api/auth/logout">
                <button type="submit" class="engr-btn engr-btn--ghost engr-account__signout">
                  Sign out
                </button>
              </form>
            </div>
          </aside>

          <main id="engr-main" class="engr-main">
            <slot />
          </main>
        </div>
      ) : (
        <main id="engr-main" class="engr-main engr-main--plain">
          <slot />
        </main>
      )
    }

    <script>
      // The chevron glyph is decorative; the group icon carries meaning. Rotate
      // it with CSS via the [open] state (see engr.css). The group icon reuses
      // the icon set, so no extra markup is needed here.

      // ---- Top progress bar for view-transition navigations -------------------
      const loader = () => document.querySelector<HTMLElement>('[data-toploader]');
      document.addEventListener('astro:before-preparation', () => {
        const el = loader();
        if (el) {
          el.classList.remove('is-done');
          el.classList.add('is-active');
        }
      });
      document.addEventListener('astro:after-preparation', () => {
        const el = loader();
        if (el) el.classList.add('is-loaded');
      });
      const finishLoader = () => {
        const el = loader();
        if (el) {
          el.classList.remove('is-active', 'is-loaded');
          el.classList.add('is-done');
        }
      };
      document.addEventListener('astro:page-load', finishLoader);

      // Escape closes the mobile drawer (attached once, acts on the live shell).
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const shell = document.querySelector('.engr-shell');
        if (shell?.classList.contains('is-open')) {
          shell.classList.remove('is-open');
          shell.querySelector('[data-navtoggle]')?.setAttribute('aria-expanded', 'false');
          shell.querySelector('[data-navscrim]')?.setAttribute('hidden', '');
        }
      });

      // ---- Single-signal guard: one request per mutating control --------------
      // On the first submit of a form, mark its submit button busy and block
      // further submits until navigation replaces the page. The button keeps its
      // value in the request (we mark it after the submit has been dispatched).
      const submitting = new WeakSet<HTMLFormElement>();
      document.addEventListener(
        'submit',
        (e) => {
          const form = e.target as HTMLFormElement;
          if (!(form instanceof HTMLFormElement)) return;
          if (submitting.has(form)) {
            e.preventDefault();
            return;
          }
          submitting.add(form);
          const submitter = (e as SubmitEvent).submitter as HTMLElement | null;
          const btn =
            submitter && submitter.tagName === 'BUTTON'
              ? (submitter as HTMLButtonElement)
              : form.querySelector<HTMLButtonElement>('button[type="submit"], button:not([type])');
          if (btn) {
            // Defer so the submitter's name/value is still serialised.
            setTimeout(() => {
              btn.setAttribute('aria-busy', 'true');
              btn.setAttribute('disabled', '');
            }, 0);
          }
        },
        true,
      );

      // ---- Sidebar drawer + user-specific pending work -----------------------
      let pendingTimer: number | undefined;
      let pendingRefreshing = false;
      let pendingRequest: AbortController | undefined;
      function enhance() {
        const shell = document.querySelector('.engr-shell');
        if (!shell) return;
        shell.classList.add('is-enhanced');
        const btn = shell.querySelector<HTMLButtonElement>('[data-navtoggle]');
        const scrim = shell.querySelector<HTMLElement>('[data-navscrim]');
        const close = () => {
          shell.classList.remove('is-open');
          btn?.setAttribute('aria-expanded', 'false');
          scrim?.setAttribute('hidden', '');
        };
        const open = () => {
          shell.classList.add('is-open');
          btn?.setAttribute('aria-expanded', 'true');
          scrim?.removeAttribute('hidden');
        };
        btn?.addEventListener('click', () =>
          shell.classList.contains('is-open') ? close() : open(),
        );
        scrim?.addEventListener('click', close);
        shell.querySelectorAll('.engr-navlink').forEach((a) => a.addEventListener('click', close));
      }

      const badgeText = (n: number) => (n > 99 ? '99+' : String(n));
      async function refreshPending() {
        if (document.hidden || pendingRefreshing) return;
        const shell = document.querySelector('.engr-shell');
        if (!shell) return;
        pendingRefreshing = true;
        const controller = new AbortController();
        pendingRequest = controller;
        try {
          const response = await fetch('/api/navigation/pending', {
            headers: { accept: 'application/json' },
            cache: 'no-store',
            signal: controller.signal,
          });
          if (!response.ok || shell !== document.querySelector('.engr-shell')) return;
          const body = (await response.json()) as { counts?: Record<string, number> };
          if (shell !== document.querySelector('.engr-shell')) return;
          const counts = body.counts ?? {};
          shell.querySelectorAll<HTMLElement>('[data-nav-key]').forEach((badge) => {
            const keys = [
              badge.dataset.navKey ?? '',
              ...(badge.dataset.navExtraKeys?.split(',') ?? []),
            ].filter(Boolean);
            const n = keys.reduce((sum, key) => {
              const raw = Number(counts[key] ?? 0);
              return sum + (Number.isSafeInteger(raw) && raw > 0 ? raw : 0);
            }, 0);
            badge.dataset.navValue = String(n);
            badge.textContent = badgeText(n);
            badge.title = n ? n + ' pending' : '';
            badge.toggleAttribute('hidden', n === 0);
            const link = badge.closest<HTMLAnchorElement>('[data-nav-label]');
            if (link) {
              const label = link.dataset.navLabel ?? '';
              link.setAttribute('aria-label', n ? label + ', ' + n + ' pending' : label);
            }
          });
          shell.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
            let total = 0;
            group.querySelectorAll<HTMLElement>('[data-nav-key]').forEach((badge) => {
              total += Number(badge.dataset.navValue ?? 0);
            });
            const badge = group.querySelector<HTMLElement>('[data-nav-group-count]');
            if (!badge) return;
            badge.textContent = badgeText(total);
            badge.title = total ? total + ' pending in section' : '';
            badge.toggleAttribute('hidden', total === 0);
            const heading = group.querySelector<HTMLElement>('.engr-navgroup__summary');
            const label = group.dataset.navGroupLabel ?? 'Section';
            heading?.setAttribute('aria-label', total ? label + ', ' + total + ' pending' : label);
          });
          // Let in-page actions reuse this one authorised fetch rather than make a second request.
          document.dispatchEvent(new CustomEvent('engr:pending-counts', { detail: counts }));
        } catch {
          // A transient failure leaves the last known counts intact.
        } finally {
          if (pendingRequest === controller) {
            pendingRequest = undefined;
            pendingRefreshing = false;
          }
        }
      }

      document.addEventListener('astro:before-swap', () => {
        pendingRequest?.abort();
        pendingRequest = undefined;
        pendingRefreshing = false;
      });
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) void refreshPending();
      });
      document.addEventListener('astro:page-load', () => {
        enhance();
        void refreshPending();
        if (pendingTimer) window.clearInterval(pendingTimer);
        pendingTimer = window.setInterval(refreshPending, 60000);
      });

    </script>
  </body>
</html>
