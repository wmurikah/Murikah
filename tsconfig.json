{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engr/*": ["src/lib/engr/*"],
      "@grc/*": ["src/lib/grc/*"],
      "@cms/*": ["src/lib/cms/*"],
      "@shared/*": ["src/lib/shared/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".wrangler", "eslint.config.js"]
}
