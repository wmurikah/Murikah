{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@engr/*": ["src/lib/engr/*"],
      "@grc/*": ["src/lib/grc/*"],
      "@shared/*": ["src/lib/shared/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  // Tutor has its own package.json, dependencies and Wrangler deployment.
  // Do not type-check its Workers against the main Astro app dependency tree.
  "exclude": ["dist", ".wrangler", "eslint.config.js", "tutor/**"]
}
