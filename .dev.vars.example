# Local Worker variables/secrets. Copy to `.dev.vars` (gitignored) for local dev.
# `astro dev` reads these via the adapter's platformProxy; `wrangler dev` reads them natively.
# In production these are set as Cloudflare secrets (see README), NOT committed.

# --- Turso (libSQL), required for contact/subscribe persistence ---
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Resend transactional email, OPTIONAL ---
# If RESEND_API_KEY is empty/unset, email sending is skipped (no-op) and the
# endpoints still validate + persist. The build never requires a key.
RESEND_API_KEY=""
# Notification recipient for contact submissions.
CONTACT_NOTIFY_EMAIL="hello@murikah.com"
# Verified sender (must be a verified domain in Resend for production).
RESEND_FROM_EMAIL="Murikah <noreply@murikah.com>"

# --- GRC platform (grc.murikah.com), its own Turso database (hassaudit) ---
# Runtime secrets only, never committed. In production set them as Cloudflare
# secrets (wrangler secret put ...). GRC_SESSION_SECRET is 32+ random bytes,
# base64 encoded, and signs the session cookie; it is distinct from engr's.
TURSO_GRC_DATABASE_URL="libsql://hassaudit-your-org.turso.io"
TURSO_GRC_AUTH_TOKEN="your-hassaudit-auth-token"
GRC_SESSION_SECRET="base64-encoded-32-byte-secret"

# --- GRC evidence storage connectors, OPTIONAL (grc/docs/storage-setup.md) ---
# The platform's own OAuth application registrations, the same for every
# customer. What is per-organisation (the refresh token, or the R2 keys) is
# sealed in the database, never here. Leave a pair unset and that provider is
# simply not offered on /settings/storage. Cloudflare R2 needs nothing here:
# a customer supplies its own account, bucket and keys on the settings screen.
GDRIVE_CLIENT_ID=""
GDRIVE_CLIENT_SECRET=""
SHAREPOINT_CLIENT_ID=""
SHAREPOINT_CLIENT_SECRET=""
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

# --- Public site URL (canonical/OG fallback for non-production environments) ---
PUBLIC_SITE_URL="http://localhost:4321"
