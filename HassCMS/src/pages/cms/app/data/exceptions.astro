---
/**
 * Data → Exceptions → Unresolved Users.
 *
 * The names an extract used that this product does not recognise. An
 * administrator maps one to an existing person or explicitly creates an
 * invited internal user with the missing identity details. Every later upload
 * then recognises the same name without another manual decision.
 */
import CmsLayout from '@hasscms/layouts/CmsLayout.astro';
import CmsPageHeader from '@hasscms/components/cms/CmsPageHeader.astro';
import CmsDataTable from '@hasscms/components/cms/CmsDataTable.astro';
import CmsDrawer from '@hasscms/components/cms/CmsDrawer.astro';
import CmsButton from '@hasscms/components/cms/CmsButton.astro';
import CmsSelect from '@hasscms/components/cms/CmsSelect.astro';
import CmsCheckbox from '@hasscms/components/cms/CmsCheckbox.astro';
import CmsInput from '@hasscms/components/cms/CmsInput.astro';
import CmsEmptyState from '@hasscms/components/cms/CmsEmptyState.astro';
import CmsErrorState from '@hasscms/components/cms/CmsErrorState.astro';
import { requestDb } from '@hasscms/lib/cms/db';
import { canManageUsers, canViewImports } from '@hasscms/lib/cms/permissions';
import {
  listUnresolvedActors,
  type UnresolvedActorRow,
} from '@hasscms/lib/cms/import/uploadCentre';
import { listJobTitles } from '@hasscms/lib/cms/repos/userAdmin';
import {
  listAffiliates,
  listBusinessUnits,
  listCountries,
  listDepartments,
} from '@hasscms/lib/cms/repos/organisationAdmin';

export const prerender = false;

const permissions = Astro.locals.cms?.user.permissions ?? [];
const mayView = canViewImports(permissions);
const mayMap = canManageUsers(permissions);

let actors: UnresolvedActorRow[] = [];
let people: { value: string; label: string }[] = [];
let jobTitles: { value: string; label: string }[] = [];
let departments: { value: string; label: string }[] = [];
let countries: { value: string; label: string }[] = [];
let affiliates: { value: string; label: string }[] = [];
let businessUnits: { value: string; label: string }[] = [];
let loadFailed = false;
if (mayView) {
  try {
    const db = await requestDb(Astro.locals);
    actors = await listUnresolvedActors(db);
    if (mayMap) {
      const [users, titles, departmentRows, countryRows, affiliateRows, unitRows] =
        await Promise.all([
          db.execute(
            `SELECT user_id, display_name, email, employee_no, status FROM users
         WHERE status IN ('ACTIVE', 'INVITED') AND user_type = 'INTERNAL'
         ORDER BY display_name`,
          ),
          listJobTitles(db),
          listDepartments(db),
          listCountries(db),
          listAffiliates(db),
          listBusinessUnits(db),
        ]);
      people = users.rows.map((row) => ({
        value: String(row.user_id),
        label: `${String(row.display_name)} (${String(row.email)}${row.employee_no === null ? '' : `, ${String(row.employee_no)}`})${String(row.status) === 'INVITED' ? ' — invited' : ''}`,
      }));
      jobTitles = titles
        .filter((row) => row.active)
        .map((row) => ({ value: row.jobTitleId, label: row.titleName }));
      departments = departmentRows
        .filter((row) => row.active)
        .map((row) => ({ value: row.departmentId, label: row.departmentName }));
      countries = countryRows
        .filter((row) => row.active)
        .map((row) => ({ value: row.countryId, label: row.countryName }));
      affiliates = affiliateRows
        .filter((row) => row.active)
        .map((row) => ({ value: row.affiliateId, label: row.affiliateName }));
      businessUnits = unitRows
        .filter((row) => row.active)
        .map((row) => ({ value: row.businessUnitId, label: row.businessUnitName }));
    }
  } catch (error) {
    console.error('[cms.data.exceptions] load failed', error);
    loadFailed = true;
  }
}
---

<CmsLayout title="Unresolved users">
  {
    !mayView ? (
      <CmsErrorState
        title="You do not have access to import exceptions"
        description="Contact your administrator if you think this is a mistake."
      />
    ) : loadFailed ? (
      <CmsErrorState
        title="The exceptions could not be loaded"
        description="Please try again in a moment."
      />
    ) : (
      <Fragment>
        <CmsPageHeader
          title="Unresolved users"
          definition="These are source-system names this product does not recognise. Map one to an existing person, or create an invited user after confirming their identity and email."
          crumbs={[
            { label: 'Home', href: '/app' },
            { label: 'Upload Centre', href: '/app/data' },
            { label: 'Exceptions' },
          ]}
        />
        <p
          id="cms-actor-message"
          role="status"
          aria-live="polite"
          class="mb-4 text-cms-body-sm text-cms-muted"
        />

        <CmsDataTable
          caption="Unresolved users"
          columns={[
            { key: 'username', label: 'Source name' },
            { key: 'source', label: 'Source system' },
            { key: 'affiliate', label: 'Affiliate' },
            { key: 'batch', label: 'First seen' },
            { key: 'rows', label: 'Rows affected', numeric: true },
            { key: 'actions', label: 'Actions' },
          ]}
          empty={actors.length === 0}
        >
          {actors.map((actor) => (
            <tr class="border-b border-cms-line last:border-0">
              <td class="px-4 py-2.5 font-medium text-cms-ink">{actor.username}</td>
              <td class="px-4 py-2.5 text-cms-muted">{actor.sourceSystem}</td>
              <td class="px-4 py-2.5 text-cms-muted">{actor.affiliateId ?? 'Not available'}</td>
              <td class="px-4 py-2.5 text-cms-muted">
                <a
                  href={`/app/data/history/${actor.firstSeenBatchId}`}
                  class="text-cms-royal outline-none hover:underline focus-visible:ring-2 focus-visible:ring-focus"
                >
                  {actor.firstSeenAt}
                </a>
              </td>
              <td class="px-4 py-2.5 text-right text-cms-muted tabular-nums">
                {actor.affectedRows}
              </td>
              <td class="px-4 py-2.5">
                {mayMap ? (
                  <button
                    type="button"
                    data-cms-actor-map={actor.unresolvedActorId}
                    data-actor-name={actor.username}
                    data-actor-affiliate={actor.affiliateId ?? ''}
                    class="rounded-cms px-2 py-1 text-cms-body-sm font-medium text-cms-royal outline-none hover:bg-cms-canvas focus-visible:ring-2 focus-visible:ring-focus"
                  >
                    Map to a person
                  </button>
                ) : (
                  <span class="text-cms-body-sm text-cms-muted">Needs user administration</span>
                )}
              </td>
            </tr>
          ))}
          <Fragment slot="empty">
            <CmsEmptyState
              icon="administration"
              title="No unresolved users"
              description="Every source name in every batch has a home."
            />
          </Fragment>
        </CmsDataTable>

        {mayMap && (
          <CmsDrawer id="cms-actor-drawer" tone="form" title="Map a source name">
            <form id="cms-actor-form" novalidate class="flex flex-col gap-4">
              <p
                id="cms-actor-error"
                role="alert"
                hidden
                class="rounded-cms border border-cms-negative bg-cms-negative-tint px-3 py-2 text-cms-body-sm text-cms-negative"
              />
              <p class="text-cms-body-sm text-cms-muted">
                Resolving <span id="cms-actor-name" class="font-medium text-cms-ink" />. Search the
                directory first. If this is a new person, provide the identity details that the
                spreadsheet does not contain.
              </p>
              <fieldset class="flex flex-col gap-2">
                <legend class="text-cms-label font-semibold text-cms-ink">Resolution</legend>
                <label class="flex items-center gap-2 text-cms-body-sm text-cms-ink">
                  <input
                    type="radio"
                    name="actor-resolution"
                    value="existing"
                    checked
                    class="h-4 w-4 accent-cms-royal"
                  />
                  Map to an existing person
                </label>
                <label class="flex items-center gap-2 text-cms-body-sm text-cms-ink">
                  <input
                    type="radio"
                    name="actor-resolution"
                    value="new"
                    class="h-4 w-4 accent-cms-royal"
                  />
                  Create a new invited user
                </label>
              </fieldset>
              <section id="actor-existing-fields">
                <CmsSelect
                  id="actor-userId"
                  name="userId"
                  label="Person"
                  required
                  options={[{ value: '', label: 'Choose a person' }, ...people]}
                />
              </section>
              <section id="actor-new-fields" hidden class="flex flex-col gap-4">
                <CmsInput id="actor-firstName" name="firstName" label="First name" required />
                <CmsInput id="actor-lastName" name="lastName" label="Last name" required />
                <CmsInput
                  id="actor-email"
                  name="email"
                  label="Work email"
                  type="email"
                  hint="The account is created as invited and cannot sign in until this address is verified."
                  required
                />
                <CmsInput
                  id="actor-employeeNo"
                  name="employeeNo"
                  label="Employee number"
                  hint="Optional, and unique where supplied."
                />
                <hr class="border-cms-line" />
                <p class="text-cms-body-sm font-semibold text-cms-navy">
                  Organisational assignment
                </p>
                <CmsSelect
                  id="actor-jobTitleId"
                  name="jobTitleId"
                  label="Job title"
                  options={[{ value: '', label: 'Choose a job title' }, ...jobTitles]}
                  required
                />
                <CmsSelect
                  id="actor-departmentId"
                  name="departmentId"
                  label="Department"
                  options={[{ value: '', label: 'Choose a department' }, ...departments]}
                  required
                />
                <CmsSelect
                  id="actor-level"
                  name="level"
                  label="Assignment level"
                  options={[
                    { value: '', label: 'Choose a level' },
                    { value: 'GROUP', label: 'Group' },
                    { value: 'COUNTRY', label: 'Country' },
                    { value: 'AFFILIATE', label: 'Affiliate' },
                    { value: 'BUSINESS_UNIT', label: 'Business unit' },
                  ]}
                  required
                />
                <div data-actor-level-field="COUNTRY" hidden>
                  <CmsSelect
                    id="actor-countryId"
                    name="countryId"
                    label="Country"
                    options={[{ value: '', label: 'Choose a country' }, ...countries]}
                  />
                </div>
                <div data-actor-level-field="AFFILIATE" hidden>
                  <CmsSelect
                    id="actor-affiliateId"
                    name="affiliateId"
                    label="Affiliate"
                    options={[{ value: '', label: 'Choose an affiliate' }, ...affiliates]}
                  />
                </div>
                <div data-actor-level-field="BUSINESS_UNIT" hidden>
                  <CmsSelect
                    id="actor-businessUnitId"
                    name="businessUnitId"
                    label="Business unit"
                    options={[{ value: '', label: 'Choose a business unit' }, ...businessUnits]}
                  />
                </div>
              </section>
              <CmsCheckbox
                id="actor-revalidate"
                name="revalidate"
                label="Revalidate the affected rows now"
                checked
              />
            </form>
            <Fragment slot="actions">
              <CmsButton variant="ghost" data-cms-modal-close>
                Cancel
              </CmsButton>
              <button
                type="submit"
                form="cms-actor-form"
                data-cms-actor-save
                class="inline-flex h-10 items-center justify-center gap-2 rounded-cms bg-cms-royal px-4 text-cms-body-sm font-semibold text-white outline-none hover:bg-cms-royal-deep focus-visible:ring-2 focus-visible:ring-focus disabled:cursor-not-allowed disabled:opacity-60"
              >
                <span data-cms-actor-save-label>Map</span>
              </button>
            </Fragment>
          </CmsDrawer>
        )}
      </Fragment>
    )
  }
</CmsLayout>

<script>
  import { busy } from '@hasscms/lib/cms/ui/busy';
  const drawer = document.getElementById('cms-actor-drawer') as HTMLDialogElement | null;
  const form = document.getElementById('cms-actor-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('cms-actor-error');
  const nameLabel = document.getElementById('cms-actor-name');
  const message = document.getElementById('cms-actor-message');
  const existingFields = document.getElementById('actor-existing-fields');
  const newFields = document.getElementById('actor-new-fields');
  const saveLabel = document.querySelector('[data-cms-actor-save-label]');
  let actorId = '';

  const resolution = () =>
    (form?.querySelector<HTMLInputElement>('input[name="actor-resolution"]:checked')?.value ??
      'existing') as 'existing' | 'new';

  const applyLevel = () => {
    const level = (document.getElementById('actor-level') as HTMLSelectElement | null)?.value ?? '';
    form?.querySelectorAll<HTMLElement>('[data-actor-level-field]').forEach((group) => {
      const mine = group.dataset.actorLevelField === level;
      group.hidden = !mine;
      group.querySelectorAll('input, select').forEach((field) => {
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
          field.disabled = !mine;
        }
      });
    });
  };

  const updateResolution = () => {
    const creating = resolution() === 'new';
    if (existingFields) existingFields.hidden = creating;
    if (newFields) newFields.hidden = !creating;
    if (saveLabel) saveLabel.textContent = creating ? 'Create and map' : 'Map';
    applyLevel();
  };

  form?.addEventListener('change', (event) => {
    const name = (event.target as HTMLInputElement | HTMLSelectElement | null)?.name;
    if (name === 'actor-resolution') updateResolution();
    if (name === 'level') applyLevel();
  });

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement | null)?.closest('[data-cms-actor-map]');
    if (!target || !drawer || !form) return;
    actorId = target.getAttribute('data-cms-actor-map') ?? '';
    if (nameLabel) nameLabel.textContent = target.getAttribute('data-actor-name') ?? '';
    if (errorBox) errorBox.hidden = true;
    form.reset();
    const affiliateId = target.getAttribute('data-actor-affiliate') ?? '';
    if (affiliateId !== '') {
      const level = document.getElementById('actor-level') as HTMLSelectElement | null;
      const affiliate = document.getElementById('actor-affiliateId') as HTMLSelectElement | null;
      if (level) level.value = 'AFFILIATE';
      if (affiliate) affiliate.value = affiliateId;
    }
    updateResolution();
    drawer.showModal();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorBox) errorBox.hidden = true;
    const mode = resolution();
    const value = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value.trim() ??
      '';
    const userId = value('actor-userId');
    const revalidate =
      (document.getElementById('actor-revalidate') as HTMLInputElement | null)?.checked ?? false;
    if (mode === 'existing' && userId === '') {
      if (errorBox) {
        errorBox.textContent = 'Choose the person this name belongs to.';
        errorBox.hidden = false;
      }
      return;
    }
    if (
      mode === 'new' &&
      [
        value('actor-firstName'),
        value('actor-lastName'),
        value('actor-email'),
        value('actor-jobTitleId'),
        value('actor-departmentId'),
        value('actor-level'),
      ].some((v) => v === '')
    ) {
      if (errorBox) {
        errorBox.textContent =
          'Enter the user’s identity, job title, department and assignment level.';
        errorBox.hidden = false;
      }
      return;
    }
    // The success path briefly stays on this page before reloading; the drawer
    // is closed by then, so restoring the button is safe on every path.
    const restore = busy(
      form?.querySelector<HTMLButtonElement>('[type="submit"]') ?? null,
      mode === 'new' ? 'Creating…' : 'Mapping…',
    );
    try {
      const response = await fetch(
        `/api/data/unresolved-actors/${actorId}/${mode === 'new' ? 'create' : 'map'}`,
        {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(
            mode === 'new'
              ? {
                  firstName: value('actor-firstName'),
                  lastName: value('actor-lastName'),
                  email: value('actor-email'),
                  employeeNo: value('actor-employeeNo') || null,
                  jobTitleId: value('actor-jobTitleId'),
                  departmentId: value('actor-departmentId'),
                  level: value('actor-level'),
                  countryId: value('actor-countryId') || null,
                  affiliateId: value('actor-affiliateId') || null,
                  businessUnitId: value('actor-businessUnitId') || null,
                  revalidate,
                }
              : { userId, revalidate },
          ),
        },
      );
      const payload = (await response.json().catch(() => null)) as Record<string, unknown> | null;
      if (!response.ok) {
        const errors = (payload?.errors ?? []) as { message: string }[];
        if (errorBox) {
          errorBox.textContent = errors[0]?.message ?? 'The mapping could not be made.';
          errorBox.hidden = false;
        }
        return;
      }
      drawer?.close();
      const revalidated = payload?.revalidated as Record<string, unknown> | null;
      if (message) {
        const base =
          revalidated === null || revalidated === undefined
            ? 'The name is mapped. Later uploads will recognise it.'
            : `The name is mapped. ${String(revalidated.rowsExamined)} rows examined, ${String(revalidated.rowsResolved)} resolved.`;
        const invitation = payload?.invitation as Record<string, unknown> | undefined;
        message.textContent =
          mode === 'new'
            ? `${base} The user was created as invited. ${String(invitation?.message ?? (invitation?.path ? `Invitation: ${String(invitation.path)}` : ''))}`.trim()
            : base;
      }
      window.setTimeout(() => window.location.reload(), mode === 'new' ? 5000 : 1500);
    } finally {
      restore();
    }
  });
</script>
