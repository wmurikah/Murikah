---
export interface FunnelStage {
  label: string;
  value: number;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  stages: FunnelStage[];
}
const { title, description, stages } = Astro.props;
const max = Math.max(1, ...stages.map((s) => s.value));
const hasData = stages.some((stage) => stage.value > 0);
---

<figure class="grc-chart grc-funnel">
  <figcaption class="grc-chart__cap">
    <h3 class="grc-chart__title">{title}</h3>{
      description && <p class="grc-chart__desc">{description}</p>
    }
  </figcaption>
  {
    hasData ? (
      <ol class="grc-funnel__stages">
        {stages.map((stage, index) => {
          const width = Math.max(38, Math.round((stage.value / max) * 100));
          const next = stages[index + 1];
          const drop =
            next && stage.value > 0
              ? Math.max(0, Math.round(((stage.value - next.value) / stage.value) * 100))
              : 0;
          return (
            <li>
              <div class="grc-funnel__bar" style={`--funnel-width:${width}%`}>
                {stage.href ? (
                  <a href={stage.href}>
                    {stage.label}
                    <strong>{stage.value}</strong>
                  </a>
                ) : (
                  <span>
                    {stage.label}
                    <strong>{stage.value}</strong>
                  </span>
                )}
              </div>
              {next && drop > 0 && (
                <span class="grc-funnel__drop" aria-label={`${drop} percent drop to ${next.label}`}>
                  −{drop}%
                </span>
              )}
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="grc-chart__empty">No observations entered this workflow in the selected year.</p>
    )
  }
  <table class="grc-vh">
    <caption>{title} data</caption><thead
      ><tr><th scope="col">Stage</th><th scope="col">Count</th></tr></thead
    ><tbody
      >{
        stages.map((s) => (
          <tr>
            <>
              <th scope="row">{s.label}</th>
              <td>{s.value}</td>
            </>
          </tr>
        ))
      }</tbody
    >
  </table>
</figure>
