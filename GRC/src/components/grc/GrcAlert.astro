---
import GrcIcon from './GrcIcon.astro';

interface Props {
  tone?: 'info' | 'success' | 'warning' | 'danger';
  title?: string;
  dismissible?: boolean;
}
const { tone = 'info', title, dismissible = false } = Astro.props;
const icon =
  tone === 'success'
    ? 'check'
    : tone === 'warning'
      ? 'warning'
      : tone === 'danger'
        ? 'warning'
        : 'info';
---

<div
  class:list={['grc-alert', `grc-alert--${tone}`]}
  role={tone === 'danger' ? 'alert' : 'status'}
  data-alert
>
  <GrcIcon name={icon} size={20} />
  <div class="grc-alert__body">
    {title && <strong class="grc-alert__title">{title}</strong>}
    <div class="grc-alert__content"><slot /></div>
  </div>
  {
    dismissible && (
      <button
        type="button"
        class="grc-iconbtn grc-alert__close"
        aria-label="Dismiss message"
        data-dismiss-alert
      >
        <GrcIcon name="close" size={18} />
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-alert]').forEach((alert) => {
    if (alert.dataset.bound === '1') return;
    alert.dataset.bound = '1';
    alert.querySelector('[data-dismiss-alert]')?.addEventListener('click', () => alert.remove());
  });
</script>
