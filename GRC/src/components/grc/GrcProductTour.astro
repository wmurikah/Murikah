---
import GrcIcon from './GrcIcon.astro';

interface TourStep {
  title: string;
  body: string;
  icon: string;
}
interface Props {
  steps: TourStep[];
  storageKey?: string;
}
const { steps, storageKey = 'grc.product-tour.v1' } = Astro.props;
---

<button type="button" class="grc-btn grc-btn--secondary grc-tour-trigger" data-tour-open>
  <GrcIcon name="info" size={17} />
  Product tour
</button>
<dialog
  class="grc-tour"
  data-tour-dialog
  data-storage-key={storageKey}
  aria-labelledby="grc-tour-title"
>
  <button
    type="button"
    class="grc-iconbtn grc-tour__close"
    data-tour-close
    aria-label="Close product tour"><GrcIcon name="close" size={18} /></button
  >
  <div class="grc-tour__steps">
    {
      steps.map((step, index) => (
        <section class="grc-tour__step" data-tour-step hidden={index !== 0}>
          <span class="grc-tour__icon">
            <GrcIcon name={step.icon} size={25} />
          </span>
          <p class="grc-tour__eyebrow">
            Step {index + 1} of {steps.length}
          </p>
          <h2 id={index === 0 ? 'grc-tour-title' : undefined}>{step.title}</h2>
          <p>{step.body}</p>
        </section>
      ))
    }
  </div>
  <div class="grc-tour__footer">
    <button type="button" class="grc-btn grc-btn--secondary" data-tour-prev disabled>Back</button>
    <div class="grc-tour__dots" aria-hidden="true">
      {steps.map((_, index) => <i class:list={{ 'is-active': index === 0 }} />)}
    </div>
    <button type="button" class="grc-btn grc-btn--primary" data-tour-next>Next</button>
  </div>
</dialog>

<script>
  const tour = document.querySelector<HTMLDialogElement>('[data-tour-dialog]');
  if (tour) {
    const steps = Array.from(tour.querySelectorAll<HTMLElement>('[data-tour-step]'));
    const dots = Array.from(tour.querySelectorAll<HTMLElement>('.grc-tour__dots i'));
    const previous = tour.querySelector<HTMLButtonElement>('[data-tour-prev]')!;
    const next = tour.querySelector<HTMLButtonElement>('[data-tour-next]')!;
    const key = tour.dataset.storageKey ?? 'grc.product-tour.v1';
    let current = 0;
    const paint = (): void => {
      steps.forEach((step, index) => {
        step.hidden = index !== current;
      });
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === current));
      previous.disabled = current === 0;
      next.textContent = current === steps.length - 1 ? 'Finish' : 'Next';
    };
    const close = (): void => {
      try {
        localStorage.setItem(key, 'seen');
      } catch {
        /* no storage */
      }
      tour.close();
    };
    document.querySelectorAll('[data-tour-open]').forEach((button) =>
      button.addEventListener('click', () => {
        current = 0;
        paint();
        tour.showModal();
      }),
    );
    tour.querySelector('[data-tour-close]')?.addEventListener('click', close);
    previous.addEventListener('click', () => {
      current = Math.max(0, current - 1);
      paint();
    });
    next.addEventListener('click', () => {
      if (current >= steps.length - 1) close();
      else {
        current += 1;
        paint();
      }
    });
    tour.addEventListener('cancel', () => {
      try {
        localStorage.setItem(key, 'seen');
      } catch {
        /* no storage */
      }
    });
  }
</script>
