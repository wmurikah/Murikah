---
import GrcIcon from './GrcIcon.astro';
interface Props {
  id: string;
  title: string;
  trigger?: string;
  side?: 'right' | 'left';
}
const { id, title, trigger = 'Open details', side = 'right' } = Astro.props;
---

<button type="button" class="grc-btn grc-btn--secondary" data-sheet-open={id}>{trigger}</button>
<dialog id={id} class:list={['grc-sheet', `grc-sheet--${side}`]} aria-labelledby={`${id}-title`}>
  <header class="grc-sheet__head">
    <h2 id={`${id}-title`}>{title}</h2>
    <button type="button" class="grc-iconbtn" data-sheet-close aria-label="Close panel"
      ><GrcIcon name="close" size={18} /></button
    >
  </header>
  <div class="grc-sheet__body"><slot /></div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-sheet-open]').forEach((trigger) => {
    if (trigger.dataset.sheetBound === '1') return;
    trigger.dataset.sheetBound = '1';
    const sheet = document.getElementById(
      trigger.dataset.sheetOpen ?? '',
    ) as HTMLDialogElement | null;
    trigger.addEventListener('click', () => sheet?.showModal());
    sheet?.querySelector('[data-sheet-close]')?.addEventListener('click', () => sheet.close());
    sheet?.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });
  });
</script>
