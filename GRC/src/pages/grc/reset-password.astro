---
export const prerender = false;

/**
 * Set a new password from an emailed reset link (public). The token from the
 * link is validated (exists by hash, not expired, not used, user active)
 * before the form shows; an invalid link gets one generic message and a way to
 * request a fresh one. The form posts the token with the new password to the
 * reset endpoint, which applies the change and invalidates every session.
 */
import GrcAuthLayout from '@/layouts/GrcAuthLayout.astro';
import { getGrcEnv } from '@grc/env';
import { getDb } from '@grc/db';
import { findValidResetToken } from '@grc/repos/passwordReset';
import { MIN_PASSWORD_LENGTH } from '@grc/auth/passwordPolicy';

const token = (Astro.url.searchParams.get('token') ?? '').trim();
const error = Astro.url.searchParams.get('error');

// A token that does not resolve renders the invalid state; the endpoint
// re-validates on submission, so this early check is purely for the user.
let valid = false;
if (token !== '') {
  try {
    const db = await getDb(getGrcEnv());
    valid = (await findValidResetToken(db, token)) !== null;
  } catch (err) {
    console.error('[grc.auth.reset] token pre-check failed', err);
    valid = false;
  }
}
---

<GrcAuthLayout title="Set a new password">
  <h1>Set a new password</h1>

  {
    !valid ? (
      <>
        <p class="grc-error" role="alert" style="margin-bottom:1rem">
          That reset link is not valid any more. Links expire after 45 minutes and work once.
        </p>
        <p class="grc-authmeta">
          <a href="/forgot-password">Request a new reset link</a>
        </p>
      </>
    ) : (
      <>
        <p class="grc-authcard__lead">
          Choose a new password of at least {MIN_PASSWORD_LENGTH} characters. A long passphrase
          works well.
        </p>

        {error && (
          <p class="grc-error" role="alert" style="margin-bottom:1rem">
            {decodeURIComponent(error)}
          </p>
        )}

        <form method="post" action="/api/auth/reset-password">
          <input type="hidden" name="token" value={token} />
          <div class="grc-field">
            <label for="new_password">New password</label>
            <input
              type="password"
              id="new_password"
              name="new_password"
              class="grc-input"
              autocomplete="new-password"
              minlength={MIN_PASSWORD_LENGTH}
              required
            />
          </div>
          <div class="grc-field">
            <label for="confirm_password">Confirm new password</label>
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              class="grc-input"
              autocomplete="new-password"
              minlength={MIN_PASSWORD_LENGTH}
              required
            />
          </div>
          <button type="submit" class="grc-btn grc-btn--primary">
            Set new password
          </button>
        </form>

        <p class="grc-authmeta">
          <a href="/login">Back to sign in</a>
        </p>
      </>
    )
  }
</GrcAuthLayout>
