---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import ContactForm from '@/components/ContactForm.astro';
import AudienceCard from '@/components/AudienceCard.astro';
import Button from '@/components/primitives/Button.astro';
import AuditOsWalkthrough from '@/components/audit-os/AuditOsWalkthrough';
import { SITE, SERVICES, AUDIENCE, STANDARDS } from '@/site.config';
import { HOME_HERO } from '@/data/homeHero';
import { TRUST } from '@/data/trust';

const permittedLogos = TRUST.logos.filter((logo) => logo.verified && logo.permitted);

const serviceCards = SERVICES.filter(
  (service) => !['assurance-os', 'research'].includes(service.slug),
).map((service, index) => ({
  ...service,
  shortSummary: [
    'Independent assurance over operations, systems, governance and data protection.',
    'Workflow automation and internal tools built after the process is understood.',
    'AI governance, analytics and decision support for executives and boards.',
    'Practical training for audit, risk, AI governance and assurance teams.',
    'Benchmarking and research that turns assurance data into context.',
  ][index],
}));
---

<BaseLayout
  titleFull="Internal audit and Assurance OS | Murikah"
  description="Internal audit and Assurance OS for teams accountable to boards, regulators and customers. Plan, evidence, report and follow up in one connected workflow."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/assurance-os/hero.webp"
    fetchpriority="high"
  />
  <section id="hero" class="home-hero on-dark" aria-labelledby="home-title">
    <span class="home-hero__nav-sentinel" data-home-nav-sentinel aria-hidden="true"></span>
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">FOR REGULATED TEAMS IN KENYA AND EAST AFRICA</p>
      <h1 id="home-title">{HOME_HERO.headline.map((line) => <span>{line}</span>)}</h1>
      <p class="home-hero__body">{HOME_HERO.body}</p>
      <div class="home-hero__actions">
        <a class="home-hero__primary" href={HOME_HERO.primary.href}>{HOME_HERO.primary.label}</a>
        <a class="home-hero__secondary" href={HOME_HERO.secondary.href}
          >{HOME_HERO.secondary.label} →</a
        >
      </div>
      <p class="home-hero__note">The sandbox opens with sample data. No sign-in.</p>
      <div class="home-hero__trust">
        <span>{TRUST.caption}</span>
        <ul aria-label="Standards our work aligns to">
          {TRUST.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      {
        permittedLogos.map((logo) => (
          <img
            src={logo.src}
            alt={logo.name}
            width={logo.width}
            height={logo.height}
            loading="lazy"
          />
        ))
      }
    </div>
    <figure class="home-hero__media">
      <img
        src="/images/assurance-os/hero.webp"
        width="1600"
        height="1000"
        fetchpriority="high"
        loading="eager"
        alt="Assurance OS sandbox: three findings with severity labels, alongside a sample board committee pack."
      />
      <figcaption>Inside the Assurance OS sandbox · Fictional sample data</figcaption>
    </figure>
  </section>

  <Section id="proof" tone="paper" aria-labelledby="proof-title" class="border-b border-hairline">
    <div class="max-w-3xl">
      <p class="eyebrow">Proof</p>
      <h2
        id="proof-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Evidence before claims.
      </h2>
      <p class="mt-4 text-lg text-slate">
        See how we work, the standards we use and the evidence before you book.
      </p>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <article class="rounded-card bg-surface p-6 ring-1 ring-hairline lg:col-span-5">
        <p class="eyebrow">Work aligned to</p>
        <h3 class="mt-4 text-2xl text-navy">Standards behind the work.</h3>
        <ul class="mt-5 space-y-5">
          {
            STANDARDS.map((standard) => (
              <li>
                <>
                  <h4 class="font-semibold text-navy">{standard.short}</h4>
                  <p class="mt-1 text-base text-slate">{standard.note}</p>
                </>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm text-slate">
          These standards guide our work. They do not imply accreditation or endorsement.
        </p>
        <a href="/about#how-we-work" class="mt-4 inline-flex min-h-11 items-center text-blue"
          >How we work →</a
        >
      </article>

      <article class="rounded-card bg-navy p-6 text-paper shadow-card lg:col-span-7">
        <p class="text-xs font-semibold tracking-[0.12em] text-brass-on-dark uppercase">
          Results from earlier audit work (client details removed)
        </p>
        <h3 class="mt-3 text-2xl text-white">
          From dispersed findings to one board-ready record of evidence.
        </h3>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-paper/75">
          These are real engagement metrics from earlier audit work. Client, system and location
          identifiers have been removed.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">93</p>
            <p class="mt-1 text-sm text-paper/70">audit observations merged into one register</p>
          </div>
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">5</p>
            <p class="mt-1 text-sm text-paper/70">
              high-priority issues found in one review of a critical system
            </p>
          </div>
          <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/15">
            <p class="text-3xl font-semibold text-white">1</p>
            <p class="mt-1 text-sm text-paper/70">action tracker feeding the board report</p>
          </div>
        </div>

        <a
          href="/proof/report-extract"
          class="mt-6 inline-flex min-h-11 items-center font-medium text-white underline decoration-gold underline-offset-4"
        >
          See a redacted report page →
        </a>
      </article>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" aria-label="Standards our work follows">
      {
        STANDARDS.map((standard) => (
          <span class="rounded-full bg-paper px-3 py-1.5 text-sm text-navy ring-1 ring-hairline">
            {standard.short}
          </span>
        ))
      }
    </div>
  </Section>

  <Section
    id="platform"
    tone="surface"
    aria-labelledby="platform-title"
    class="border-b border-hairline"
  >
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5">
        <p class="eyebrow">Platform</p>
        <h2
          id="platform-title"
          class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
        >
          One workspace from audit plan to board pack.
        </h2>
        <p class="mt-5 max-w-prose text-lg text-slate">
          Plan the audit. Store the evidence. Raise the finding. Track the action. Build the
          committee pack. Keep one trail from start to end.
        </p>
        <div class="mt-7">
          <Button href="/assurance-os/sandbox" size="lg">Try the public sandbox</Button>
        </div>
        <p class="mt-4 text-sm">
          <a href="/assurance-os" class="font-medium text-blue no-underline hover:underline">
            See Assurance OS →
          </a>
          <a href="/pricing" class="ml-4 inline-flex min-h-11 items-center font-medium text-blue"
            >See pricing →</a
          >
        </p>
      </div>
      <div class="lg:col-span-7">
        <AuditOsWalkthrough client:visible />
      </div>
    </div>
  </Section>

  <Section
    id="services"
    tone="paper"
    aria-labelledby="services-title"
    class="border-b border-hairline"
  >
    <div class="max-w-3xl">
      <p class="eyebrow">Services</p>
      <h2
        id="services-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Specialist work around the platform.
      </h2>
      <p class="mt-4 text-lg text-slate">
        Start with the service you need. The Services page compares who each line is for, what it
        produces and how it starts.
      </p>
    </div>

    <div class="mt-8 grid gap-x-8 gap-y-2 md:grid-cols-2">
      {
        serviceCards.map((service, index) => (
          <a
            href={service.href}
            class="group grid grid-cols-[2.4rem_1fr] gap-3 border-t border-hairline py-5 no-underline"
          >
            <span class="pt-1 text-xs font-semibold tracking-[0.14em] text-gold uppercase">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>
              <span class="block text-xl font-semibold text-navy">{service.fullName}</span>
              <span class="mt-1.5 block text-sm leading-relaxed text-slate">
                {service.shortSummary}
              </span>
              <span class="mt-3 inline-flex text-sm font-medium text-blue group-hover:underline">
                Compare this service →
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section
    id="audience"
    tone="surface"
    aria-labelledby="audience-title"
    class="border-b border-hairline"
  >
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow is-centred">Audience</p>
      <h2
        id="audience-title"
        class="mt-5 text-[length:var(--text-title)] leading-[1.08] font-semibold tracking-[-0.015em] text-navy"
      >
        Built for teams accountable to boards, regulators and funders.
      </h2>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
      {AUDIENCE.map((segment, index) => <AudienceCard segment={segment} index={index} />)}
    </div>
    <p class="mt-6 text-center text-sm text-slate">{SITE.areaServed}</p>
  </Section>

  <Section id="contact" tone="paper" aria-labelledby="contact-title">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title" class="mt-5 text-4xl text-navy">Book a 20-minute call</h2>
        <ol class="mt-6 list-decimal space-y-3 pl-6 text-slate">
          <li>You tell us your audit challenge.</li>
          <li>We confirm a time within 1 business day.</li>
          <li>You leave with a next step, with or without us.</li>
        </ol>
        <p class="mt-6">
          <button
            type="button"
            disabled
            class="min-h-11 rounded-btn border border-control-border px-4 text-slate"
            title="WhatsApp number to be added">WhatsApp · coming soon</button>
        </p>
        <p class="mt-6"><a href={`mailto:${SITE.email}`}>{SITE.email}</a> · Nairobi, Kenya</p>
      </div>
      <ContactForm location="home" />
    </div>
  </Section>

  <script>
    document.documentElement.classList.add('home-hero-page');

    const homeHeader = document.querySelector<HTMLElement>('[data-home-header]');
    const navSentinel = document.querySelector<HTMLElement>('[data-home-nav-sentinel]');

    if (homeHeader && navSentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => homeHeader.classList.toggle('is-scrolled', !entry?.isIntersecting),
        { threshold: 0 },
      );
      observer.observe(navSentinel);
    }
  </script>

  <style>
    .home-hero {
      position: relative;
      display: grid;
      gap: 2.5rem;
      align-items: center;
      padding: 8rem max(1.5rem, 5vw) 4rem;
      background: var(--color-navy);
      color: var(--color-hero-ivory);
    }
    .home-hero__nav-sentinel {
      position: absolute;
      top: 24px;
      left: 0;
      width: 1px;
      height: 1px;
    }
    .home-hero__eyebrow {
      font-size: 14px;
      letter-spacing: 0.12em;
      line-height: 1.6;
      color: var(--color-brass-on-dark);
    }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 4.1vw, 4.5rem);
      font-weight: 450;
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin: 1.25rem 0;
      color: inherit;
    }
    h1 span {
      display: block;
    }
    .home-hero__body {
      max-width: 60ch;
      font-size: 18px;
      line-height: 1.6;
      color: var(--color-on-navy-muted);
    }
    .home-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
    }
    .home-hero__primary,
    .home-hero__secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0.75rem 1.25rem;
      border-radius: 6px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
    }
    .home-hero__primary {
      background: var(--color-brass-on-dark);
      color: var(--color-navy);
    }
    .home-hero__secondary {
      border: 1px solid var(--color-on-navy-muted);
      color: var(--color-hero-ivory);
    }
    .home-hero a:focus-visible {
      outline: 2px solid var(--color-hero-ivory);
      outline-offset: 3px;
    }
    .home-hero__note {
      font-size: 13px;
      margin-top: 1rem;
      color: var(--color-on-navy-muted);
    }
    .home-hero__trust {
      margin-top: 2rem;
      font-size: 13px;
      color: var(--color-on-navy-muted);
    }
    .home-hero__trust ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin-top: 0.5rem;
    }
    .home-hero__media {
      min-width: 0;
      margin: 0;
    }
    .home-hero__media img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 12px;
      box-shadow: 0 20px 60px #0004;
    }
    figcaption {
      font-size: 13px;
      color: var(--color-on-navy-muted);
      margin-top: 1rem;
    }
    @media (min-width: 1024px) {
      .home-hero {
        grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
        gap: 2rem;
        min-height: 680px;
      }
    }
    @media (max-width: 639px) {
      .home-hero__actions a {
        width: 100%;
      }
      .home-hero {
        padding-top: 7rem;
      }
    }
  </style>
</BaseLayout>
