---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE } from '@/site.config';
const params = Astro.url.searchParams;
---

<BaseLayout
  titleFull="Book a 20-minute call | Murikah"
  description="Tell us your audit challenge. Book a 20-minute call with Murikah in Nairobi, Kenya."
>
  <Section tone="paper" aria-labelledby="page-title">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 id="page-title" class="mt-5 text-[length:var(--text-title)] text-navy">
          Book a 20-minute call
        </h1>
        <ol class="mt-8 list-decimal space-y-4 pl-6 text-slate">
          <li>You tell us your audit challenge.</li>
          <li>We confirm a time within 1 business day.</li>
          <li>You leave with a next step, with or without us.</li>
        </ol>
        <p class="mt-8">
          <button
            type="button"
            disabled
            class="min-h-11 rounded-btn border border-control-border px-4 text-slate"
            title="WhatsApp number to be added">WhatsApp · coming soon</button>
        </p>
        <p class="mt-6"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p class="mt-3 text-slate">Nairobi, Kenya</p>
      </div>
      <ContactForm
        location="contact"
        status={params.get('status')}
        segment={params.get('segment')}
        intent={params.get('intent') ?? 'call'}
      />
    </div>
  </Section>
</BaseLayout>
