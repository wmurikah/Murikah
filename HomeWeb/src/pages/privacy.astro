---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Breadcrumb from '@/components/primitives/Breadcrumb.astro';
import { SITE } from '@/site.config';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy', href: '/privacy' },
];
---

<BaseLayout
  titleFull="Privacy policy | Murikah"
  description="How Murikah collects, uses and protects personal data, and your rights under the Kenya Data Protection Act."
>
  <Section tone="surface" aria-labelledby="page-title">
    <Breadcrumb items={crumbs} class="mb-6" />
    <p class="eyebrow">Legal</p>
    <h1
      id="page-title"
      class="mt-5 font-serif text-[length:var(--text-title)] leading-[1.06] font-semibold tracking-[-0.02em] text-navy"
    >
      Privacy policy
    </h1>
    <p class="mt-4 text-slate">Last updated: <time datetime="2026-10-29">29 October 2026</time></p>

    <Prose class="mt-10">
      <h2>Who we are</h2>
      <p>
        Murikah ("we", "us") is the data controller for personal data collected through this
        website. For any privacy question, contact us at
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>

      <h2>What we collect</h2>
      <p>We collect only what we need to respond to you and run the site:</p>
      <ul>
        <li>
          Details you submit through the contact form: your name, work email and optional challenge.
          We also retain the enquiry type and audience segment selected through the site links.
        </li>
        <li>Your email address if you subscribe to updates.</li>
        <li>Basic, privacy-respecting analytics about how the site is used.</li>
      </ul>

      <h2>Why we use it, and our lawful basis</h2>
      <p>
        We use contact details to reply to enquiries and provide the services you ask about, and to
        send updates you have asked for. We rely on your consent for marketing emails, and on our
        legitimate interest in responding to enquiries and keeping the site secure. You can withdraw
        consent at any time.
      </p>

      <h2>How long we keep it</h2>
      <p>
        We keep personal data only as long as we need it for the purpose it was collected, and then
        delete it. Contact us to ask about the retention of your enquiry or to request deletion.
      </p>

      <h2>Your rights under the Kenya Data Protection Act</h2>
      <p>
        Under the Data Protection Act, 2019 you have the right to be informed, to access your data,
        to have it corrected or deleted, to object to certain processing, and to data portability.
        To exercise any of these, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. You may
        also complain to the Office of the Data Protection Commissioner (ODPC).
      </p>

      <h2>Service providers</h2>
      <p>
        Cloudflare hosts this website. Where configured, Turso stores enquiry and subscription
        records, and Resend delivers enquiry notifications. Google Analytics processes usage events
        only when enabled and with your permission. These providers may process data outside Kenya;
        contact us with questions about how your data is handled.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        When enabled, Google Analytics measures page visits and call, sandbox, form and WhatsApp
        conversions only after you allow analytics. We exclude form contents, sandbox records and
        URL query parameters from these events. Advertising signals are disabled. You can decline
        analytics or change your choice using “Analytics choices” in the footer. The sandbox keeps
        its sample records in your browser whether or not you allow analytics.
      </p>
    </Prose>
  </Section>
</BaseLayout>
