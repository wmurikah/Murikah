{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murikah.com/schemas/virtual-internship/scenario-pack-v1.schema.json",
  "title": "Murikah Virtual Internship Scenario Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "company",
    "facts",
    "actors",
    "tasks",
    "events",
    "decisions"
  ],
  "properties": {
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "company": {
      "$ref": "#/$defs/company"
    },
    "facts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "actors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "scenario_version_id",
        "schema_version",
        "scenario_version",
        "title",
        "career_family",
        "role_title",
        "region_context",
        "company_ref",
        "minimum_duration_days",
        "expected_workload_band",
        "classification",
        "qualifying",
        "initial_task_ids",
        "initial_event_ids",
        "required_components",
        "available_actor_classes",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,127}$",
          "maxLength": 128
        },
        "scenario_version_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "schema_version": {
          "const": 1
        },
        "scenario_version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "career_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "role_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "region_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "company_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "minimum_duration_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730
        },
        "expected_workload_band": {
          "enum": [
            "light",
            "standard",
            "intensive"
          ]
        },
        "classification": {
          "enum": [
            "demo",
            "test",
            "qualifying"
          ]
        },
        "qualifying": {
          "type": "boolean"
        },
        "initial_task_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "initial_event_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "required_components": {
          "type": "array",
          "minItems": 7,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manifest.json",
              "company.json",
              "facts.json",
              "actors.json",
              "tasks.json",
              "events.json",
              "decisions.json"
            ]
          }
        },
        "available_actor_classes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "midpoint_day",
            "final_review_day",
            "demo_accelerated_midpoint_day",
            "demo_accelerated_final_day"
          ],
          "properties": {
            "midpoint_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            },
            "final_review_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            },
            "demo_accelerated_midpoint_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            },
            "demo_accelerated_final_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 730
            }
          }
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "name",
        "fictional",
        "sector",
        "country_region",
        "description",
        "products_services",
        "departments",
        "systems",
        "process_references",
        "vocabulary",
        "communication_norms",
        "work_calendar"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fictional": {
          "const": true
        },
        "sector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "products_services": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "departments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        },
        "systems": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "process_references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "vocabulary": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "communication_norms": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "work_calendar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timezone_label",
            "work_days",
            "notes"
          ],
          "properties": {
            "timezone_label": {
              "type": "string",
              "maxLength": 80
            },
            "work_days": {
              "type": "array",
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              }
            },
            "notes": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "reporting_relationships": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manager_actor_id",
              "direct_report_actor_id"
            ],
            "properties": {
              "manager_actor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$",
                "maxLength": 64
              },
              "direct_report_actor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$",
                "maxLength": 64
              }
            }
          }
        },
        "organization_chart_entries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "department_id",
              "label"
            ],
            "properties": {
              "department_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "value",
        "mutability",
        "visibility",
        "visibility_scopes",
        "source",
        "initially_revealed",
        "future_only"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "value": {
          "$ref": "#/$defs/canonicalValue"
        },
        "mutability": {
          "enum": [
            "immutable",
            "mutable"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "learner_visible",
            "department",
            "role",
            "actor_specific",
            "hidden_truth"
          ]
        },
        "visibility_scopes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "initially_revealed": {
          "type": "boolean"
        },
        "future_only": {
          "type": "boolean"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "name",
        "actor_class",
        "job_title",
        "department_id",
        "reports_to_actor_id",
        "authority",
        "goals",
        "knowledge_fact_ids",
        "communication_style",
        "learner_relationship",
        "escalation_capabilities",
        "allowed_event_ids",
        "active"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "actor_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "job_title": {
          "type": "string",
          "maxLength": 120
        },
        "department_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "reports_to_actor_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 180
          }
        },
        "goals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "knowledge_fact_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "communication_style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tone",
            "formality"
          ],
          "properties": {
            "tone": {
              "type": "string",
              "maxLength": 80
            },
            "formality": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        },
        "learner_relationship": {
          "type": "string",
          "maxLength": 120
        },
        "escalation_capabilities": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 180
          }
        },
        "allowed_event_ids": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "authored_sequence",
        "title",
        "category",
        "assigned_by_actor_id",
        "business_context",
        "learner_objective",
        "brief",
        "dependencies",
        "due_policy",
        "expected_effort",
        "difficulty",
        "allowed_tools",
        "allowed_mentor_support",
        "stakeholder_actor_ids",
        "event_references",
        "completion_criteria",
        "revision_policy",
        "competency_refs",
        "initial_state",
        "deliverable_types"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "authored_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "category": {
          "enum": [
            "routine",
            "analytical",
            "investigative",
            "creative",
            "communication",
            "planning",
            "research",
            "coding",
            "review",
            "decision",
            "incident",
            "presentation",
            "capstone"
          ]
        },
        "assigned_by_actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "business_context": {
          "type": "string",
          "maxLength": 2000
        },
        "learner_objective": {
          "type": "string",
          "maxLength": 2000
        },
        "brief": {
          "type": "string",
          "maxLength": 2000
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "due_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "days"
          ],
          "properties": {
            "kind": {
              "const": "offset_days"
            },
            "days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 730
            }
          }
        },
        "expected_effort": {
          "type": "string",
          "maxLength": 80
        },
        "difficulty": {
          "enum": [
            "introductory",
            "intermediate",
            "advanced"
          ]
        },
        "allowed_tools": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "allowed_mentor_support": {
          "enum": [
            "none",
            "clarification",
            "light_coaching",
            "moderate_coaching"
          ]
        },
        "stakeholder_actor_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "event_references": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "completion_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "trusted_internal_demo"
            },
            "description": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "revision_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_revisions"
          ],
          "properties": {
            "max_revisions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "competency_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "initial_state": {
          "enum": [
            "locked",
            "available"
          ]
        },
        "deliverable_types": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "rubric": {
          "anyOf": [
            {
              "$ref": "#/$defs/rubric"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_type"
      ],
      "properties": {
        "trigger_type": {
          "enum": [
            "time_elapsed_days",
            "task_state",
            "all_dependencies_completed",
            "fact_equals",
            "prior_event",
            "decision"
          ]
        },
        "days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 730
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "status": {
          "enum": [
            "locked",
            "available",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "fact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "expected": {
          "$ref": "#/$defs/canonicalValue"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "option_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_type"
      ],
      "properties": {
        "mutation_type": {
          "enum": [
            "reveal_fact",
            "set_mutable_fact",
            "unlock_task",
            "assign_task",
            "adjust_deadline",
            "record_decision"
          ]
        },
        "fact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "value": {
          "$ref": "#/$defs/canonicalValue"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "offset_days": {
          "type": "integer",
          "minimum": -365,
          "maximum": 365
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "option_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "authored_sequence",
        "event_type",
        "priority",
        "triggers",
        "mutations",
        "message_template_id",
        "actor_ids",
        "once",
        "audit_label",
        "learning_objective"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "authored_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "message_template_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "actor_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "once": {
          "const": true
        },
        "audit_label": {
          "type": "string",
          "maxLength": 180
        },
        "learning_objective": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "label",
        "options"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 240
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "label"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "canonicalValue": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/canonicalValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          }
        }
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_id",
        "schema_version",
        "title",
        "purpose",
        "calculation",
        "rating_levels",
        "criteria"
      ],
      "properties": {
        "rubric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,127}$",
          "maxLength": 128
        },
        "schema_version": {
          "const": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "maxLength": 1000
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "weight_total",
            "rounding"
          ],
          "properties": {
            "method": {
              "enum": [
                "weighted_average",
                "none"
              ]
            },
            "weight_total": {
              "const": 100
            },
            "rounding": {
              "const": "half_up_2dp"
            }
          }
        },
        "rating_levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rating_id",
              "label",
              "value"
            ],
            "properties": {
              "rating_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,79}$",
                "maxLength": 80
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "description",
              "evidence_expectations",
              "allowed_rating_ids",
              "deliverable_types",
              "allow_not_assessed"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,127}$",
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "evidence_expectations": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "weight": {
                "type": "number",
                "minimum": 0
              },
              "allowed_rating_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,79}$",
                  "maxLength": 80
                }
              },
              "deliverable_types": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "maxLength": 64
                }
              },
              "allow_not_assessed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
