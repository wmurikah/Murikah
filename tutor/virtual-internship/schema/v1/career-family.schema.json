{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murikah.com/schemas/virtual-internship/career-family-registry-v1.schema.json",
  "title": "Murikah Virtual Internship Career Family Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "families"],
  "properties": {
    "schema_version": {"const": 1},
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","schema_version","slug","title","short_title","description","sort_order","active","physical_competency_classification","physical_competency_limitation_text"],
        "properties": {
          "id": {"type": "string", "pattern": "^cf_[a-z0-9_]{3,80}$"},
          "schema_version": {"const": 1},
          "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "short_title": {"type": "string", "minLength": 1, "maxLength": 80},
          "description": {"type": "string", "minLength": 1, "maxLength": 600},
          "sort_order": {"type": "integer", "minimum": 0, "maximum": 10000},
          "active": {"type": "boolean"},
          "physical_competency_classification": {"enum": ["knowledge_work","mixed","physical_skill_limited"]},
          "physical_competency_limitation_text": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
