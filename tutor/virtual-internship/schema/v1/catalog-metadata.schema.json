{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murikah.com/schemas/virtual-internship/catalog-metadata-v1.schema.json",
  "title": "Murikah Virtual Internship Catalog Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","catalog_slug","career_family_id","short_description","long_description","internship_type","minimum_duration_days","weekly_hours_min","weekly_hours_max","workload_band","experience_level","competencies_developed","sample_responsibilities","deliverables","work_rhythm","prerequisites","physical_competency_classification","physical_competency_limitation_text","simulation_disclosure","completion_overview","support_summary","published","catalog_visible","sort_order","search_keywords"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_slug": {"type": "string","pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
    "career_family_id": {"type": "string","pattern": "^cf_[a-z0-9_]{3,80}$"},
    "short_description": {"type": "string","minLength": 1,"maxLength": 320},
    "long_description": {"type": "string","minLength": 1,"maxLength": 2400},
    "internship_type": {"enum": ["qualifying","practice"]},
    "minimum_duration_days": {"type": "integer","minimum": 1,"maximum": 730},
    "weekly_hours_min": {"type": "integer","minimum": 1,"maximum": 80},
    "weekly_hours_max": {"type": "integer","minimum": 1,"maximum": 80},
    "workload_band": {"enum": ["light","standard","intensive"]},
    "experience_level": {"enum": ["entry","early_career","intermediate"]},
    "competencies_developed": {"type": "array","minItems": 1,"maxItems": 24,"uniqueItems": true,"items": {"type": "string","maxLength": 120}},
    "sample_responsibilities": {"type": "array","minItems": 1,"maxItems": 24,"uniqueItems": true,"items": {"type": "string","maxLength": 240}},
    "deliverables": {"type": "array","minItems": 1,"maxItems": 24,"uniqueItems": true,"items": {"type": "string","maxLength": 120}},
    "work_rhythm": {"type": "string","minLength": 1,"maxLength": 1000},
    "prerequisites": {"type": "string","maxLength": 800},
    "physical_competency_classification": {"enum": ["knowledge_work","mixed","physical_skill_limited"]},
    "physical_competency_limitation_text": {"type": "string","maxLength": 500},
    "simulation_disclosure": {"type": "string","minLength": 1,"maxLength": 800},
    "completion_overview": {"type": "string","minLength": 1,"maxLength": 1000},
    "support_summary": {"type": "string","minLength": 1,"maxLength": 800},
    "published": {"type": "boolean"},
    "catalog_visible": {"type": "boolean"},
    "sort_order": {"type": "integer","minimum": 0,"maximum": 10000},
    "search_keywords": {"type": "array","maxItems": 64,"uniqueItems": true,"items": {"type": "string","maxLength": 80}}
  }
}
