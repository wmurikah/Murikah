# syntax=docker/dockerfile:1.7

# Murikah Tutor is built independently from the existing Murikah application.
# This Dockerfile is selected explicitly by the Railway Tutor service; it does
# not participate in the root Astro/Cloudflare Worker build.

ARG DEEPTUTOR_VERSION=1.6.6
ARG DEEPTUTOR_COMMIT=7a96bba1ae03401644c17763a2411c28aff3dcc9

FROM python:3.11-slim AS branded-source
ARG DEEPTUTOR_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /src/DeepTutor \
    && cd /src/DeepTutor \
    && git init \
    && git remote add origin https://github.com/HKUDS/DeepTutor.git \
    && git fetch --depth 1 origin "${DEEPTUTOR_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${DEEPTUTOR_COMMIT}"
COPY tutor/scripts/apply_branding.py /opt/murikah/apply_branding.py
COPY tutor/railway/apply_railway_overlay.py /opt/murikah/apply_railway_overlay.py
COPY tutor/railway/apply_guest_continuity.py /opt/murikah/apply_guest_continuity.py
COPY tutor/railway/refine_guest_experience.py /opt/murikah/refine_guest_experience.py
COPY tutor/railway/polish_guest_shell.py /opt/murikah/polish_guest_shell.py
COPY tutor/railway/render_guest_markdown.py /opt/murikah/render_guest_markdown.py
COPY tutor/railway/validate_guest_overlay.py /opt/murikah/validate_guest_overlay.py
COPY tutor/railway/prepare_next_build.py /opt/murikah/prepare_next_build.py
# The Next.js overlay sources are stored with a trailing .txt in this monorepo
# so the root Astro/TypeScript checker does not compile them as Murikah site
# sources. They are restored to their real extensions inside the image before
# the overlay is applied to the pinned DeepTutor checkout.
COPY tutor/railway/health-route.ts.txt /opt/murikah/health-route.ts
COPY tutor/railway/murikah_guest_v2.py /opt/murikah/murikah_guest.py
COPY tutor/railway/murikah_oauth.py /opt/murikah/murikah_oauth.py
COPY tutor/railway/MurikahGuestChatV2.tsx.txt /opt/murikah/MurikahGuestChat.tsx
COPY tutor/railway/MurikahGuestResume.tsx.txt /opt/murikah/MurikahGuestResume.tsx
COPY tutor/railway/MurikahSocialButtons.tsx.txt /opt/murikah/MurikahSocialButtons.tsx
COPY tutor/railway/murikah-entry-page.tsx.txt /opt/murikah/murikah-entry-page.tsx
COPY tutor/railway/murikah-login-page.tsx.txt /opt/murikah/murikah-login-page.tsx
COPY tutor/railway/murikah-register-page.tsx.txt /opt/murikah/murikah-register-page.tsx
COPY docs/images/murikah_6.png /opt/murikah/murikah-logo.png
RUN python /opt/murikah/apply_branding.py /src/DeepTutor \
    && python /opt/murikah/apply_railway_overlay.py /src/DeepTutor /opt/murikah/health-route.ts \
    && python /opt/murikah/apply_guest_continuity.py /src/DeepTutor /opt/murikah/MurikahGuestResume.tsx \
    && python /opt/murikah/refine_guest_experience.py /src/DeepTutor \
    && python /opt/murikah/polish_guest_shell.py /src/DeepTutor \
    && python /opt/murikah/render_guest_markdown.py /src/DeepTutor \
    && python /opt/murikah/validate_guest_overlay.py /src/DeepTutor \
    && python /opt/murikah/prepare_next_build.py /src/DeepTutor \
    && cp /opt/murikah/murikah-logo.png /src/DeepTutor/web/public/murikah-logo.png

FROM node:22-slim AS frontend-builder
WORKDIR /app/web
COPY --from=branded-source /src/DeepTutor/web/package.json /src/DeepTutor/web/package-lock.json ./
RUN npm config set fetch-timeout 600000 \
    && npm config set fetch-retries 5 \
    && npm ci --legacy-peer-deps
COPY --from=branded-source /src/DeepTutor/web/ ./
RUN mkdir -p /app/deeptutor
COPY --from=branded-source /src/DeepTutor/deeptutor/__version__.py /app/deeptutor/__version__.py
RUN printf 'NEXT_PUBLIC_APP_VERSION=\n' > .env.local
# The pinned DeepTutor release is already type-checked upstream. The Murikah
# overlay invariants are validated in branded-source above. Next 16 otherwise
# starts an additional full-project TypeScript worker after webpack compilation,
# which exceeds the constrained Codespaces builder and is terminated (143).
# Opt out only for this reproducible production image build.
RUN MURIKAH_SKIP_NEXT_TYPECHECK=1 NEXT_TELEMETRY_DISABLED=1 npm run build

# Reuse the official DeepTutor runtime rather than copying its Python dependency
# stack into Murikah. Pin the image to the same explicit release as the source
# checkout so upstream changes to `latest` cannot break a reproducible rebuild.
FROM ghcr.io/hkuds/deeptutor:${DEEPTUTOR_VERSION} AS runtime
ARG DEEPTUTOR_VERSION
USER root
RUN python -c "from deeptutor.__version__ import __version__; expected='${DEEPTUTOR_VERSION}'; assert __version__ == expected, f'Expected DeepTutor {expected}, base image is {__version__}'"

# The upstream runtime owns the Python dependency stack. Replace only the
# Murikah overlay router modules and patched API main after verifying the
# runtime is the pinned release; the rest remains the reviewed upstream image.
COPY --from=branded-source /src/DeepTutor/deeptutor/api/routers/murikah_guest.py /app/deeptutor/api/routers/murikah_guest.py
COPY --from=branded-source /src/DeepTutor/deeptutor/api/routers/murikah_oauth.py /app/deeptutor/api/routers/murikah_oauth.py
COPY --from=branded-source /src/DeepTutor/deeptutor/api/main.py /app/deeptutor/api/main.py

RUN rm -rf /app/web && mkdir -p /app/web
COPY --from=frontend-builder /app/web/.next/standalone/ /app/web/
COPY --from=frontend-builder /app/web/.next/static/ /app/web/.next/static/
COPY --from=frontend-builder /app/web/public/ /app/web/public/
RUN chown -R deeptutor:deeptutor /app/web /app/deeptutor

COPY tutor/railway/bootstrap_runtime.py /app/murikah-tutor-bootstrap.py
COPY tutor/railway/entrypoint.sh /app/murikah-tutor-entrypoint.sh
RUN chmod 0755 /app/murikah-tutor-entrypoint.sh /app/murikah-tutor-bootstrap.py

ENV PORT=3782
EXPOSE 3782
ENTRYPOINT ["/app/murikah-tutor-entrypoint.sh"]
