# syntax=docker/dockerfile:1.7

# Murikah Tutor is built independently from the existing Murikah application.
# This Dockerfile is selected explicitly by the Railway Tutor service; it does
# not participate in the root Astro/Cloudflare Worker build.

ARG DEEPTUTOR_VERSION=1.6.6
ARG DEEPTUTOR_COMMIT=7a96bba1ae03401644c17763a2411c28aff3dcc9
ARG MURIKAH_CLOUDFLARE_IMAGE_REV=dev

FROM python:3.11-slim AS branded-source
ARG DEEPTUTOR_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /src/DeepTutor \
    && cd /src/DeepTutor \
    && git init \
    && git remote add origin https://github.com/HKUDS/DeepTutor.git \
    && git fetch --depth 1 origin "${DEEPTUTOR_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${DEEPTUTOR_COMMIT}"
COPY tutor/scripts/apply_branding.py /opt/murikah/apply_branding.py
COPY tutor/railway/apply_railway_overlay.py /opt/murikah/apply_railway_overlay.py
COPY tutor/railway/apply_guest_continuity.py /opt/murikah/apply_guest_continuity.py
COPY tutor/railway/refine_guest_experience.py /opt/murikah/refine_guest_experience.py
COPY tutor/railway/polish_guest_shell.py /opt/murikah/polish_guest_shell.py
COPY tutor/railway/render_guest_markdown.py /opt/murikah/render_guest_markdown.py
COPY tutor/railway/enhance_guest_diagram.py /opt/murikah/enhance_guest_diagram.py
COPY tutor/railway/add_virtual_internship_placeholder.py /opt/murikah/add_virtual_internship_placeholder.py
COPY tutor/railway/fluid_visual_outputs.py /opt/murikah/fluid_visual_outputs.py
COPY tutor/railway/harden_member_runtime.py /opt/murikah/harden_member_runtime.py
COPY tutor/railway/share_admin_models.py /opt/murikah/share_admin_models.py
COPY tutor/railway/harden_admin_controls.py /opt/murikah/harden_admin_controls.py
COPY tutor/railway/harden_math_animator.py /opt/murikah/harden_math_animator.py
COPY tutor/railway/harden_guest_completion.py /opt/murikah/harden_guest_completion.py
COPY tutor/railway/accelerate_chat.py /opt/murikah/accelerate_chat.py
COPY tutor/railway/persist_learning_journal.py /opt/murikah/persist_learning_journal.py
COPY tutor/railway/brand_chat_status.py /opt/murikah/brand_chat_status.py
COPY tutor/railway/murikah_fast_lane.py /opt/murikah/murikah_fast_lane.py
COPY tutor/railway/murikah_context_packet.py /opt/murikah/murikah_context_packet.py
COPY tutor/railway/murikah_persistence.py /opt/murikah/murikah_persistence.py
COPY tutor/railway/virtual_internship /src/DeepTutor/deeptutor/virtual_internship
COPY tutor/railway/lock_guest_composer.py /opt/murikah/lock_guest_composer.py
COPY tutor/railway/validate_guest_overlay.py /opt/murikah/validate_guest_overlay.py
COPY tutor/railway/apply_workspace_access.py /opt/murikah/apply_workspace_access.py
COPY tutor/railway/hide_guest_account_ui.py /opt/murikah/hide_guest_account_ui.py
COPY tutor/railway/apply_tutor_personalization.py /opt/murikah/apply_tutor_personalization.py
COPY tutor/railway/murikah_personalization.py /opt/murikah/murikah_personalization.py
COPY tutor/railway/murikah_visible_text.py /opt/murikah/murikah_visible_text.py
COPY tutor/railway/murikah-personalization.ts.txt /opt/murikah/murikah-personalization.ts.txt
COPY tutor/railway/MurikahPreferredName.tsx.txt /opt/murikah/MurikahPreferredName.tsx.txt
COPY tutor/railway/murikah_access.py /opt/murikah/murikah_access.py
COPY tutor/railway/murikah_email_verification.py /opt/murikah/murikah_email_verification.py
COPY tutor/railway/disposable_email_domains.txt /opt/murikah/disposable_email_domains.txt
COPY tutor/railway/murikah_diagram.py /opt/murikah/murikah_diagram.py
COPY tutor/railway/murikah_er.py /opt/murikah/murikah_er.py
COPY tutor/railway/MurikahWorkspaceEntry.tsx.txt /opt/murikah/MurikahWorkspaceEntry.tsx.txt
COPY tutor/railway/MurikahGuestBanner.tsx.txt /opt/murikah/MurikahGuestBanner.tsx.txt
COPY tutor/railway/MurikahAccountPage.tsx.txt /opt/murikah/MurikahAccountPage.tsx.txt
COPY tutor/railway/MurikahInviteFriends.tsx.txt /opt/murikah/MurikahInviteFriends.tsx.txt
COPY tutor/railway/prepare_next_build.py /opt/murikah/prepare_next_build.py
# The Next.js overlay sources are stored with a trailing .txt in this monorepo
# so the root Astro/TypeScript checker does not compile them as Murikah site
# sources. They are restored to their real extensions inside the image before
# the overlay is applied to the pinned DeepTutor checkout.
COPY tutor/railway/health-route.ts.txt /opt/murikah/health-route.ts
COPY tutor/railway/murikah_guest_v2.py /opt/murikah/murikah_guest.py
COPY tutor/railway/murikah_oauth.py /opt/murikah/murikah_oauth.py
COPY tutor/railway/MurikahGuestChatV2.tsx.txt /opt/murikah/MurikahGuestChat.tsx
COPY tutor/railway/MurikahGuestResume.tsx.txt /opt/murikah/MurikahGuestResume.tsx
COPY tutor/railway/MurikahSocialButtons.tsx.txt /opt/murikah/MurikahSocialButtons.tsx
COPY tutor/railway/MurikahDiagramStudio.tsx.txt /opt/murikah/MurikahDiagramStudio.tsx
COPY tutor/railway/murikah-diagram-page.tsx.txt /opt/murikah/murikah-diagram-page.tsx
COPY tutor/railway/murikah-virtual-internship-page.tsx.txt /opt/murikah/murikah-virtual-internship-page.tsx
COPY tutor/railway/murikah-entry-page.tsx.txt /opt/murikah/murikah-entry-page.tsx
COPY tutor/railway/murikah-login-page.tsx.txt /opt/murikah/murikah-login-page.tsx
COPY tutor/railway/murikah-register-page.tsx.txt /opt/murikah/murikah-register-page.tsx
COPY docs/images/murikah_6.png /opt/murikah/murikah-logo.png
RUN cp /opt/murikah/murikah_fast_lane.py /src/DeepTutor/deeptutor/murikah_fast_lane.py \
    && cp /opt/murikah/murikah_context_packet.py /src/DeepTutor/deeptutor/murikah_context_packet.py \
    && cp /opt/murikah/murikah_persistence.py /src/DeepTutor/deeptutor/murikah_persistence.py \
    && cp /opt/murikah/murikah_diagram.py /src/DeepTutor/deeptutor/murikah_diagram.py \
    && cp /opt/murikah/murikah_er.py /src/DeepTutor/deeptutor/murikah_er.py \
    && python /opt/murikah/apply_branding.py /src/DeepTutor \
    && python /opt/murikah/apply_railway_overlay.py /src/DeepTutor /opt/murikah/health-route.ts \
    && python /opt/murikah/apply_guest_continuity.py /src/DeepTutor /opt/murikah/MurikahGuestResume.tsx \
    && python /opt/murikah/refine_guest_experience.py /src/DeepTutor \
    && python /opt/murikah/polish_guest_shell.py /src/DeepTutor \
    && python /opt/murikah/render_guest_markdown.py /src/DeepTutor \
    && python /opt/murikah/enhance_guest_diagram.py /src/DeepTutor \
    && python /opt/murikah/add_virtual_internship_placeholder.py /src/DeepTutor /opt/murikah/murikah-virtual-internship-page.tsx \
    && python /opt/murikah/harden_guest_completion.py /src/DeepTutor \
    && python /opt/murikah/accelerate_chat.py /src/DeepTutor \
    && python /opt/murikah/lock_guest_composer.py /src/DeepTutor \
    && python /opt/murikah/prepare_next_build.py /src/DeepTutor \
    && python /opt/murikah/apply_workspace_access.py /src/DeepTutor \
    && python /opt/murikah/harden_member_runtime.py /src/DeepTutor \
    && python /opt/murikah/share_admin_models.py /src/DeepTutor \
    && python /opt/murikah/harden_admin_controls.py /src/DeepTutor \
    && python /opt/murikah/harden_math_animator.py /src/DeepTutor \
    && python /opt/murikah/fluid_visual_outputs.py /src/DeepTutor \
    && python /opt/murikah/validate_guest_overlay.py /src/DeepTutor \
    && python /opt/murikah/persist_learning_journal.py /src/DeepTutor \
    && python /opt/murikah/brand_chat_status.py /src/DeepTutor \
    && python /opt/murikah/hide_guest_account_ui.py /src/DeepTutor \
    && python /opt/murikah/apply_tutor_personalization.py /src/DeepTutor /opt/murikah \
    && cp /opt/murikah/murikah-logo.png /src/DeepTutor/web/public/murikah-logo.png

FROM node:22-slim AS frontend-builder
WORKDIR /app/web
COPY --from=branded-source /src/DeepTutor/web/package.json /src/DeepTutor/web/package-lock.json ./
RUN npm config set fetch-timeout 600000 \
    && npm config set fetch-retries 5 \
    && npm ci --legacy-peer-deps
COPY --from=branded-source /src/DeepTutor/web/ ./
COPY tutor/tests/diagram-studio.spec.tsx.txt ./tests/integration/diagram-studio.spec.tsx
COPY tutor/tests/guest-limit.spec.tsx.txt ./tests/integration/guest-limit.spec.tsx
COPY tutor/tests/auth-sso.spec.tsx.txt ./tests/integration/auth-sso.spec.tsx
COPY tutor/tests/settings-admin-boundary.spec.tsx.txt ./tests/integration/settings-admin-boundary.spec.tsx
COPY tutor/tests/verified-email-invites.spec.tsx.txt ./tests/integration/verified-email-invites.spec.tsx
COPY tutor/tests/personalization-visible-text.spec.tsx.txt ./tests/integration/personalization-visible-text.spec.tsx
COPY tutor/tests/personalization.spec.tsx.txt ./tests/integration/personalization.spec.tsx
RUN npx vitest run tests/integration/diagram-studio.spec.tsx tests/integration/guest-limit.spec.tsx tests/integration/auth-sso.spec.tsx tests/integration/settings-admin-boundary.spec.tsx tests/integration/verified-email-invites.spec.tsx tests/integration/personalization-visible-text.spec.tsx tests/integration/personalization.spec.tsx
RUN mkdir -p /app/deeptutor
COPY --from=branded-source /src/DeepTutor/deeptutor/__version__.py /app/deeptutor/__version__.py
RUN printf 'NEXT_PUBLIC_APP_VERSION=\n' > .env.local
# The pinned release is validated by Murikah's overlay checks and already
# type-checked upstream. The constrained production build isolates webpack,
# serializes module work, disables its transient cache and caps each inherited
# Node process below the Codespaces host ceiling. This keeps the image build
# deterministic without changing normal DeepTutor development behaviour.
RUN MURIKAH_CONSTRAINED_BUILD=1 \
    MURIKAH_SKIP_NEXT_TYPECHECK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=1280 \
    npm run build

# Reuse the official DeepTutor runtime rather than copying its Python dependency
# stack into Murikah. Pin the image to the same explicit release as the source
# checkout so upstream changes to `latest` cannot break a reproducible rebuild.
FROM ghcr.io/hkuds/deeptutor:${DEEPTUTOR_VERSION} AS runtime
ARG DEEPTUTOR_VERSION
ARG MURIKAH_CLOUDFLARE_IMAGE_REV=dev
LABEL com.murikah.tutor.cloudflare-image-rev="${MURIKAH_CLOUDFLARE_IMAGE_REV}"
USER root
RUN python -c "from deeptutor.__version__ import __version__; expected='${DEEPTUTOR_VERSION}'; assert __version__ == expected, f'Expected DeepTutor {expected}, base image is {__version__}'"

# Math Animator is exposed in the production capability picker, so its
# dependencies are part of the production contract rather than an optional
# developer extra. Install Manim plus the system render toolchain once in the
# final runtime image, then fail the image build if any required executable is
# absent. This prevents a selectable feature from reaching users half-installed.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential cmake ffmpeg pkg-config \
       libcairo2 libcairo2-dev libpango-1.0-0 libpango1.0-dev \
       texlive-latex-base texlive-latex-extra texlive-fonts-recommended \
       texlive-science dvisvgm \
    && python -m pip install --no-cache-dir "manim>=0.19.0,<0.20" \
    && python -c "import manim, shutil; assert shutil.which('ffmpeg'); assert shutil.which('latex'); assert shutil.which('dvisvgm')" \
    && rm -rf /var/lib/apt/lists/*

# The upstream runtime owns the Python dependency stack. Replace only the
# Murikah overlay router modules and patched API/chat surfaces after verifying
# the runtime is the pinned release; the rest remains the reviewed upstream image.
COPY --from=branded-source /src/DeepTutor/deeptutor/api/routers/murikah_guest.py /app/deeptutor/api/routers/murikah_guest.py
COPY --from=branded-source /src/DeepTutor/deeptutor/api/routers/murikah_oauth.py /app/deeptutor/api/routers/murikah_oauth.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_access.py /app/deeptutor/murikah_access.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_email_verification.py /app/deeptutor/murikah_email_verification.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_personalization.py /app/deeptutor/murikah_personalization.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_visible_text.py /app/deeptutor/murikah_visible_text.py
COPY --from=branded-source /src/DeepTutor/deeptutor/disposable_email_domains.txt /app/deeptutor/disposable_email_domains.txt
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_diagram.py /app/deeptutor/murikah_diagram.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_er.py /app/deeptutor/murikah_er.py
COPY --from=branded-source /src/DeepTutor/deeptutor/services/auth.py /app/deeptutor/services/auth.py
COPY --from=branded-source /src/DeepTutor/deeptutor/multi_user/model_access.py /app/deeptutor/multi_user/model_access.py
COPY --from=branded-source /src/DeepTutor/deeptutor/app/service.py /app/deeptutor/app/service.py
COPY --from=branded-source /src/DeepTutor/deeptutor/api/main.py /app/deeptutor/api/main.py
COPY --from=branded-source /src/DeepTutor/deeptutor/api/routers/settings.py /app/deeptutor/api/routers/settings.py
COPY --from=branded-source /src/DeepTutor/deeptutor/agents/chat/capability.py /app/deeptutor/agents/chat/capability.py
COPY --from=branded-source /src/DeepTutor/deeptutor/agents/math_animator /app/deeptutor/agents/math_animator
COPY --from=branded-source /src/DeepTutor/deeptutor/services/session/turns/executor.py /app/deeptutor/services/session/turns/executor.py
COPY --from=branded-source /src/DeepTutor/deeptutor/services/session/_turn_runtime_shared.py /app/deeptutor/services/session/_turn_runtime_shared.py
COPY --from=branded-source /src/DeepTutor/deeptutor/runtime/stream_bus.py /app/deeptutor/runtime/stream_bus.py
COPY --from=branded-source /src/DeepTutor/deeptutor/agents/loop/pipeline.py /app/deeptutor/agents/loop/pipeline.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_fast_lane.py /app/deeptutor/murikah_fast_lane.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_context_packet.py /app/deeptutor/murikah_context_packet.py
COPY --from=branded-source /src/DeepTutor/deeptutor/murikah_persistence.py /app/deeptutor/murikah_persistence.py
COPY --from=branded-source /src/DeepTutor/deeptutor/virtual_internship /app/deeptutor/virtual_internship

# The Python regression suite intentionally validates both installed runtime
# modules and repository overlay sources. Copy the complete non-secret railway
# overlay tree into the test fixture root so any source-backed regression test
# has the same paths it has in a repository checkout. This prevents Cloudflare
# image builds from failing when a new test reads an overlay source file.
COPY tutor/railway /opt/murikah/railway
COPY tutor/virtual-internship /opt/murikah/virtual-internship
COPY tutor/scripts/validate_virtual_internship_scenarios.py /opt/murikah/scripts/validate_virtual_internship_scenarios.py
COPY tutor/cloudflare/src /opt/murikah/cloudflare/src
COPY tutor/cloudflare/migrations /opt/murikah/cloudflare/migrations
COPY tutor/cloudflare/entrypoint.sh /opt/murikah/cloudflare/entrypoint.sh
COPY tutor/tests /opt/murikah/tests
RUN python /opt/murikah/scripts/validate_virtual_internship_scenarios.py
RUN python -m unittest discover -s /opt/murikah/tests -v

RUN rm -rf /app/web && mkdir -p /app/web
COPY --from=frontend-builder /app/web/.next/standalone/ /app/web/
COPY --from=frontend-builder /app/web/.next/static/ /app/web/.next/static/
COPY --from=frontend-builder /app/web/public/ /app/web/public/
RUN chown -R deeptutor:deeptutor /app/web /app/deeptutor

COPY tutor/railway/bootstrap_runtime.py /app/murikah-tutor-bootstrap.py
COPY tutor/railway/bootstrap_fast_lane.py /app/murikah-fast-lane-bootstrap.py
COPY tutor/railway/entrypoint.sh /app/murikah-tutor-entrypoint.sh
COPY tutor/cloudflare/entrypoint.sh /app/murikah-cloudflare-entrypoint.sh
RUN chmod 0755 \
    /app/murikah-tutor-entrypoint.sh \
    /app/murikah-tutor-bootstrap.py \
    /app/murikah-cloudflare-entrypoint.sh \
    && printf '%s\n' "${MURIKAH_CLOUDFLARE_IMAGE_REV}" > /app/murikah-cloudflare-image-rev

ENV PORT=3782
EXPOSE 3782
ENTRYPOINT ["/app/murikah-tutor-entrypoint.sh"]
